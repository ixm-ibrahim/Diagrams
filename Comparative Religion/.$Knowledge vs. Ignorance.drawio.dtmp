        <mxCell id="wjP_0DYecouRZlg33f4N-12" value="&lt;span style=&quot;font-size: 14px;&quot;&gt;for &lt;i&gt;p&lt;/i&gt;&amp;nbsp;statements, every possible arrangement of &lt;i&gt;p&lt;/i&gt; premises and &lt;i&gt;n - p &lt;/i&gt;conclusions*&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=1;fillColor=none;strokeColor=none;" parent="wjP_0DYecouRZlg33f4N-4" vertex="1">
