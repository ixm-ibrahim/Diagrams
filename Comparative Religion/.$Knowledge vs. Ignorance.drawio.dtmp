        <mxCell id="wjP_0DYecouRZlg33f4N-6" value="&lt;span style=&quot;text-wrap-mode: nowrap;&quot;&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;$$A_n&amp;nbsp;\;=\; 3^n\;\sum_{p=1}^{n-1}&lt;br&gt;\binom{n}{p}\; 3^{\,p(n-p)}$$&lt;/font&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=1;fillColor=none;strokeColor=none;spacingTop=0;" parent="wjP_0DYecouRZlg33f4N-4" vertex="1">
