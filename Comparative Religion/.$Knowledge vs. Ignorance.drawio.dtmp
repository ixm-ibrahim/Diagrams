        <mxCell id="wjP_0DYecouRZlg33f4N-74" value="&lt;span style=&quot;text-wrap-mode: nowrap;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;$$A_2&amp;nbsp;\;=\; 3^2\;\sum_{p=1}^{1} \binom{2}{p}\; 3^{\,p(2-p)} \;=\;&lt;br&gt;3^2\;\binom{2}{1}\;3^1 \;=\; 9*2*3 \;=\; 54$$&lt;/font&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=1;fillColor=none;strokeColor=none;spacingTop=0;" parent="wjP_0DYecouRZlg33f4N-72" vertex="1">
