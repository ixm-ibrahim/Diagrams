          <mxGeometry x="30" y="1020" width="770" height="140" as="geometry" />
        </mxCell>
        <mxCell id="kp4HC5xhiUsZ4yLr_8o6-496" value="" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=1;fillColor=none;strokeColor=default;spacingTop=0;" parent="kp4HC5xhiUsZ4yLr_8o6-495" vertex="1">
          <mxGeometry width="770" height="140" as="geometry" />
        </mxCell>
        <mxCell id="kp4HC5xhiUsZ4yLr_8o6-497" value="&lt;span style=&quot;text-wrap-mode: nowrap;&quot;&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;$$A_3&amp;nbsp;\;=\; 3^3\;\sum_{p=1}^{2} \binom{3}{p}\; 3^{\,p(3-p)}&amp;nbsp;\;=\;&lt;br&gt;3^3\left(\binom{3}{1}3^2 + \binom{3}{2}3^2\right) \;=\; 27(3*9+3*9) \;=\; 1458$$&lt;/font&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=1;fillColor=none;strokeColor=none;spacingTop=0;" parent="kp4HC5xhiUsZ4yLr_8o6-495" vertex="1">
          <mxGeometry width="770" height="80" as="geometry" />
        </mxCell>
        <mxCell id="kp4HC5xhiUsZ4yLr_8o6-498" value="&lt;font style=&quot;&quot;&gt;&lt;i style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 20px;&quot;&gt;$$Upper Bound_3 = 3^3\;2^3\;3^{3^2 / 4} = 27*8*11.8447 ≈&amp;nbsp;2559$$&lt;/span&gt;&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=1;fillColor=none;strokeColor=none;fontStyle=0;spacingTop=0;" parent="kp4HC5xhiUsZ4yLr_8o6-495" vertex="1">
          <mxGeometry y="80" width="770" height="50" as="geometry" />
        </mxCell>
        <mxCell id="kp4HC5xhiUsZ4yLr_8o6-510" value="" style="group" parent="kp4HC5xhiUsZ4yLr_8o6-663" vertex="1" connectable="0">
          <mxGeometry x="30" y="920" width="770" height="90" as="geometry" />
        </mxCell>
        <mxCell id="kp4HC5xhiUsZ4yLr_8o6-501" value="" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=1;fillColor=none;strokeColor=default;spacingTop=0;" parent="kp4HC5xhiUsZ4yLr_8o6-510" vertex="1">
          <mxGeometry width="770" height="90" as="geometry" />
        </mxCell>
        <mxCell id="kp4HC5xhiUsZ4yLr_8o6-499" value="&lt;span style=&quot;text-wrap-mode: nowrap;&quot;&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;$$A_n&amp;nbsp;\;=\; 3^n\;\sum_{p=1}^{n-1}&lt;br&gt;\binom{n}{p}\; 3^{\,p(n-p)}$$&lt;/font&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=1;fillColor=none;strokeColor=none;spacingTop=0;" parent="kp4HC5xhiUsZ4yLr_8o6-510" vertex="1">
          <mxGeometry y="10" width="370" height="70" as="geometry" />
        </mxCell>
        <mxCell id="kp4HC5xhiUsZ4yLr_8o6-500" value="&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;i style=&quot;&quot;&gt;$$Upper Bound_n = 3^n\;2^n\;3^{n^2 / 4}$$&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=1;fillColor=none;strokeColor=none;fontStyle=0;spacingTop=0;" parent="kp4HC5xhiUsZ4yLr_8o6-510" vertex="1">
          <mxGeometry x="400" y="10" width="370" height="70" as="geometry" />
        </mxCell>
        <mxCell id="4MRHiqvjY2QezjOFMfRu-1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#CCCCCC;strokeColor=#000000;fontColor=#333333;" parent="1" vertex="1">
          <mxGeometry x="860" y="10" width="830" height="1190" as="geometry" />
        </mxCell>
        <mxCell id="4MRHiqvjY2QezjOFMfRu-3" value="&lt;b style=&quot;font-size: 36px; text-wrap-mode: nowrap;&quot;&gt;Knowledge vs. Ignorance&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="1050" y="30" width="450" height="60" as="geometry" />
        </mxCell>
        <mxCell id="D0tRHAQ9LQ57oHEz4JKX-4" value="" style="group" parent="1" vertex="1" connectable="0">
          <mxGeometry x="890" y="110" width="760" height="590" as="geometry" />
        </mxCell>
        <mxCell id="ZEsSeHQPeyFyIlUhyiSo-2" value="&lt;font style=&quot;font-size: 24px;&quot;&gt;&lt;b&gt;Ignorance: Adding a new statement&lt;/b&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=top;fontSize=1;fillColor=none;strokeColor=default;" parent="D0tRHAQ9LQ57oHEz4JKX-4" vertex="1">
          <mxGeometry width="760" height="570" as="geometry" />
        </mxCell>
        <mxCell id="ZEsSeHQPeyFyIlUhyiSo-16" value="&lt;span style=&quot;text-wrap-mode: nowrap;&quot;&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;$$\begin{gathered}&lt;br&gt;\boldsymbol{A_n} = 3^n\;\sum_{p=1}^{n-1}&lt;br&gt;\binom{n}{p}\; 3^{\,p(n-p)}&lt;br&gt;\end{gathered}$$&lt;/font&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=1;fillColor=none;strokeColor=none;spacingTop=0;" parent="D0tRHAQ9LQ57oHEz4JKX-4" vertex="1">
          <mxGeometry x="20" y="80" width="340" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ZEsSeHQPeyFyIlUhyiSo-17" value="&lt;span style=&quot;text-wrap-mode: nowrap;&quot;&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;$$\begin{gathered}&lt;br&gt;\boldsymbol{A_{n+1}} = 3^{n+1}\sum_{p=1}^{n}&lt;br&gt;\binom{n+1}{p}\; 3^{\;p(n-p+1)}&lt;br&gt;\end{gathered}$$&lt;/font&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=1;fillColor=none;strokeColor=none;spacingTop=0;" parent="D0tRHAQ9LQ57oHEz4JKX-4" vertex="1">
          <mxGeometry x="400" y="80" width="340" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ZEsSeHQPeyFyIlUhyiSo-19" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;$$\begin{gathered}&lt;br&gt;\boldsymbol{M} \;=\; \frac{A_{n+1}}{A_n} \;=\;&lt;br&gt;\frac{3^{n+1}\sum_{p=1}^{n}&lt;br&gt;\binom{n+1}{p}\; 3^{\;p(n-p+1)}}&lt;br&gt;{3^n\;\sum_{p=1}^{n-1}&lt;br&gt;\binom{n}{p}\; 3^{\,p(n-p)}}&amp;nbsp;\;=\;&lt;br&gt;3\frac{\sum_{p=1}^{n}&lt;br&gt;\binom{n+1}{p}\; 3^{\;p(n+1-p)}}&lt;br&gt;{\sum_{p=1}^{n-1}&lt;br&gt;\binom{n}{p}\; 3^{\,p(n-p)}}&lt;br&gt;\end{gathered}$$&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=1;fillColor=none;strokeColor=none;spacingTop=0;" parent="D0tRHAQ9LQ57oHEz4JKX-4" vertex="1">
          <mxGeometry x="20" y="170" width="720" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ZEsSeHQPeyFyIlUhyiSo-20" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;It&#39;s more intuitive to consider the worst-case scenario (the one with the largest impact).&amp;nbsp;For each of the already existing &lt;i&gt;n&lt;/i&gt;&amp;nbsp;statements, the new statement &lt;i&gt;S&lt;/i&gt;&amp;nbsp;can connect with all of them 3 different ways: {&lt;i&gt;P&lt;/i&gt;, &lt;i&gt;C&lt;/i&gt;, &lt;i&gt;I&lt;/i&gt;} - which is&amp;nbsp;&lt;i&gt;3&lt;sup&gt;n&lt;/sup&gt;&lt;/i&gt;. For each of those arrangements, &lt;i&gt;S&lt;/i&gt; can have any truth-value {?, T, F} - which is simply 3. Adjusting&amp;nbsp;&lt;i&gt;A&lt;sub&gt;n&lt;/sub&gt;&lt;/i&gt; by these coefficeints leads to &lt;i&gt;M&lt;/i&gt;:&lt;/font&gt;" style="rounded=0;align=center;verticalAlign=middle;fontSize=1;fillColor=none;strokeColor=none;spacingTop=0;whiteSpace=wrap;html=1;" parent="D0tRHAQ9LQ57oHEz4JKX-4" vertex="1">
          <mxGeometry x="10" y="250" width="740" height="100" as="geometry" />
        </mxCell>
        <mxCell id="ZEsSeHQPeyFyIlUhyiSo-21" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;It&#39;s possible to algebraically reduce this, but doing so results in a difficult summation:&lt;/font&gt;" style="rounded=0;align=center;verticalAlign=middle;fontSize=1;fillColor=none;strokeColor=none;spacingTop=0;whiteSpace=wrap;html=1;" parent="D0tRHAQ9LQ57oHEz4JKX-4" vertex="1">
          <mxGeometry x="10" y="50" width="740" height="30" as="geometry" />
        </mxCell>
        <mxCell id="ZEsSeHQPeyFyIlUhyiSo-22" value="&lt;span style=&quot;text-wrap-mode: nowrap;&quot;&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;$$\begin{gathered}&lt;br&gt;\boldsymbol{A_{n+1}} \;=\; A_n*3*3^n \;=\; 3^{n+1}A_n&lt;br&gt;\end{gathered}$$&lt;/font&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=1;fillColor=none;strokeColor=none;spacingTop=0;" parent="D0tRHAQ9LQ57oHEz4JKX-4" vertex="1">
          <mxGeometry x="20" y="350" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ZEsSeHQPeyFyIlUhyiSo-23" value="&lt;span style=&quot;text-wrap-mode: nowrap;&quot;&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;$$\begin{gathered}&lt;br&gt;\boldsymbol{M} \;=\; \frac{A_{n+1}}{A_n}&lt;br&gt;\;=\; \frac{3^{n+1} A_n}{A_n}&lt;br&gt;&amp;nbsp;\;=\; 3^{n+1}\&lt;br&gt;\end{gathered}$$&lt;/font&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=1;fillColor=none;strokeColor=none;spacingTop=0;" parent="D0tRHAQ9LQ57oHEz4JKX-4" vertex="1">
          <mxGeometry x="390" y="350" width="350" height="60" as="geometry" />
        </mxCell>
        <mxCell id="D0tRHAQ9LQ57oHEz4JKX-1" value="&lt;span style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;Adding a new statement increases the number of arrangements by a maximum of 3&lt;sup&gt;n+1&lt;/sup&gt;, or &lt;i&gt;n+1&lt;/i&gt;&amp;nbsp;in log-space.&lt;/b&gt;&lt;/span&gt;" style="rounded=0;align=center;verticalAlign=middle;fontSize=1;fillColor=none;strokeColor=none;spacingTop=0;whiteSpace=wrap;html=1;" parent="D0tRHAQ9LQ57oHEz4JKX-4" vertex="1">
          <mxGeometry y="510" width="760" height="60" as="geometry" />
        </mxCell>
        <mxCell id="D0tRHAQ9LQ57oHEz4JKX-2" value="&lt;span style=&quot;font-size: 18px;&quot;&gt;To make the ratio more intuitive (ie. removing the exponent), we can transform it onto the logarithmic scale:&lt;/span&gt;" style="rounded=0;align=center;verticalAlign=middle;fontSize=1;fillColor=none;strokeColor=none;spacingTop=0;whiteSpace=wrap;html=1;" parent="D0tRHAQ9LQ57oHEz4JKX-4" vertex="1">
          <mxGeometry x="10" y="420" width="740" height="40" as="geometry" />
        </mxCell>
        <mxCell id="D0tRHAQ9LQ57oHEz4JKX-3" value="&lt;span style=&quot;text-wrap-mode: nowrap;&quot;&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;$$\begin{gathered}&lt;br&gt;\boldsymbol{R} \;=\; log_3(M) \;=\; log_3(3^{n+1}) \;=\; n+1&lt;br&gt;\end{gathered}$$&lt;/font&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=1;fillColor=none;strokeColor=none;spacingTop=0;" parent="D0tRHAQ9LQ57oHEz4JKX-4" vertex="1">
          <mxGeometry x="190" y="460" width="390" height="50" as="geometry" />
        </mxCell>
        <mxCell id="D0tRHAQ9LQ57oHEz4JKX-6" value="&lt;font style=&quot;font-size: 24px;&quot;&gt;&lt;b&gt;Knowledge: Learning that a statement is valid or sound&lt;/b&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=top;fontSize=1;fillColor=none;strokeColor=default;" parent="1" vertex="1">
          <mxGeometry x="890" y="690" width="760" height="590" as="geometry" />
        </mxCell>
        <mxCell id="D0tRHAQ9LQ57oHEz4JKX-9" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;$$\begin{gathered}&lt;br&gt;\boldsymbol{M} \;=\; \frac{A_{n+1}}{A_n} \;=\;&lt;br&gt;\frac{3^{n+1}\sum_{p=1}^{n}&lt;br&gt;\binom{n+1}{p}\; 3^{\;p(n-p+1)}}&lt;br&gt;{3^n\;\sum_{p=1}^{n-1}&lt;br&gt;\binom{n}{p}\; 3^{\,p(n-p)}}&amp;nbsp;\;=\;&lt;br&gt;3\frac{\sum_{p=1}^{n}&lt;br&gt;\binom{n+1}{p}\; 3^{\;p(n+1-p)}}&lt;br&gt;{\sum_{p=1}^{n-1}&lt;br&gt;\binom{n}{p}\; 3^{\,p(n-p)}}&lt;br&gt;\end{gathered}$$&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=1;fillColor=none;strokeColor=none;spacingTop=0;" parent="1" vertex="1">
          <mxGeometry x="910" y="860" width="720" height="80" as="geometry" />
        </mxCell>
        <mxCell id="D0tRHAQ9LQ57oHEz4JKX-10" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;It&#39;s more intuitive to consider the worst-case scenario.&amp;nbsp;The new statement &lt;i&gt;C&lt;/i&gt; adds 3 new possibilities to each of the n statements: {&lt;i&gt;?&lt;/i&gt;, &lt;i&gt;T&lt;/i&gt;, &lt;i&gt;F&lt;/i&gt;} (note: this corresponds to the &lt;i&gt;3&lt;/i&gt;&amp;nbsp;coefficient in &lt;i&gt;M&lt;/i&gt; above). For each of the already existing &lt;i&gt;n&lt;/i&gt;&amp;nbsp;statements, C can connect with all of them 3 different ways: {&lt;i&gt;P&lt;/i&gt;, &lt;i&gt;C&lt;/i&gt;, &lt;i&gt;I&lt;/i&gt;} - which is&amp;nbsp;&lt;i&gt;3&lt;sup&gt;n&lt;/sup&gt;&lt;/i&gt;. Adjusting&amp;nbsp;&lt;i&gt;A&lt;sub&gt;n&lt;/sub&gt;&lt;/i&gt; by these coefficeints leads to &lt;i&gt;M&lt;/i&gt;:&lt;/font&gt;" style="rounded=0;align=center;verticalAlign=middle;fontSize=1;fillColor=none;strokeColor=none;spacingTop=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="900" y="940" width="740" height="100" as="geometry" />
        </mxCell>
        <mxCell id="D0tRHAQ9LQ57oHEz4JKX-11" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;A statement &lt;i&gt;S&amp;nbsp;&lt;/i&gt;becomes sound when arranging it within &lt;i&gt;k&lt;/i&gt;&amp;nbsp;known&amp;nbsp;statements (ignoring all unknown statements) leaves no contradictions (ie. no two known statements that are both &quot;true&quot; have the &quot;contradicts&quot; relationship). In this case, the only arrangements left will have each &lt;i&gt;k&lt;/i&gt;&amp;nbsp;statement be &quot;true&quot; or &quot;false&quot;, with the rest of the&amp;nbsp;&lt;i&gt;n - k&lt;/i&gt;&amp;nbsp;statements to have all three truth-values.&lt;/font&gt;" style="rounded=0;align=center;verticalAlign=middle;fontSize=1;fillColor=none;strokeColor=none;spacingTop=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="900" y="740" width="740" height="90" as="geometry" />
        </mxCell>
        <mxCell id="D0tRHAQ9LQ57oHEz4JKX-12" value="&lt;span style=&quot;text-wrap-mode: nowrap;&quot;&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;$$\begin{gathered}&lt;br&gt;\boldsymbol{A_{n+1}} \;=\; A_n*3*3^n \;=\; 3^{n+1}A_n&lt;br&gt;\end{gathered}$$&lt;/font&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=1;fillColor=none;strokeColor=none;spacingTop=0;" parent="1" vertex="1">
          <mxGeometry x="960" y="1040" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="D0tRHAQ9LQ57oHEz4JKX-13" value="&lt;span style=&quot;text-wrap-mode: nowrap;&quot;&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;$$\begin{gathered}&lt;br&gt;\boldsymbol{M} \;=\; 3^{n+1}\&lt;br&gt;\end{gathered}$$&lt;/font&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=1;fillColor=none;strokeColor=none;spacingTop=0;" parent="1" vertex="1">
          <mxGeometry x="1320" y="1040" width="190" height="60" as="geometry" />
        </mxCell>
        <mxCell id="D0tRHAQ9LQ57oHEz4JKX-14" value="&lt;span style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;Adding a new statement increases the number of arrangements by a maximum of 3&lt;sup&gt;n+1&lt;/sup&gt;, or &lt;i&gt;n+1&lt;/i&gt;&amp;nbsp;in log-space.&lt;/b&gt;&lt;/span&gt;" style="rounded=0;align=center;verticalAlign=middle;fontSize=1;fillColor=none;strokeColor=none;spacingTop=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="890" y="1210" width="760" height="60" as="geometry" />
        </mxCell>
        <mxCell id="D0tRHAQ9LQ57oHEz4JKX-15" value="&lt;span style=&quot;font-size: 18px;&quot;&gt;To make the ratio more intuitive (ie. removing the exponent), we can transform it onto the logarithmic scale:&lt;/span&gt;" style="rounded=0;align=center;verticalAlign=middle;fontSize=1;fillColor=none;strokeColor=none;spacingTop=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="900" y="1110" width="740" height="40" as="geometry" />
        </mxCell>
        <mxCell id="D0tRHAQ9LQ57oHEz4JKX-16" value="&lt;span style=&quot;text-wrap-mode: nowrap;&quot;&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;$$\begin{gathered}&lt;br&gt;\boldsymbol{R} \;=\; log_3(M) \;=\; log_3(3^{n+1}) \;=\; n+1&lt;br&gt;\end{gathered}$$&lt;/font&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=1;fillColor=none;strokeColor=none;spacingTop=0;" parent="1" vertex="1">
          <mxGeometry x="1080" y="1150" width="390" height="60" as="geometry" />
