        <mxCell id="kp4HC5xhiUsZ4yLr_8o6-524" value="&lt;span style=&quot;text-wrap-mode: nowrap;&quot;&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;$$A_n&amp;nbsp;\;=\; 3^n\;\sum_{p=1}^{n-1}&lt;br&gt;\binom{n}{p}\; 3^{\,p(n-p)}$$&lt;/font&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=1;fillColor=none;strokeColor=none;spacingTop=0;" parent="kp4HC5xhiUsZ4yLr_8o6-656" vertex="1">
          <mxGeometry y="10" width="380" height="70" as="geometry" />
        </mxCell>
        <mxCell id="kp4HC5xhiUsZ4yLr_8o6-525" value="&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;i style=&quot;&quot;&gt;$$Upper Bound_n = 3^n\;2^n\;3^{n^2 / 4}$$&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=1;fillColor=none;strokeColor=none;fontStyle=0;spacingTop=0;" parent="kp4HC5xhiUsZ4yLr_8o6-656" vertex="1">
