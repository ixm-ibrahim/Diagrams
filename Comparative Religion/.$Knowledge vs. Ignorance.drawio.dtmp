        <mxCell id="D0tRHAQ9LQ57oHEz4JKX-36" value="&lt;span style=&quot;text-wrap-mode: nowrap;&quot;&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;$$\begin{gathered}&lt;br&gt;\boldsymbol{R} \;=\; log_3(M) \;=\; log_3(3^{n+1}) \;=\; n+1&lt;br&gt;\end{gathered}$$&lt;/font&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=1;fillColor=none;strokeColor=none;spacingTop=0;" parent="1" vertex="1">
          <mxGeometry x="2100" y="890" width="390" height="60" as="geometry" />
