        <mxCell id="wjP_0DYecouRZlg33f4N-71" value="&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;span style=&quot;text-wrap-mode: nowrap;&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;*&lt;/font&gt;&lt;/b&gt;&lt;b style=&quot;font-size: 14px;&quot;&gt;&amp;nbsp;&lt;/b&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;Semantically equivalent statements, such as&amp;nbsp;&lt;/span&gt;&lt;b style=&quot;font-size: 14px;&quot;&gt;&quot;&lt;/b&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;A is independent of B&quot; and &quot;B is independent of A&quot;, are considered distinct&amp;nbsp;&lt;/span&gt;&lt;b&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;*&lt;br&gt;&lt;/font&gt;&lt;/b&gt;&lt;b&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;**&lt;/font&gt;&lt;/b&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 14px; text-wrap-mode: nowrap;&quot;&gt;(&lt;/span&gt;&lt;i style=&quot;font-size: 14px; text-wrap-mode: nowrap;&quot;&gt;n/2&lt;/i&gt;&lt;span style=&quot;font-size: 14px; text-wrap-mode: nowrap;&quot;&gt;)(&lt;/span&gt;&lt;i style=&quot;font-size: 14px; text-wrap-mode: nowrap;&quot;&gt;n/2&lt;/i&gt;&lt;span style=&quot;font-size: 14px; text-wrap-mode: nowrap;&quot;&gt;) =&amp;nbsp;&lt;/span&gt;&lt;i style=&quot;font-size: 14px; text-wrap-mode: nowrap;&quot;&gt;n&lt;sup&gt;2&lt;/sup&gt;&amp;nbsp;/ 4&lt;/i&gt;&lt;span style=&quot;font-size: 14px; text-wrap-mode: nowrap;&quot;&gt;; note that s&lt;/span&gt;&lt;span style=&quot;text-wrap-mode: nowrap;&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;uper-exponentials grow much faster than factorials: 2&lt;/span&gt;&lt;/span&gt;&lt;sup style=&quot;font-size: 14px; text-wrap-mode: nowrap;&quot;&gt;n&lt;/sup&gt;&lt;span style=&quot;font-size: 14px; text-wrap-mode: nowrap;&quot;&gt;&amp;nbsp;&amp;lt; n! &amp;lt; n&lt;/span&gt;&lt;sup style=&quot;font-size: 14px; text-wrap-mode: nowrap;&quot;&gt;n&lt;/sup&gt;&lt;span style=&quot;font-size: 14px; text-wrap-mode: nowrap;&quot;&gt;&amp;nbsp;&amp;lt; (k&lt;/span&gt;&lt;sup style=&quot;font-size: 14px; text-wrap-mode: nowrap;&quot;&gt;n&lt;/sup&gt;&lt;span style=&quot;font-size: 14px; text-wrap-mode: nowrap;&quot;&gt;)&lt;/span&gt;&lt;sup style=&quot;font-size: 14px; text-wrap-mode: nowrap;&quot;&gt;n&lt;/sup&gt;&lt;span style=&quot;font-size: 14px; text-wrap-mode: nowrap;&quot;&gt;&amp;nbsp;=&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;span style=&quot;font-size: 14px; text-wrap-mode: nowrap;&quot;&gt;k&lt;/span&gt;&lt;sup style=&quot;font-size: 14px; text-wrap-mode: nowrap;&quot;&gt;n&lt;sup&gt;2&lt;/sup&gt;&lt;/sup&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&amp;nbsp;∝&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;text-wrap-mode: nowrap; font-size: 14px;&quot;&gt;3&lt;/span&gt;&lt;span style=&quot;text-wrap-mode: nowrap; font-size: 14px;&quot;&gt;&lt;sup&gt;n&lt;sup&gt;2&lt;/sup&gt;&amp;nbsp;/ 4&lt;/sup&gt;&lt;/span&gt;&lt;sup style=&quot;text-wrap-mode: nowrap;&quot;&gt;n&lt;sup&gt;2&lt;/sup&gt;/4&amp;nbsp;&lt;/sup&gt;&lt;span style=&quot;font-size: 12px; text-wrap-mode: nowrap;&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;**&lt;/font&gt;&lt;/b&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=1;" parent="wjP_0DYecouRZlg33f4N-1" vertex="1">
