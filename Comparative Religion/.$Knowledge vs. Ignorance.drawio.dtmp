        <mxCell id="nq8xUccM6tySzO8bM1H0-45" value="&lt;font style=&quot;&quot;&gt;&lt;i style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 20px;&quot;&gt;$$Upper Bound_3 = 3^4\;2^4\;3^{4^2 / 4} = 81*16*81 = 104,976$$&lt;/span&gt;&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=1;fillColor=none;strokeColor=none;fontStyle=0;spacingTop=0;" parent="nq8xUccM6tySzO8bM1H0-42" vertex="1">
