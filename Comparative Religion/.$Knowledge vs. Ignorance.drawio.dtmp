        <mxCell id="nq8xUccM6tySzO8bM1H0-49" value="&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;i style=&quot;&quot;&gt;$$Upper Bound_n = 3^n\;2^n\;3^{n^2 / 4}$$&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=1;fillColor=none;strokeColor=none;fontStyle=0;spacingTop=0;" parent="nq8xUccM6tySzO8bM1H0-46" vertex="1">
