        <mxCell id="kp4HC5xhiUsZ4yLr_8o6-655" value="&lt;span style=&quot;text-wrap-mode: nowrap;&quot;&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;Note: the number of panels above corresponds to the summation, in which the number of premises in each panel ranges from&lt;br&gt;&lt;i style=&quot;&quot;&gt;1&lt;/i&gt; to &lt;i style=&quot;&quot;&gt;n-1&lt;/i&gt; (this intuition can be carried over to all other &lt;i style=&quot;&quot;&gt;n&lt;/i&gt;), with the wrost-case middle panel (n/2) being used to get the upper bounds&lt;/font&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;" parent="kp4HC5xhiUsZ4yLr_8o6-656" vertex="1">
          <mxGeometry y="90" width="790" height="30" as="geometry" />
        </mxCell>
