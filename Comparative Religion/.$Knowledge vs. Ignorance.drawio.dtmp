        <mxCell id="wjP_0DYecouRZlg33f4N-11" value="&lt;b style=&quot;&quot;&gt;&lt;i style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;$$\boldsymbol{\binom{n}{p}}$$&lt;/font&gt;&lt;/i&gt;&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=1;fillColor=none;strokeColor=none;spacingTop=0;spacingLeft=-4;" parent="wjP_0DYecouRZlg33f4N-4" vertex="1">
