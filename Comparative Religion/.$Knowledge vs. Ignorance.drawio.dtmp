        <mxCell id="wjP_0DYecouRZlg33f4N-27" value="&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;&lt;i&gt;$$\boldsymbol{3^{n^2 / 4}}$$&lt;/i&gt;&lt;/b&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=1;fillColor=none;strokeColor=none;spacingTop=0;" parent="wjP_0DYecouRZlg33f4N-18" vertex="1">
          <mxGeometry x="340" y="72.60504201680672" width="60" height="36.30252100840336" as="geometry" />
        </mxCell>
        <mxCell id="wjP_0DYecouRZlg33f4N-28" value="&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;&lt;i&gt;$$\boldsymbol{2^n}$$&lt;/i&gt;&lt;/b&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=1;fillColor=none;strokeColor=none;spacingTop=0;" parent="wjP_0DYecouRZlg33f4N-18" vertex="1">
          <mxGeometry x="340" y="36.30252100840336" width="60.68" height="36.30252100840336" as="geometry" />
        </mxCell>
        <mxCell id="wjP_0DYecouRZlg33f4N-29" value="" style="group" parent="wjP_0DYecouRZlg33f4N-1" vertex="1" connectable="0">
