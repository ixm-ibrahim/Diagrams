        <mxCell id="nq8xUccM6tySzO8bM1H0-43" value="" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=1;fillColor=none;strokeColor=default;spacingTop=0;" parent="nq8xUccM6tySzO8bM1H0-42" vertex="1">
          <mxGeometry width="790" height="154.28571428571428" as="geometry" />
        </mxCell>
        <mxCell id="nq8xUccM6tySzO8bM1H0-44" value="&lt;span style=&quot;text-wrap-mode: nowrap;&quot;&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;$$\begin{gathered}A_4&amp;nbsp;\;=\; 3^4\;\sum_{p=1}^{3} \binom{4}{p}\; 3^{\,p(4-p)}&amp;nbsp;\;=\;&lt;br&gt;&amp;nbsp;3^4\left(\binom{4}{1}4^3 +\binom{4}{2}4^4 + \binom{4}{3}4^3\right) \\ \;=\; 81(4*27+6*81+4*27) \;=\; &lt;br&gt;56,862\end{gathered}$$&lt;/font&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=1;fillColor=none;strokeColor=none;spacingTop=0;" parent="nq8xUccM6tySzO8bM1H0-42" vertex="1">
          <mxGeometry y="9.07563025210084" width="790" height="81.68067226890756" as="geometry" />
