        <mxCell id="wjP_0DYecouRZlg33f4N-26" value="&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;i style=&quot;&quot;&gt;$$Upper Bound_n = 3^n\;2^n\;3^{n^2 / 4}$$&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=1;fillColor=none;strokeColor=none;fontStyle=0;spacingTop=0;" parent="wjP_0DYecouRZlg33f4N-18" vertex="1">
          <mxGeometry width="340" height="108.90756302521008" as="geometry" />
