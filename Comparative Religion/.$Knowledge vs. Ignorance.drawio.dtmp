        <mxCell id="nq8xUccM6tySzO8bM1H0-48" value="&lt;span style=&quot;text-wrap-mode: nowrap;&quot;&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;$$A_n&amp;nbsp;\;=\; 3^n\;\sum_{p=1}^{n-1}&lt;br&gt;\binom{n}{p}\; 3^{\,p(n-p)}$$&lt;/font&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=1;fillColor=none;strokeColor=none;spacingTop=0;" parent="nq8xUccM6tySzO8bM1H0-46" vertex="1">
          <mxGeometry y="9.075630252100842" width="380" height="63.52941176470588" as="geometry" />
