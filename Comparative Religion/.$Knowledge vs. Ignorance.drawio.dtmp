        <mxCell id="wjP_0DYecouRZlg33f4N-10" value="&lt;span style=&quot;font-size: 14px;&quot;&gt;count the number of ways&amp;nbsp;&lt;i&gt;n&lt;/i&gt; statements can be arranged into premises and conclusions&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=1;fillColor=none;strokeColor=none;" parent="wjP_0DYecouRZlg33f4N-4" vertex="1">
