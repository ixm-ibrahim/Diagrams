          <mxGeometry relative="1" as="geometry">
            <mxPoint x="423" y="340" as="sourcePoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="2b-gEbGxIzFqQ9dfg996-9" value="" style="group" vertex="1" connectable="0" parent="2b-gEbGxIzFqQ9dfg996-1">
          <mxGeometry x="320" y="370" width="210" height="30" as="geometry" />
        </mxCell>
        <mxCell id="2b-gEbGxIzFqQ9dfg996-10" value="&lt;span style=&quot;font-size: 10px;&quot;&gt;&lt;b&gt;6. Incrementally Refine/Update Beliefs&lt;br&gt;with New Knowledge&lt;/b&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;comic=0;strokeColor=#8381BF;fontSize=8;fillColor=#DCDBFC;gradientColor=#9393E0;arcSize=50;treeMoving=1;treeFolding=0;strokeWidth=0.5;" vertex="1" collapsed="1" parent="2b-gEbGxIzFqQ9dfg996-9">
          <mxGeometry width="210" height="30" as="geometry" />
        </mxCell>
        <mxCell id="2b-gEbGxIzFqQ9dfg996-11" value="" style="swimlane;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;gradientColor=#FFD966;swimlaneFillColor=#E6E6E6;connectable=1;allowArrows=0;treeFolding=0;treeMoving=1;expand=0;" vertex="1" collapsed="1" parent="2b-gEbGxIzFqQ9dfg996-9">
          <mxGeometry y="20" width="210" height="5" as="geometry">
            <mxRectangle y="20" width="50.00000000000001" height="3.333333333333333" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="2b-gEbGxIzFqQ9dfg996-12" value="&lt;div style=&quot;&quot;&gt;&lt;div&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;What It Is&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;As you learn more about the world (like new science or experiences), tweak your definition of God and re-check the other steps to keep everything sharp and accurate.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- If you realize that your new definition of God is not aligned with your chosen religion (on a fundamental level), then the &quot;True&quot; religion will need to be identified again.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;- Applies to all previous steps, allowing for constant personal refinement in understanding and wisdom.&lt;br&gt;&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;What Happens Without It&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;Your understanding stays outdated and rigid, so you might cling to wrong ideas even when better evidence shows up, blocking real progress and preventing you from recognizing the &quot;True&quot; religion.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;What Happens When&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 8px;&quot;&gt;Misapplied&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;If beliefs (with any step) are refined without being filtered properly (ie. placing information in the right category, and understanding it in light of already established fundamental beliefs), then the new knowledge will lead to holding a belief for the wrong reasons.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;strokeColor=default;fillColor=#E6E6E6;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=4;treeFolding=0;expand=1;" vertex="1" parent="2b-gEbGxIzFqQ9dfg996-11">
          <mxGeometry y="15" width="330" height="150" as="geometry" />
        </mxCell>
        <mxCell id="2b-gEbGxIzFqQ9dfg996-13" value="" style="group" vertex="1" connectable="0" parent="2b-gEbGxIzFqQ9dfg996-1">
          <mxGeometry x="320" y="310" width="210" height="30" as="geometry" />
        </mxCell>
        <mxCell id="2b-gEbGxIzFqQ9dfg996-14" value="&lt;b style=&quot;font-size: 10px;&quot;&gt;5. Interpreting Non-Fundamental Details through Fundamental Beliefs&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;comic=0;strokeColor=#6C8EBF;fontSize=8;fillColor=#DAE8FC;gradientColor=#7EA6E0;arcSize=50;treeMoving=1;treeFolding=0;strokeWidth=0.5;" vertex="1" collapsed="1" parent="2b-gEbGxIzFqQ9dfg996-13">
          <mxGeometry width="210" height="30" as="geometry" />
        </mxCell>
        <mxCell id="2b-gEbGxIzFqQ9dfg996-15" value="" style="swimlane;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;gradientColor=#FFD966;swimlaneFillColor=#E6E6E6;connectable=1;allowArrows=0;treeFolding=0;treeMoving=1;expand=0;" vertex="1" collapsed="1" parent="2b-gEbGxIzFqQ9dfg996-13">
          <mxGeometry y="20" width="210" height="5" as="geometry">
            <mxRectangle y="20" width="50.00000000000001" height="3.333333333333333" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="2b-gEbGxIzFqQ9dfg996-16" value="&lt;div style=&quot;&quot;&gt;&lt;div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;What It Is&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;Use the core, fundamental truths to make sense of the smaller, more specialized parts of the chosen religion (like rituals and laws) that would otherwise appear inconsistent with your personal experience.&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;What Happens Without It&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;Non-fundamental details in the true religion could cause fundamental confusion or cause rejection of good ideas, leading to shallow judgments and the prevention of recognizing the True religion, and possibly failing to learn wisdom in implementing the True religion properly.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;What Happens When&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 8px;&quot;&gt;Misapplied&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;If a fundamental principle is updated but the non-fundamental details connected to the old principle are not re-evaluated, the belief system becomes internally inconsistent.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;This creates a mix of true foundations with false or outdated applications, preventing the new understanding from properly translating into meaningful changes in one&#39;s actions and worldview.&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" style="text;html=1;strokeColor=default;fillColor=#E6E6E6;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=4;treeFolding=0;expand=1;" vertex="1" parent="2b-gEbGxIzFqQ9dfg996-15">
          <mxGeometry y="15" width="325" height="140" as="geometry" />
        </mxCell>
        <mxCell id="2b-gEbGxIzFqQ9dfg996-17" value="" style="group;fontSize=11;" vertex="1" connectable="0" parent="2b-gEbGxIzFqQ9dfg996-1">
          <mxGeometry x="320" y="250" width="210" height="30" as="geometry" />
        </mxCell>
        <mxCell id="2b-gEbGxIzFqQ9dfg996-18" value="&lt;b style=&quot;font-size: 10px;&quot;&gt;4. Match objective claims/religions to your subjective definition of God&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;comic=0;strokeColor=#82B366;fontSize=8;fillColor=#D5E8D4;gradientColor=#97D077;arcSize=50;treeMoving=1;treeFolding=0;strokeWidth=0.5;" vertex="1" collapsed="1" parent="2b-gEbGxIzFqQ9dfg996-17">
          <mxGeometry width="210" height="30" as="geometry" />
        </mxCell>
        <mxCell id="FVks1_eH0LWD4R80RGgw-0" value="" style="swimlane;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;gradientColor=#FFD966;swimlaneFillColor=#E6E6E6;connectable=1;allowArrows=0;treeFolding=0;treeMoving=1;expand=0;" vertex="1" collapsed="1" parent="2b-gEbGxIzFqQ9dfg996-17">
          <mxGeometry y="20" width="210" height="5" as="geometry">
            <mxRectangle y="20" width="50.00000000000001" height="3.333333333333333" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="FVks1_eH0LWD4R80RGgw-1" value="&lt;div&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;What It Is&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;- Check which religions&#39; core ideas about God correspond with your definition, focusing on the fundamental/big-picture stuff rather than surface details.&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- Fundamental claims can be understood by the everyday normal person, while details require specialized knowledge - inaccessible to the everyday normal person.&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- This assumes that, in your previous definition, God speaks/made truth accessible to everyone - not just scholars - such that the fundamental knowledge is accessible to the everyday person while the details are accessible through specialized education.&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- In other words, the &quot;True&quot; religion exists, and your purpose in life is to identify it and live by it.&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- This also assumes that, in your previous definition, you discovered that your own personal pursuit of knowledge can only get you so far, and it is far more efficient to learn from others who are more knowledgeable than you.&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- This requires humility.&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;What Happens Without It&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;- Your definition of God becomes limited by the ignorance of your own personal experience, limiting growth.&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- Or, you somehow concluded in the previous step that God doesn&#39;t exist, or that He is impersonal and didn&#39;t give authority to any religion or scripture.&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;- It would be impossible to filter the false claims/religions from the true ones, as they all would have equal claims to truth (or, more accurately: you are equally ignorant about all of them) and you could never converge your beliefs to what&#39;s truly consistent with reality.&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;What Happens When Misapplied&lt;/font&gt;&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;If&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;you focus on a religion&#39;s secondary details before confirming its core principles are true, you create two primary risks:&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- Rejecting the Truth: you might dismiss a fundamentally sound belief system because a secondary detail (like a specific ritual or law) seems strange or is misunderstood.&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- Accepting Falsehood: you might accept a fundamentally flawed belief system because its secondary beliefs are aesthetically pleasing, culturally familiar, or emotionally comforting.&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;" style="text;html=1;strokeColor=default;fillColor=#E6E6E6;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=2;treeFolding=0;expand=1;spacingLeft=0;" vertex="1" parent="FVks1_eH0LWD4R80RGgw-0">
          <mxGeometry y="15" width="480" height="220" as="geometry" />
        </mxCell>
        <mxCell id="2b-gEbGxIzFqQ9dfg996-21" value="" style="group" vertex="1" connectable="0" parent="2b-gEbGxIzFqQ9dfg996-1">
          <mxGeometry x="320" y="190" width="210" height="30" as="geometry" />
        </mxCell>
        <mxCell id="2b-gEbGxIzFqQ9dfg996-22" value="&lt;div&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;&lt;b&gt;3. Deduce the definition of God based on how reality is&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;comic=0;strokeColor=#D6B656;fontSize=8;fillColor=#FFF2CC;gradientColor=#FFD966;arcSize=50;treeMoving=1;treeFolding=0;strokeWidth=0.5;" vertex="1" collapsed="1" parent="2b-gEbGxIzFqQ9dfg996-21">
          <mxGeometry width="210" height="30" as="geometry" />
        </mxCell>
        <mxCell id="2b-gEbGxIzFqQ9dfg996-23" value="" style="swimlane;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;gradientColor=#FFD966;swimlaneFillColor=#E6E6E6;connectable=1;allowArrows=0;treeFolding=0;treeMoving=1;expand=0;" vertex="1" collapsed="1" parent="2b-gEbGxIzFqQ9dfg996-21">
          <mxGeometry y="20" width="210" height="5" as="geometry">
            <mxRectangle y="20" width="50.00000000000001" height="3.333333333333333" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="2b-gEbGxIzFqQ9dfg996-24" value="&lt;div style=&quot;&quot;&gt;&lt;div&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;What It Is&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;- Identify the properties that &quot;God&quot; (or ultimate reality, or the starter of reality) must have by looking at how the universe works and identifying what kind of source could produce it.&lt;/span&gt;&lt;br&gt;&lt;div&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;What Happens Without It&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;- The definition for God becomes ungrounded in reality, which prevents false beliefs from being identified.&lt;br&gt;&amp;nbsp;- Your perception of God necessarily becomes either guesswork or wishful thinking, making it impossible to spot wrong beliefs since everything would be based on vibes instead of facts.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;What Happens When&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 8px;&quot;&gt;Misapplied&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;If a religion is accepted on authority before you infer God&#39;s necessary properties from reality, then any conflict between a false religion&#39;s claims and how reality truly is would be necessarily rationalized as a &quot;mystery&quot; or your own personal shortcomings.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- Because inconsistencies and personal shortcomings are now indistinguishable, this now prevents you from being capable of recognizing falsehood and distinguishing it from the Truth.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- In short: your own personal growth towards the truth would be impossible.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;strokeColor=default;fillColor=#E6E6E6;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=4;treeFolding=0;expand=1;" vertex="1" parent="2b-gEbGxIzFqQ9dfg996-23">
          <mxGeometry y="15" width="305" height="165" as="geometry" />
        </mxCell>
        <mxCell id="2b-gEbGxIzFqQ9dfg996-25" value="" style="group" vertex="1" connectable="0" parent="2b-gEbGxIzFqQ9dfg996-1">
          <mxGeometry x="320" y="130" width="210" height="30" as="geometry" />
        </mxCell>
        <mxCell id="2b-gEbGxIzFqQ9dfg996-26" value="&lt;span style=&quot;font-size: 10px;&quot;&gt;&lt;b&gt;2. Discover observations and infer the&lt;br&gt;nature of reality&lt;/b&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;comic=0;strokeColor=#D69555;fontSize=8;fillColor=#FFDEC9;gradientColor=#FFB663;arcSize=50;treeMoving=1;treeFolding=0;strokeWidth=0.5;" vertex="1" collapsed="1" parent="2b-gEbGxIzFqQ9dfg996-25">
          <mxGeometry width="210" height="30" as="geometry" />
        </mxCell>
        <mxCell id="2b-gEbGxIzFqQ9dfg996-27" value="" style="swimlane;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;gradientColor=#FFD966;swimlaneFillColor=#E6E6E6;connectable=1;allowArrows=0;treeFolding=0;treeMoving=1;expand=0;" vertex="1" collapsed="1" parent="2b-gEbGxIzFqQ9dfg996-25">
          <mxGeometry y="20" width="210" height="5" as="geometry">
            <mxRectangle y="20" width="50.00000000000001" height="3.333333333333333" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="2b-gEbGxIzFqQ9dfg996-28" value="&lt;div style=&quot;&quot;&gt;&lt;div&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;What It Is&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;Discover what reality is and how it works - using everyday experiences, science, logic, and introspection.&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;What Happens Without It&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;- Without education of reality (both empirical and logical), your worldviews will be shaped purely by feelings and intuition - leading you to naturally conclude that &quot;what I feel = what is true&quot;.&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;- This prevents you from concluding that &quot;what is real = what is true&quot;, which would have otherwise allowed you to be capable of distinguishing between &quot;what I feel is true&quot; and &quot;what is true&quot;.&lt;br&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;What Happens When&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 8px;&quot;&gt;Misapplied&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;If a definition of God or a specific religion is adopted before observing reality, the foundation is inverted: instead of reality informing your belief, your belief begins to filter reality.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;This replaces the principle of &quot;what is real = what is true&quot; with &quot;what I already believe = what is true,&quot; leading directly to confirmation bias - cherry-picking evidence that fits and discarding evidence that doesn&#39;t.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;Ultimately, this method severely undermines the ability to objectively identify the truth, as the criteria for what is &quot;true&quot; have become entirely subjective.&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" style="text;html=1;strokeColor=default;fillColor=#E6E6E6;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=4;treeFolding=0;expand=1;" vertex="1" parent="2b-gEbGxIzFqQ9dfg996-27">
          <mxGeometry y="15" width="335" height="155" as="geometry" />
        </mxCell>
        <mxCell id="2b-gEbGxIzFqQ9dfg996-29" value="" style="group" vertex="1" connectable="0" parent="2b-gEbGxIzFqQ9dfg996-1">
          <mxGeometry x="320" y="70" width="210" height="30" as="geometry" />
        </mxCell>
        <mxCell id="2b-gEbGxIzFqQ9dfg996-30" value="&lt;span style=&quot;font-size: 10px;&quot;&gt;&lt;b&gt;1. Motivation for knowing our purpose&lt;br&gt;and following the Truth&lt;/b&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;comic=0;strokeColor=#B85450;fontSize=8;fillColor=#F8CECC;gradientColor=#EA6B66;arcSize=50;treeMoving=1;treeFolding=0;strokeWidth=0.5;" vertex="1" collapsed="1" parent="2b-gEbGxIzFqQ9dfg996-29">
          <mxGeometry width="210" height="30" as="geometry" />
        </mxCell>
        <mxCell id="2b-gEbGxIzFqQ9dfg996-31" value="" style="swimlane;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;gradientColor=#FFD966;swimlaneFillColor=#E6E6E6;connectable=1;allowArrows=0;treeFolding=0;treeMoving=1;expand=0;" vertex="1" collapsed="1" parent="2b-gEbGxIzFqQ9dfg996-29">
          <mxGeometry y="20" width="210" height="5" as="geometry">
            <mxRectangle y="20" width="50.00000000000001" height="3.333333333333333" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="2b-gEbGxIzFqQ9dfg996-32" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;What It Is&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;- Start with the natural urge to understand life’s purpose and chase real answers, like why we’re here or what matters most.&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;What Happens Without It&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;- Without motivation for knowing our purpose, this whole process wouldn’t happen to begin with, preventing true beliefs from being identified.&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;- Without motivation for following the truth, it can lead to rationalizing confusion or aligning one’s beliefs with their feelings, preventing false beliefs from being identified.&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;What Happens When Misapplied&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;If a belief or conclusion is adopted before a genuine motivation for truth is established, the entire process is inverted: motivation ceases to be about honest inquiry and becomes an exercise in justifying a pre-selected answer.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;This transforms the search for truth into the act of rationalization, making one vulnerable to defending a falsehood without ever recognizing it as such.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;strokeColor=default;fillColor=#E6E6E6;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=4;treeFolding=0;expand=1;spacingLeft=0;" vertex="1" parent="2b-gEbGxIzFqQ9dfg996-31">
          <mxGeometry y="15" width="290" height="155" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="2. Discovering Reality" id="c3uish9zr8GmwgX8hyLQ">
    <mxGraphModel dx="1242" dy="828" grid="1" gridSize="5" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" background="#CCCCCC" math="0" shadow="0" adaptiveColors="none">
      <root>
