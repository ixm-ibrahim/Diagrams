        </mxCell>
        <mxCell id="pJg3SHPVufzG-P1PX_YF-177" parent="pJg3SHPVufzG-P1PX_YF-146" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" vertex="1">
          <mxGeometry height="45" width="810" as="geometry" />
        </mxCell>
        <mxCell id="pJg3SHPVufzG-P1PX_YF-179" parent="pJg3SHPVufzG-P1PX_YF-177" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#DFDFDF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;gradientColor=none;align=left;strokeWidth=0;" value="&lt;div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&amp;nbsp;- Christianity looks more like a corrupted version of Islam.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&amp;nbsp;- Islam looks more like a corrected version of Christianity.&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="45" width="305" as="geometry">
            <mxRectangle height="45" width="305" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="pJg3SHPVufzG-P1PX_YF-180" parent="pJg3SHPVufzG-P1PX_YF-177" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#DFDFDF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;gradientColor=none;align=left;strokeWidth=0;" value="&lt;span style=&quot;font-size: 10px;&quot;&gt;&amp;nbsp;- Nothing - this only verifies previous results. Islam seems to maximize both internal and external consistency when compared to any other worldview.&lt;/span&gt;" vertex="1">
          <mxGeometry height="45" width="265" x="305" as="geometry">
            <mxRectangle height="45" width="265" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="pJg3SHPVufzG-P1PX_YF-181" parent="pJg3SHPVufzG-P1PX_YF-177" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#DFDFDF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;gradientColor=none;align=left;strokeWidth=0;" value="&lt;span style=&quot;font-size: 10px;&quot;&gt;&amp;nbsp;- The final step is to verify the project&#39;s conclusion for yourself. If you disagree with any result, you can precisely locate the filter you reject and identify why.&lt;/span&gt;" vertex="1">
          <mxGeometry height="45" width="240" x="570" as="geometry">
            <mxRectangle height="45" width="240" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
