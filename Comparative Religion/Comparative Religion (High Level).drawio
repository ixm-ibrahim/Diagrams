        <mxCell id="rarmOi1NBRmtzClJweJV-2" parent="rarmOi1NBRmtzClJweJV-1" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#DFDFDF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=middle;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;gradientColor=none;align=center;strokeWidth=0;" value="&lt;div&gt;&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;If you reject this:&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;" vertex="1">
