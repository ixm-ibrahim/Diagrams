        <UserObject label="&lt;b style=&quot;text-align: left; font-size: 8px;&quot;&gt;Who were the eyewitnesses, and what did&amp;nbsp;they bear witness to?&lt;/b&gt;" link="data:page/id,UnD5iH2WOAX1UBhe1G6C" id="rhcqr-XzwB1Ql8kuJBcr-151">
