        <mxCell id="XmoEW__EEp50cMUPfqny-31" value="&lt;span style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- The custodianship of Jesus&#39; message could have been with b&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;ad faith, revisionism, and gradual Christological development.&lt;/span&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=middle;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=0;align=left;strokeWidth=0;" vertex="1" parent="XmoEW__EEp50cMUPfqny-30">
