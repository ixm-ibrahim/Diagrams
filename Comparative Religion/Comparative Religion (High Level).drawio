        <mxCell id="wqzDi3H2TwTPRZB3JOWi-0" value="&lt;b&gt;4. Which salvific narrative better fits reality?&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=18;fillColor=#D5E8D4;gradientColor=#97D077;strokeColor=#82B366;" vertex="1" parent="sYscbi_ctIr7rLCjfTU3-1">
