        <mxCell id="k2k2wWd_USnzYlMqRSar-16" value="&lt;span style=&quot;font-size: 10px;&quot;&gt;Our actions are a sign of our moral values.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;comic=0;strokeColor=#666666;fontSize=8;fillColor=#f5f5f5;gradientColor=#b3b3b3;arcSize=50;treeMoving=1;treeFolding=0;strokeWidth=0.5;fontStyle=0" parent="k2k2wWd_USnzYlMqRSar-15" vertex="1" collapsed="1">
          <mxGeometry width="195" height="30" as="geometry" />
        </mxCell>
        <mxCell id="k2k2wWd_USnzYlMqRSar-17" value="" style="swimlane;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;gradientColor=#FFD966;swimlaneFillColor=#E6E6E6;connectable=1;allowArrows=0;treeFolding=0;treeMoving=1;expand=0;" parent="k2k2wWd_USnzYlMqRSar-15" vertex="1" collapsed="1">
          <mxGeometry y="20" width="195" height="5" as="geometry">
            <mxRectangle y="20" width="50.00000000000001" height="3.333333333333333" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="k2k2wWd_USnzYlMqRSar-18" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;Observations (non-exhaustive)&lt;/font&gt;&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&quot;All information comes from a source&quot;.&lt;/span&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;- &quot;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;We have the capacity to make choices, based on our knowledge and desires&quot;.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;If a person consistently donates to charity, we infer they are a generous person.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;- The words someone says can contradict their actions;&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&quot;actions speak louder than words&quot;.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;We assess a person&#39;s priorities by observing where they spend their time and resources.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b&gt;The Inference (and why)&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&lt;i&gt;Our actions are a sign of our moral values.&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;font&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;We observe that our repeated, freely-made choices reveal our true internal commitments.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;This means that our behavior can be interpreted as&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;the external manifestation of our internal character.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b&gt;What Happens When Not Inferred&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;It would be impossible to ever assess a person&#39;s character.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;Trust would be impossible, as there would be no reliable way to know if someone is honest or dependable.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- W&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;e would not distinguish a virtuous person from a vicious person who simply says the right things.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;strokeColor=default;fillColor=#E6E6E6;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=4;treeFolding=0;expand=1;spacingLeft=0;" parent="k2k2wWd_USnzYlMqRSar-17" vertex="1">
          <mxGeometry y="15" width="350" height="155" as="geometry" />
        </mxCell>
        <mxCell id="zvqRTCDcasdBtbY2sySJ-83" value="" style="group" parent="E9NDm9MUUsob3Jb-81NS-1" vertex="1" connectable="0">
          <mxGeometry x="65" y="870" width="195" height="30" as="geometry" />
        </mxCell>
        <mxCell id="zvqRTCDcasdBtbY2sySJ-59" value="&lt;span style=&quot;font-size: 10px;&quot;&gt;Intelligence correlates with success and purposeful/conscious complexity.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;comic=0;strokeColor=#666666;fontSize=8;fillColor=#f5f5f5;gradientColor=#b3b3b3;arcSize=50;treeMoving=1;treeFolding=0;strokeWidth=0.5;fontStyle=0" parent="zvqRTCDcasdBtbY2sySJ-83" vertex="1" collapsed="1">
          <mxGeometry width="195" height="30" as="geometry" />
        </mxCell>
        <mxCell id="zvqRTCDcasdBtbY2sySJ-60" value="" style="swimlane;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;gradientColor=#FFD966;swimlaneFillColor=#E6E6E6;connectable=1;allowArrows=0;treeFolding=0;treeMoving=1;expand=0;startSize=23;" parent="zvqRTCDcasdBtbY2sySJ-83" vertex="1" collapsed="1">
          <mxGeometry y="20" width="195" height="5" as="geometry">
            <mxRectangle y="20" width="50.00000000000001" height="3.333333333333333" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="zvqRTCDcasdBtbY2sySJ-61" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;Observations (non-exhaustive)&lt;/font&gt;&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&quot;Biological structures are goal-oriented&quot;.&lt;/span&gt;&lt;/span&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&quot;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;We are capable of intelligence, to form abstractions from observations&quot;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;A squirrel that is more intelligent at finding and storing nuts is more likely to survive the winter.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;Human beings who plan and use reason tend to achieve their goals more effectively than those who do not.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;Complex, successful biological systems (like the human immune system) exhibit a high degree of information processing.&lt;br&gt;&amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;In professional endeavors (from medicine to engineering to art), a higher degree of planning and intelligence allows for the capacity for more successful outcomes.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b&gt;The Inference (and why)&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&lt;i&gt;Intelligence correlates with success and purposeful/conscious complexity.&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;font&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;We consistently observe that the ability to process information and act purposefully provides a survival and success advantage.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;T&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;his suggests that intelligence is a powerful and effective force for navigating and shaping reality toward a desired outcome.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b&gt;What Happens When Not Inferred&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;- It would be impossible to have the capacity to&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp;distinguish the distinction between wisdom and insanity, as well as the capacity to distinguish truth from interconnected falsehoods.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;Random, thoughtless action would be just as effective as careful, intelligent planning.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;The development of complex life and human civilization, which are built on layers of successful information processing, would be an entirely unexplainable accident.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;strokeColor=default;fillColor=#E6E6E6;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=4;treeFolding=0;expand=1;spacingLeft=0;" parent="zvqRTCDcasdBtbY2sySJ-60" vertex="1">
          <mxGeometry y="15" width="415" height="190" as="geometry" />
        </mxCell>
        <mxCell id="k2k2wWd_USnzYlMqRSar-19" value="" style="group" parent="E9NDm9MUUsob3Jb-81NS-1" vertex="1" connectable="0">
          <mxGeometry x="330" y="870" width="195" height="30" as="geometry" />
        </mxCell>
        <mxCell id="k2k2wWd_USnzYlMqRSar-20" value="&lt;span style=&quot;font-size: 10px;&quot;&gt;We have a disposition towards concepts&lt;br&gt;of justice.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;comic=0;strokeColor=#666666;fontSize=8;fillColor=#f5f5f5;gradientColor=#b3b3b3;arcSize=50;treeMoving=1;treeFolding=0;strokeWidth=0.5;fontStyle=0" parent="k2k2wWd_USnzYlMqRSar-19" vertex="1" collapsed="1">
          <mxGeometry width="195" height="30" as="geometry" />
        </mxCell>
        <mxCell id="k2k2wWd_USnzYlMqRSar-21" value="" style="swimlane;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;gradientColor=#FFD966;swimlaneFillColor=#E6E6E6;connectable=1;allowArrows=0;treeFolding=0;treeMoving=1;expand=0;" parent="k2k2wWd_USnzYlMqRSar-19" vertex="1" collapsed="1">
          <mxGeometry y="20" width="195" height="5" as="geometry">
            <mxRectangle y="20" width="50.00000000000001" height="3.333333333333333" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="k2k2wWd_USnzYlMqRSar-22" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;Observations (non-exhaustive)&lt;/font&gt;&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&quot;All information comes from a source&quot;.&lt;/span&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&quot;We have a disposition towards concepts of morality&quot;.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;You feel a deep sense of satisfaction when a villain in a story gets their &quot;just deserts&quot;.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;The desire to see wrongs righted and victims compensated is a powerful social force.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;In legal systems, the punishment is expected to fit the crime.&lt;br&gt;&amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;People generally feel outrage when the guilty go free or the innocent are punished.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b&gt;The Inference (and why)&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&lt;i&gt;You have a disposition towards concepts of justice.&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;font&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;We observe a universal human desire for proportionality and accountability, where actions have fitting consequences.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;We appear to be disposed to expecting fairness in the world - as in, everyone gets what they deserve.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b&gt;What Happens When Not Inferred&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;The foundation of all legal systems would be arbitrary and irrational.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;The deep-seated human cry for fairness in the face of suffering would have to be dismissed as a meaningless emotional outburst.&lt;/span&gt;&lt;br&gt;&lt;/div&gt;" style="text;html=1;strokeColor=default;fillColor=#E6E6E6;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=4;treeFolding=0;expand=1;spacingLeft=0;" parent="k2k2wWd_USnzYlMqRSar-21" vertex="1">
          <mxGeometry y="15" width="335" height="170" as="geometry" />
        </mxCell>
        <mxCell id="k2k2wWd_USnzYlMqRSar-27" value="" style="group" parent="E9NDm9MUUsob3Jb-81NS-1" vertex="1" connectable="0">
          <mxGeometry x="590" y="870" width="195" height="30" as="geometry" />
        </mxCell>
        <mxCell id="k2k2wWd_USnzYlMqRSar-28" value="&lt;span style=&quot;font-size: 10px;&quot;&gt;We have a disposition to dislike hardship&lt;br&gt;&amp;amp; pain and pursue beauty &amp;amp; pleasure.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;comic=0;strokeColor=#666666;fontSize=8;fillColor=#f5f5f5;gradientColor=#b3b3b3;arcSize=50;treeMoving=1;treeFolding=0;strokeWidth=0.5;fontStyle=0" parent="k2k2wWd_USnzYlMqRSar-27" vertex="1" collapsed="1">
          <mxGeometry width="195" height="30" as="geometry" />
        </mxCell>
        <mxCell id="k2k2wWd_USnzYlMqRSar-29" value="" style="swimlane;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;gradientColor=#FFD966;swimlaneFillColor=#E6E6E6;connectable=1;allowArrows=0;treeFolding=0;treeMoving=1;expand=0;" parent="k2k2wWd_USnzYlMqRSar-27" vertex="1" collapsed="1">
          <mxGeometry y="20" width="195" height="5" as="geometry">
            <mxRectangle y="20" width="50.00000000000001" height="3.333333333333333" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="k2k2wWd_USnzYlMqRSar-30" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;Observations (non-exhaustive)&lt;/font&gt;&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&quot;All information comes from a source&quot;.&lt;br&gt;&amp;nbsp;- &quot;&lt;/span&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;Reality is a mixture of pleasure &amp;amp; pain,&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;as well as good &amp;amp; evil&quot;.&lt;/span&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;An infant naturally cries from hunger and quiets when fed.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;You instinctively pull our hand away from a hot surface.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;We tend go to great lengths to create art, listen to music, and seek out beautiful landscapes.&lt;br&gt;&amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;The pursuit of happiness is a primary motivator for human action across all cultures.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b&gt;The Inference (and why)&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&lt;i&gt;You have a disposition to dislike hardship &amp;amp; pain and pursue beauty &amp;amp; pleasure.&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;font&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;We observe a universal, innate orientation in living things towards states of well-being and away from states of harm.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;We then have the disposition to be actively directed toward certain goals and away from others.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b&gt;What Happens When Not Inferred&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;- The concept of motivation would be meaningless and unexplainable.&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;There would be no reason to prefer health over sickness, peace over conflict, or joy over misery..&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;There would be no rational basis for the fields of economics, art, or medicine.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;strokeColor=default;fillColor=#E6E6E6;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=4;treeFolding=0;expand=1;spacingLeft=0;" parent="k2k2wWd_USnzYlMqRSar-29" vertex="1">
          <mxGeometry y="15" width="380" height="165" as="geometry" />
        </mxCell>
        <mxCell id="k2k2wWd_USnzYlMqRSar-7" value="" style="group" parent="E9NDm9MUUsob3Jb-81NS-1" vertex="1" connectable="0">
          <mxGeometry x="330" y="825" width="197" height="30" as="geometry" />
        </mxCell>
        <mxCell id="k2k2wWd_USnzYlMqRSar-8" value="&lt;span style=&quot;font-size: 10px;&quot;&gt;We have a disposition towards concepts&lt;br&gt;of morality.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;comic=0;strokeColor=#666666;fontSize=8;fillColor=#f5f5f5;gradientColor=#b3b3b3;arcSize=50;treeMoving=1;treeFolding=0;strokeWidth=0.5;fontStyle=0" parent="k2k2wWd_USnzYlMqRSar-7" vertex="1" collapsed="1">
          <mxGeometry width="195" height="30" as="geometry" />
        </mxCell>
        <mxCell id="k2k2wWd_USnzYlMqRSar-9" value="" style="swimlane;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;gradientColor=#FFD966;swimlaneFillColor=#E6E6E6;connectable=1;allowArrows=0;treeFolding=0;treeMoving=1;expand=0;" parent="k2k2wWd_USnzYlMqRSar-7" vertex="1" collapsed="1">
          <mxGeometry x="2" y="22" width="195" height="5" as="geometry">
            <mxRectangle x="2" y="22" width="50.00000000000001" height="3.333333333333333" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="k2k2wWd_USnzYlMqRSar-10" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;Observations (non-exhaustive)&lt;/font&gt;&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&quot;All information comes from a source&quot;.&lt;/span&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;A small child will protest an action by saying, &quot;That&#39;s not fair!&quot;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;Every known human culture has developed a moral code with concepts of right and wrong.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;You feel internal emotions like guilt, shame, and righteous indignation.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;We tend to admire acts of self-sacrifice and condemn acts of senseless cruelty, even when they don&#39;t affect us directly.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b&gt;The Inference (and why)&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&lt;i&gt;You have a disposition towards concepts of morality.&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;font&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;We observe that human beings are naturally inclined to view the world through a moral lens.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;This means the morality can be interpreted as an innate part of the human condition.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b&gt;What Happens When Not Inferred&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;The universal human experience of morality becomes an unexplainable.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;Concepts like human rights, heroism, and evil would be incomprehensible, as all&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;moral language would be complete nonsense.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;strokeColor=default;fillColor=#E6E6E6;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=4;treeFolding=0;expand=1;spacingLeft=0;" parent="k2k2wWd_USnzYlMqRSar-9" vertex="1">
          <mxGeometry y="15" width="325" height="165" as="geometry" />
        </mxCell>
        <mxCell id="k2k2wWd_USnzYlMqRSar-23" value="" style="group" parent="E9NDm9MUUsob3Jb-81NS-1" vertex="1" connectable="0">
          <mxGeometry x="590" y="825" width="195" height="30" as="geometry" />
        </mxCell>
        <mxCell id="k2k2wWd_USnzYlMqRSar-24" value="&lt;span style=&quot;font-size: 10px;&quot;&gt;Reality is a mixture of pleasure &amp;amp; pain,&lt;br&gt;as well as good &amp;amp; evil.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;comic=0;strokeColor=#666666;fontSize=8;fillColor=#f5f5f5;gradientColor=#b3b3b3;arcSize=50;treeMoving=1;treeFolding=0;strokeWidth=0.5;fontStyle=0" parent="k2k2wWd_USnzYlMqRSar-23" vertex="1" collapsed="1">
          <mxGeometry width="195" height="30" as="geometry" />
        </mxCell>
        <mxCell id="k2k2wWd_USnzYlMqRSar-25" value="" style="swimlane;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;gradientColor=#FFD966;swimlaneFillColor=#E6E6E6;connectable=1;allowArrows=0;treeFolding=0;treeMoving=1;expand=0;" parent="k2k2wWd_USnzYlMqRSar-23" vertex="1" collapsed="1">
          <mxGeometry y="20" width="195" height="5" as="geometry">
            <mxRectangle y="20" width="50.00000000000001" height="3.333333333333333" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="k2k2wWd_USnzYlMqRSar-26" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;Observations (non-exhaustive)&lt;/font&gt;&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&quot;All information comes from a source&quot;.&lt;/span&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;We experience profound joy and profound suffering.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;The same day can contain moments of happiness and moments of grief.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;Nature is both breathtakingly beautiful (a sunset) and terrifyingly brutal (a natural disaster).&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;Human history is a story of both incredible acts of love and compassion, and horrific acts of cruelty and hatred.&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b&gt;The Inference (and why)&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;font-style: italic; background-color: transparent; font-size: 7px; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Reality is a mixture of pleasure &amp;amp; pain,&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-style: italic; background-color: transparent; font-size: 7px; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;as well as good &amp;amp; evil.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;font&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;We observe that our existence is characterized by a fundamental duality of opposing forces and experiences.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;A complete picture of reality must account for both positive and negative aspects; ignoring one or the other would be oversimplifying reality.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b&gt;What Happens When Not Inferred&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;Reality would either be purely good or evil, or being either wholly pleasure or pain.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;This world would need to be interpreted in terms akin to heaven or hell, with nothing being either worse or better than the world as it is now.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;You would either become a pure cynic who denies the existence of genuine good, or a naive optimist who ignores the reality of suffering.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;strokeColor=default;fillColor=#E6E6E6;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=4;treeFolding=0;expand=1;spacingLeft=0;" parent="k2k2wWd_USnzYlMqRSar-25" vertex="1">
          <mxGeometry y="15" width="370" height="180" as="geometry" />
        </mxCell>
        <mxCell id="jaU37FtTESFEtsjytWu3-0" value="" style="group" parent="E9NDm9MUUsob3Jb-81NS-1" vertex="1" connectable="0">
          <mxGeometry x="65" y="825" width="195" height="30" as="geometry" />
        </mxCell>
        <mxCell id="jaU37FtTESFEtsjytWu3-1" value="&lt;span style=&quot;font-size: 10px;&quot;&gt;We are capable of intelligence, forming abstractions from observations.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;comic=0;strokeColor=#666666;fontSize=8;fillColor=#f5f5f5;gradientColor=#b3b3b3;arcSize=50;treeMoving=1;treeFolding=0;strokeWidth=0.5;fontStyle=0" parent="jaU37FtTESFEtsjytWu3-0" vertex="1" collapsed="1">
          <mxGeometry width="195" height="30" as="geometry" />
        </mxCell>
        <mxCell id="jaU37FtTESFEtsjytWu3-2" value="" style="swimlane;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;gradientColor=#FFD966;swimlaneFillColor=#E6E6E6;connectable=1;allowArrows=0;treeFolding=0;treeMoving=1;expand=0;" parent="jaU37FtTESFEtsjytWu3-0" vertex="1" collapsed="1">
          <mxGeometry y="20" width="195" height="5" as="geometry">
            <mxRectangle y="20" width="50.00000000000001" height="3.333333333333333" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="jaU37FtTESFEtsjytWu3-3" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;Observations (non-exhaustive)&lt;/font&gt;&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&quot;Reality is ordered, operating on consistent and intelligible laws&quot;.&lt;/span&gt;&lt;/span&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;You observe many individual dogs and form the abstract concept of &quot;dog&quot;.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;You observe objects falling and infer the abstract law of &quot;gravity&quot;.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;You use abstract symbols like numbers to count concrete objects.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;You can understand a general principle and apply it to a new, specific situation.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b&gt;The Inference (and why)&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&lt;i&gt;You are capable of intelligence, forming abstractions from observations.&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;font&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;We observe that the human mind can move beyond raw, particular sensory data to identify universal patterns, principles, and concepts.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;This ability to form abstract ideas is the basis for language, science, and all higher reasoning - including this very document.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b&gt;What Happens When Not Inferred&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;Reason becomes impossible - especially the ability to infer general rules/laws from reality.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;We would be trapped in a world of raw, disconnected sensory experiences.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;Learning from the past, planning for the future, or creating categories to understand the world would be impossible, as all of these rely on abstracting general rules from specific examples.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;strokeColor=default;fillColor=#E6E6E6;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=4;treeFolding=0;expand=1;spacingLeft=0;" parent="jaU37FtTESFEtsjytWu3-2" vertex="1">
          <mxGeometry y="15" width="380" height="185" as="geometry" />
        </mxCell>
        <mxCell id="zvqRTCDcasdBtbY2sySJ-84" value="" style="group" parent="E9NDm9MUUsob3Jb-81NS-1" vertex="1" connectable="0">
          <mxGeometry x="65" y="780" width="195" height="30" as="geometry" />
        </mxCell>
        <mxCell id="zvqRTCDcasdBtbY2sySJ-54" value="&lt;span style=&quot;font-size: 10px;&quot;&gt;Consciousness can&#39;t be reduced to&lt;br&gt;purely physical components.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;comic=0;strokeColor=#666666;fontSize=8;fillColor=#f5f5f5;gradientColor=#b3b3b3;arcSize=50;treeMoving=1;treeFolding=0;strokeWidth=0.5;fontStyle=0" parent="zvqRTCDcasdBtbY2sySJ-84" vertex="1" collapsed="1">
          <mxGeometry width="195" height="30" as="geometry" />
        </mxCell>
        <mxCell id="zvqRTCDcasdBtbY2sySJ-55" value="" style="swimlane;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;gradientColor=#FFD966;swimlaneFillColor=#E6E6E6;connectable=1;allowArrows=0;treeFolding=0;treeMoving=1;expand=0;" parent="zvqRTCDcasdBtbY2sySJ-84" vertex="1" collapsed="1">
          <mxGeometry y="20" width="195" height="5" as="geometry">
            <mxRectangle y="20" width="50.00000000000001" height="3.333333333333333" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="zvqRTCDcasdBtbY2sySJ-56" value="&lt;b&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;Observations (non-exhaustive)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&amp;nbsp;- Thoughts, feelings, and choices are associated with the brain.&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- The brain is &quot;dark&quot; in the sense that it doesn&#39;t actually feel any sensations (such as light), rather it receives signals from various organs and identifies them as results from the different senses.&lt;br&gt;&amp;nbsp;- A thought has no physical weight or dimensions.&lt;br&gt;&amp;nbsp;- You experience your consciousness as a unified &quot;I&quot; that has phenomenal experiences, not as a collection of distinguishable chemical reactions.&lt;br&gt;&amp;nbsp;- The subjective experience of &quot;redness&quot; is not the same &quot;thing&quot; as the light waves that cause it.&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- To experience &quot;redness&quot;, light would need to bounce off an object into our eyes, to which our eyes then transform the light into an electrical signal, which then gets passed through the brain via nerves, and from there we somehow experience a reconstruction of the signal as &quot;redness&quot;.&lt;br&gt;&amp;nbsp; &amp;nbsp; - It is as if one of the functions of the brain is to transform the signal into a medium such that whatever component is responsible for consciousness can become aware of it - like how we view computer monitor to &quot;see&quot; what the computer is doing.&lt;br&gt;&amp;nbsp;- All physical models explain what we can be conscious of, without explaining &quot;why&quot; there is qualia (felt, conscious experiences) to begin with.&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;The Inference (and why)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&amp;nbsp;- &lt;i&gt;Consciousness cannot be reduced to purely physical components.&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- We observe that our mental and emotional states have properties that physical objects do not.&lt;br&gt;&amp;nbsp;- This means that reality can be interpreted as having both a physical dimension and a conscious dimension.&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;What Happens When Not Inferred&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&amp;nbsp;- You can no longer infer an explanation for phenomenal consciousness or free will.&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- If we possess phenomenal consciousness, and it&#39;s reduced to some physical component, then reality possessing phenomenal consciousness as well now becomes possible.&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- There would no meaningful way to distinguish between animate and inanimate objects in terms of consciousness, as both are made of the same physical materials.&lt;br&gt;&amp;nbsp;- You no longer have the capacity for free will.&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- If your thoughts are just deterministic chemical reactions, then your &quot;choices&quot; are simply predetermined outcomes of those physical processes: there is no &quot;you&quot; to be actively &quot;making&quot; any choices.&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- This reduces human beings to mere biological machines, as there is no meaningful distinction between a person and a complex robot." style="text;html=1;strokeColor=default;fillColor=#E6E6E6;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=7;treeFolding=0;expand=1;spacingLeft=0;" parent="zvqRTCDcasdBtbY2sySJ-55" vertex="1">
          <mxGeometry y="15" width="455" height="255" as="geometry" />
        </mxCell>
        <mxCell id="k2k2wWd_USnzYlMqRSar-41" value="" style="group" parent="E9NDm9MUUsob3Jb-81NS-1" vertex="1" connectable="0">
          <mxGeometry x="590" y="780" width="195" height="30" as="geometry" />
        </mxCell>
        <mxCell id="k2k2wWd_USnzYlMqRSar-42" value="&lt;span style=&quot;font-size: 10px;&quot;&gt;There is a seen reality, and an unseen reality.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;comic=0;strokeColor=#666666;fontSize=8;fillColor=#f5f5f5;gradientColor=#b3b3b3;arcSize=50;treeMoving=1;treeFolding=0;strokeWidth=0.5;fontStyle=0" parent="k2k2wWd_USnzYlMqRSar-41" vertex="1" collapsed="1">
          <mxGeometry width="195" height="30" as="geometry" />
        </mxCell>
        <mxCell id="k2k2wWd_USnzYlMqRSar-43" value="" style="swimlane;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;gradientColor=#FFD966;swimlaneFillColor=#E6E6E6;connectable=1;allowArrows=0;treeFolding=0;treeMoving=1;expand=0;" parent="k2k2wWd_USnzYlMqRSar-41" vertex="1" collapsed="1">
          <mxGeometry y="20" width="195" height="5" as="geometry">
            <mxRectangle y="20" width="50.00000000000001" height="3.333333333333333" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="k2k2wWd_USnzYlMqRSar-44" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;Observations (non-exhaustive)&lt;/font&gt;&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&quot;All information comes from a source&quot;.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;- &quot;Consciousness can&#39;t be reduced to purely physical components&quot;.&lt;/span&gt;&lt;/span&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;We cannot see the laws of physics, only their consistent effects on the physical world.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;A magnetic field is invisible, yet its force can be clearly demonstrated.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;Your thoughts and feelings are real to you, but they are unobservable to anyone else.&lt;/span&gt;&lt;/div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;Abstract concepts like mathematics, justice, and love are real (they have effects) but have no physical weight or location.&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b&gt;The Inference (and why)&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&lt;i&gt;There is a seen reality, and an unseen reality.&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;font&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;We consistently observe that the material world is governed and influenced by immaterial/unseen principles, laws, and consciousness.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;This means that reality can be interpreted as being more than governed by the sum of its physical parts.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b&gt;What Happens When Not Inferred&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;All of science, mathematics, and philosophy would be meaningless.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;We would have to conclude that our own conscious mind does not exist, as it is not a physical object.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;The world would be reduced to a collection of objects with no underlying order, laws, or meaning.&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" style="text;html=1;strokeColor=default;fillColor=#E6E6E6;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=4;treeFolding=0;expand=1;spacingLeft=0;" parent="k2k2wWd_USnzYlMqRSar-43" vertex="1">
          <mxGeometry y="15" width="355" height="180" as="geometry" />
        </mxCell>
        <mxCell id="k2k2wWd_USnzYlMqRSar-47" value="" style="group" parent="E9NDm9MUUsob3Jb-81NS-1" vertex="1" connectable="0">
          <mxGeometry x="330" y="780" width="195" height="30" as="geometry" />
        </mxCell>
        <mxCell id="k2k2wWd_USnzYlMqRSar-48" value="&lt;span style=&quot;font-size: 10px;&quot;&gt;We have the capacity to make choices, based on our knowledge and desires.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;comic=0;strokeColor=#666666;fontSize=8;fillColor=#f5f5f5;gradientColor=#b3b3b3;arcSize=50;treeMoving=1;treeFolding=0;strokeWidth=0.5;fontStyle=0" parent="k2k2wWd_USnzYlMqRSar-47" vertex="1" collapsed="1">
          <mxGeometry width="195" height="30" as="geometry" />
        </mxCell>
        <mxCell id="k2k2wWd_USnzYlMqRSar-49" value="" style="swimlane;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;gradientColor=#FFD966;swimlaneFillColor=#E6E6E6;connectable=1;allowArrows=0;treeFolding=0;treeMoving=1;expand=0;" parent="k2k2wWd_USnzYlMqRSar-47" vertex="1" collapsed="1">
          <mxGeometry y="20" width="195" height="5" as="geometry">
            <mxRectangle y="20" width="50.00000000000001" height="3.333333333333333" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="k2k2wWd_USnzYlMqRSar-50" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;Observations (non-exhaustive)&lt;/font&gt;&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&quot;All information comes from a source&quot;.&lt;/span&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&quot;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;All things are contingent on their causes&quot;.&lt;br&gt;&amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&quot;Consciousness can&#39;t be reduced to purely physical components&quot;.&lt;/span&gt;&lt;/div&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;You experience the internal sensation of&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); background-color: transparent; font-size: 7px;&quot;&gt;deliberately&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); background-color: transparent; font-size: 7px;&quot;&gt;weighing options&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); background-color: transparent; font-size: 7px;&quot;&gt;before making a decision&lt;/span&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;You can consciously decide to act against a strong emotional impulse (like anger, or short-term pleasure) in favor of an abstract, long-term goal.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;You can experience regret or satisfaction over choices we have made in the past.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;You hold people responsible for their actions, which assumes they could have chosen to act differently.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b&gt;The Inference (and why)&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&lt;i&gt;You have the capacity to make choices, based on our knowledge and desires.&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;font&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;We experience ourselves as agents who are capable of causing our own actions, as well as being capable of rejecting being passive observers of predetermined events..&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp;- We can now interpret choices to be caused by our desires, with respect to our knowledge.&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;This capacity for choice, or free will, is the foundation for moral responsibility.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b&gt;What Happens When Not Inferred&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;The concepts of praise, blame, and responsibility become meaningless.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;It would be irrational to praise someone for a good deed or blame them for a crime if they were merely a biological machine executing its programming.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;Justice would be reduced to a mere tool for modifying behavior, no different from training an animal.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;strokeColor=default;fillColor=#E6E6E6;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=4;treeFolding=0;expand=1;spacingLeft=0;" parent="k2k2wWd_USnzYlMqRSar-49" vertex="1">
          <mxGeometry y="15" width="410" height="205" as="geometry" />
        </mxCell>
        <mxCell id="3AuyWV5wqyfNcxQHLaBd-0" value="Tier 3: Universal Inferences" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=20;fontColor=default;labelBackgroundColor=none;gradientColor=#FFD966;fillColor=#FFF2CC;strokeColor=#D6B656;fontStyle=1;verticalAlign=top;spacingTop=12;strokeWidth=2;" parent="E9NDm9MUUsob3Jb-81NS-1" vertex="1">
          <mxGeometry x="40" y="480" width="375" height="195" as="geometry" />
        </mxCell>
        <mxCell id="3AuyWV5wqyfNcxQHLaBd-1" value="Tier 3: Biological Inferences" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=20;fontColor=default;labelBackgroundColor=none;gradientColor=#97D077;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;verticalAlign=top;spacingTop=12;strokeWidth=2;" parent="E9NDm9MUUsob3Jb-81NS-1" vertex="1">
          <mxGeometry x="435" y="480" width="375" height="195" as="geometry" />
        </mxCell>
        <mxCell id="zvqRTCDcasdBtbY2sySJ-32" value="" style="group" parent="E9NDm9MUUsob3Jb-81NS-1" vertex="1" connectable="0">
          <mxGeometry x="55" y="630" width="165" height="30" as="geometry" />
        </mxCell>
        <mxCell id="zvqRTCDcasdBtbY2sySJ-21" value="&lt;span style=&quot;font-size: 10px;&quot;&gt;All things are contingent on their causes (that are not the thing).&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;comic=0;strokeColor=#666666;fontSize=8;fillColor=#f5f5f5;gradientColor=#b3b3b3;arcSize=50;treeMoving=1;treeFolding=0;strokeWidth=0.5;fontStyle=0" parent="zvqRTCDcasdBtbY2sySJ-32" vertex="1" collapsed="1">
          <mxGeometry width="165" height="30" as="geometry" />
        </mxCell>
        <mxCell id="zvqRTCDcasdBtbY2sySJ-22" value="" style="swimlane;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;gradientColor=#FFD966;swimlaneFillColor=#E6E6E6;connectable=1;allowArrows=0;treeFolding=0;treeMoving=1;expand=0;" parent="zvqRTCDcasdBtbY2sySJ-32" vertex="1" collapsed="1">
          <mxGeometry y="20" width="165" height="5" as="geometry">
            <mxRectangle y="20" width="50.00000000000001" height="3.333333333333333" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="zvqRTCDcasdBtbY2sySJ-23" value="&lt;b&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;Observations (non-exhaustive)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&amp;nbsp;- &quot;All information comes from a source&quot;.&lt;br&gt;&amp;nbsp;- &quot;Speculation is not refutation&quot;.&lt;br&gt;&amp;nbsp;- &quot;Every thing that has a beginning has a preceding cause&quot;.&lt;div&gt;&amp;nbsp;- The existence of this specific planet depends on a long chain of prior events that could have been different.&lt;br&gt;&amp;nbsp;- A particular tree exists because a seed happened to fall in that specific spot and grow.&lt;br&gt;&amp;nbsp;- The specific arrangement of continents on Earth is not the only possible arrangement.&lt;br&gt;&amp;nbsp;- If a thing depends on a variable property to occur, then how it manifested is contingent on that particular value of that variable.&lt;br&gt;&amp;nbsp;- For a conclusion to be valid, it must be contingent on premises that are not the conclusion itself.&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- Otherwise, it would either be a tautology, circular reasoning, or infinite regression.&lt;br&gt;&amp;nbsp;- All things originating from something else that is not the thing:&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- Chickens and eggs come from each other, except for the first egg, which came from a non-chicken.&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Animals come from other animals, except for the first animal, which came from a non-animal.&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Life comes from other life, except for the first living thing, which came from a non-living thing.&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Temporal things are made from other temporal things, except for the first temporal thing, which came from a non-temporal thing.&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Our laws of causality are inferred from events within time, so they can&#39;t be applied to a reality that may exist outside of time.&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;The Inference (and why)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&amp;nbsp;- &lt;i&gt;All things are contingent on their causes (that are not the thing).&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- We observe that things in the universe depend on external conditions and prior causes for their existence.&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- This must include the universe, as its existence depends on its initial/external conditions.&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- This is what &quot;determinism&quot; is: where an effect is contingent on a particular set of initial causes.&lt;br&gt;&amp;nbsp;- This means their existence is not a matter of logical necessity; they could have been otherwise.&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- This is what a &quot;possibility&quot; is: what would have happened (in theory) based on manipulating variables and simulating the outcome based on a specified set of rules.&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;What Happens When Not Inferred&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&amp;nbsp;- Reality would be impossible to explain.&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- There would be no reason to ask &quot;why&quot; things are the way they are (ie. what something&#39;s &quot;purpose&quot; is), as they would have always existed that way (rather than &quot;starting&quot; from somewhere).&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- All patterns and cycles would reduce to an infinite regress (ex. life would always come from other life, without a &quot;first&quot; living thing that came from non-life).&lt;/div&gt;" style="text;html=1;strokeColor=default;fillColor=#E6E6E6;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=7;treeFolding=0;expand=1;spacingLeft=0;" parent="zvqRTCDcasdBtbY2sySJ-22" vertex="1">
          <mxGeometry y="15" width="525" height="275" as="geometry" />
        </mxCell>
        <mxCell id="zvqRTCDcasdBtbY2sySJ-36" value="" style="group" parent="E9NDm9MUUsob3Jb-81NS-1" vertex="1" connectable="0">
          <mxGeometry x="235" y="630" width="165" height="30" as="geometry" />
        </mxCell>
        <mxCell id="zvqRTCDcasdBtbY2sySJ-37" value="&lt;span style=&quot;font-size: 10px;&quot;&gt;Reality tends to progress from&lt;/span&gt;&lt;br style=&quot;font-size: 10px;&quot;&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;order to disorder.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;comic=0;strokeColor=#666666;fontSize=8;fillColor=#f5f5f5;gradientColor=#b3b3b3;arcSize=50;treeMoving=1;treeFolding=0;strokeWidth=0.5;fontStyle=0" parent="zvqRTCDcasdBtbY2sySJ-36" vertex="1" collapsed="1">
          <mxGeometry width="165" height="30" as="geometry" />
        </mxCell>
        <mxCell id="zvqRTCDcasdBtbY2sySJ-38" value="" style="swimlane;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;gradientColor=#FFD966;swimlaneFillColor=#E6E6E6;connectable=1;allowArrows=0;treeFolding=0;treeMoving=1;expand=0;" parent="zvqRTCDcasdBtbY2sySJ-36" vertex="1" collapsed="1">
          <mxGeometry y="20" width="165" height="5" as="geometry">
            <mxRectangle y="20" width="50.00000000000001" height="3.333333333333333" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="zvqRTCDcasdBtbY2sySJ-39" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;Observations (non-exhaustive)&lt;/font&gt;&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&quot;Time, as we experience it, is linear and progresses asymmetrically&quot;.&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;A hot cup of coffee always cools down to room temperature; it never spontaneously heats up.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;A tidy room, if left alone, will gradually become messy and dusty.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;A sandcastle built with great effort is easily washed away into a simple pile of sand.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp;- Trust takes time to build, while the breaking of trust can take a moment.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp;- Everything ultimately dies.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;The Pareto Principle: 80% of a task takes 20% of the time, while the remaining 20% takes 80% of the time.&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- Or, 20% of effort leads to 80% of the reward, while the remaning 80% of efforts gets you the remaining 20% of the reward.&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- Order requires active maintenance, while disorder requires passive abandonment (or lack of intelligence).&lt;br&gt;&amp;nbsp; -&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;Energy tends to spread out and dissipate over time.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b&gt;The Inference (and why)&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;font-style: italic; background-color: transparent; font-size: 7px; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Reality tends to progress from&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-style: italic; background-color: transparent; font-size: 7px; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;order to disorder.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;font&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- This inference is consistent across all fields of study, including physics, social interactions, etc&lt;/span&gt;&lt;/font&gt;&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp;- This means that the universe could be moments away from disorder on any level.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- Reality can now be interpreted as: all systems require active maintenance to counteract their natural decline.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b&gt;What Happens When Not Inferred&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;font-size: 7px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;It becomes difficult to accept the reality of your own deterioration, or that of the universe.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;It becomes difficult to understand or appreciate the immense and continuous effort required to create and maintain order on a consistent level, whether in a home, a relationship, a society, or science.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;strokeColor=default;fillColor=#E6E6E6;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=4;treeFolding=0;expand=1;spacingLeft=0;" parent="zvqRTCDcasdBtbY2sySJ-38" vertex="1">
          <mxGeometry y="15" width="395" height="205" as="geometry" />
        </mxCell>
        <mxCell id="zvqRTCDcasdBtbY2sySJ-49" value="" style="group" parent="E9NDm9MUUsob3Jb-81NS-1" vertex="1" connectable="0">
          <mxGeometry x="520" y="630" width="210" height="30" as="geometry" />
        </mxCell>
        <mxCell id="zvqRTCDcasdBtbY2sySJ-50" value="&lt;span style=&quot;font-size: 10px;&quot;&gt;Reality (and life) is a hierarchy of deeply&lt;br&gt;interconnected systems.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;comic=0;strokeColor=#666666;fontSize=8;fillColor=#f5f5f5;gradientColor=#b3b3b3;arcSize=50;treeMoving=1;treeFolding=0;strokeWidth=0.5;fontStyle=0" parent="zvqRTCDcasdBtbY2sySJ-49" vertex="1" collapsed="1">
          <mxGeometry width="210" height="30" as="geometry" />
        </mxCell>
        <mxCell id="zvqRTCDcasdBtbY2sySJ-51" value="" style="swimlane;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;gradientColor=#FFD966;swimlaneFillColor=#E6E6E6;connectable=1;allowArrows=0;treeFolding=0;treeMoving=1;expand=0;" parent="zvqRTCDcasdBtbY2sySJ-49" vertex="1" collapsed="1">
          <mxGeometry y="20" width="210" height="5" as="geometry">
            <mxRectangle y="20" width="50.00000000000001" height="3.333333333333333" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="zvqRTCDcasdBtbY2sySJ-52" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;Observations (non-exhaustive)&lt;/font&gt;&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;- &quot;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;Biological structures are goal-oriented&quot;.&lt;/span&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;Bees rely on flowers for food, and flowers rely on bees for pollination.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;The water cycle connects the oceans, the atmosphere, and the land in a single system.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;The human body is a system of interdependent organs that must work together to sustain life.&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;Predators and prey exist in a delicate ecological balance that affects the entire environment.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b&gt;The Inference (and why)&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;font-style: italic; background-color: transparent; font-size: 7px; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Reality (and life) is a hierarchy of deeply&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-style: italic; background-color: transparent; font-size: 7px; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;interconnected systems.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;font&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;We observe that from the microscopic to the cosmic, things exist in complex relationships with one another.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;The function of the whole can be interpreted as composed of the&amp;nbsp;unique arrangement of its individual parts.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b&gt;What Happens When Not Inferred&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;- You would fail to understand or comprehend any complex system&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;This would prevent us from solving problems or inferring about systems that involve the interaction of multiple components.&lt;/span&gt;&lt;br&gt;&lt;/div&gt;" style="text;html=1;strokeColor=default;fillColor=#E6E6E6;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=4;treeFolding=0;expand=1;spacingLeft=0;" parent="zvqRTCDcasdBtbY2sySJ-51" vertex="1">
          <mxGeometry y="15" width="350" height="160" as="geometry" />
        </mxCell>
        <mxCell id="zvqRTCDcasdBtbY2sySJ-29" value="" style="group" parent="E9NDm9MUUsob3Jb-81NS-1" vertex="1" connectable="0">
          <mxGeometry x="235" y="585" width="165" height="30" as="geometry" />
        </mxCell>
        <mxCell id="zvqRTCDcasdBtbY2sySJ-5" value="&lt;span style=&quot;font-size: 10px;&quot;&gt;Reality has a universally applicable set of fundamental laws.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;comic=0;strokeColor=#666666;fontSize=8;fillColor=#f5f5f5;gradientColor=#b3b3b3;arcSize=50;treeMoving=1;treeFolding=0;strokeWidth=0.5;fontStyle=0" parent="zvqRTCDcasdBtbY2sySJ-29" vertex="1" collapsed="1">
          <mxGeometry width="165" height="30" as="geometry" />
        </mxCell>
        <mxCell id="zvqRTCDcasdBtbY2sySJ-6" value="" style="swimlane;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;gradientColor=#FFD966;swimlaneFillColor=#E6E6E6;connectable=1;allowArrows=0;treeFolding=0;treeMoving=1;expand=0;" parent="zvqRTCDcasdBtbY2sySJ-29" vertex="1" collapsed="1">
          <mxGeometry y="20" width="165" height="5" as="geometry">
            <mxRectangle y="20" width="50.00000000000001" height="3.333333333333333" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="zvqRTCDcasdBtbY2sySJ-7" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;Observations (non-exhaustive)&lt;/font&gt;&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&quot;Reality is ordered, operating according to consistent and intelligible laws&quot;.&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;The law of gravity that makes an apple fall is the same law that holds galaxies together.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;The periodic table of elements is the same on Earth as it is in distant stars.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;The speed of light in a vacuum is a universal constant everywhere we measure it.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;All known life is based on the same fundamental DNA coding system.&lt;br&gt;&amp;nbsp;- All things appear to be in pairs or contrasted against an opposite.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b&gt;The Inference (and why)&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&lt;i&gt;Reality has a universally applicable set of fundamental laws.&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;font&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;We observe that the rules governing reality are consistent and integrated across all of space and time.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;The universe can then be interpreted as a single, unified system (on a fundamental level), not a collection of separate domains with their own rules.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b&gt;What Happens When Not Inferred&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;Knowledge would be fragmented and unreliable.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;We could never be confident that the laws of physics that work here would work on the Moon or in another galaxy.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;This would prevent us from forming a comprehensive understanding of reality as a whole.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;strokeColor=default;fillColor=#E6E6E6;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=4;treeFolding=0;expand=1;spacingLeft=0;" parent="zvqRTCDcasdBtbY2sySJ-6" vertex="1">
          <mxGeometry y="15" width="335" height="175" as="geometry" />
        </mxCell>
        <mxCell id="zvqRTCDcasdBtbY2sySJ-31" value="" style="group" parent="E9NDm9MUUsob3Jb-81NS-1" vertex="1" connectable="0">
          <mxGeometry x="55" y="585" width="165" height="30" as="geometry" />
        </mxCell>
        <mxCell id="iH2UVBOdWFAa72GYO2fS-6" value="&lt;span style=&quot;font-size: 10px;&quot;&gt;Every thing that has a beginning&lt;br&gt;has a preceding cause.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;comic=0;strokeColor=#666666;fontSize=8;fillColor=#f5f5f5;gradientColor=#b3b3b3;arcSize=50;treeMoving=1;treeFolding=0;strokeWidth=0.5;fontStyle=0" parent="zvqRTCDcasdBtbY2sySJ-31" vertex="1" collapsed="1">
          <mxGeometry width="165" height="30" as="geometry" />
        </mxCell>
        <mxCell id="iH2UVBOdWFAa72GYO2fS-7" value="" style="swimlane;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;gradientColor=#FFD966;swimlaneFillColor=#E6E6E6;connectable=1;allowArrows=0;treeFolding=0;treeMoving=1;expand=0;" parent="zvqRTCDcasdBtbY2sySJ-31" vertex="1" collapsed="1">
          <mxGeometry y="20" width="165" height="5" as="geometry">
            <mxRectangle y="20" width="50.00000000000001" height="3.333333333333333" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="iH2UVBOdWFAa72GYO2fS-8" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;Observations (non-exhaustive)&lt;/font&gt;&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&quot;All information comes from a source&quot;.&lt;/span&gt;&lt;/div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&quot;Speculation is not refutation&quot;.&lt;/span&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;Glass shatters on the floor only after it has been dropped.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;A fire starts only after a spark meets fuel and oxygen.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;An object at rest only moves when a force acts upon it.&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;- Your hand starts at a non-hand (arm), your arm starts at a non-arm (shoulder), your shoulder starts at a non-shoulder (etc.).&lt;/span&gt;&lt;/div&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;You consistently observe that effects never precede their [inferred] causes.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp;- You know about the quadratic equation because someone else taught you.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp;- A scholar writing about a historical event must have learned from someone else or made it up.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b&gt;The Inference (and why)&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&lt;i&gt;Every thing that has a beginning has a preceding cause.&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;font&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;We infer this rule from our universal, unbroken experience that things do not happen without a reason.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;This reflects our observation that reality can be interpreted as an ordered chain of events, not a series of random, disconnected occurrences.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- Note that this even encompasses quantum events, as they are still correspond with probabilistic laws and wave functions.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- Our ignorance over what actually causes the wave function collapse is not a refutation of this inference.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b&gt;What Happens When Not Inferred&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;Understanding reality becomes impossible.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;There would be no reason to expect the future to be connected to the past in any meaningful way.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;Science would be a pointless exercise, as experiments would have no reliable connection between tests and results.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;strokeColor=default;fillColor=#E6E6E6;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=4;treeFolding=0;expand=1;spacingLeft=0;" parent="iH2UVBOdWFAa72GYO2fS-7" vertex="1">
          <mxGeometry y="15" width="450" height="205" as="geometry" />
        </mxCell>
        <mxCell id="zvqRTCDcasdBtbY2sySJ-45" value="" style="group" parent="E9NDm9MUUsob3Jb-81NS-1" vertex="1" connectable="0">
          <mxGeometry x="520" y="585" width="210" height="30" as="geometry" />
        </mxCell>
        <mxCell id="zvqRTCDcasdBtbY2sySJ-46" value="&lt;span style=&quot;font-size: 10px;&quot;&gt;Biological structures are goal-oriented.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;comic=0;strokeColor=#666666;fontSize=8;fillColor=#f5f5f5;gradientColor=#b3b3b3;arcSize=50;treeMoving=1;treeFolding=0;strokeWidth=0.5;fontStyle=0" parent="zvqRTCDcasdBtbY2sySJ-45" vertex="1" collapsed="1">
          <mxGeometry width="210" height="30" as="geometry" />
        </mxCell>
        <mxCell id="zvqRTCDcasdBtbY2sySJ-47" value="" style="swimlane;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;gradientColor=#FFD966;swimlaneFillColor=#E6E6E6;connectable=1;allowArrows=0;treeFolding=0;treeMoving=1;expand=0;" parent="zvqRTCDcasdBtbY2sySJ-45" vertex="1" collapsed="1">
          <mxGeometry y="20" width="210" height="5" as="geometry">
            <mxRectangle y="20" width="50.00000000000001" height="3.333333333333333" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="zvqRTCDcasdBtbY2sySJ-48" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;Observations (non-exhaustive)&lt;/font&gt;&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&quot;All information has a source&quot;.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;The eye has a lens, iris, and retina that work together to allow specific function of seeing.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;The wings of a bird are structured with feathers, bones, and muscles to allow the specific function of flying.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;The components of a cell work together for the purpose of allowing the cell&#39;s survival and replication.&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;The heart is structured as a muscular pump for allowing the specific function of circulating blood.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp;- Biological evolution appears to seek survival, favoring environmental advantages.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b&gt;The Inference (and why)&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&lt;i&gt;Biological structures are goal-oriented.&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;font&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;We observe that the parts of living organisms are not arranged randomly,&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;where they are arranged to achieve a specific function that would otherwise be impossible&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp;- As such, biological components can be interpreted as having a goal or purpose.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b&gt;What Happens When Not Inferred&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;Your lived experience becomes disconnected from your understanding of reality.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;We would be unable to understand the source or meaning of our own phenomenal feelings, as the systems that produce them would now be seen as purposeless.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;The concepts of health and sickness would lose their meaning, as there would be no standard of proper function for our organs to meet or fail.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;The pursuit of personal meaning would be undermined, as the very components of our being would be considered purposeless.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;strokeColor=default;fillColor=#E6E6E6;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=4;treeFolding=0;expand=1;spacingLeft=0;" parent="zvqRTCDcasdBtbY2sySJ-47" vertex="1">
          <mxGeometry y="15" width="370" height="205" as="geometry" />
        </mxCell>
        <mxCell id="zvqRTCDcasdBtbY2sySJ-30" value="" style="group" parent="E9NDm9MUUsob3Jb-81NS-1" vertex="1" connectable="0">
          <mxGeometry x="55" y="540" width="165" height="30" as="geometry" />
        </mxCell>
        <mxCell id="zvqRTCDcasdBtbY2sySJ-17" value="&lt;span style=&quot;font-size: 10px;&quot;&gt;Time (as we experience it) is linear and progresses asymmetrically.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;comic=0;strokeColor=#666666;fontSize=8;fillColor=#f5f5f5;gradientColor=#b3b3b3;arcSize=50;treeMoving=1;treeFolding=0;strokeWidth=0.5;fontStyle=0" parent="zvqRTCDcasdBtbY2sySJ-30" vertex="1" collapsed="1">
          <mxGeometry width="165" height="30" as="geometry" />
        </mxCell>
        <mxCell id="zvqRTCDcasdBtbY2sySJ-18" value="" style="swimlane;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;gradientColor=#FFD966;swimlaneFillColor=#E6E6E6;connectable=1;allowArrows=0;treeFolding=0;treeMoving=1;expand=0;" parent="zvqRTCDcasdBtbY2sySJ-30" vertex="1" collapsed="1">
          <mxGeometry y="20" width="165" height="5" as="geometry">
            <mxRectangle y="20" width="50.00000000000001" height="3.333333333333333" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="zvqRTCDcasdBtbY2sySJ-19" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;Observations (non-exhaustive)&lt;/font&gt;&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&quot;All information comes from a source&quot;.&lt;/span&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;You can remember the past but you can&#39;t remember the future.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;An egg can be scrambled, but a scrambled egg can&#39;t be unscrambled.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;You experience events sequentially, one after the other, in a forward progression.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;We all age in one direction, from younger to older.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b&gt;The Inference (and why)&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&lt;i&gt;Time, as you experience it, is a linear and asymmetrical progression.&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;font&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;We observe that the flow of time has a clear direction that is tied to cause and effect.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;This means the past can be interpreted as fixed and unchangeable, while the future can be interpreted as open.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b&gt;What Happens When Not Inferred&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;Our concepts of causality and history become meaningless.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;There would be no distinction between past, present, and future.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;Planning, learning from experience, and our entire perception of a life narrative would be impossible.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;strokeColor=default;fillColor=#E6E6E6;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=4;treeFolding=0;expand=1;spacingLeft=0;" parent="zvqRTCDcasdBtbY2sySJ-18" vertex="1">
          <mxGeometry y="15" width="355" height="160" as="geometry" />
        </mxCell>
        <mxCell id="zvqRTCDcasdBtbY2sySJ-35" value="" style="group" parent="E9NDm9MUUsob3Jb-81NS-1" vertex="1" connectable="0">
          <mxGeometry x="235" y="540" width="165" height="30" as="geometry" />
        </mxCell>
        <mxCell id="zvqRTCDcasdBtbY2sySJ-1" value="&lt;span style=&quot;font-size: 10px;&quot;&gt;Reality is ordered, operating on consistent and intelligible laws.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;comic=0;strokeColor=#666666;fontSize=8;fillColor=#f5f5f5;gradientColor=#b3b3b3;arcSize=50;treeMoving=1;treeFolding=0;strokeWidth=0.5;fontStyle=0" parent="zvqRTCDcasdBtbY2sySJ-35" vertex="1" collapsed="1">
          <mxGeometry width="165" height="30" as="geometry" />
        </mxCell>
        <mxCell id="zvqRTCDcasdBtbY2sySJ-2" value="" style="swimlane;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;gradientColor=#FFD966;swimlaneFillColor=#E6E6E6;connectable=1;allowArrows=0;treeFolding=0;treeMoving=1;expand=0;" parent="zvqRTCDcasdBtbY2sySJ-35" vertex="1" collapsed="1">
          <mxGeometry y="20" width="165" height="5" as="geometry">
            <mxRectangle y="20" width="50.00000000000001" height="3.333333333333333" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="zvqRTCDcasdBtbY2sySJ-3" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;Observations (non-exhaustive)&lt;/font&gt;&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&quot;Proper reasoning corresponds with reality&quot;.&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;The orbits of planets follow precise, predictable mathematical paths.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;Snowflakes consistently form in intricate, six-sided symmetrical patterns.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;The natural world is filled with complex systems that operate in a regular and orderly way.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;We are able to comprehend and describe these patterns using the abstract language of mathematics.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b&gt;The Inference (and why)&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&lt;i&gt;Reality is ordered, operating according to consistent and intelligible laws.&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;font&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;We observe that the universe is not a random chaos but is fundamentally structured and patterned.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp;-&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp;Its orderly nature allows our minds to grasp and understand its workings: we can reduce complex behavior into an encompassing set of rules/laws.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b&gt;What Happens When Not Inferred&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;Reason becomes useless for understanding the world.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;There would be no patterns to discover, no laws to formulate, and no predictions to be made.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;The universe would be an incomprehensible mystery rather than a subject for rational investigation.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;strokeColor=default;fillColor=#E6E6E6;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=4;treeFolding=0;expand=1;spacingLeft=0;" parent="zvqRTCDcasdBtbY2sySJ-2" vertex="1">
          <mxGeometry y="15" width="340" height="165" as="geometry" />
        </mxCell>
        <mxCell id="zvqRTCDcasdBtbY2sySJ-41" value="" style="group" parent="E9NDm9MUUsob3Jb-81NS-1" vertex="1" connectable="0">
          <mxGeometry x="517.5" y="540" width="210" height="30" as="geometry" />
        </mxCell>
        <mxCell id="zvqRTCDcasdBtbY2sySJ-42" value="&lt;span style=&quot;font-size: 10px;&quot;&gt;Life comes from other life, yet originated&lt;br&gt;from non-life.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;comic=0;strokeColor=#666666;fontSize=8;fillColor=#f5f5f5;gradientColor=#b3b3b3;arcSize=50;treeMoving=1;treeFolding=0;strokeWidth=0.5;fontStyle=0" parent="zvqRTCDcasdBtbY2sySJ-41" vertex="1" collapsed="1">
          <mxGeometry width="210" height="30" as="geometry" />
        </mxCell>
        <mxCell id="zvqRTCDcasdBtbY2sySJ-43" value="" style="swimlane;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;gradientColor=#FFD966;swimlaneFillColor=#E6E6E6;connectable=1;allowArrows=0;treeFolding=0;treeMoving=1;expand=0;" parent="zvqRTCDcasdBtbY2sySJ-41" vertex="1" collapsed="1">
          <mxGeometry y="20" width="210" height="5" as="geometry">
            <mxRectangle y="20" width="50.00000000000001" height="3.333333333333333" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="zvqRTCDcasdBtbY2sySJ-44" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;Observations (non-exhaustive)&lt;/font&gt;&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&quot;All information has a source&quot;.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&quot;Every inference has a limit&quot;.&lt;/span&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;Every human being comes from human parents.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;A tree grows from a seed that came from another tree.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;Bacteria reproduce by dividing into new bacteria.&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp;- All things originate from something else that is not the thing.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp;- There was a time in cosmological history when life didn&#39;t exist.&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- There was a time where you didn&#39;t exist: you yourself weren&#39;t living, yet you became alive somehow.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b&gt;The Inference (and why)&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&lt;i&gt;Life comes from other life, yet originated from non-life.&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;font&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;We infer this from the consistent, unbroken observation that all life originates from prior life, and that there was once a time in which life did not exist.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp;- As such, even without knowing the precise means of how it came to be, life necessarily must have originated from a non-living source.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; - Considering modern advancements in technology and our knowledge of the required environment for life to form, the conditions for the first living thing must have been incredibly and unusually specific for it to have formed.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b&gt;What Happens When Not Inferred&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;- The significance of your own existence would be diminished.&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;It would be easy to take your own existence for granted, viewing it as a common accident rather than an extraordinary event.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;This would prevent you from asking deeper questions about the meaning or purpose of life, as its origin would seem unremarkable.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;strokeColor=default;fillColor=#E6E6E6;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=4;treeFolding=0;expand=1;spacingLeft=0;" parent="zvqRTCDcasdBtbY2sySJ-43" vertex="1">
          <mxGeometry y="15" width="425" height="210" as="geometry" />
        </mxCell>
        <mxCell id="k2k2wWd_USnzYlMqRSar-35" value="***To &quot;infer&quot; is to draw a generalized conclusion, pattern, or rule, based on a set of consistent observations***&amp;nbsp;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=14;fontColor=default;labelBackgroundColor=none;fontStyle=2" parent="E9NDm9MUUsob3Jb-81NS-1" vertex="1">
          <mxGeometry x="81" y="80" width="700" height="35" as="geometry" />
        </mxCell>
        <UserObject label="Discovering the Nature of Reality" link="data:page/id,lkuSvPZcJC7dHRsydWrw" id="p9Y1kiUNqS1NnhsnenXU-0">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#E6E6E6;fontSize=24;strokeWidth=2;" parent="E9NDm9MUUsob3Jb-81NS-1" vertex="1">
            <mxGeometry x="40" y="20" width="770" height="60" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="IeQf6rbAiGyA5MmECNZY-8" value="Tier 2: Epistemological Inferences" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=20;fontColor=default;labelBackgroundColor=none;gradientColor=#FFB663;fillColor=#FFDEC9;strokeColor=#D69555;fontStyle=1;verticalAlign=top;spacingTop=12;strokeWidth=2;" parent="E9NDm9MUUsob3Jb-81NS-1" vertex="1">
          <mxGeometry x="40" y="265" width="770" height="195" as="geometry" />
        </mxCell>
        <mxCell id="5nsJZ0thar9e5fJC-qJR-16" value="" style="group" parent="E9NDm9MUUsob3Jb-81NS-1" vertex="1" connectable="0">
          <mxGeometry x="200" y="415" width="210" height="30" as="geometry" />
        </mxCell>
        <mxCell id="5nsJZ0thar9e5fJC-qJR-17" value="&lt;span style=&quot;font-size: 10px;&quot;&gt;Proper reasoning corresponds with reality.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;comic=0;strokeColor=#666666;fontSize=8;fillColor=#f5f5f5;gradientColor=#b3b3b3;arcSize=50;treeMoving=1;treeFolding=0;strokeWidth=0.5;fontStyle=0" parent="5nsJZ0thar9e5fJC-qJR-16" vertex="1" collapsed="1">
          <mxGeometry width="210" height="30" as="geometry" />
        </mxCell>
        <mxCell id="5nsJZ0thar9e5fJC-qJR-18" value="" style="swimlane;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;gradientColor=#FFD966;swimlaneFillColor=#E6E6E6;connectable=1;allowArrows=0;treeFolding=0;treeMoving=1;expand=0;" parent="5nsJZ0thar9e5fJC-qJR-16" vertex="1" collapsed="1">
          <mxGeometry y="20" width="210" height="5" as="geometry">
            <mxRectangle y="20" width="50.00000000000001" height="3.333333333333333" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5nsJZ0thar9e5fJC-qJR-19" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;Observations (non-exhaustive)&lt;/font&gt;&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;- An engineer uses the laws/inferences of physics and mathematics to design a bridge that successfully stands in the real world.&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- A bad engineer would create an unsuccessful bridge due to improperly applying the&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 7px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;laws/inferences of physics and mathematics.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;- A map (which is an abstract representation of terrain and geographical locations) allows us to successfully navigate a physical city.&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- A bad map would misrepresent reality on some useful level, leading to getting lost.&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;- The inference that your eyes is the cause of your phenomenal sight corresponds with the lack of phenomenal sight any time your eye gets blocked.&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b&gt;The Inference (and why)&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&lt;i&gt;Proper reasoning corresponds with reality.&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;font&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;We observe that the abstract rules of logic are incredibly effective at describing and predicting the physical world.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;This means sound thinking is not just useful in the mind: it is a tool that reliably connects to the way the universe actually works.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b&gt;What Happens When Not Inferred&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;Knowledge becomes useless.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;There would be no reason to believe that our thoughts, plans, or scientific theories have any practical application, as there would be no correlation between our theories and what occurs in reality.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp; -&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;We would be wholly unable to trust our own minds to solve real-world problems.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;strokeColor=default;fillColor=#E6E6E6;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=4;treeFolding=0;expand=1;spacingLeft=0;" parent="5nsJZ0thar9e5fJC-qJR-18" vertex="1">
          <mxGeometry y="15" width="405" height="195" as="geometry" />
        </mxCell>
        <mxCell id="iH2UVBOdWFAa72GYO2fS-0" value="" style="group" parent="E9NDm9MUUsob3Jb-81NS-1" vertex="1" connectable="0">
          <mxGeometry x="440" y="415" width="210" height="30" as="geometry" />
        </mxCell>
        <mxCell id="iH2UVBOdWFAa72GYO2fS-1" value="&lt;span style=&quot;font-size: 10px;&quot;&gt;Every inference has a limit.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;comic=0;strokeColor=#666666;fontSize=8;fillColor=#f5f5f5;gradientColor=#b3b3b3;arcSize=50;treeMoving=1;treeFolding=0;strokeWidth=0.5;fontStyle=0" parent="iH2UVBOdWFAa72GYO2fS-0" vertex="1" collapsed="1">
          <mxGeometry width="210" height="30" as="geometry" />
        </mxCell>
        <mxCell id="iH2UVBOdWFAa72GYO2fS-2" value="" style="swimlane;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;gradientColor=#FFD966;swimlaneFillColor=#E6E6E6;connectable=1;allowArrows=0;treeFolding=0;treeMoving=1;expand=0;" parent="iH2UVBOdWFAa72GYO2fS-0" vertex="1" collapsed="1">
          <mxGeometry y="20" width="210" height="5" as="geometry">
            <mxRectangle y="20" width="50.00000000000001" height="3.333333333333333" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="iH2UVBOdWFAa72GYO2fS-3" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;Observations (non-exhaustive)&lt;/font&gt;&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;- A fish can infer all the rules that govern its pond, but those rules don&#39;t apply to the forest beyond the pond.&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;The laws of classical mechanics accurately describe the motion of baseballs, but they break down at the motion of atoms.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;The rules of chess apply perfectly within the game, but they are meaningless for playing checkers.&lt;br&gt;&amp;nbsp;- All things originate from something else that is not the thing:&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 7px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 7px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;- Chickens and eggs come from each other, except for the first egg, which came from a non-chicken.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 7px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 7px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp;&amp;nbsp; &amp;nbsp;- Animals come from other animals, except for the first animal, which came from a non-animal.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 7px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 7px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp;- Life comes from other life, except for the first living thing, which came from a non-living thing.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 7px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 7px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- Temporal things are made from other temporal things, except for the first temporal thing, which came from a non-temporal thing.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 7px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 7px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 7px;&quot;&gt;Our inferred law of causality (&quot;all information comes from a source&quot;) describes events within time, so it cannot be applied to a reality that may exist outside of time.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b&gt;The Inference (and why)&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&lt;i&gt;Every inference has a limit.&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;font&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;We observe that rules and principles are derived from a specific context and may not apply outside of that context.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;font-size: 7px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;This protects against overgeneralization, as&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp;any general rule you infer is limited by the scope of your observations.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;Therefore, this very principle - that &quot;every inference has a limit&quot; - must also have a limit, leading to the exploration of an ultimate, un-limited truth.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b&gt;What Happens When Not Inferred&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;- Knowledge becomes rigid and hyper-dogmatic.&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;True inferences would be oversimplified, preventing the acceptance of more correct truths.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;We would mistakenly apply rules from one domain to another where they do not belong, leading to profound errors that appear beautifully sound.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;We would be forced to ignore or reject valid evidence simply because it does not fit our oversimplified models.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;This prevents us from achieving a more complete understanding by mistaking the limits of our inferences and understanding for the limits of reality itself.&lt;/span&gt;&lt;br&gt;&lt;/div&gt;" style="text;html=1;strokeColor=default;fillColor=#E6E6E6;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=4;treeFolding=0;expand=1;spacingLeft=0;" parent="iH2UVBOdWFAa72GYO2fS-2" vertex="1">
          <mxGeometry y="15" width="470" height="230" as="geometry" />
        </mxCell>
        <mxCell id="5nsJZ0thar9e5fJC-qJR-4" value="" style="group" parent="E9NDm9MUUsob3Jb-81NS-1" vertex="1" connectable="0">
          <mxGeometry x="80" y="370" width="210" height="30" as="geometry" />
        </mxCell>
        <mxCell id="5nsJZ0thar9e5fJC-qJR-5" value="&lt;span style=&quot;font-size: 10px;&quot;&gt;Truth is defined by reality, not by feelings&lt;br&gt;or intuition.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;comic=0;strokeColor=#666666;fontSize=8;fillColor=#f5f5f5;gradientColor=#b3b3b3;arcSize=50;treeMoving=1;treeFolding=0;strokeWidth=0.5;fontStyle=0" parent="5nsJZ0thar9e5fJC-qJR-4" vertex="1" collapsed="1">
          <mxGeometry width="210" height="30" as="geometry" />
        </mxCell>
        <mxCell id="5nsJZ0thar9e5fJC-qJR-6" value="" style="swimlane;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;gradientColor=#FFD966;swimlaneFillColor=#E6E6E6;connectable=1;allowArrows=0;treeFolding=0;treeMoving=1;expand=0;" parent="5nsJZ0thar9e5fJC-qJR-4" vertex="1" collapsed="1">
          <mxGeometry y="20" width="210" height="5" as="geometry">
            <mxRectangle y="20" width="50.00000000000001" height="3.333333333333333" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5nsJZ0thar9e5fJC-qJR-7" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;Observations (non-exhaustive)&lt;/font&gt;&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;You can feel with certainty that a door is unlocked, but that feeling does not change the physical state of the lock.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;A person can feel that a particular investment is a &quot;sure thing&quot;, but that intuition does not prevent it from failing.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;Two people can have opposite feelings about who should have won a game, but the final score is an objective fact.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;A mirage in the desert feels and looks real, but your desire for an oasis fails to correspond with reality.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b&gt;The Inference (and why)&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&lt;i&gt;Truth is defined by reality, not by feelings or intuition.&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;font&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;We observe that reality is the ultimate judge of whether a claim is true, regardless of our internal state of certainty.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- This means that truth corresponds with rationality, not comprehensibility: it is possible for something to be true that you can&#39;t comprehend or fully understand.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;This means truth is objective because it is based on something outside of ourselves.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b&gt;What Happens When Not Inferred&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;The pursuit of truth becomes a matter of personal preference.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;There would be no functional difference between a verifiable fact and a deeply felt opinion.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;Meaningful disagreement would be impossible, as every conflicting viewpoint would be &quot;true&quot; for the person holding it.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;strokeColor=default;fillColor=#E6E6E6;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=4;treeFolding=0;expand=1;spacingLeft=0;" parent="5nsJZ0thar9e5fJC-qJR-6" vertex="1">
          <mxGeometry y="15" width="370" height="175" as="geometry" />
        </mxCell>
        <mxCell id="5nsJZ0thar9e5fJC-qJR-12" value="" style="group" parent="E9NDm9MUUsob3Jb-81NS-1" vertex="1" connectable="0">
          <mxGeometry x="320" y="370" width="210" height="30" as="geometry" />
        </mxCell>
        <mxCell id="5nsJZ0thar9e5fJC-qJR-13" value="&lt;span style=&quot;font-size: 10px;&quot;&gt;Falsehood is defined by contradiction,&lt;br&gt;not&amp;nbsp;by feelings or intuition.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;comic=0;strokeColor=#666666;fontSize=8;fillColor=#f5f5f5;gradientColor=#b3b3b3;arcSize=50;treeMoving=1;treeFolding=0;strokeWidth=0.5;fontStyle=0" parent="5nsJZ0thar9e5fJC-qJR-12" vertex="1" collapsed="1">
          <mxGeometry width="210" height="30" as="geometry" />
        </mxCell>
        <mxCell id="5nsJZ0thar9e5fJC-qJR-14" value="" style="swimlane;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;gradientColor=#FFD966;swimlaneFillColor=#E6E6E6;connectable=1;allowArrows=0;treeFolding=0;treeMoving=1;expand=0;" parent="5nsJZ0thar9e5fJC-qJR-12" vertex="1" collapsed="1">
          <mxGeometry y="20" width="210" height="5" as="geometry">
            <mxRectangle y="20" width="50.00000000000001" height="3.333333333333333" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5nsJZ0thar9e5fJC-qJR-15" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;Observations (non-exhaustive)&lt;/font&gt;&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;A suspect&#39;s alibi is proven false when it is shown he could not have been in two places at once.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;A scientific theory is discarded when its predictions contradict experimental results.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;A statement is known to be false if it contradicts a verifiable fact, such as the statement &quot;the sky is green.&quot;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;- Square circles don&#39;t exist, no matter how try to visualize it.&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;- An integer cannot be both even and odd.&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b&gt;The Inference (and why)&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;- &lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;font-style: italic; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 7px; background-color: transparent;&quot;&gt;Falsehood is defined by contradiction, not&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-style: italic; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 7px; background-color: transparent;&quot;&gt;by feelings or intuition.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;font&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;Because reality is consistent, a claim that is untrue (which would be inconsistent with reality) will inevitably clash with a known fact.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- This means that falsehood corresponds with irrationality, not incomprehensibility.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;This contradiction - the clashing of a claim with a fact - is the objective marker of falsehood, regardless of how plausible the false claim may feel.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b&gt;What Happens When Not Inferred&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;Identifying falsehood becomes impossible.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;If contradiction is not the standard, any claim could be accepted so long as it &quot;feels right&quot;.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;We would have no logical tool to reject misinformation or any belief that is inconsistent with the observable world.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;strokeColor=default;fillColor=#E6E6E6;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=4;treeFolding=0;expand=1;spacingLeft=0;" parent="5nsJZ0thar9e5fJC-qJR-14" vertex="1">
          <mxGeometry y="15" width="360" height="175" as="geometry" />
        </mxCell>
        <mxCell id="L5jaFK7IuG-8SZXckjEd-0" value="" style="group" parent="E9NDm9MUUsob3Jb-81NS-1" vertex="1" connectable="0">
          <mxGeometry x="560" y="370" width="210" height="30" as="geometry" />
        </mxCell>
        <mxCell id="L5jaFK7IuG-8SZXckjEd-1" value="&lt;span style=&quot;font-size: 10px;&quot;&gt;Speculation is neither proof nor refutation.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;comic=0;strokeColor=#666666;fontSize=8;fillColor=#f5f5f5;gradientColor=#b3b3b3;arcSize=50;treeMoving=1;treeFolding=0;strokeWidth=0.5;fontStyle=0" parent="L5jaFK7IuG-8SZXckjEd-0" vertex="1" collapsed="1">
          <mxGeometry width="210" height="30" as="geometry" />
        </mxCell>
        <mxCell id="L5jaFK7IuG-8SZXckjEd-2" value="" style="swimlane;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;gradientColor=#FFD966;swimlaneFillColor=#E6E6E6;connectable=1;allowArrows=0;treeFolding=0;treeMoving=1;expand=0;" parent="L5jaFK7IuG-8SZXckjEd-0" vertex="1" collapsed="1">
          <mxGeometry y="20" width="210" height="5" as="geometry">
            <mxRectangle y="20" width="50.00000000000001" height="3.333333333333333" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="L5jaFK7IuG-8SZXckjEd-3" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;Observations (non-exhaustive)&lt;/font&gt;&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;If you see dark clouds and suddenly feel wet, saying &quot;it&#39;s raining&quot; matches what you observe - while saying &quot;it might be aliens spraying water, but we don&#39;t know&quot; is just a wild guess without any proof.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp;-&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;When a doctor diagnoses a cold based on your symptoms like a runny nose and cough, that&#39;s better than saying &quot;it could be anything unknown&quot; without checking.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;In a puzzle, fitting a piece where it matches the picture is stronger than saying &quot;any piece might work if we imagine a different picture we haven&#39;t seen&quot;.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;You know your phone is charged because the screen lights up, not because &quot;it might be powered by magic we don&#39;t understand&quot;.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;- Proving that the Earth is flat fundamentally leads to more questions than answers - even with more explanations.&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b&gt;The Inference (and why)&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&lt;i&gt;Speculation is neither proof nor refutation.&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;font&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;We see that ideas tied to clear facts and patterns (what matches reality) explain and predict the world better than ideas built on unknowns or &quot;what-ifs&quot; without proof.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- In other words, correspondence with reality is a stronger basis for truth than speculation or ignorance.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;As a result, rules from what we&#39;ve seen stay useful until real proof against them shows up.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- &quot;Maybe&quot; ideas don&#39;t disprove inferences that correspond with reality.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- In other words: if a claim can be made without definitive evidence, then it can also be dismissed without definitive evidence.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b&gt;What Happens When Not Inferred&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;- Truth becomes unattainable.&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;All hypotheses would be equally strong based on &quot;possibility&quot;, causing science to stall endlessly on speculations without needing evidence.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;This also makes truth and falsehood indistinguishable from one another, as false possibilities now have equal (or more) weight as the truth (without you ever being able to figure that out).&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;We would be forced to ignore or reject valid evidence simply because it does not fit our oversimplified models.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;Knowledge would always reduce to skepticism or relativism, as no claim could be objectively preferred.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- Without correspondence with reality, the only alternative is emotion or ignorance:&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;you could end up doubting everything or believing anything, as nothing could stand out without matching reality as the judge.&lt;/span&gt;&lt;br&gt;&lt;/div&gt;" style="text;html=1;strokeColor=default;fillColor=#E6E6E6;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=4;treeFolding=0;expand=1;spacingLeft=0;" parent="L5jaFK7IuG-8SZXckjEd-2" vertex="1">
          <mxGeometry y="15" width="465" height="255" as="geometry" />
        </mxCell>
        <mxCell id="5nsJZ0thar9e5fJC-qJR-20" value="" style="group" parent="E9NDm9MUUsob3Jb-81NS-1" vertex="1" connectable="0">
          <mxGeometry x="560" y="325" width="210" height="30" as="geometry" />
        </mxCell>
        <mxCell id="5nsJZ0thar9e5fJC-qJR-21" value="&lt;span style=&quot;font-size: 10px;&quot;&gt;Perception, memory, and reasoning are imperfect and subject to error.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;comic=0;strokeColor=#666666;fontSize=8;fillColor=#f5f5f5;gradientColor=#b3b3b3;arcSize=50;treeMoving=1;treeFolding=0;strokeWidth=0.5;fontStyle=0" parent="5nsJZ0thar9e5fJC-qJR-20" vertex="1" collapsed="1">
          <mxGeometry width="210" height="30" as="geometry" />
        </mxCell>
        <mxCell id="5nsJZ0thar9e5fJC-qJR-22" value="" style="swimlane;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;gradientColor=#FFD966;swimlaneFillColor=#E6E6E6;connectable=1;allowArrows=0;treeFolding=0;treeMoving=1;expand=0;" parent="5nsJZ0thar9e5fJC-qJR-20" vertex="1" collapsed="1">
          <mxGeometry y="20" width="210" height="5" as="geometry">
            <mxRectangle y="20" width="50.00000000000001" height="3.333333333333333" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5nsJZ0thar9e5fJC-qJR-23" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;Observations (non-exhaustive)&lt;/font&gt;&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;- A straight straw in a glass of water appears to be bent.&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;Eyewitness testimonies of the same event often differ from one another in significant ways.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;- People appear to generally favor evidence that confirms what they already think is true.&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;History is filled with examples of widely held beliefs that were later proven to be completely wrong.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp;- Scientific paradoxes exist, where two established phenomena occur simultaneously in such a way that introduces a contradiction in an established explanation.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp;- Our minds and bodies appear to be susceptible to electrical and psychological influences.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b&gt;The Inference (and why)&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&lt;i&gt;Perception, memory, and reasoning are imperfect and subject to error.&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;font&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;We consistently observe that our senses can be deceived and our minds can make mistakes.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;This implies our knowledge is always provisional (subject to either future change or confirmation) and must be open to revision in light of new evidence.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b&gt;What Happens When Not Inferred&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;Learning and self-correction become impossible.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;If we assume our minds are infallible, or that our knowledge is perfect and there is nothing else to learn (or, anything new must be filtered through our preconceived ideas), we prevent ourselves from being able to change our minds when we&#39;re wrong about something.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;This leads to a complete inability to identify and correct our own errors, preventing any growth in understanding.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;strokeColor=default;fillColor=#E6E6E6;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=4;treeFolding=0;expand=1;spacingLeft=0;" parent="5nsJZ0thar9e5fJC-qJR-22" vertex="1">
          <mxGeometry y="15" width="380" height="200" as="geometry" />
        </mxCell>
        <mxCell id="5nsJZ0thar9e5fJC-qJR-8" value="" style="group" parent="E9NDm9MUUsob3Jb-81NS-1" vertex="1" connectable="0">
          <mxGeometry x="81" y="325" width="210" height="30" as="geometry" />
        </mxCell>
        <mxCell id="5nsJZ0thar9e5fJC-qJR-9" value="&lt;span style=&quot;font-size: 10px;&quot;&gt;All information comes from a source.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;comic=0;strokeColor=#666666;fontSize=8;fillColor=#f5f5f5;gradientColor=#b3b3b3;arcSize=50;treeMoving=1;treeFolding=0;strokeWidth=0.5;fontStyle=0" parent="5nsJZ0thar9e5fJC-qJR-8" vertex="1" collapsed="1">
          <mxGeometry width="210" height="30" as="geometry" />
        </mxCell>
        <mxCell id="5nsJZ0thar9e5fJC-qJR-10" value="" style="swimlane;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;gradientColor=#FFD966;swimlaneFillColor=#E6E6E6;connectable=1;allowArrows=0;treeFolding=0;treeMoving=1;expand=0;" parent="5nsJZ0thar9e5fJC-qJR-8" vertex="1" collapsed="1">
          <mxGeometry y="20" width="210" height="5" as="geometry">
            <mxRectangle y="20" width="50.00000000000001" height="3.333333333333333" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5nsJZ0thar9e5fJC-qJR-11" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;Observations (non-exhaustive)&lt;/font&gt;&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;A book has an author who wrote the words.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;A news report comes from a journalist who gathered the facts.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;- The formation of an organism is directed by DNA.&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;When we receive an anonymous letter, we know someone wrote it, even if we do not know who.&lt;br&gt;&amp;nbsp;- When a scholar writes about something, he must have either copied it from someone else, organized pre-existing ideas (from other people or reality) into a new, unique concept, or made it up.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp;- An object at rest only moves when a force acts upon it.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b&gt;The Inference (and why)&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&lt;i&gt;All information comes from a source.&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;font&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;We observe that information does not spontaneously generate from nothingness: it always comes from somewhere.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;This inference allows every fact, claim, or piece of data to have an origin that can be investigated for its reliability.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b&gt;What Happens When Not Inferred&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;Distinguishing fact from fiction becomes impossible.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;There would be no reason to question the origin of a claim, as information could just &quot;be&quot; without any source.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- If the source of information is meaningless, and truth is defined by reality (and falsehoods by their contradiction with reality), then falsehoods would become indistinguishable from truth.&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;Concepts like evidence, credibility, and citation would be meaningless because the origin of information would be irrelevant.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;strokeColor=default;fillColor=#E6E6E6;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=4;treeFolding=0;expand=1;spacingLeft=0;" parent="5nsJZ0thar9e5fJC-qJR-10" vertex="1">
          <mxGeometry y="15" width="380" height="200" as="geometry" />
        </mxCell>
        <mxCell id="UWiHhDv4sJXpDAHeavtf-10" value="" style="group" parent="E9NDm9MUUsob3Jb-81NS-1" vertex="1" connectable="0">
          <mxGeometry x="320" y="325" width="210" height="30" as="geometry" />
        </mxCell>
        <mxCell id="UWiHhDv4sJXpDAHeavtf-11" value="&lt;span style=&quot;font-size: 10px;&quot;&gt;Phenomenal/conscious experience corresponds with reality.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;comic=0;strokeColor=#666666;fontSize=8;fillColor=#f5f5f5;gradientColor=#b3b3b3;arcSize=50;treeMoving=1;treeFolding=0;strokeWidth=0.5;fontStyle=0" parent="UWiHhDv4sJXpDAHeavtf-10" vertex="1" collapsed="1">
          <mxGeometry width="210" height="30" as="geometry" />
        </mxCell>
        <mxCell id="UWiHhDv4sJXpDAHeavtf-12" value="" style="swimlane;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;gradientColor=#FFD966;swimlaneFillColor=#E6E6E6;connectable=1;allowArrows=0;treeFolding=0;treeMoving=1;expand=0;" parent="UWiHhDv4sJXpDAHeavtf-10" vertex="1" collapsed="1">
          <mxGeometry y="20" width="210" height="5" as="geometry">
            <mxRectangle y="20" width="50.00000000000001" height="3.333333333333333" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="UWiHhDv4sJXpDAHeavtf-13" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;Observations (non-exhaustive)&lt;/font&gt;&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;You can see because you have eyes.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;You can touch because you have nerves.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp;- You know where your hands and feet are (without seeing them) because you have proprioceptors.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;You can feel emotions because you have ____.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;- You can think because you have ____.&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;- You can make decisions because you have ____.&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b&gt;The Inference (and why)&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&lt;i&gt;Phenomenal/conscious experience corresponds with reality.&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;font&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;When the source of our phenomenal experience is removed, we lose the capacity for that experience (ex. you stop seeing when you close your eyes, you stop hearing when you cover your ears, you stop feeling when nothing touches your skin, etc.).&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;This means that we can interpret our experience like sensors, receptors, and transducers: there exist some object that transforms what occurs in reality into our own awareness.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b&gt;What Happens When Not Inferred&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;- Learning about the world would be impossible, as you can&#39;t distinguish between &quot;you&quot; and &quot;reality&quot;.&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;Your awareness would somehow be completely detached from reality, making you unable to make useful associations (like pain with fire, sight with eyelids, etc.)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;Or, you would have to conclude that there is no &quot;reason&quot; or &quot;source&quot; for your experiences, making you unable to distinguish between a &quot;you&quot; and &quot;reality&quot;.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;strokeColor=default;fillColor=#E6E6E6;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=4;treeFolding=0;expand=1;spacingLeft=0;" parent="UWiHhDv4sJXpDAHeavtf-12" vertex="1">
          <mxGeometry y="15" width="390" height="205" as="geometry" />
        </mxCell>
        <mxCell id="JcFAENRXmRqFqC4FB-uc-0" value="Tier 1: Foundational Inferences" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=20;fontColor=default;labelBackgroundColor=none;gradientColor=#EA6B66;fillColor=#F8CECC;strokeColor=#B85450;fontStyle=1;verticalAlign=top;spacingTop=12;strokeWidth=2;" parent="E9NDm9MUUsob3Jb-81NS-1" vertex="1">
          <mxGeometry x="40" y="140" width="770" height="105" as="geometry" />
        </mxCell>
        <mxCell id="7oxWtMFBQvJBjM5p-5OE-0" value="" style="group" parent="E9NDm9MUUsob3Jb-81NS-1" vertex="1" connectable="0">
          <mxGeometry x="80" y="200" width="210" height="30" as="geometry" />
        </mxCell>
        <mxCell id="7oxWtMFBQvJBjM5p-5OE-1" value="&lt;span style=&quot;font-size: 10px;&quot;&gt;Something exists.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;comic=0;strokeColor=#666666;fontSize=8;fillColor=#f5f5f5;gradientColor=#b3b3b3;arcSize=50;treeMoving=1;treeFolding=0;strokeWidth=0.5;fontStyle=0" parent="7oxWtMFBQvJBjM5p-5OE-0" vertex="1" collapsed="1">
          <mxGeometry width="210" height="30" as="geometry" />
        </mxCell>
        <mxCell id="7oxWtMFBQvJBjM5p-5OE-2" value="" style="swimlane;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;gradientColor=#FFD966;swimlaneFillColor=#E6E6E6;connectable=1;allowArrows=0;treeFolding=0;treeMoving=1;expand=0;" parent="7oxWtMFBQvJBjM5p-5OE-0" vertex="1" collapsed="1">
          <mxGeometry y="20" width="210" height="5" as="geometry">
            <mxRectangle y="20" width="50.00000000000001" height="3.333333333333333" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="7oxWtMFBQvJBjM5p-5OE-3" value="&lt;b&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;Observations (non-exhaustive)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&amp;nbsp;- Ouch.&lt;br&gt;&amp;nbsp;- Ah.&lt;br&gt;&amp;nbsp;- Red.&lt;br&gt;&amp;nbsp;- Tasty.&lt;br&gt;&amp;nbsp;- Happy, sad, angry, satisfaction.&lt;br&gt;&amp;nbsp;- Words, thoughts, meaning, understanding.&lt;br&gt;&amp;nbsp;- Me, you, this, that.&lt;br&gt;&amp;nbsp;- You are currently reading and thinking about these words.&lt;br&gt;&amp;nbsp;- You have memories of what you did earlier today.&lt;br&gt;&amp;nbsp;- You perceive things through your senses, emotions, and intellect (the light from the screen, the thoughts that form that awareness, etc.).&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;The Inference (and why)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&amp;nbsp;- &lt;i&gt;Something exists.&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- This is the ultimate self-evident truth: its truth is demonstrated by the very act of questioning it.&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- Reality can now be defined as &quot;the set of all things&quot;.&lt;br&gt;&amp;nbsp;- You can&#39;t have thoughts without a thinker, doubts without a doubter, or observations without an observer. It is the necessary starting point for all knowledge.&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- As such, there can&#39;t be &quot;nothing&quot; on a fundamental level, as any single &quot;thing&quot; is the counterexample to show otherwise.&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- Any attempt to validate the denial of existence as a whole means that *something* is doing the denying.&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;What Happens When Not Inferred&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&amp;nbsp;- The pursuit of knowledge (and, by extension, distinguishing between truth and falsehood) becomes impossible.&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- If you don&#39;t accept that anything exists, then there is nothing for a statement to be true (or false) about.&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- The entire concepts of knowledge, logic, and inquiry become meaningless because there is no subject matter to inquire about, all these sentences you&#39;ve been reading themselves have no meaning, and there is not even a you to understand a thing to begin with." style="text;html=1;strokeColor=default;fillColor=#E6E6E6;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=7;treeFolding=0;expand=1;spacingLeft=0;" parent="7oxWtMFBQvJBjM5p-5OE-2" vertex="1">
          <mxGeometry y="15" width="490" height="230" as="geometry" />
        </mxCell>
        <mxCell id="IeQf6rbAiGyA5MmECNZY-0" value="" style="group" parent="E9NDm9MUUsob3Jb-81NS-1" vertex="1" connectable="0">
          <mxGeometry x="320" y="200" width="210" height="30" as="geometry" />
        </mxCell>
        <mxCell id="IeQf6rbAiGyA5MmECNZY-1" value="&lt;font style=&quot;font-size: 10px;&quot;&gt;Things are defined (or known) by their consistent properties.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;comic=0;strokeColor=#666666;fontSize=8;fillColor=#f5f5f5;gradientColor=#b3b3b3;arcSize=50;treeMoving=1;treeFolding=0;strokeWidth=0.5;fontStyle=0" parent="IeQf6rbAiGyA5MmECNZY-0" vertex="1" collapsed="1">
          <mxGeometry width="210" height="30" as="geometry" />
        </mxCell>
        <mxCell id="IeQf6rbAiGyA5MmECNZY-2" value="" style="swimlane;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;gradientColor=#FFD966;swimlaneFillColor=#E6E6E6;connectable=1;allowArrows=0;treeFolding=0;treeMoving=1;expand=0;" parent="IeQf6rbAiGyA5MmECNZY-0" vertex="1" collapsed="1">
          <mxGeometry y="20" width="210" height="5" as="geometry">
            <mxRectangle y="20" width="50.00000000000001" height="3.333333333333333" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="IeQf6rbAiGyA5MmECNZY-3" value="&lt;b&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;Observations (non-exhaustive)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&amp;nbsp;- An apple is a red, spherical fruit with a particular taste.&lt;br&gt;&amp;nbsp;- An orange is an orange, spherical fruit with a particular taste.&lt;br&gt;&amp;nbsp;- A grapefruit is an orange, spherical fruit with a different particular taste.&lt;br&gt;&amp;nbsp;- A rock has hardness and solidness. If the rock loses hardness and solidness, it is no longer defined as a rock.&lt;br&gt;&amp;nbsp;- A triangle has 3 straight sides.&lt;br&gt;&amp;nbsp;- Water is H2O and boils at 100°C. If it doesn&#39;t boil at 100°C, then it is not pure H2O.&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;The Inference (and why)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&amp;nbsp;- &lt;i&gt;Things are defined by their consistent properties.&lt;/i&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- We observe that for anything to be what it is, it must possess a stable nature or a set of core properties.&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- If a property about a thing changes, then:&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- The definition changes into a different thing (like a rock: rocks are consistently solid, and so if it becomes hotter and turns into a liquid, it&#39;s no longer considered a &quot;rock&quot; and now becomes &quot;magma&quot;).&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- The variability itself is a consistent property of the thing (like the hardness of a rock, as rocks can differ in how hard and soft they are - as long as they are solid).&lt;br&gt;&amp;nbsp;- Objects are knowable because they have stable, consistent identities.&lt;br&gt;&amp;nbsp;- As such, we now have a basis for primitive terms such as &quot;fundamental&quot; and &quot;superficial&quot;:&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- Fundamental properties refer to a thing&#39;s consistent properties, where its negation makes it not-the-thing (ex. rocks are solid, rocks have color, etc.).&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- Superficial properties refer to a thing&#39;s inconsistent properties, where its negation does not make it not-the-thing (ex. rocks can be strong or brittle, rocks can be black or red, etc.).&lt;div&gt;&amp;nbsp;- We can also now understand comprehensibility and rationality:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- Comprehensibility is the ability to accurately visualize, represent, or imagine observations in the mind.&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- Rationality is the ability to identify/define a concept based on the comprehensible association of known observations.&lt;/div&gt;&lt;div&gt;&amp;nbsp;- As such, we can now distinguish between the various combinations of the two:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- Comprehensible &amp;amp; Rational: consistency between what is imagined and known observations (ex. a rock, 2+2=4, the mitochondria is the powerhouse of the cell)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- Comprehensible &amp;amp; Irrational: inconsistency between what is imagined and known observations (ex. a pink elephant, flying pig, talking door, any fiction story)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- Incomprehensible &amp;amp; Rational: inability to imagine known observations (ex. infinity, a color outside the visible spectrum, trying to remember before you were born)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- Incomprehensible &amp;amp; Irrational: inability to imagine unknown observations (ex. a square circle, a married bachelor,&amp;nbsp;&lt;i&gt;P&lt;/i&gt; and &lt;i&gt;not P&lt;/i&gt;, neither &lt;i&gt;P&lt;/i&gt; nor &lt;i&gt;not P&lt;/i&gt;)&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;What Happens When Not Inferred&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&amp;nbsp;- Knowledge becomes impossible.&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- If things do not have a stable and consistent nature, then nothing can be reliably known - nothing for us to point to and learn more about.&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- Scientific laws would be meaningless (with never-ending counterexamples), language would be useless (with the meaning of words always changing), and reality would be an incomprehensible chaos where a cat could become a dog for no reason.&lt;/div&gt;" style="text;html=1;strokeColor=default;fillColor=#E6E6E6;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=7;treeFolding=0;expand=1;spacingLeft=0;" parent="IeQf6rbAiGyA5MmECNZY-2" vertex="1">
          <mxGeometry y="15" width="520" height="310" as="geometry" />
        </mxCell>
        <mxCell id="IeQf6rbAiGyA5MmECNZY-4" value="" style="group" parent="E9NDm9MUUsob3Jb-81NS-1" vertex="1" connectable="0">
          <mxGeometry x="560" y="200" width="210" height="30" as="geometry" />
        </mxCell>
        <mxCell id="IeQf6rbAiGyA5MmECNZY-5" value="&lt;font style=&quot;font-size: 10px;&quot;&gt;Things are identified (or known) by distinguishing their properties from others.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;comic=0;strokeColor=#666666;fontSize=8;fillColor=#f5f5f5;gradientColor=#b3b3b3;arcSize=50;treeMoving=1;treeFolding=0;strokeWidth=0.5;fontStyle=0" parent="IeQf6rbAiGyA5MmECNZY-4" vertex="1" collapsed="1">
          <mxGeometry width="210" height="30" as="geometry" />
        </mxCell>
        <mxCell id="IeQf6rbAiGyA5MmECNZY-6" value="" style="swimlane;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;gradientColor=#FFD966;swimlaneFillColor=#E6E6E6;connectable=1;allowArrows=0;treeFolding=0;treeMoving=1;expand=0;" parent="IeQf6rbAiGyA5MmECNZY-4" vertex="1" collapsed="1">
          <mxGeometry y="20" width="210" height="5" as="geometry">
            <mxRectangle y="20" width="50.00000000000001" height="3.333333333333333" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="IeQf6rbAiGyA5MmECNZY-7" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;Observations (non-exhaustive)&lt;/font&gt;&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;- A fruit is not a rock.&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;- A true statement is not a false statement.&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;- A man is not a woman.&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;- Pain is not pleasure.&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b&gt;The Inference&lt;/b&gt;&lt;/span&gt;&lt;b style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;&amp;nbsp;(and why)&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&lt;i&gt;Things are identified (or known) by distinguishing their properties from others.&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;font&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;The act of knowing what something is requires knowing what it is not (ie. a frame of reference).&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;Identification is an act of separation and distinction: we draw a conceptual line around a thing, separating it from everything else.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- That is what a &quot;contradiction&quot; is: when the distinguishing property between two objects is also shared by them (ex. triangles and squares are distinguished by the number of sides they have, and so it would be a contradiction to define a shape with both properties of 3 sides &lt;b&gt;and&lt;/b&gt;&amp;nbsp;4 sides).&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- This is the basis for &quot;The Principle of Non-Contradiction&quot;, as there cannot be a true statement that has the same properties as a false statement (or vice versa).&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b&gt;What Happens When Not Inferred&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;Proper r&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;easoning becomes impossible, and contradictions no longer become problematic.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;All distinctions would collapse into meaninglessness: &quot;true&quot; could simultaneously mean &quot;false,&quot; &quot;yes&quot; could mean &quot;no,&quot; and a thing could be both a rock and not a rock at the same time.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;You would not be capable of forming a single coherent sentence or thought.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;strokeColor=default;fillColor=#E6E6E6;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=4;treeFolding=0;expand=1;spacingLeft=0;" parent="IeQf6rbAiGyA5MmECNZY-6" vertex="1">
          <mxGeometry y="15" width="415" height="200" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
