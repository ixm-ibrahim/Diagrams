        <mxCell id="rhcqr-XzwB1Ql8kuJBcr-31" value="&lt;span style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;Three significant events: Jesus&#39; 3-year earthly ministry, 40 days of Jesus&#39; resurrection, and the post-resurrection vision that appeared to Paul.&lt;/span&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=middle;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=0;align=left;strokeWidth=0;" vertex="1" parent="rhcqr-XzwB1Ql8kuJBcr-29">
          <mxGeometry width="260" height="35" as="geometry">
            <mxRectangle width="260" height="35" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="rhcqr-XzwB1Ql8kuJBcr-32" value="&lt;span style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;Two significant events: the Quran&#39;s revelation to the Prophet Muhammad over 23 years, and his character, personality, and ministry in that time period.&lt;/span&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CBE2FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=middle;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=0;align=left;strokeWidth=0;" vertex="1" parent="rhcqr-XzwB1Ql8kuJBcr-29">
          <mxGeometry x="260" width="260" height="35" as="geometry">
            <mxRectangle width="260" height="35" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="rhcqr-XzwB1Ql8kuJBcr-33" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" vertex="1" parent="rhcqr-XzwB1Ql8kuJBcr-28">
          <mxGeometry y="35" width="520" height="30" as="geometry" />
        </mxCell>
        <mxCell id="rhcqr-XzwB1Ql8kuJBcr-35" value="&lt;span style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- 1st century context preserved c&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;ore concepts without necessary verbatim transmission.&lt;/span&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=middle;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=0;align=left;strokeWidth=0;" vertex="1" parent="rhcqr-XzwB1Ql8kuJBcr-33">
          <mxGeometry width="260" height="30" as="geometry">
            <mxRectangle width="260" height="30" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="rhcqr-XzwB1Ql8kuJBcr-36" value="&lt;span style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- 7th century context preserved v&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;erbatim with the Quran, semi-verbatim preservation with the Prophet&#39;s life and character.&lt;/span&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CBE2FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=middle;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=0;align=left;strokeWidth=0;" vertex="1" parent="rhcqr-XzwB1Ql8kuJBcr-33">
          <mxGeometry x="260" width="260" height="30" as="geometry">
            <mxRectangle width="260" height="30" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="rhcqr-XzwB1Ql8kuJBcr-37" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" vertex="1" parent="rhcqr-XzwB1Ql8kuJBcr-28">
          <mxGeometry y="65" width="520" height="40" as="geometry" />
        </mxCell>
        <mxCell id="rhcqr-XzwB1Ql8kuJBcr-39" value="&lt;span style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;The Gospels and Epistles were written by multiple authors (not Jesus) sometime 10-70 years after Jesus&#39; ministry, while the canon was standardized in 382 AD by the Council of Rome.&lt;/span&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=middle;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=0;align=left;strokeWidth=0;" vertex="1" parent="rhcqr-XzwB1Ql8kuJBcr-37">
          <mxGeometry width="260" height="40" as="geometry">
            <mxRectangle width="260" height="40" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="rhcqr-XzwB1Ql8kuJBcr-40" value="&lt;span style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;Three significant events: the writing and ordering of the Quran during the Prophet Muhammad&#39;s life, the first complete written Quran being codified 2 years after his death, and the written standardization of the dialect/accent 20 years after his death.&lt;/span&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CBE2FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=middle;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=0;align=left;strokeWidth=0;" vertex="1" parent="rhcqr-XzwB1Ql8kuJBcr-37">
          <mxGeometry x="260" width="260" height="40" as="geometry">
            <mxRectangle width="260" height="40" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="rhcqr-XzwB1Ql8kuJBcr-41" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" vertex="1" parent="rhcqr-XzwB1Ql8kuJBcr-28">
          <mxGeometry y="105" width="520" height="30" as="geometry" />
        </mxCell>
        <mxCell id="rhcqr-XzwB1Ql8kuJBcr-43" value="&lt;span style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- Archaeology shows s&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;trong historical and cultural corroboration, with earliest manuscripts of the New Testament dating to 125 AD.&lt;/span&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=middle;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=0;align=left;strokeWidth=0;" vertex="1" parent="rhcqr-XzwB1Ql8kuJBcr-41">
          <mxGeometry width="260" height="30" as="geometry">
            <mxRectangle width="260" height="30" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="rhcqr-XzwB1Ql8kuJBcr-44" value="&lt;span style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- Archaeology shows o&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;verwhelming historical and cultural corroboration, with the earliest manuscripts dating to the Prophet&#39;s life.&lt;/span&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CBE2FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=middle;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=0;align=left;strokeWidth=0;" vertex="1" parent="rhcqr-XzwB1Ql8kuJBcr-41">
          <mxGeometry x="260" width="260" height="30" as="geometry">
            <mxRectangle width="260" height="30" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <UserObject label="&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 10px; font-weight: bold;&quot;&gt;2.&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;&lt;b&gt;Oral, Written, and Archaeological Presence&lt;/b&gt;&lt;/span&gt;" link="data:page/id,UnD5iH2WOAX1UBhe1G6C" id="rhcqr-XzwB1Ql8kuJBcr-150">
