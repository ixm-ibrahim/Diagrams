          </mxGeometry>
        </mxCell>
        <mxCell id="XmoEW__EEp50cMUPfqny-36" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" vertex="1" parent="XmoEW__EEp50cMUPfqny-23">
          <mxGeometry y="80" width="520" height="40" as="geometry" />
        </mxCell>
        <mxCell id="XmoEW__EEp50cMUPfqny-37" value="&lt;div&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;Gospel custodianship, defending claims, and fabrication/error claims all fundamentally rely on speculation.&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=middle;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=0;align=left;strokeWidth=0;" vertex="1" parent="XmoEW__EEp50cMUPfqny-36">
