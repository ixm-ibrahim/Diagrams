        <mxCell id="UaIa3pECy3QJddEg9h5O-65" parent="UaIa3pECy3QJddEg9h5O-63" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=middle;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;swimlaneFillColor=none;gradientColor=none;gradientDirection=east;align=left;" value="&lt;div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;&amp;nbsp;&lt;b&gt;=&amp;nbsp;God&#39;s justice&lt;/b&gt; (crediting both righteousness and sin from the start)&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;&amp;nbsp;&lt;b&gt;=&amp;nbsp;God&#39;s grace&lt;/b&gt; (manifesting within the law rather than beyond it)&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
