        </mxCell>
        <mxCell id="k2k2wWd_USnzYlMqRSar-32" value="&lt;span style=&quot;font-size: 10px;&quot;&gt;Truth is associated with good, while falsehood is associated with evil.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;comic=0;strokeColor=#666666;fontSize=8;fillColor=#f5f5f5;gradientColor=#b3b3b3;arcSize=50;treeMoving=1;treeFolding=0;strokeWidth=0.5;fontStyle=0" parent="k2k2wWd_USnzYlMqRSar-31" vertex="1" collapsed="1">
          <mxGeometry width="195" height="30" as="geometry" />
        </mxCell>
        <mxCell id="k2k2wWd_USnzYlMqRSar-33" value="" style="swimlane;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;gradientColor=#FFD966;swimlaneFillColor=#E6E6E6;connectable=1;allowArrows=0;treeFolding=0;treeMoving=1;expand=0;" parent="k2k2wWd_USnzYlMqRSar-31" vertex="1" collapsed="1">
          <mxGeometry y="20" width="195" height="5" as="geometry">
            <mxRectangle y="20" width="50.00000000000001" height="3.333333333333333" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="k2k2wWd_USnzYlMqRSar-34" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;Observations (non-exhaustive)&lt;/font&gt;&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&quot;Truth is defined by reality, not by feelings or intuition&quot;.&lt;/span&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;Trust, the foundation of all healthy relationships and societies, is built on telling the truth.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;Deception, lies, and fraud are primary tools of harm and exploitation.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;A just verdict in a court of law depends on discovering the truth of what occurred.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;We seek the truth to solve problems, heal illnesses, and build things that work - while falsehood in these areas leads to failure and harm.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b&gt;The Inference (and why)&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&lt;i&gt;Truth is associated with good, while falsehood is associated with evil.&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;font&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;We observe that alignment with reality (truth) leads to functionality, trust, and flourishing, while contradiction with reality (falsehood) leads to dysfunction, decay, and harm.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;This means truth is no longer just &quot;true&quot; but also &quot;good&quot;, while falsehood is not longer just&amp;nbsp; &quot;false&quot; but also &quot;bad&quot;.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b&gt;What Happens When Not Inferred&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;Lies and deception would become morally neutral, just as morally significant as honesty and kindness.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;T&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;here would be no inherent &quot;good&quot; in knowing what is true.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;There would be no ethical foundation to condemn fraud, propaganda, or betrayal.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;strokeColor=default;fillColor=#E6E6E6;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=4;treeFolding=0;expand=1;spacingLeft=0;" parent="k2k2wWd_USnzYlMqRSar-33" vertex="1">
          <mxGeometry y="15" width="390" height="175" as="geometry" />
        </mxCell>
        <mxCell id="YymgHO22iy3FTdxAbw36-0" value="" style="group" parent="E9NDm9MUUsob3Jb-81NS-1" vertex="1" connectable="0">
          <mxGeometry x="65" y="1015" width="195" height="30" as="geometry" />
        </mxCell>
        <mxCell id="YymgHO22iy3FTdxAbw36-1" value="&lt;span style=&quot;font-size: 10px;&quot;&gt;Our perception is susceptible to normalization and adaptation.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;comic=0;strokeColor=#666666;fontSize=8;fillColor=#f5f5f5;gradientColor=#b3b3b3;arcSize=50;treeMoving=1;treeFolding=0;strokeWidth=0.5;fontStyle=0" parent="YymgHO22iy3FTdxAbw36-0" vertex="1" collapsed="1">
          <mxGeometry width="195" height="30" as="geometry" />
        </mxCell>
        <mxCell id="YymgHO22iy3FTdxAbw36-2" value="" style="swimlane;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;gradientColor=#FFD966;swimlaneFillColor=#E6E6E6;connectable=1;allowArrows=0;treeFolding=0;treeMoving=1;expand=0;" parent="YymgHO22iy3FTdxAbw36-0" vertex="1" collapsed="1">
          <mxGeometry y="20" width="195" height="5" as="geometry">
            <mxRectangle y="20" width="50.00000000000001" height="3.333333333333333" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="YymgHO22iy3FTdxAbw36-3" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;Observations (non-exhaustive)&lt;/font&gt;&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&quot;All information comes from a source&quot;.&lt;/span&gt;&lt;/font&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&quot;Perception, memory, and reasoning are imperfect and subject to error&quot;.&lt;/span&gt;&lt;br&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;When you first enter a room with a distinct smell, it&#39;s very noticeable, but after a while, you no longer perceive it.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;A luxury that once felt incredible quickly becomes the new baseline standard.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;We often &quot;take for granted&quot; the most constant aspects of our lives (like our health or loved ones) until there is a sudden change.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b&gt;The Inference (and why)&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&lt;i&gt;Your perception is susceptible to normalization and adaptation.&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;font&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;We observe that our minds create a &quot;baseline&quot; of what is normal based on consistent experience. This baseline filters our awareness, making constant things less noticeable and novel things more prominent.&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;This is a vital cognitive shortcut that allows us to focus our attention on changes in our environment, but it can also blind us to pursuing and verifying the truth of our beliefs.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- This means that we naturally get accustomed to areas of knowledge, while areas of ignorance triggers more of our awareness.&lt;/span&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b&gt;What Happens When Not Inferred&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;We wouldn&#39;t ever get the feeling of &quot;getting used to&quot; things, and we would be immune to confirmation bias.&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;The human ability to adapt to both wonderful and terrible long-term conditions would be a complete mystery.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;Every single sensation would be a constant, overwhelming distraction, making it impossible to focus on what is new or important.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;strokeColor=default;fillColor=#E6E6E6;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=4;treeFolding=0;expand=1;spacingLeft=0;" parent="YymgHO22iy3FTdxAbw36-2" vertex="1">
          <mxGeometry y="15" width="410" height="180" as="geometry" />
        </mxCell>
        <mxCell id="TTAEdrooEgT8bfmt33tf-0" value="" style="group" parent="E9NDm9MUUsob3Jb-81NS-1" vertex="1" connectable="0">
          <mxGeometry x="590" y="1015" width="195" height="30" as="geometry" />
        </mxCell>
        <mxCell id="TTAEdrooEgT8bfmt33tf-1" value="&lt;span style=&quot;font-size: 10px;&quot;&gt;We fear death, yet we will all die.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;comic=0;strokeColor=#666666;fontSize=8;fillColor=#f5f5f5;gradientColor=#b3b3b3;arcSize=50;treeMoving=1;treeFolding=0;strokeWidth=0.5;fontStyle=0" parent="TTAEdrooEgT8bfmt33tf-0" vertex="1" collapsed="1">
          <mxGeometry width="195" height="30" as="geometry" />
        </mxCell>
        <mxCell id="TTAEdrooEgT8bfmt33tf-2" value="" style="swimlane;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;gradientColor=#FFD966;swimlaneFillColor=#E6E6E6;connectable=1;allowArrows=0;treeFolding=0;treeMoving=1;expand=0;" parent="TTAEdrooEgT8bfmt33tf-0" vertex="1" collapsed="1">
          <mxGeometry y="20" width="195" height="5" as="geometry">
            <mxRectangle y="20" width="50.00000000000001" height="3.333333333333333" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="TTAEdrooEgT8bfmt33tf-3" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;Observations (non-exhaustive)&lt;/font&gt;&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&quot;All information comes from a source&quot;.&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;- &quot;Reality tends to progress from order to disorder&quot;.&lt;/span&gt;&lt;/div&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;All living things you observe eventually die.&amp;nbsp;&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;You&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp;have no reason to believe we are an exception.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;You&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;have a powerful, innate survival instinct and experience fear when your life is threatened.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;You&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;contemplate our own future non-existence with anxiety, a feeling you don&#39;t have about the non-existence that preceded our birth.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;Much of human behavior (religion, the desire for legacy, art, and philosophy) can be interpreted as a way to come to terms with death.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b&gt;The Inference (and why)&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&lt;i&gt;You fear death, yet you will die.&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;font&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;We are beings who consciously understand the inevitability of our own end, and this knowledge creates a fundamental tension with our innate desire to continue existing.&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;This is one of the strongest motivators for exploring questions about meaning, value, and what we do with our limited time.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- If death is our ultimate end, then we seem to desire why we were made alive to begin with.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b&gt;What Happens When Not Inferred&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;Motivation for defining our purpose in life would decrease, and a&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;vast portion of human motivation and culture would be unexplainable.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;The profound emotional weight of grief and the fear of death would have to be dismissed as an irrational, meaningless anomaly.&lt;/span&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;" style="text;html=1;strokeColor=default;fillColor=#E6E6E6;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=4;treeFolding=0;expand=1;spacingLeft=0;" parent="TTAEdrooEgT8bfmt33tf-2" vertex="1">
          <mxGeometry y="15" width="395" height="215" as="geometry" />
        </mxCell>
        <mxCell id="zvqRTCDcasdBtbY2sySJ-85" value="" style="group" parent="E9NDm9MUUsob3Jb-81NS-1" vertex="1" connectable="0">
          <mxGeometry x="65" y="970" width="195" height="30" as="geometry" />
        </mxCell>
        <mxCell id="zvqRTCDcasdBtbY2sySJ-86" value="&lt;span style=&quot;font-size: 10px;&quot;&gt;We have a disposition for having a&lt;br&gt;purpose and feeling wanted.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;comic=0;strokeColor=#666666;fontSize=8;fillColor=#f5f5f5;gradientColor=#b3b3b3;arcSize=50;treeMoving=1;treeFolding=0;strokeWidth=0.5;fontStyle=0" parent="zvqRTCDcasdBtbY2sySJ-85" vertex="1" collapsed="1">
          <mxGeometry width="195" height="30" as="geometry" />
        </mxCell>
        <mxCell id="zvqRTCDcasdBtbY2sySJ-87" value="" style="swimlane;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;gradientColor=#FFD966;swimlaneFillColor=#E6E6E6;connectable=1;allowArrows=0;treeFolding=0;treeMoving=1;expand=0;" parent="zvqRTCDcasdBtbY2sySJ-85" vertex="1" collapsed="1">
          <mxGeometry y="20" width="195" height="5" as="geometry">
            <mxRectangle y="20" width="50.00000000000001" height="3.333333333333333" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="zvqRTCDcasdBtbY2sySJ-88" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;Observations (non-exhaustive)&lt;/font&gt;&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&quot;All information comes from a source&quot;.&lt;/span&gt;&lt;/font&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&quot;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;All things are contingent on their causes&quot;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;.&lt;/span&gt;&lt;/font&gt;&lt;br&gt;&lt;font&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;- &lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;People seek meaning and purpose in their work, family, hobbies, or religion.&lt;/span&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- We feel a sense of inner peace when we think we know how the world works.&lt;/span&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- We naturally feel a sense of an existential crisis when we feel like our lives are meaningless, or have no purpose.&lt;br&gt;&lt;/span&gt;&lt;font&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;We naturally form groups, teams, communities, and nations.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;Prolonged loneliness and social isolation are major sources of human suffering.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;Feeling that you are a valued and needed part of a group is a profound source of psychological well-being.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b&gt;The Inference (and why)&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;font-style: italic; background-color: transparent; font-size: 7px;&quot;&gt;You have a disposition for having a&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-style: italic; background-color: transparent; font-size: 7px;&quot;&gt;purpose and feeling wanted.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;font&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;We observe that humans are not solitary creatures but are deeply driven by the need for meaning and belonging.&lt;br&gt;&amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;This drive for purpose is a fundamental aspect of our conscious experience.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b&gt;What Happens When Not Inferred&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;We would not feel empty if we fail to find meaning or purpose in our lives.&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;The deep psychological pain caused by loneliness and meaninglessness would be a bizarre and nonsensical phenomenon.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;The entire structure of human society, which is built on community and shared purpose, would be unexplainable.&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;It would be a mystery why people form families, communities, and nations.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;strokeColor=default;fillColor=#E6E6E6;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=4;treeFolding=0;expand=1;spacingLeft=0;" parent="zvqRTCDcasdBtbY2sySJ-87" vertex="1">
          <mxGeometry y="15" width="370" height="200" as="geometry" />
        </mxCell>
        <mxCell id="k2k2wWd_USnzYlMqRSar-11" value="" style="group" parent="E9NDm9MUUsob3Jb-81NS-1" vertex="1" connectable="0">
          <mxGeometry x="330" y="970" width="195" height="30" as="geometry" />
        </mxCell>
        <mxCell id="k2k2wWd_USnzYlMqRSar-12" value="&lt;span style=&quot;font-size: 10px;&quot;&gt;Morality does not necessarily correlate&lt;br&gt;with our intentions and behavior.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;comic=0;strokeColor=#666666;fontSize=8;fillColor=#f5f5f5;gradientColor=#b3b3b3;arcSize=50;treeMoving=1;treeFolding=0;strokeWidth=0.5;fontStyle=0" parent="k2k2wWd_USnzYlMqRSar-11" vertex="1" collapsed="1">
          <mxGeometry width="195" height="30" as="geometry" />
        </mxCell>
        <mxCell id="k2k2wWd_USnzYlMqRSar-13" value="" style="swimlane;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;gradientColor=#FFD966;swimlaneFillColor=#E6E6E6;connectable=1;allowArrows=0;treeFolding=0;treeMoving=1;expand=0;" parent="k2k2wWd_USnzYlMqRSar-11" vertex="1" collapsed="1">
          <mxGeometry y="20" width="195" height="5" as="geometry">
            <mxRectangle y="20" width="50.00000000000001" height="3.333333333333333" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="k2k2wWd_USnzYlMqRSar-14" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;Observations (non-exhaustive)&lt;/font&gt;&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&quot;All information comes from a source&quot;.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;- &quot;We have the capacity to make choices, based on our knowledge and desires&quot;.&lt;/span&gt;&lt;br&gt;&lt;/span&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&quot;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;Our actions are a sign of our moral values&quot;.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;An action performed with good intentions can have disastrous consequences (like accidentally giving a sick person the wrong medicine, thinking it&#39;s the right one).&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;A person can do the &quot;right thing&quot; for the &quot;wrong reason&quot; (like donating to charity for public praise, not out of generosity).&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;We often know what the right thing to do is, but fail to do it due to weakness or temptation.&lt;br&gt;&amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;It is possible to feel deep regret for an action even if the outcome was positive.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b&gt;The Inference (and why)&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&lt;i&gt;Morality does not necessarily correlate with our intentions and behavior.&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;font&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;We observe that we can choose to be or not to be moral.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b&gt;What Happens When Not Inferred&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;Moral evaluation would become hypersimplistic.&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;Concepts like negligence, hypocrisy, and tragic moral luck would be incomprehensible.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;One would have to adopt either a pure consequentialism (only outcomes matter) or a pure intentionalism (only motives matter), both of which fail to capture our full moral experience.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;strokeColor=default;fillColor=#E6E6E6;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=4;treeFolding=0;expand=1;spacingLeft=0;" parent="k2k2wWd_USnzYlMqRSar-13" vertex="1">
          <mxGeometry y="15" width="380" height="180" as="geometry" />
        </mxCell>
        <mxCell id="YymgHO22iy3FTdxAbw36-4" value="" style="group" parent="E9NDm9MUUsob3Jb-81NS-1" vertex="1" connectable="0">
          <mxGeometry x="590" y="970" width="195" height="30" as="geometry" />
        </mxCell>
        <mxCell id="YymgHO22iy3FTdxAbw36-5" value="&lt;span style=&quot;font-size: 10px;&quot;&gt;Reality could have been different.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;comic=0;strokeColor=#666666;fontSize=8;fillColor=#f5f5f5;gradientColor=#b3b3b3;arcSize=50;treeMoving=1;treeFolding=0;strokeWidth=0.5;fontStyle=0" parent="YymgHO22iy3FTdxAbw36-4" vertex="1" collapsed="1">
          <mxGeometry width="195" height="30" as="geometry" />
        </mxCell>
        <mxCell id="YymgHO22iy3FTdxAbw36-6" value="" style="swimlane;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;gradientColor=#FFD966;swimlaneFillColor=#E6E6E6;connectable=1;allowArrows=0;treeFolding=0;treeMoving=1;expand=0;" parent="YymgHO22iy3FTdxAbw36-4" vertex="1" collapsed="1">
          <mxGeometry y="20" width="195" height="5" as="geometry">
            <mxRectangle y="20" width="50.00000000000001" height="3.333333333333333" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="YymgHO22iy3FTdxAbw36-7" value="&lt;b&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;Observations (non-exhaustive)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&amp;nbsp;- &quot;All information comes from a source&quot;.&lt;br&gt;&amp;nbsp;- &quot;Speculation is not refutation&quot;.&lt;br&gt;&amp;nbsp;- &quot;All things are contingent on their causes&quot;.&lt;br&gt;&amp;nbsp;- You can conceive of and model (based on already-established inferred rules) alternative outcomes based on different starting conditions.&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- You can imagine how history would have unfolded differently if a single key event had changed.&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- If the asteroid that caused the extinction of the dinosaurs had missed, the entire evolutionary path of life on Earth would be unimaginably different.&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- The fundamental constants of physics appear finely-tuned; if they were even slightly different, the universe as we know it could not exist.&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Moreover, any other simulated tuning reveals that fundamental things (such as matter and light) would not exist, let alone life - which requires even more fine tuning within that scope of fine tuning.&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Your own existence is the result of an incredibly specific and improbable chain of events; the slightest alteration anywhere along that chain, and you would not be here.&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;The Inference (and why)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&amp;nbsp;- Reality could have been different.&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- We observe that the specific state of our reality - from the laws of physics to the details of our own lives - is the result of a long chain of tuned, contingent events.&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- The universe is unique in that, while everything else must be contingent on another contingent thing, the universe itself must be contingent on something that is non-contingent itself.&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- The introduction of atemporality allows for alternative tunings to be considered, as our inability to comprehend lack of contingency means there&#39;s no &quot;reason&quot; why the universe must be tuned one way or another.&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- If history had occurred differently, reality would look different and would now be contingent on that change.&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Even if current events are the result of a deterministic chain going back to the start of the universe, then &quot;reality could have been different&quot; is still reduced to &quot;reality could have had different initial starting conditions&quot;.&lt;br&gt;&amp;nbsp;- This allows us to attach significance to an event based on probabilistic and statistical concepts.&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;What Happens When Not Inferred&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&amp;nbsp;- Concepts such as necessity, possibility, and statistics would be meaningless.&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- Low probability events would be equally significant as high-probability events.&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- Speculation (without data) would be equally significant as improbability.&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- You would fail to grasp the extraordinary improbability of your own life.&lt;br&gt;&amp;nbsp;- The basis for wonder and awe about existence would be lost." style="text;html=1;strokeColor=default;fillColor=#E6E6E6;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=7;treeFolding=0;expand=1;spacingLeft=0;" parent="YymgHO22iy3FTdxAbw36-6" vertex="1">
          <mxGeometry y="15" width="475" height="290" as="geometry" />
        </mxCell>
        <mxCell id="k2k2wWd_USnzYlMqRSar-36" value="" style="group" parent="E9NDm9MUUsob3Jb-81NS-1" vertex="1" connectable="0">
          <mxGeometry x="590" y="925" width="195" height="30" as="geometry" />
        </mxCell>
        <mxCell id="k2k2wWd_USnzYlMqRSar-37" value="&lt;span style=&quot;font-size: 10px;&quot;&gt;Falsehood is easier and more common, while good is harder and more valued.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;comic=0;strokeColor=#666666;fontSize=8;fillColor=#f5f5f5;gradientColor=#b3b3b3;arcSize=50;treeMoving=1;treeFolding=0;strokeWidth=0.5;fontStyle=0" parent="k2k2wWd_USnzYlMqRSar-36" vertex="1" collapsed="1">
          <mxGeometry width="195" height="30" as="geometry" />
        </mxCell>
        <mxCell id="k2k2wWd_USnzYlMqRSar-38" value="" style="swimlane;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;gradientColor=#FFD966;swimlaneFillColor=#E6E6E6;connectable=1;allowArrows=0;treeFolding=0;treeMoving=1;expand=0;" parent="k2k2wWd_USnzYlMqRSar-36" vertex="1" collapsed="1">
          <mxGeometry y="20" width="195" height="5" as="geometry">
            <mxRectangle y="20" width="50.00000000000001" height="3.333333333333333" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="k2k2wWd_USnzYlMqRSar-39" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;Observations (non-exhaustive)&lt;/font&gt;&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&quot;All information comes from a source&quot;.&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;- &quot;Reality tends to progress from order to disorder&quot;.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;- &quot;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;Reality is a mixture of pleasure &amp;amp; pain,&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 7px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;as well as good &amp;amp; evil&quot;.&lt;/span&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;It is easier to tell a lie than to do the work of finding the truth.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;It is easier to neglect a relationship than to maintain it.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;It takes a great deal of communal effort to build a safe and just society, but it can be destroyed by the corruption and apathy of a single person.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;We praise virtues like courage, discipline, and honesty precisely because they are difficult and require effort to maintain.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b&gt;The Inference (and why)&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&lt;i&gt;Falsehood is easier and more common, while good is harder and more valued.&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;font&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;We observe that creating and maintaining order, truth, and goodness requires a constant input of energy and intention against a natural slide into disorder, falsehood, and decay.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;This means that &quot;good&quot; can be interpreted as more valuable than &quot;falsehood&quot;, as its difficulty makes it more meaningful..&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b&gt;What Happens When Not Inferred&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;It would be equally easy to perform a good deed vs. a bad one, and the concept of virtue would be meaningless..&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;We would have no reason to admire or strive for qualities like integrity or diligence.&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" style="text;html=1;strokeColor=default;fillColor=#E6E6E6;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=4;treeFolding=0;expand=1;spacingLeft=0;" parent="k2k2wWd_USnzYlMqRSar-38" vertex="1">
          <mxGeometry y="15" width="390" height="180" as="geometry" />
        </mxCell>
        <mxCell id="zvqRTCDcasdBtbY2sySJ-82" value="" style="group" parent="E9NDm9MUUsob3Jb-81NS-1" vertex="1" connectable="0">
          <mxGeometry x="65" y="925" width="195" height="30" as="geometry" />
        </mxCell>
        <mxCell id="zvqRTCDcasdBtbY2sySJ-79" value="&lt;span style=&quot;font-size: 10px;&quot;&gt;Information is explicitly and implicitly communicated with language.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;comic=0;strokeColor=#666666;fontSize=8;fillColor=#f5f5f5;gradientColor=#b3b3b3;arcSize=50;treeMoving=1;treeFolding=0;strokeWidth=0.5;fontStyle=0" parent="zvqRTCDcasdBtbY2sySJ-82" vertex="1" collapsed="1">
          <mxGeometry width="195" height="30" as="geometry" />
        </mxCell>
        <mxCell id="zvqRTCDcasdBtbY2sySJ-80" value="" style="swimlane;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;gradientColor=#FFD966;swimlaneFillColor=#E6E6E6;connectable=1;allowArrows=0;treeFolding=0;treeMoving=1;expand=0;" parent="zvqRTCDcasdBtbY2sySJ-82" vertex="1" collapsed="1">
          <mxGeometry y="20" width="195" height="5" as="geometry">
            <mxRectangle y="20" width="50.00000000000001" height="3.333333333333333" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="zvqRTCDcasdBtbY2sySJ-81" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;Observations (non-exhaustive)&lt;/font&gt;&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&quot;All information comes from a source&quot;.&lt;/span&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&quot;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;We are capable of intelligence, to form abstractions from observations&quot;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;A sentence in a book explicitly communicates a specific idea.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;The tone of voice, facial expression, and body language implicitly communicates emotional states&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;A story can implicitly communicate a moral lesson without ever stating it directly.&lt;br&gt;&amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;Body language can implicitly contradict what a person is saying explicitly.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b&gt;The Inference (and why)&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&lt;i&gt;Information is explicitly and implicitly communicated with language.&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;font&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;We observe that language operates on multiple levels, conveying both direct data and subtle context.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;This richness of communication is what allows for the formation of culture, deep relationships, and complex societies.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px; color: rgb(0, 0, 0);&quot;&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;b&gt;What Happens When Not Inferred&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;You would be unable to comprehend writing, poetry, sarcasm, emotional subtext, or any form of non-literal communication&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- .&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 7px;&quot;&gt;You would be &quot;literal-minded,&quot; unable to understand sarcasm, metaphors, emotional subtext, poetry, or any form of non-literal meaning.&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- Communication would be reduced to a flat, robotic transfer of data.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;strokeColor=default;fillColor=#E6E6E6;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=4;treeFolding=0;expand=1;spacingLeft=0;" parent="zvqRTCDcasdBtbY2sySJ-80" vertex="1">
          <mxGeometry y="15" width="375" height="185" as="geometry" />
        </mxCell>
        <mxCell id="jaU37FtTESFEtsjytWu3-4" style="edgeStyle=elbowEdgeStyle;shape=connector;rounded=1;jumpSize=6;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;entryX=0.5;entryY=1;entryDx=0;entryDy=0;strokeColor=default;strokeWidth=1.5;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;endSize=3;" parent="zvqRTCDcasdBtbY2sySJ-80" source="zvqRTCDcasdBtbY2sySJ-81" target="zvqRTCDcasdBtbY2sySJ-81" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
