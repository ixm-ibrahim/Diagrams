        <mxCell id="DHazi4g6tnZFVyByypoz-31" parent="DHazi4g6tnZFVyByypoz-30" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=middle;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;swimlaneFillColor=none;gradientColor=none;gradientDirection=east;align=left;" value="&lt;span style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;b style=&quot;font-size: 8px;&quot;&gt;Messenger spoke Aramaic&lt;/b&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;(as the language of his people),&amp;nbsp;&lt;/span&gt;&lt;b style=&quot;font-size: 8px;&quot;&gt;Hebrew&lt;/b&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;(for Jewish liturgy), and&amp;nbsp;&lt;/span&gt;&lt;b style=&quot;font-size: 8px;&quot;&gt;possibly Koine Greek&lt;/b&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;(for interaction with the Romans)&lt;/span&gt;" vertex="1">
