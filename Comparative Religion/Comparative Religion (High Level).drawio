  </diagram>
  <diagram name="6. Historical Comparison (5/10)" id="Gh7CGhRKrvzv2LP0f_I5">
    <mxGraphModel dx="1242" dy="-3572" grid="1" gridSize="5" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" background="#CCCCCC" math="0" shadow="0" adaptiveColors="none">
      <root>
        <mxCell id="i-ldhcgxSOpe3z3huQwf-0" />
        <mxCell id="i-ldhcgxSOpe3z3huQwf-1" parent="i-ldhcgxSOpe3z3huQwf-0" />
        <UserObject label="Historicity&amp;nbsp;Comparison: Bible vs. Quran (5/10)" link="data:page/id,lkuSvPZcJC7dHRsydWrw" id="i-ldhcgxSOpe3z3huQwf-25">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#E6E6E6;fontSize=20;" vertex="1" parent="i-ldhcgxSOpe3z3huQwf-1">
            <mxGeometry x="20" y="4425" width="810" height="50" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="i-ldhcgxSOpe3z3huQwf-147" value="" style="group" vertex="1" connectable="0" parent="i-ldhcgxSOpe3z3huQwf-1">
          <mxGeometry x="20" y="4490" width="810.0000000000001" height="1000" as="geometry" />
        </mxCell>
        <mxCell id="i-ldhcgxSOpe3z3huQwf-148" value="" style="shape=table;startSize=0;container=1;collapsible=0;childLayout=tableLayout;fontSize=1;spacingRight=0;" vertex="1" parent="i-ldhcgxSOpe3z3huQwf-147">
          <mxGeometry y="45" width="810" height="955" as="geometry" />
        </mxCell>
        <mxCell id="i-ldhcgxSOpe3z3huQwf-149" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" vertex="1" parent="i-ldhcgxSOpe3z3huQwf-148">
          <mxGeometry width="810" height="500" as="geometry" />
        </mxCell>
        <mxCell id="i-ldhcgxSOpe3z3huQwf-150" value="&lt;font size=&quot;1&quot;&gt;&lt;b&gt;How strongly does the claim&#39;s custodianship resist fabrication and error?&lt;/b&gt;&lt;br&gt;(Observed Patterns)&lt;/font&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#D5D5D5;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;gradientColor=none;spacingRight=2;spacingLeft=2;" vertex="1" parent="i-ldhcgxSOpe3z3huQwf-149">
          <mxGeometry width="180" height="500" as="geometry">
            <mxRectangle width="180" height="500" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i-ldhcgxSOpe3z3huQwf-151" value="&lt;div style=&quot;text-align: left;&quot;&gt;&lt;b style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); background-color: transparent; font-size: 8px;&quot;&gt;&amp;nbsp;- All chains to the earthly Jesus depend on unknown transmission or lost works.&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- The earthly Jesus never wrote anything himself.&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; text-align: center; font-size: 8px;&quot;&gt;Mark depends on Papias&#39; lost work, an unnamed &quot;Elder&quot;, and unknown oral transmission from Irenaeus.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; text-align: center; font-size: 8px;&quot;&gt;Matthew depends on Papias, unknown oral tradition, and the lost Q/Logia source.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- Luke depends on unknown oral transmission and unknown eyewitness accounts.&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; text-align: center; font-size: 8px;&quot;&gt;John depends solely on the oral testimony of one witness and was not written by that witness.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- Paul never met the earthly Jesus.&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- All&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; text-align: center; font-size: 8px;&quot;&gt;Jewish Christian writings are lost, surviving only through hostile authors.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; text-align: center; font-size: 8px;&quot;&gt;Ebionite chains depend on lost works, unknown transmitters, and hostile sources.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; text-align: center; font-size: 8px;&quot;&gt;Gnostic chains rely on secret, hidden, and unknown lines of transmission.&lt;/span&gt;&lt;/div&gt;&lt;span style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;b&gt;&amp;nbsp;- All Gospels portray Jesus as someone with divine authority.&lt;/b&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- Mark: Jesus forgives sins, has power over nature, and expels evil spirits.&lt;/span&gt;&lt;/div&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- Matthew: Jesus has all authority in heaven and earth.&lt;/span&gt;&lt;/div&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- Luke: Jesus is the Lord of the Sabbath and accepted worship.&lt;/span&gt;&lt;/div&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- John: Jesus is explicitly divine and pre-existent&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;.&lt;/span&gt;&lt;/div&gt;&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;b&gt;&amp;nbsp;-&amp;nbsp;&lt;/b&gt;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; text-align: center; font-size: 8px;&quot;&gt;&lt;b&gt;Gospels agree on core historical events but differ in details.&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- The Gospels&#39; testimonies could be used in court, as they all corroborate the theologically significant events, such as:&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; text-align: center; font-size: 8px;&quot;&gt;Crucifixion timing differs, but crucifixion is unanimous.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; text-align: center; font-size: 8px;&quot;&gt;Cross inscription wording differs, but &quot;King of the Jews&quot; is unanimous.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- First witnesses to the empty tomb differ, as well as who they saw there and what they said, but witnesses to an empty tomb is unanimous.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;b&gt;&amp;nbsp;- The stronger the chain, the higher the Christology.&lt;/b&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- Synoptic stream: lower Christology than John and Paul, and rely on unknown transmission and lost works.&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- John: highest Gospel Christology, and a single unwritten oral source.&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- Paul: clearest and strongest Christology, with the strongest transmission chain.&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;span style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;b&gt;&amp;nbsp;- The later the Gospel, the higher the Christology.&lt;/b&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;span style=&quot;font-size: 8px; text-align: left;&quot;&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- Reconstruction of Q/Logia: lowest Christology; omitting the death and resurrection of Jesus as the primary means of salvation.&lt;/span&gt;&lt;/div&gt;&lt;/span&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; text-align: center; font-size: 8px;&quot;&gt;Mark: low Christology; no virgin birth, no pre-existence, and is the only one to identify Jesus as the &quot;son of Mary&quot;.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- Matthew: medium-low Christology; mentions his virgin birth and identifies him as Emmanuel (&quot;God is with us&quot;) as the fulfilment of Old Testament prophecies.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- Luke: medium-high Christology; identifies Jesus as the universal Savior (not just for Jews) and as someone who can forgive sins - a prerogative of God&#39;s alone.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- John: highest Christology; explicitly identifying Jesus as divine and pre-existing from the beginning of the text.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- While a minority, textual variants in the preserved manuscripts affect the Christological rating of their passages.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;span style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;b&gt;&amp;nbsp;- Paul&#39;s authority primarily rests on his vision.&lt;/b&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;b&gt;&lt;/b&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; text-align: center; font-size: 8px;&quot;&gt;Paul states he did not learn his gospel from any man, but received it through a direct, private revelation of the risen Jesus. His verification by the&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px; text-align: center; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;leaders of the Jerusalem Church was also done in private.&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=top;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;" vertex="1" parent="i-ldhcgxSOpe3z3huQwf-149">
          <mxGeometry x="180" width="315" height="500" as="geometry">
            <mxRectangle width="315" height="500" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i-ldhcgxSOpe3z3huQwf-152" value="&lt;div style=&quot;&quot;&gt;&lt;b style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); background-color: transparent; font-size: 8px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/b&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;&lt;b&gt;The Quran&#39;s transmission traces to a single, public, fully-identified source.&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;Muhammad is the sole earthly source for Quranic content, reciting it publicly for 23 years.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- The 13-year Makkan period was more about core theology (comprising 75% of the Quran), while the 10-year Madinan period was more about the law.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;No part of the Quran depends on lost works, secret teachers, unknown transmitters, or anonymous oral chains.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;Opponents, allies, and neutral tribes all witnessed the same recitations, creating an open-environment custodianship (not esoteric, scholarly, or elite-circle transmission).&lt;/span&gt;&lt;br&gt;&lt;/div&gt;&lt;span style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;b&gt;&amp;nbsp;-&amp;nbsp;&lt;/b&gt;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;&lt;b&gt;The Quran was preserved orally and textually, and by the public community and known individuals.&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;Revelations were delivered in identifiable contexts, such as during public gatherings, responses to specific events, or interactions with known individuals.&lt;/span&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;Large-scale memorization across independent individuals and tribes allowed redundancy across a large, geographic region. Its chain is openly distributed, not privately linear.&lt;/span&gt;&lt;/div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px; background-color: transparent;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;The Quran was recited publicly and daily in communal prayers, in which the reciter could be immediately corrected by those behind him.&lt;/span&gt;&lt;/div&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;b&gt;&amp;nbsp;-&amp;nbsp;&lt;/b&gt;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&lt;b&gt;Standardization occurred by eyewitnesses early, while they were alive&lt;/b&gt;&lt;/span&gt;&lt;b style=&quot;font-size: 8px;&quot;&gt;.&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); background-color: transparent; font-size: 8px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;Multiple designated scribes recorded passages immediately as revelations were received, in which Muhammad could listen and verify.&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;These were preserved as written fragments until 1-2 years after Muhammad&#39;s death, in which the first caliph (Abu Bakr) ordered their compilation into a single, written standard (the &lt;i&gt;rasm&lt;/i&gt;), safeguarded by Hafsah b. Umar (one of Muhammad&#39;s wives).&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;br&gt;&lt;/span&gt;&lt;b style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); background-color: transparent; font-size: 8px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/b&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;&lt;b&gt;No enduring rival Qurans survived - even amid early political and sectarian fragmentation.&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- &lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;Islamic factions were fundamentally political, without generating alternative theological texts in addition to or replacing the Quran. Moreover, while some alternative Qurans and claims to prophethood did appear, they were politically or tribally motivated and were all extinguished during Muhammad&#39;s life or within a year after his death.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;The closest thing to &quot;different Qurans&quot; would be the qira&#39;at (accepted ranges of pronunciation), but they trace to known individuals, are considered valid (having being authorized by Muhammad himself), and only affect pronunciation or minor synonyms.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;div style=&quot;&quot;&gt;&lt;b style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); background-color: transparent; font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/b&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;b&gt;-&amp;nbsp;&lt;/b&gt;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;&lt;b&gt;The Uthmanic standardization only codified the Quran&#39;s pronunciation and diacritical script, as the core text had already been standardized earlier.&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- Since the 7th century Arabs lacked a literary presence (beyond oral poetry and the Quran), they didn&#39;t have a sophisticated written language established - with writings serving more as aids to memorization rather than primary sources - kind of like shorthand English. Since they were masters of their language, they would be able to look at the simplified script and know how it is supposed to be pronounced. Even the Quran&#39;s standardization under Abu Bakr was written in a&amp;nbsp;&lt;i&gt;rasm&lt;/i&gt;&amp;nbsp;(consonantal skeleton).&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- As a result, when the textual Quran was transmitted in non-Arab regions, they weren&#39;t as acquainted with this style and pronounced it according to their own dialects - which weren&#39;t authorized and caused disputes. In response, Uthman enlisted Zaid b. Thabit (the same scribe who oversaw the original Quranic standardization) - as well as several others - in standardizing the Quran&#39;s pronunciation.&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- Uthman also ordered the burning of all unofficial Quranic manuscripts (this was seen as a respectful way to dispose of texts that contained God&#39;s name in it) to ensure that the standardized text would remain in circulation, and to prevent far-reaching areas to fragment of theological differences.&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCE5FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;align=left;" vertex="1" parent="i-ldhcgxSOpe3z3huQwf-149">
          <mxGeometry x="495" width="315" height="500" as="geometry">
            <mxRectangle width="315" height="500" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i-ldhcgxSOpe3z3huQwf-153" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" vertex="1" parent="i-ldhcgxSOpe3z3huQwf-148">
          <mxGeometry y="500" width="810" height="455" as="geometry" />
        </mxCell>
        <mxCell id="i-ldhcgxSOpe3z3huQwf-154" value="&lt;b style=&quot;font-size: x-small;&quot;&gt;How strongly does the claim&#39;s custodianship resist fabrication and error?&lt;/b&gt;&lt;br style=&quot;font-size: x-small;&quot;&gt;&lt;span style=&quot;font-size: x-small;&quot;&gt;(Steelmanned Defense)&lt;/span&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#D5D5D5;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;gradientColor=none;spacingRight=2;spacingLeft=2;" vertex="1" parent="i-ldhcgxSOpe3z3huQwf-153">
          <mxGeometry width="180" height="455" as="geometry">
            <mxRectangle width="180" height="455" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i-ldhcgxSOpe3z3huQwf-155" value="&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&lt;b&gt;&amp;nbsp;- Absence of evidence is not evidence of absence.&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- The existence of some unknowns doesn&#39;t necessitate unreliability. This is actually very common and expected in oral societies at the time.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- If the Gospels are rejected on that basis, then Aristotle&#39;s work, Homer&#39;s Iliad, and all other non-contemporary historical documents and people would similarly be considered unreliable.&lt;/span&gt;&lt;/div&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- The absence of rival texts reflects the success of the early Church in extinguishing false claims.&lt;/span&gt;&lt;/div&gt;&lt;/span&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 2px; text-align: center;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&lt;b&gt;&amp;nbsp;-&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;The preserved manuscripts and independent streams corroborate one another.&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- They all converge on the same core events: Jesus&#39;s ministry, his divine miracles and authority, crucifixion, and resurrection. Human error, even if it exists, doesn&#39;t detract from these events. Moreover, the creeds mentioned in Paul&#39;s earliest writings (ex. 1 Corinthians 15:3-7, Philippians 2:5-11, etc.) show high Christology before any other text was written. As such,&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;the redundancy from independent origins makes a late, singular fabrication highly improbable.&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 8px; text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- Additionally, we have thousands of manuscripts today in various languages, giving us a robust method for verification. Variants can be analyzed, and the original texts can be faithfully reconstructed - which show that the documents from the earliest manuscripts largely correspond to what we have today.&lt;/span&gt;&lt;/div&gt;&lt;span style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&lt;b&gt;&amp;nbsp;-&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; text-align: center; font-size: 8px;&quot;&gt;&lt;b&gt;Criterion of embarrassment strengthens credibility.&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; text-align: center; font-size: 8px;&quot;&gt;The Gospels preserve details that would have been unhelpful for a growing movement, such as the disciples&#39; cowardice, Peter&#39;s denial of Jesus, and the shameful execution of their Messiah by crucifixion.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; text-align: center; font-size: 8px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; text-align: center; font-size: 8px;&quot;&gt;Crucially, all four Gospels report that women were the first witnesses to the resurrection. In a culture where female testimony was considered unreliable, this detail runs contrary to what one would invent to create a persuasive story.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; text-align: center; font-size: 8px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- Paul himself went through great suffering for his claim - it is inconceivable to explain why he was willing to die for his message if he knew that it was wrong.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 8px; text-align: left;&quot;&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&amp;nbsp;- Differing Christologies don&#39;t contradict each other and reflect progressive revelation, not gradual development.&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); text-align: center;&quot;&gt;Each author, writing for a different audience, made intentional theological choices about what to emphasize. However, a&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px; text-align: center; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;ll four Gospels are rooted in the same, complete truth about Jesus&#39;s divine identity, which was understood by the apostles from the beginning. As such, they complement each other.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px; text-align: center; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; text-align: center; font-size: 8px;&quot;&gt;The theory of a &quot;gradually developing&quot; Christology is challenged by the fact that Paul&#39;s letters - the earliest Christian documents - contain the highest and most explicit Christology, proving the belief in Jesus&#39;s divinity was present from the very beginning&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px; text-align: center;&quot;&gt;.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px; text-align: center; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;b style=&quot;font-size: 8px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&amp;nbsp;- P&lt;/b&gt;&lt;span style=&quot;background-color: transparent; text-align: center; font-size: 8px;&quot;&gt;&lt;b&gt;aul&#39;s authority is the strongest proof of the Gospels&#39; divine origin.&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;He received direct revelation from the risen Christ, perfectly aligning with the core message of the Jerusalem apostles. And His chains provides two powerful, independent lines of testimony to the same truth.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; text-align: center; font-size: 8px;&quot;&gt;Paul used to be an active persecutor of the early church. As such, his dramatic transformation requires an extraordinary explanation, which can only be attributed to a direct encounter with the risen Christ.&lt;/span&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=top;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;" vertex="1" parent="i-ldhcgxSOpe3z3huQwf-153">
          <mxGeometry x="180" width="315" height="455" as="geometry">
            <mxRectangle width="315" height="455" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i-ldhcgxSOpe3z3huQwf-156" value="&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&lt;b&gt;&amp;nbsp;- It is impossible for the preserved Quran to be different than what Muhammad recited, and it must have been revealed during his lifetime.&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;The Quran is not a book of history: it speaks into live disputes, questions, accusations, negotiations, and community events - clearly assuming shared, real-time knowledge with its first audience.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;Its verses respond directly to unpredictable, contemporary situations, such as private conversations, military setbacks, political betrayals, and personal scandals. A later fabrication or committee would have needed to reconstruct countless micro-events and tribal dynamics with impossible precision, in front of an audience that directly lived those moments and could publicly challenge any deviation.&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- This is especially relevant given that this was the very period in which fiercely independent tribes were being unified - thus their power to collectively witness events only grew. A fabricated scripture from an unknown source would have fractured them further, rather than rally them around a single text and a single religion.&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 2px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&lt;b&gt;&amp;nbsp;-&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;Muhammad is the only possible candidate for the Quran&#39;s revelation, and his illiteracy (relative to the Quran&#39;s eloquence) is a proof of divine origin.&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;T&lt;font&gt;he Quran&#39;s linguistic sophistication, structural originality, and rhetorical force exceed the demonstrated output of Muhammad&#39;s own speech, poetry, correspondence, and time in his day to produce such a work. This would have required years of specialized education that would have been beyond the hearsay he would hear from his job as a merchant, making self-authorship implausible.&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;font&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- The Quran&#39;s eloquence is such that&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;no prior linguistic system was sophisticated enough to explain it, and so it became the grammatical standard for the Arabic language itself.&lt;/span&gt;&lt;/div&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- Yet at the same time, no alternative author or historical committee fits the established historical record&lt;/span&gt;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;: the Quran emerged through continuous public recitation, without revisions or hidden editorial phases yet requiring specialized education, and in full view of allies and opponents.&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&lt;font&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;As such, early fabrication would have required coordination across hostile tribes, rival poets, and specialized, educated audiences -&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;all of whom had strong motive and opportunity to expose forgery against each other - yet no rival claimant or counter-text ever emerged.&lt;/span&gt;&lt;/div&gt;&lt;span style=&quot;font-size: 2px;&quot;&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;/span&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&lt;b&gt;&amp;nbsp;-&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;&lt;b&gt;Preservation errors are historically implausible under the Quran&#39;s transmission environment, and logically demonstrable today.&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; text-align: center; font-size: 8px;&quot;&gt;The Quran was recited publicly, daily, and from memory by large groups of people, creating live error-correction (from Muhammad to the average person): any alteration in public prayer, recitation, or teaching would be immediately challenged by those who memorized the same passage.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- The non-chronological order of the Quran&#39;s verses doesn&#39;t affect the content of those verses. Moreover, we can reasonably reconstruct a chronological ordering of the Quran today, which doesn&#39;t expose any theological differences. This shows the Quran&#39;s timelessness, as this change occurred to transcend the context of 7th century Arabia.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- As such, the live, public revelation of the Quran paired with the memory, accessibility, and liturgical practices of Muhammad&#39;s community make preservation errors highly unlikely, especially since the earliest manuscripts corroborate what we have today. Moreover, its logical coherence is timeless and can be demonstrably verified by anyone in any given time.&lt;br&gt;&lt;/span&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCE5FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;" vertex="1" parent="i-ldhcgxSOpe3z3huQwf-153">
          <mxGeometry x="495" width="315" height="455" as="geometry">
            <mxRectangle width="315" height="455" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i-ldhcgxSOpe3z3huQwf-157" value="&lt;b&gt;&lt;font&gt;5. Resistance to Fabrication (continued)&lt;/font&gt;&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=18;fillColor=#DAE8FC;gradientColor=#7EA6E0;strokeColor=#6C8EBF;" vertex="1" parent="i-ldhcgxSOpe3z3huQwf-147">
          <mxGeometry width="810.0000000000001" height="44.9999999999999" as="geometry" />
        </mxCell>
