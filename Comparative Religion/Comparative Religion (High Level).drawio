        <mxCell id="QDhsdInRaVgg9gpE5JQB-52" parent="QDhsdInRaVgg9gpE5JQB-50" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#FFCCCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=top;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=-2;" value="&lt;font style=&quot;color: rgb(153, 153, 153); font-size: 9px;&quot;&gt;&lt;b&gt;Yes&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;Assuming &quot;speculation is proof/refutation&quot;, then this can be explained by quantum randomness and/or many-worlds theories.&lt;/font&gt;&lt;/div&gt;" vertex="1">
