        <mxCell id="2b-gEbGxIzFqQ9dfg996-6" style="edgeStyle=elbowEdgeStyle;shape=connector;rounded=1;jumpSize=6;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=default;strokeWidth=1.5;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;endSize=3;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="2b-gEbGxIzFqQ9dfg996-1" source="2b-gEbGxIzFqQ9dfg996-18" target="2b-gEbGxIzFqQ9dfg996-14">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="568" y="345" as="sourcePoint" />
          </mxGeometry>
        </mxCell>
        <UserObject label="The Pursuit of (Capital T) Truth" link="data:page/id,lkuSvPZcJC7dHRsydWrw" id="2b-gEbGxIzFqQ9dfg996-7">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#E6E6E6;" vertex="1" parent="2b-gEbGxIzFqQ9dfg996-1">
            <mxGeometry x="255" y="10" width="340" height="30" as="geometry" />
