          <mxCell style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#FFF2CC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;gradientColor=#FFD966;align=center;" vertex="1" parent="rhcqr-XzwB1Ql8kuJBcr-46">
