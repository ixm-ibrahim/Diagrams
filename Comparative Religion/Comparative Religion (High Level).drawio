        <mxCell id="rhcqr-XzwB1Ql8kuJBcr-51" value="&lt;span style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- There are&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;3 main streams of transmission (the synoptic, johannine, and pauline chains) that merge with Irenaeus to start the patristic stream, leading directly to its standardization in the Council of Rome.&lt;/span&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=middle;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=0;align=left;strokeWidth=0;" vertex="1" parent="rhcqr-XzwB1Ql8kuJBcr-49">
          <mxGeometry width="260" height="40" as="geometry">
            <mxRectangle width="260" height="40" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="rhcqr-XzwB1Ql8kuJBcr-52" value="&lt;span style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- There are&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;2 main streams of transmission: the Quran (through its eyewitnesses, both orally and textually) and Hadith (through chains of eyewitness testimony, until its textual standardization).&lt;/span&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CBE2FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=middle;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=0;align=left;strokeWidth=0;" vertex="1" parent="rhcqr-XzwB1Ql8kuJBcr-49">
          <mxGeometry x="260" width="260" height="40" as="geometry">
            <mxRectangle width="260" height="40" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="rhcqr-XzwB1Ql8kuJBcr-53" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" vertex="1" parent="rhcqr-XzwB1Ql8kuJBcr-48">
          <mxGeometry y="40" width="519.9999999999995" height="35" as="geometry" />
        </mxCell>
        <mxCell id="rhcqr-XzwB1Ql8kuJBcr-55" value="&lt;span style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;Yes - the Jewish Christians and Gnostics are competing claims to Jesus&#39; message.&lt;/span&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=middle;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=0;align=left;strokeWidth=0;" vertex="1" parent="rhcqr-XzwB1Ql8kuJBcr-53">
          <mxGeometry width="260" height="35" as="geometry">
            <mxRectangle width="260" height="35" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="rhcqr-XzwB1Ql8kuJBcr-56" value="&lt;span style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;No competing claims to the Quran&#39;s transmission, while there are competing claims for the transmission of Hadith (Shia vs. Sunni).&lt;/span&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CBE2FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=middle;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=0;align=left;strokeWidth=0;" vertex="1" parent="rhcqr-XzwB1Ql8kuJBcr-53">
          <mxGeometry x="260" width="260" height="35" as="geometry">
            <mxRectangle width="260" height="35" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="rhcqr-XzwB1Ql8kuJBcr-57" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" vertex="1" parent="rhcqr-XzwB1Ql8kuJBcr-48">
          <mxGeometry y="75" width="519.9999999999995" height="35" as="geometry" />
        </mxCell>
        <mxCell id="rhcqr-XzwB1Ql8kuJBcr-59" value="&lt;span style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;Custodianship converges with Irenaeus, Eusebius, and Paul.&lt;/span&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=middle;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=0;align=left;strokeWidth=0;" vertex="1" parent="rhcqr-XzwB1Ql8kuJBcr-57">
          <mxGeometry width="260" height="35" as="geometry">
            <mxRectangle width="260" height="35" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="rhcqr-XzwB1Ql8kuJBcr-60" value="&lt;span style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;Quranic custodianship rests on Uthman, Hafsa, Abu Bakr, and those who memorized it verbatim, while Hadith custodianship converges with the textual compilations.&lt;/span&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CBE2FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=middle;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=0;align=left;strokeWidth=0;" vertex="1" parent="rhcqr-XzwB1Ql8kuJBcr-57">
          <mxGeometry x="260" width="260" height="35" as="geometry">
            <mxRectangle width="260" height="35" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="rhcqr-XzwB1Ql8kuJBcr-61" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" vertex="1" parent="rhcqr-XzwB1Ql8kuJBcr-48">
