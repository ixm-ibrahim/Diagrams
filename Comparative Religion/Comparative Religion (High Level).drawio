          </mxGeometry>
        </mxCell>
        <mxCell id="DHazi4g6tnZFVyByypoz-50" parent="DHazi4g6tnZFVyByypoz-48" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCE5FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=middle;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;swimlaneFillColor=none;gradientColor=none;gradientDirection=east;align=left;" value="&lt;span style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- &lt;b&gt;Sunni is 22.2%,&lt;/b&gt; Shia is 2.6%, all others &amp;lt;2%&lt;/span&gt;" vertex="1">
          <mxGeometry height="20" width="315" x="315" as="geometry">
            <mxRectangle height="20" width="315" as="alternateBounds" />
