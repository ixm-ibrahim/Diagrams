        <mxCell id="oIxCu5UkMhoze8bENyrH-2" parent="oIxCu5UkMhoze8bENyrH-1" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#F8CECC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=middle;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;swimlaneFillColor=none;gradientColor=#EA6B66;gradientDirection=south;" value="&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;b&gt;How were God&#39;s expectations changed?&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="35" width="660" as="geometry">
