        <mxCell id="ev5vojVGDBCjoDU-CP_1-6" parent="ev5vojVGDBCjoDU-CP_1-34" style="shape=table;startSize=0;container=1;collapsible=0;childLayout=tableLayout;fontSize=1;" value="" vertex="1">
          <mxGeometry height="80" width="630" x="105" as="geometry" />
        </mxCell>
        <mxCell id="ev5vojVGDBCjoDU-CP_1-7" parent="ev5vojVGDBCjoDU-CP_1-6" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;swimlaneFillColor=none;" vertex="1">
          <mxGeometry height="35" width="630" as="geometry" />
        </mxCell>
        <mxCell id="ev5vojVGDBCjoDU-CP_1-8" parent="ev5vojVGDBCjoDU-CP_1-7" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=middle;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;swimlaneFillColor=none;gradientColor=none;gradientDirection=east;align=left;" value="&lt;span style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- &lt;b&gt;Faith is trusting God on the authority of His revelation&lt;/b&gt; (as witnessed by the Church and scripture)&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- &lt;b&gt;Reason is used to interpret scripture, develop doctrine, and defend faith&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="35" width="315" as="geometry">
            <mxRectangle height="35" width="315" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ev5vojVGDBCjoDU-CP_1-9" parent="ev5vojVGDBCjoDU-CP_1-7" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCE5FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=middle;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;swimlaneFillColor=none;gradientColor=none;gradientDirection=east;align=left;" value="&lt;span style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- &lt;b&gt;Faith is affirmation of the heart, speech of the tongue, and action &lt;/b&gt;(manifestation of the will)&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- &lt;b&gt;Proper reasoning about reality is recognizing God and His revelation&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="35" width="315" x="315" as="geometry">
            <mxRectangle height="35" width="315" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ev5vojVGDBCjoDU-CP_1-10" parent="ev5vojVGDBCjoDU-CP_1-6" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;swimlaneFillColor=none;" vertex="1">
          <mxGeometry height="45" width="630" y="35" as="geometry" />
        </mxCell>
        <mxCell id="ev5vojVGDBCjoDU-CP_1-11" parent="ev5vojVGDBCjoDU-CP_1-10" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=middle;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;swimlaneFillColor=none;gradientColor=none;gradientDirection=east;align=left;" value="&lt;b style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/b&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;- &lt;b&gt;Some revealed truths &lt;/b&gt;(ex. the Trinity, Incarnation)&lt;b&gt; exceed our capacity for reason &lt;/b&gt;(without contradicting it) -&amp;nbsp;&lt;b&gt;known as mysteries&lt;/b&gt;&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- &lt;b&gt;Pious acceptance of mystery is a virtue&lt;/b&gt;, in trusting God and the Church even when intellectual understanding is incomplete&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="45" width="315" as="geometry">
            <mxRectangle height="45" width="315" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ev5vojVGDBCjoDU-CP_1-12" parent="ev5vojVGDBCjoDU-CP_1-10" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCE5FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=middle;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;swimlaneFillColor=none;gradientColor=none;gradientDirection=east;align=left;" value="&lt;b style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/b&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;- &lt;b&gt;Faith is the continuation of reason, putting aside one&#39;s worldly desires &lt;/b&gt;&lt;b&gt;for what they know to be true&lt;/b&gt;: there is no conflict between the two&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- &lt;b&gt;Improper use of reason is caused by deficiencies in the heart, not the mind&lt;/b&gt;: God inspired all mankind with the &lt;i&gt;fitrah&lt;/i&gt;&amp;nbsp;to witness His existence and submit to His will&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="45" width="315" x="315" as="geometry">
            <mxRectangle height="45" width="315" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
