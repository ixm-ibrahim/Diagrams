        <mxCell id="QDhsdInRaVgg9gpE5JQB-51" parent="QDhsdInRaVgg9gpE5JQB-50" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#D5D5D5;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;gradientColor=none;" value="&lt;font style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;Reality could have been different&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="55" width="163" as="geometry">
