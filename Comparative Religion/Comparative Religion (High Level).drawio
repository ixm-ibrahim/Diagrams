        <mxCell id="an_TeZdyltkLNw7kslnf-41" parent="an_TeZdyltkLNw7kslnf-40" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#E6E6E6;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=middle;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;swimlaneFillColor=none;gradientColor=none;gradientDirection=east;align=center;" value="&lt;b style=&quot;font-size: 11px;&quot;&gt;Structure and Timelessness&lt;/b&gt;" vertex="1">
          <mxGeometry height="85" width="105" as="geometry">
            <mxRectangle height="85" width="105" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="an_TeZdyltkLNw7kslnf-42" parent="ev5vojVGDBCjoDU-CP_1-17" style="shape=table;startSize=0;container=1;collapsible=0;childLayout=tableLayout;fontSize=1;" value="" vertex="1">
          <mxGeometry height="85" width="630" x="105" as="geometry" />
        </mxCell>
        <mxCell id="an_TeZdyltkLNw7kslnf-43" parent="an_TeZdyltkLNw7kslnf-42" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;swimlaneFillColor=none;" vertex="1">
          <mxGeometry height="35" width="630" as="geometry" />
        </mxCell>
        <mxCell id="an_TeZdyltkLNw7kslnf-44" parent="an_TeZdyltkLNw7kslnf-43" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=middle;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;swimlaneFillColor=none;gradientColor=none;gradientDirection=east;align=left;" value="&lt;span style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;b style=&quot;font-size: 8px;&quot;&gt;The scripture is structured chronologically and historically&lt;/b&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;, contextualizing law and grace within specific covenants (ex. Abrahamic, Mosaic, Davidic, New)&lt;/span&gt;" vertex="1">
          <mxGeometry height="35" width="315" as="geometry">
            <mxRectangle height="35" width="315" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="an_TeZdyltkLNw7kslnf-45" parent="an_TeZdyltkLNw7kslnf-43" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCE5FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=middle;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;swimlaneFillColor=none;gradientColor=none;gradientDirection=east;align=left;" value="&lt;span style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;b style=&quot;font-size: 8px;&quot;&gt;The scripture is structured achronologically and pedagogically&lt;/b&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;, abstracting away the historical context from passages and grouping verses to emphasize themes, patterns, and reminders&lt;/span&gt;" vertex="1">
          <mxGeometry height="35" width="315" x="315" as="geometry">
            <mxRectangle height="35" width="315" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="an_TeZdyltkLNw7kslnf-46" parent="an_TeZdyltkLNw7kslnf-42" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;swimlaneFillColor=none;" vertex="1">
          <mxGeometry height="25" width="630" y="35" as="geometry" />
        </mxCell>
        <mxCell id="an_TeZdyltkLNw7kslnf-47" parent="an_TeZdyltkLNw7kslnf-46" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=middle;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;swimlaneFillColor=none;gradientColor=none;gradientDirection=east;align=left;" value="&lt;b style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/b&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;b style=&quot;font-size: 8px;&quot;&gt;God reveals Himself through history&lt;/b&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;, where the truth unfolds in a linear narrative (from Creation to Fall to Redemption to Restoration)&lt;/span&gt;" vertex="1">
          <mxGeometry height="25" width="315" as="geometry">
            <mxRectangle height="25" width="315" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="an_TeZdyltkLNw7kslnf-48" parent="an_TeZdyltkLNw7kslnf-46" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCE5FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=middle;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;swimlaneFillColor=none;gradientColor=none;gradientDirection=east;align=left;" value="&lt;b style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/b&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;-&amp;nbsp;&lt;/span&gt;&lt;b style=&quot;font-size: 8px;&quot;&gt;God reveals Himself the same way across history&lt;/b&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;, inspiring the same gospel and warnings to all mankind (through the Prophets, Messengers, and their scriptures)&lt;/span&gt;" vertex="1">
          <mxGeometry height="25" width="315" x="315" as="geometry">
            <mxRectangle height="25" width="315" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="an_TeZdyltkLNw7kslnf-49" parent="an_TeZdyltkLNw7kslnf-42" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;swimlaneFillColor=none;" vertex="1">
          <mxGeometry height="25" width="630" y="60" as="geometry" />
        </mxCell>
        <mxCell id="an_TeZdyltkLNw7kslnf-50" parent="an_TeZdyltkLNw7kslnf-49" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=middle;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;swimlaneFillColor=none;gradientColor=none;gradientDirection=east;align=left;" value="&lt;span style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;b style=&quot;font-size: 8px;&quot;&gt;Timelessness manifests by Christ&#39;s atonement being relevant to all times and places&lt;/b&gt;" vertex="1">
          <mxGeometry height="25" width="315" as="geometry">
            <mxRectangle height="25" width="315" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="an_TeZdyltkLNw7kslnf-51" parent="an_TeZdyltkLNw7kslnf-49" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCE5FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=middle;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;swimlaneFillColor=none;gradientColor=none;gradientDirection=east;align=left;" value="&lt;span style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;b style=&quot;font-size: 8px;&quot;&gt;Timelessness manifests through the universality of the message&lt;/b&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;(across time and culture)&amp;nbsp;&lt;/span&gt;&lt;b style=&quot;font-size: 8px;&quot;&gt;and by its atemporal structure&lt;/b&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;(aligning with God&#39;s atemporality)&lt;/span&gt;" vertex="1">
          <mxGeometry height="25" width="315" x="315" as="geometry">
            <mxRectangle height="25" width="315" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
