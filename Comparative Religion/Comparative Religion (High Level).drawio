        </mxCell>
        <mxCell id="I55OHFyqlXbNXwQoPFCH-3" value="&lt;div style=&quot;&quot;&gt;&lt;font&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;&amp;nbsp;- &quot;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;Simon Peter answered, “&lt;b&gt;You are the Messiah&lt;/b&gt;, the Son of the living God.&quot; (Matthew 16:16)&lt;/span&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- &quot;&lt;/span&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;Moreover, demons came out of many people, shouting, &#39;You are the Son of God!&#39; But he rebuked them and would not allow them to speak, because &lt;b&gt;they knew he was the Messiah&lt;/b&gt;.&quot; (Luke 4:41)&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;&amp;nbsp;- &quot;&lt;/span&gt;&lt;/font&gt;&lt;font style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;But these are written that you may believe that &lt;b&gt;Jesus is the Messiah, the Son of God&lt;/b&gt;, and that by believing you may have life in his name.&quot; (&lt;/span&gt;&lt;/font&gt;&lt;font style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;John 20:31)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- &quot;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;He is dressed in a robe dipped in blood, and &lt;b&gt;his name is the Word of God&lt;/b&gt;.&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&quot; (Revelation 19:13)&lt;/span&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=middle;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;swimlaneFillColor=none;gradientColor=none;gradientDirection=east;align=left;" vertex="1" parent="I55OHFyqlXbNXwQoPFCH-2">
          <mxGeometry width="315" height="145" as="geometry">
            <mxRectangle width="315" height="145" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="I55OHFyqlXbNXwQoPFCH-4" value="&lt;div style=&quot;&quot;&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;&amp;nbsp;- &quot;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;˹Remember˺ when the angels proclaimed, “O Mary! &lt;b&gt;God gives you good news of a Word from Him, his name will be the Messiah, Jesus, son of Mary&lt;/b&gt;; honoured in this world and the Hereafter, and he will be one of those nearest ˹to God˺.&quot; (Quran 3:45)&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&amp;nbsp;- &quot;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;O People of the Book! Do not go to extremes regarding your faith; say nothing about God except the truth. &lt;b&gt;The Messiah, Jesus, son of Mary, was no more than a messenger of God and the fulfilment of His Word through Mary and a spirit ˹created by a command˺ from Him&lt;/b&gt;. So believe in God and His messengers and do not say, “Three.” Stop! - for your own good. God is only One God. Glory be to Him! He is far above having a son! To Him belongs whatever is in the heavens and whatever is on the earth. And God is sufficient as a Trustee of Affairs.&quot; (Quran 4:171)&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- &quot;&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&lt;b&gt;The Messiah, son of Mary, was no more than a messenger.&lt;/b&gt; ˹Many˺ messengers had ˹come and˺ gone before him. His mother was a woman of truth. They both ate food. See how We make the signs clear to them, yet see how they are deluded ˹from the truth˺!&quot;&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;(Quran 5:75)&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCE5FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=middle;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;swimlaneFillColor=none;gradientColor=none;gradientDirection=east;align=left;" vertex="1" parent="I55OHFyqlXbNXwQoPFCH-2">
          <mxGeometry x="315" width="315" height="145" as="geometry">
            <mxRectangle width="315" height="145" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="I55OHFyqlXbNXwQoPFCH-5" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;swimlaneFillColor=none;" vertex="1" parent="I55OHFyqlXbNXwQoPFCH-1">
          <mxGeometry y="145" width="630" height="30" as="geometry" />
        </mxCell>
        <mxCell id="I55OHFyqlXbNXwQoPFCH-6" value="&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;&amp;nbsp;- Jesus is the divine Son of God, the Person of the Son.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;&amp;nbsp;- Jesus turned water into wine&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;&amp;nbsp;(among other miracles)&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;.&lt;/span&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=middle;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;swimlaneFillColor=none;gradientColor=none;gradientDirection=east;align=left;" vertex="1" parent="I55OHFyqlXbNXwQoPFCH-5">
          <mxGeometry width="315" height="30" as="geometry">
            <mxRectangle width="315" height="30" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="I55OHFyqlXbNXwQoPFCH-7" value="&lt;span style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- Jesus is one of God&#39;s Messengers, who have all preached the Gospel&#39;s message.&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- Jesus spoke at childbirth and turned clay birds into life&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;&amp;nbsp;(among other miracles)&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;.&lt;/span&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCE5FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=middle;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;swimlaneFillColor=none;gradientColor=none;gradientDirection=east;align=left;" vertex="1" parent="I55OHFyqlXbNXwQoPFCH-5">
          <mxGeometry x="315" width="315" height="30" as="geometry">
            <mxRectangle width="315" height="30" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="I55OHFyqlXbNXwQoPFCH-8" value="" style="shape=table;startSize=0;container=1;collapsible=0;childLayout=tableLayout;fontSize=1;" vertex="1" parent="I55OHFyqlXbNXwQoPFCH-11">
          <mxGeometry width="105" height="175" as="geometry" />
        </mxCell>
        <mxCell id="I55OHFyqlXbNXwQoPFCH-9" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;swimlaneFillColor=none;" vertex="1" parent="I55OHFyqlXbNXwQoPFCH-8">
          <mxGeometry width="105" height="175" as="geometry" />
        </mxCell>
        <mxCell id="I55OHFyqlXbNXwQoPFCH-10" value="&lt;b style=&quot;font-size: 11px;&quot;&gt;Jesus was born of the virgin Mary, performed miracles, is the Word of God, and is the Messiah.&lt;/b&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=middle;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;swimlaneFillColor=none;gradientColor=#CCE5FF;gradientDirection=east;" vertex="1" parent="I55OHFyqlXbNXwQoPFCH-9">
          <mxGeometry width="105" height="175" as="geometry">
            <mxRectangle width="105" height="175" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="I55OHFyqlXbNXwQoPFCH-23" value="" style="group" vertex="1" connectable="0" parent="zuZuHAAaARETqynN6Csq-1">
          <mxGeometry x="95" y="10605" width="735" height="95" as="geometry" />
        </mxCell>
        <mxCell id="I55OHFyqlXbNXwQoPFCH-13" value="" style="shape=table;startSize=0;container=1;collapsible=0;childLayout=tableLayout;fontSize=1;" vertex="1" parent="I55OHFyqlXbNXwQoPFCH-23">
          <mxGeometry x="105" width="630" height="95" as="geometry" />
        </mxCell>
        <mxCell id="I55OHFyqlXbNXwQoPFCH-14" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;swimlaneFillColor=none;" vertex="1" parent="I55OHFyqlXbNXwQoPFCH-13">
          <mxGeometry width="630" height="70" as="geometry" />
        </mxCell>
        <mxCell id="I55OHFyqlXbNXwQoPFCH-15" value="&lt;div style=&quot;&quot;&gt;&lt;font&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;&amp;nbsp;- &quot;... &lt;b&gt;F&lt;/b&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&lt;b&gt;or all have sinned and fall short of the glory of God&lt;/b&gt;, and all are justified freely by his grace through the redemption that came by Christ Jesus.&quot; (Romans 3:23-24)&lt;/span&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- &quot;&lt;/span&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;If we claim to be without sin, we deceive ourselves and the truth is not in us.&amp;nbsp;&lt;b&gt;If we confess our sins, he is faithful and just and will forgive us our sins and purify us from all unrighteousness&lt;/b&gt;.&lt;/span&gt;&lt;font style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&quot; (&lt;/span&gt;&lt;/font&gt;&lt;font style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;1 John 1:8-9)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=middle;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;swimlaneFillColor=none;gradientColor=none;gradientDirection=east;align=left;" vertex="1" parent="I55OHFyqlXbNXwQoPFCH-14">
          <mxGeometry width="315" height="70" as="geometry">
            <mxRectangle width="315" height="70" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="I55OHFyqlXbNXwQoPFCH-16" value="&lt;div style=&quot;&quot;&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;&amp;nbsp;- &quot;...&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;and those who, when they happen to commit a shameful act or wrong themselves, remember God, then, seek forgiveness for their sins-&lt;b&gt;and who is there to forgive sins except God?&lt;/b&gt;-and do not persist in what they have done, knowingly.&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;&quot; (Quran 3:135)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- &quot;&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;Say: &#39;O my Servants who have transgressed against their souls! Despair not of the Mercy of God: &lt;b&gt;for God forgives all sins&lt;/b&gt;: for He is Oft-Forgiving, Ever-Merciful.&#39;&quot;&lt;br&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;(Quran 39:53)&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCE5FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=middle;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;swimlaneFillColor=none;gradientColor=none;gradientDirection=east;align=left;" vertex="1" parent="I55OHFyqlXbNXwQoPFCH-14">
          <mxGeometry x="315" width="315" height="70" as="geometry">
            <mxRectangle width="315" height="70" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="I55OHFyqlXbNXwQoPFCH-17" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;swimlaneFillColor=none;" vertex="1" parent="I55OHFyqlXbNXwQoPFCH-13">
          <mxGeometry y="70" width="630" height="25" as="geometry" />
        </mxCell>
        <mxCell id="I55OHFyqlXbNXwQoPFCH-18" value="&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;&amp;nbsp;- The mechanism for God&#39;s forgiveness is linked to Christ&#39;s atonement.&amp;nbsp;&lt;/span&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=middle;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;swimlaneFillColor=none;gradientColor=none;gradientDirection=east;align=left;" vertex="1" parent="I55OHFyqlXbNXwQoPFCH-17">
          <mxGeometry width="315" height="25" as="geometry">
            <mxRectangle width="315" height="25" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="I55OHFyqlXbNXwQoPFCH-19" value="&lt;span style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- The mechanism for God&#39;s forgiveness is grounded as a direct interaction with God.&lt;/span&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCE5FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=middle;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;swimlaneFillColor=none;gradientColor=none;gradientDirection=east;align=left;" vertex="1" parent="I55OHFyqlXbNXwQoPFCH-17">
          <mxGeometry x="315" width="315" height="25" as="geometry">
            <mxRectangle width="315" height="25" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="I55OHFyqlXbNXwQoPFCH-20" value="" style="shape=table;startSize=0;container=1;collapsible=0;childLayout=tableLayout;fontSize=1;" vertex="1" parent="I55OHFyqlXbNXwQoPFCH-23">
          <mxGeometry width="105" height="95" as="geometry" />
        </mxCell>
        <mxCell id="I55OHFyqlXbNXwQoPFCH-21" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;swimlaneFillColor=none;" vertex="1" parent="I55OHFyqlXbNXwQoPFCH-20">
