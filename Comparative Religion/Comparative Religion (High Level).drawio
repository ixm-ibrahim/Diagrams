        <mxCell id="DHazi4g6tnZFVyByypoz-46" parent="DHazi4g6tnZFVyByypoz-45" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=middle;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;swimlaneFillColor=none;gradientColor=none;gradientDirection=east;align=left;" value="&lt;span style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- &lt;b&gt;Christianity is the largest at 28.8%&lt;/b&gt;, and second largest by denomination at 14.4%&lt;/span&gt;" vertex="1">
          <mxGeometry height="20" width="315" as="geometry">
            <mxRectangle height="20" width="315" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="DHazi4g6tnZFVyByypoz-47" parent="DHazi4g6tnZFVyByypoz-45" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCE5FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=middle;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;swimlaneFillColor=none;gradientColor=none;gradientDirection=east;align=left;" value="&lt;span style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- Islam is the second largest at 25.6%, and &lt;b&gt;largest by denomination at 22.2%&lt;/b&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="20" width="315" x="315" as="geometry">
            <mxRectangle height="20" width="315" as="alternateBounds" />
