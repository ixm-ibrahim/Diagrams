          </mxGeometry>
        </mxCell>
        <mxCell id="rhcqr-XzwB1Ql8kuJBcr-64" value="&lt;span style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;The potential weaknesses of the oral and textual chains are mitigated by the other.&lt;/span&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CBE2FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=middle;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=0;align=left;strokeWidth=0;" vertex="1" parent="rhcqr-XzwB1Ql8kuJBcr-61">
