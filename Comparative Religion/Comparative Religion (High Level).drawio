        <mxCell id="S8Pw8Tw3iUAq8b6uVJTt-83" value="&lt;b style=&quot;font-size: 11px;&quot;&gt;God is merciful, loving, and forgiving.&lt;/b&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=middle;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;swimlaneFillColor=none;gradientColor=#CCE5FF;gradientDirection=east;" vertex="1" parent="S8Pw8Tw3iUAq8b6uVJTt-82">
