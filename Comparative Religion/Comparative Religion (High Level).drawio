        <mxCell id="QDhsdInRaVgg9gpE5JQB-58" parent="QDhsdInRaVgg9gpE5JQB-56" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#FFCCCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=top;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=-2;" value="&lt;font style=&quot;color: rgb(153, 153, 153); font-size: 9px;&quot;&gt;&lt;b&gt;Yes&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&lt;span style=&quot;color: light-dark(rgb(153, 153, 153), rgb(106, 106, 106)); font-size: 8px;&quot;&gt;Assuming &quot;speculation is&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;&lt;font color=&quot;#999999&quot;&gt;proof/&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(153, 153, 153), rgb(106, 106, 106)); font-size: 8px; background-color: transparent;&quot;&gt;refutation&quot;, then nothing happens after we die.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="65" width="161" x="163" as="geometry">
