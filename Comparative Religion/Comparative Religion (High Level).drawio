  <diagram name="1. Pursuit of Truth" id="-h21NPjJcReqmbgmwP93">
    <mxGraphModel dx="674" dy="460" grid="1" gridSize="5" guides="0" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" background="#CCCCCC" math="0" shadow="0" adaptiveColors="none">
      <root>
        <mxCell id="2b-gEbGxIzFqQ9dfg996-0" />
        <mxCell id="2b-gEbGxIzFqQ9dfg996-1" parent="2b-gEbGxIzFqQ9dfg996-0" />
        <mxCell id="2b-gEbGxIzFqQ9dfg996-2" value="" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;strokeColor=default;fillColor=none;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" vertex="1" parent="2b-gEbGxIzFqQ9dfg996-1">
          <mxGeometry x="245" width="359.32" height="465" as="geometry" />
        </mxCell>
        <mxCell id="2b-gEbGxIzFqQ9dfg996-3" style="edgeStyle=elbowEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeWidth=1.5;jumpSize=6;elbow=vertical;endSize=3;" edge="1" parent="2b-gEbGxIzFqQ9dfg996-1" source="2b-gEbGxIzFqQ9dfg996-30" target="2b-gEbGxIzFqQ9dfg996-26">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="425" y="205" as="sourcePoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="2b-gEbGxIzFqQ9dfg996-4" style="edgeStyle=elbowEdgeStyle;shape=connector;rounded=1;jumpSize=6;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=default;strokeWidth=1.5;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;endSize=3;" edge="1" parent="2b-gEbGxIzFqQ9dfg996-1" source="2b-gEbGxIzFqQ9dfg996-26" target="2b-gEbGxIzFqQ9dfg996-22">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="2b-gEbGxIzFqQ9dfg996-5" style="edgeStyle=elbowEdgeStyle;shape=connector;rounded=1;jumpSize=6;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=default;strokeWidth=1.5;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;endSize=3;" edge="1" parent="2b-gEbGxIzFqQ9dfg996-1" source="2b-gEbGxIzFqQ9dfg996-22" target="2b-gEbGxIzFqQ9dfg996-18">
