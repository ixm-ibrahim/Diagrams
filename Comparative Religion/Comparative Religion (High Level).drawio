        </mxCell>
        <mxCell id="XmoEW__EEp50cMUPfqny-35" value="&lt;span style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- To verify strong custodianship of the Quran,&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;all plausible natural pathways for fabrication or alteration need to be eliminated.&lt;/span&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CBE2FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=middle;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=0;align=left;strokeWidth=0;" vertex="1" parent="XmoEW__EEp50cMUPfqny-33">
