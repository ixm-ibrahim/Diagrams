        <UserObject label="Defining God from Reality, and Religion from God" link="data:page/id,lkuSvPZcJC7dHRsydWrw" id="ZjHmXdts4T1RER6AKXDF-0">
          <mxCell parent="mIenp-yJnPnNglZ723Zf-1" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#E6E6E6;fontSize=20;" vertex="1">
            <mxGeometry height="50" width="810" x="20" y="20" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="EHY3XnCysVSyneqZfFhU-0" edge="1" parent="mIenp-yJnPnNglZ723Zf-1" source="AGBN_yRrD6I4HZXZdgja-1" style="edgeStyle=elbowEdgeStyle;shape=connector;rounded=1;jumpSize=6;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=default;strokeWidth=1.5;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;endSize=3;" target="kXGbjwJ6K_rhmKNq67j1-1">
