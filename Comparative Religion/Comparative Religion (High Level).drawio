        <mxCell id="QDhsdInRaVgg9gpE5JQB-55" value="&lt;font style=&quot;color: rgb(153, 153, 153); font-size: 9px;&quot;&gt;&lt;b&gt;Yes&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;God can will as He pleases.&lt;/font&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CBE2FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=-2;" vertex="1" parent="QDhsdInRaVgg9gpE5JQB-50">
          <mxGeometry x="648" width="162" height="55" as="geometry">
            <mxRectangle width="162" height="55" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="QDhsdInRaVgg9gpE5JQB-56" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" vertex="1" parent="QDhsdInRaVgg9gpE5JQB-19">
          <mxGeometry y="575" width="810.0000000000001" height="60" as="geometry" />
        </mxCell>
        <mxCell id="QDhsdInRaVgg9gpE5JQB-57" value="&lt;font style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;We fear death, yet we will all die.&lt;/b&gt;&lt;/font&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#D5D5D5;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;gradientColor=none;" vertex="1" parent="QDhsdInRaVgg9gpE5JQB-56">
          <mxGeometry width="163" height="60" as="geometry">
            <mxRectangle width="163" height="60" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="QDhsdInRaVgg9gpE5JQB-58" value="&lt;font style=&quot;color: rgb(153, 153, 153); font-size: 9px;&quot;&gt;&lt;b&gt;Yes&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;Assuming &quot;speculation is refutation&quot;, then nothing happens after we die.&lt;/span&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#FFCCCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=top;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=-2;" vertex="1" parent="QDhsdInRaVgg9gpE5JQB-56">
          <mxGeometry x="163" width="161" height="60" as="geometry">
            <mxRectangle width="161" height="60" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="QDhsdInRaVgg9gpE5JQB-59" value="&lt;font style=&quot;color: rgb(153, 153, 153); font-size: 9px;&quot;&gt;&lt;b&gt;Yes&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;The gods will judge us as they please.&lt;/font&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#FFFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=-2;" vertex="1" parent="QDhsdInRaVgg9gpE5JQB-56">
          <mxGeometry x="324" width="163" height="60" as="geometry">
            <mxRectangle width="163" height="60" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="QDhsdInRaVgg9gpE5JQB-60" value="&lt;font style=&quot;color: rgb(153, 153, 153); font-size: 9px;&quot;&gt;&lt;b&gt;Yes&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;Life is our opportunity to decide, without coercion, if we want to believe in and love God or not. Death and the Hereafter is where we will be judged accordingly.&lt;/font&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=-2;" vertex="1" parent="QDhsdInRaVgg9gpE5JQB-56">
          <mxGeometry x="487" width="161" height="60" as="geometry">
            <mxRectangle width="161" height="60" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="QDhsdInRaVgg9gpE5JQB-61" value="&lt;font style=&quot;color: rgb(153, 153, 153); font-size: 9px;&quot;&gt;&lt;b&gt;Yes&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;Life is our opportunity to decide, without coercion, if we want to believe in and love God or not. Death and the Hereafter is where we will be judged accordingly.&lt;/font&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CBE2FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=-2;" vertex="1" parent="QDhsdInRaVgg9gpE5JQB-56">
          <mxGeometry x="648" width="162" height="60" as="geometry">
            <mxRectangle width="162" height="60" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="QDhsdInRaVgg9gpE5JQB-62" value="&lt;font style=&quot;&quot;&gt;&lt;b&gt;Alignment with Inferences from Reality&lt;/b&gt; (continued)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=18;fillColor=#f5f5f5;gradientColor=#b3b3b3;strokeColor=#666666;" vertex="1" parent="ML9JfPRL2OMM4K-oLYDR-1">
          <mxGeometry width="810.0000000000001" height="44.9999999999999" as="geometry" />
        </mxCell>
        <mxCell id="ML9JfPRL2OMM4K-oLYDR-2" value="" style="group" vertex="1" connectable="0" parent="QDhsdInRaVgg9gpE5JQB-1">
          <mxGeometry x="20" y="1905" width="810.0000000000001" height="290" as="geometry" />
        </mxCell>
        <mxCell id="QDhsdInRaVgg9gpE5JQB-10" value="" style="shape=table;startSize=0;container=1;collapsible=0;childLayout=tableLayout;fontSize=1;spacingBottom=0;" vertex="1" parent="ML9JfPRL2OMM4K-oLYDR-2">
          <mxGeometry y="45" width="810.0000000000001" height="244.9999999999999" as="geometry" />
        </mxCell>
        <mxCell id="QDhsdInRaVgg9gpE5JQB-11" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" vertex="1" parent="QDhsdInRaVgg9gpE5JQB-10">
          <mxGeometry width="810.0000000000001" height="245" as="geometry" />
        </mxCell>
        <mxCell id="QDhsdInRaVgg9gpE5JQB-12" value="&lt;div&gt;&lt;font size=&quot;1&quot;&gt;&lt;b&gt;Does the belief system align&lt;br&gt;with reality?&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#D5D5D5;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;gradientColor=none;" vertex="1" parent="QDhsdInRaVgg9gpE5JQB-11">
          <mxGeometry width="163" height="245" as="geometry">
            <mxRectangle width="163" height="245" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="QDhsdInRaVgg9gpE5JQB-13" value="&lt;font style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;No (internally contradictory)&lt;/b&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;Every argument reduces to &quot;any explanation with a supernatural god can be refuted with the possibility of a natural explanation&quot;. As such, to make Atheism align with reality, we are required to assume that &quot;speculation is refutation&quot; - thus equally weighting knowledge with ignorance.&lt;br&gt;&lt;br&gt;While this does allow us to dismiss arguments for God&#39;s existence in favor of unobserved possibilities that fit the data, it also doesn&#39;t refute the opposing claim (that God is real), nor does it prevent the opposition from making the same kind of argument in return (that He explains those possibilities and could have created those &quot;natural processes&quot; as well).&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;As such, both a claim and its opposite can be valid under this argument, making truth fundamentally indistinguishable from falsehood and invalidating atheism&#39;s authority to make claims about reality.&lt;/font&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#FFCCCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=top;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=0;" vertex="1" parent="QDhsdInRaVgg9gpE5JQB-11">
          <mxGeometry x="163" width="161" height="245" as="geometry">
            <mxRectangle width="161" height="245" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="QDhsdInRaVgg9gpE5JQB-14" value="&lt;font style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;No (not the best fit)&lt;/b&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;Reality doesn&#39;t support inferring a Polytheistic source of reality. Reality can be observed to operate under fundamental, universally applicable behaviors, and we were created with the capacity for logic that seeks and recognizes a single, fundamental cause for all things.&lt;br&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;Furthermore, the possibility for the gods&#39; wills to contradict each other doesn&#39;t align with reality either, as no contradictions in reality have ever been observed.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;As such, while the existence of multiple atemporal gods seems speculatively valid, it can&#39;t be the best explanation for reality&#39;s source.&lt;/font&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#FFFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=0;" vertex="1" parent="QDhsdInRaVgg9gpE5JQB-11">
          <mxGeometry x="324" width="163" height="245" as="geometry">
            <mxRectangle width="163" height="245" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="QDhsdInRaVgg9gpE5JQB-15" value="&lt;font style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;Yes&lt;br&gt;(pending superior textual authority)&lt;/b&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;This methodology seems to show that properly inferring about reality necessarily leads to the discovery of a single, transcendent source of the universe (of course, assuming the inferences are true without omitting any that are significant).&lt;br&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;As for the concept of Personhood, it requires us to infer that&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;&quot;inferring about reality doesn&#39;t lead to spiritual truth&quot;. This allows&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 8px;&quot;&gt;&amp;nbsp;the Trinity becomes an exception to &quot;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 8px;&quot;&gt;things are identified (or known) by distinguishing their properties from others&quot;, as there is no coherent, identifiable distinction between the 3 Persons.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;As such, because truth still needs to be distinguishable from falsehood,&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;its truth now becomes entirely contingent upon proving that its historical and textual authority is sound and superior to all alternatives.&lt;/span&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=0;" vertex="1" parent="QDhsdInRaVgg9gpE5JQB-11">
          <mxGeometry x="487" width="161" height="245" as="geometry">
            <mxRectangle width="161" height="245" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="QDhsdInRaVgg9gpE5JQB-16" value="&lt;font style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;Yes&lt;/b&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;This methodology shows that properly inferring about reality necessarily leads to the discovery of a single, transcendent source of the universe.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;It also seems to be initially superior to Trinitarianism, as Monotheism can more clearly assert that truth is fundamentally distinguishable from falsehood. However, this will be verified (or refuted) in the next step, as the properties of the textual evidence will need to be compared. Because God is necessarily consistent, and this is reflected in the coherence and consistency of reality, we can expect that the True religion will reflect the same coherence and consistency.&lt;/span&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CBE2FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=0;" vertex="1" parent="QDhsdInRaVgg9gpE5JQB-11">
          <mxGeometry x="648" width="162" height="245" as="geometry">
            <mxRectangle width="162" height="245" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="QDhsdInRaVgg9gpE5JQB-17" value="&lt;b&gt;&lt;font&gt;Conclusions&lt;/font&gt;&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=18;fillColor=#f5f5f5;gradientColor=#b3b3b3;strokeColor=#666666;" vertex="1" parent="ML9JfPRL2OMM4K-oLYDR-2">
          <mxGeometry width="810.0000000000001" height="44.9999999999999" as="geometry" />
        </mxCell>
        <UserObject label="" link="data:page/id,wpfU1qMn-CJc2hLsmo2Y" id="KwOw5QolJIjtXPDDMoCl-2">
          <mxCell style="group" vertex="1" connectable="0" parent="QDhsdInRaVgg9gpE5JQB-1">
            <mxGeometry x="20" y="1125" width="50" height="50" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" id="U1xSaMkx9VoSRVXpbNlL-0">
          <mxCell style="shape=flexArrow;endArrow=classic;html=1;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=default;fillColor=#B3B3B3;" edge="1" parent="KwOw5QolJIjtXPDDMoCl-2">
