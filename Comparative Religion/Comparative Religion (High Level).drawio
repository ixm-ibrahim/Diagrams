        <UserObject label="Building Confidence in the Truth of a Logical Claim" link="data:page/id,lkuSvPZcJC7dHRsydWrw" id="Cbk4jdbypY1MTeg349pZ-46">
          <mxCell parent="hWMIEFPYRjVYOYn_n3Nj-1" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#E6E6E6;" vertex="1">
            <mxGeometry height="30" width="340" x="50" y="10" as="geometry" />
