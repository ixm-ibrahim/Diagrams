        <mxCell id="YZqMC-y3LvAAL2BY0nUx-7" parent="YZqMC-y3LvAAL2BY0nUx-2" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" value="" vertex="1">
          <mxGeometry height="110" width="810.0000000000001" y="215" as="geometry" />
        </mxCell>
        <mxCell id="YZqMC-y3LvAAL2BY0nUx-8" parent="YZqMC-y3LvAAL2BY0nUx-7" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#D5D5D5;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;gradientColor=none;" value="&lt;font style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;All information comes from a source.&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="110" width="163" as="geometry">
            <mxRectangle height="110" width="163" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="YZqMC-y3LvAAL2BY0nUx-9" parent="YZqMC-y3LvAAL2BY0nUx-7" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#FFCCCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=top;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=-2;" value="&lt;font style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;No&lt;/b&gt;&lt;/font&gt;&lt;div&gt;&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;If each process always came from another process (without a cyclical limit), then it results in an infinite regress - which is indistinguishable from a contradiction or false belief.&lt;br&gt;&lt;br&gt;Or, if the universe was created from nothing, then it didn&#39;t come &quot;from&quot; anything to begin with - which contradicts this inference.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="161" x="163" as="geometry">
            <mxRectangle height="110" width="161" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="YZqMC-y3LvAAL2BY0nUx-16" parent="YZqMC-y3LvAAL2BY0nUx-7" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#FFFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=-2;" value="&lt;font style=&quot;color: rgb(153, 153, 153);&quot;&gt;&lt;b style=&quot;font-size: 9px;&quot;&gt;Yes&lt;/b&gt;&lt;br&gt;&lt;/font&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&lt;font style=&quot;color: rgb(153, 153, 153);&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px; color: rgb(153, 153, 153);&quot;&gt;The universe came from the gods, while the gods are uncaused themselves.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px; color: rgb(153, 153, 153);&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&lt;font style=&quot;color: rgb(153, 153, 153);&quot;&gt;If one god created the rest, then those gods would be contingent on the primary god.&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="163" x="324" as="geometry">
            <mxRectangle height="110" width="163" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="YZqMC-y3LvAAL2BY0nUx-19" parent="YZqMC-y3LvAAL2BY0nUx-7" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=-2;" value="&lt;font style=&quot;color: rgb(153, 153, 153); font-size: 9px;&quot;&gt;&lt;b&gt;Yes&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;The universe came from God, while He is uncaused Himself.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="161" x="487" as="geometry">
            <mxRectangle height="110" width="161" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="YZqMC-y3LvAAL2BY0nUx-22" parent="YZqMC-y3LvAAL2BY0nUx-7" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CBE2FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=-2;" value="&lt;font style=&quot;color: rgb(153, 153, 153); font-size: 9px;&quot;&gt;&lt;b&gt;Yes&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;The universe came from God, while He is uncaused Himself.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="162" x="648" as="geometry">
            <mxRectangle height="110" width="162" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="YZqMC-y3LvAAL2BY0nUx-11" parent="YZqMC-y3LvAAL2BY0nUx-2" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" value="" vertex="1">
          <mxGeometry height="175" width="810.0000000000001" y="325" as="geometry" />
        </mxCell>
        <mxCell id="YZqMC-y3LvAAL2BY0nUx-12" parent="YZqMC-y3LvAAL2BY0nUx-11" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#D5D5D5;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;gradientColor=none;" value="&lt;font style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;Every inference has a limit.&lt;br&gt;+&lt;br&gt;Speculation is neither proof nor refutation.&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="175" width="163" as="geometry">
            <mxRectangle height="175" width="163" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="YZqMC-y3LvAAL2BY0nUx-13" parent="YZqMC-y3LvAAL2BY0nUx-11" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#FFCCCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=top;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=-2;" value="&lt;font style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;Maybe&lt;/b&gt;&lt;/font&gt;&lt;div&gt;&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&lt;font style=&quot;color: rgb(102, 102, 102);&quot;&gt;If true, then the universe would have to have been fundamentally created by a&lt;br&gt;not-universe, which could have been some multiversal structure.&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;color: rgb(102, 102, 102); font-size: 8px;&quot;&gt;However, this doesn&#39;t resolve the result of infinite regression, as now the question shifts to what caused the multiverse - without an observed answer.&lt;/span&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&lt;font style=&quot;color: rgb(102, 102, 102);&quot;&gt;&lt;br&gt;&lt;br&gt;&lt;/font&gt;&lt;/span&gt;&lt;font color=&quot;#666666&quot;&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;Also, any explanation for the universe&#39;s origin is speculative, requiring us to infer that &quot;arguments from ignorance are stronger than arguments of best-fit&quot;. However, this would also require the contradiction of &quot;speculation is neither proof nor refutation&quot; - ie. &quot;speculation &lt;b&gt;is&lt;/b&gt;&amp;nbsp;proof/refutation&quot;.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="175" width="161" x="163" as="geometry">
            <mxRectangle height="175" width="161" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="YZqMC-y3LvAAL2BY0nUx-17" parent="YZqMC-y3LvAAL2BY0nUx-11" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#FFFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=-2;" value="&lt;font style=&quot;color: rgb(153, 153, 153); font-size: 9px;&quot;&gt;&lt;b&gt;Yes&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;Reality is temporal and contingent, while the gods must be eternal and uncaused.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="175" width="163" x="324" as="geometry">
            <mxRectangle height="175" width="163" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="YZqMC-y3LvAAL2BY0nUx-20" parent="YZqMC-y3LvAAL2BY0nUx-11" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=-2;" value="&lt;font style=&quot;color: rgb(153, 153, 153); font-size: 9px;&quot;&gt;&lt;b&gt;Yes&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;Reality is temporal and contingent, while God must be eternal and uncaused.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="175" width="161" x="487" as="geometry">
            <mxRectangle height="175" width="161" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="YZqMC-y3LvAAL2BY0nUx-23" parent="YZqMC-y3LvAAL2BY0nUx-11" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CBE2FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=-2;" value="&lt;font style=&quot;color: rgb(153, 153, 153); font-size: 9px;&quot;&gt;&lt;b&gt;Yes&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;Reality is temporal and contingent, while God must be eternal and uncaused.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="175" width="162" x="648" as="geometry">
            <mxRectangle height="175" width="162" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Aw4qQZnFIbvZ1GE5txsA-0" parent="YZqMC-y3LvAAL2BY0nUx-2" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" vertex="1">
          <mxGeometry height="90" width="810.0000000000001" y="500" as="geometry" />
        </mxCell>
        <mxCell id="Aw4qQZnFIbvZ1GE5txsA-1" parent="Aw4qQZnFIbvZ1GE5txsA-0" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#D5D5D5;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;gradientColor=none;" value="&lt;div&gt;&lt;font style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;Every thing that has a beginning&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;b style=&quot;font-size: 9px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;has a preceding cause.&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b style=&quot;font-size: 9px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;+&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b style=&quot;font-size: 9px;&quot;&gt;All things are contingent on their causes (that are not the thing).&lt;/b&gt;&lt;b style=&quot;font-size: 9px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="163" as="geometry">
            <mxRectangle height="90" width="163" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Aw4qQZnFIbvZ1GE5txsA-2" parent="Aw4qQZnFIbvZ1GE5txsA-0" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#FFCCCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=top;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=-2;" value="&lt;font style=&quot;color: rgb(153, 153, 153); font-size: 9px;&quot;&gt;&lt;b&gt;Yes&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;Assuming &quot;speculation is proof/refutation&quot;, then the universe could be the one exception that was created by an infinite regress.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="161" x="163" as="geometry">
            <mxRectangle height="90" width="161" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Aw4qQZnFIbvZ1GE5txsA-3" parent="Aw4qQZnFIbvZ1GE5txsA-0" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#FFFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=-2;" value="&lt;font style=&quot;color: rgb(153, 153, 153);&quot;&gt;&lt;b style=&quot;font-size: 9px;&quot;&gt;Yes&lt;/b&gt;&lt;br&gt;&lt;/font&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&lt;font style=&quot;color: rgb(153, 153, 153);&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px; color: rgb(153, 153, 153);&quot;&gt;The universe was created by a non-universe, the gods. And they never began, therefore they don&#39;t have a cause.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px; color: rgb(153, 153, 153);&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px; color: rgb(153, 153, 153);&quot;&gt;If some of the gods were created by others, then there is still some uncaused god that was the source of all the others.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="163" x="324" as="geometry">
            <mxRectangle height="90" width="163" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Aw4qQZnFIbvZ1GE5txsA-4" parent="Aw4qQZnFIbvZ1GE5txsA-0" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=-2;" value="&lt;font style=&quot;color: rgb(153, 153, 153); font-size: 9px;&quot;&gt;&lt;b&gt;Yes&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;The universe was created by a non-universe, God. And because He never began, He doesn&#39;t have a cause.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="161" x="487" as="geometry">
            <mxRectangle height="90" width="161" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Aw4qQZnFIbvZ1GE5txsA-5" parent="Aw4qQZnFIbvZ1GE5txsA-0" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CBE2FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=-2;" value="&lt;font style=&quot;color: rgb(153, 153, 153); font-size: 9px;&quot;&gt;&lt;b&gt;Yes&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;The universe was created by a non-universe, God. And because He never began, He doesn&#39;t have a cause.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="162" x="648" as="geometry">
            <mxRectangle height="90" width="162" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Aw4qQZnFIbvZ1GE5txsA-12" parent="YZqMC-y3LvAAL2BY0nUx-2" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" vertex="1">
          <mxGeometry height="60" width="810.0000000000001" y="590" as="geometry" />
        </mxCell>
        <mxCell id="Aw4qQZnFIbvZ1GE5txsA-13" parent="Aw4qQZnFIbvZ1GE5txsA-12" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#D5D5D5;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;gradientColor=none;" value="&lt;font style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;Reality has a universally applicable set of fundamental laws.&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="60" width="163" as="geometry">
            <mxRectangle height="60" width="163" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Aw4qQZnFIbvZ1GE5txsA-14" parent="Aw4qQZnFIbvZ1GE5txsA-12" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#FFCCCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=top;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=-2;" value="&lt;font style=&quot;color: rgb(153, 153, 153); font-size: 9px;&quot;&gt;&lt;b&gt;Yes&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;Natural laws are very consistent and universally applicable. They don&#39;t need some &quot;god&quot; explanation to make sense.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="161" x="163" as="geometry">
            <mxRectangle height="60" width="161" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Aw4qQZnFIbvZ1GE5txsA-15" parent="Aw4qQZnFIbvZ1GE5txsA-12" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#FFFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=-2;" value="&lt;font style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;No&lt;/b&gt;&lt;/font&gt;&lt;div&gt;&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;If multiple gods exist, and reality is &quot;made of&quot; the gods&#39; wills, then reality must fundamentally be reduced to each of their wills - ie. many fundamental laws.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="163" x="324" as="geometry">
            <mxRectangle height="60" width="163" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Aw4qQZnFIbvZ1GE5txsA-16" parent="Aw4qQZnFIbvZ1GE5txsA-12" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=-2;" value="&lt;font style=&quot;color: rgb(153, 153, 153); font-size: 9px;&quot;&gt;&lt;b&gt;Yes&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;God&#39;s will is what reality is &quot;made of&quot;, so His will is the fundamental and universal law that affects all things.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="161" x="487" as="geometry">
            <mxRectangle height="60" width="161" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Aw4qQZnFIbvZ1GE5txsA-17" parent="Aw4qQZnFIbvZ1GE5txsA-12" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CBE2FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=-2;" value="&lt;font style=&quot;color: rgb(153, 153, 153); font-size: 9px;&quot;&gt;&lt;b&gt;Yes&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;God&#39;s will is what reality is &quot;made of&quot;, so His will is the fundamental and universal law that affects all things.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="162" x="648" as="geometry">
            <mxRectangle height="60" width="162" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Aw4qQZnFIbvZ1GE5txsA-18" parent="YZqMC-y3LvAAL2BY0nUx-2" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" vertex="1">
          <mxGeometry height="110" width="810.0000000000001" y="650" as="geometry" />
        </mxCell>
        <mxCell id="Aw4qQZnFIbvZ1GE5txsA-19" parent="Aw4qQZnFIbvZ1GE5txsA-18" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#D5D5D5;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;gradientColor=none;" value="&lt;font style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;Consciousness can&#39;t be reduced to purely physical components.&amp;nbsp;&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="110" width="163" as="geometry">
            <mxRectangle height="110" width="163" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Aw4qQZnFIbvZ1GE5txsA-20" parent="Aw4qQZnFIbvZ1GE5txsA-18" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#FFCCCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=top;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=-2;" value="&lt;font style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;Maybe&lt;/b&gt;&lt;/font&gt;&lt;div&gt;&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&lt;font style=&quot;color: rgb(102, 102, 102);&quot;&gt;Consciousness is observed to correlate with the brain, therefore it could be an emergent property from how it&#39;s structured.&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&lt;font style=&quot;color: rgb(102, 102, 102);&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&lt;font style=&quot;color: rgb(102, 102, 102);&quot;&gt;However, this still doesn&#39;t explain phenomenal consciousness, and if &quot;speculation is&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;&lt;font color=&quot;#666666&quot;&gt;proof/&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(102, 102, 102), rgb(149, 149, 149)); font-size: 8px; background-color: transparent;&quot;&gt;refutation&quot;, then it could be because of some natural process that we simply don&#39;t know yet.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="161" x="163" as="geometry">
            <mxRectangle height="110" width="161" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Aw4qQZnFIbvZ1GE5txsA-21" parent="Aw4qQZnFIbvZ1GE5txsA-18" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#FFFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=-2;" value="&lt;font style=&quot;color: rgb(153, 153, 153); font-size: 9px;&quot;&gt;&lt;b&gt;Yes&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;Just as the gods are spiritual in nature, so are we.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="163" x="324" as="geometry">
            <mxRectangle height="110" width="163" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Aw4qQZnFIbvZ1GE5txsA-22" parent="Aw4qQZnFIbvZ1GE5txsA-18" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=-2;" value="&lt;font style=&quot;color: rgb(153, 153, 153); font-size: 9px;&quot;&gt;&lt;b&gt;Yes&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;God breathed the breath of life in us, such that our spirit is immortal (or, at the very least, connected with eternality in some way).&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="161" x="487" as="geometry">
            <mxRectangle height="110" width="161" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Aw4qQZnFIbvZ1GE5txsA-23" parent="Aw4qQZnFIbvZ1GE5txsA-18" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CBE2FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=-2;" value="&lt;font style=&quot;color: rgb(153, 153, 153); font-size: 9px;&quot;&gt;&lt;b&gt;Yes&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;God breathed His spirit in us, such that our souls are unseen in the spiritual realm.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="162" x="648" as="geometry">
