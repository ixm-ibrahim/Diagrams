        <mxCell id="dyAkvh6oCZAIHyciMj3W-6" parent="dyAkvh6oCZAIHyciMj3W-5" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCE5FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=middle;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;swimlaneFillColor=none;gradientColor=none;gradientDirection=east;" value="&lt;font style=&quot;font-size: 8px;&quot;&gt;Let&#39;s assume that Islam is true. What deceptive changes would Christianity introduce?&lt;/font&gt;" vertex="1">
