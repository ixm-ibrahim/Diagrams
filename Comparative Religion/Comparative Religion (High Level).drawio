        <mxCell id="zuZuHAAaARETqynN6Csq-4" value="&lt;b&gt;&lt;font&gt;1. What are the apparent similarities and differences between Islam and Christianity?&lt;/font&gt;&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=18;fillColor=#F8CECC;gradientColor=#EA6B66;strokeColor=#B85450;" vertex="1" parent="zuZuHAAaARETqynN6Csq-1">
          <mxGeometry x="20" y="9985" width="810.0000000000001" height="44.9999999999999" as="geometry" />
        </mxCell>
        <mxCell id="S8Pw8Tw3iUAq8b6uVJTt-0" value="" style="shape=table;startSize=0;container=1;collapsible=0;childLayout=tableLayout;fontSize=1;" vertex="1" parent="zuZuHAAaARETqynN6Csq-1">
          <mxGeometry x="20" y="10030" width="75" height="425" as="geometry" />
        </mxCell>
        <mxCell id="S8Pw8Tw3iUAq8b6uVJTt-1" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;swimlaneFillColor=none;" vertex="1" parent="S8Pw8Tw3iUAq8b6uVJTt-0">
          <mxGeometry width="75" height="425" as="geometry" />
        </mxCell>
        <mxCell id="S8Pw8Tw3iUAq8b6uVJTt-2" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b style=&quot;&quot;&gt;God&lt;/b&gt;&lt;/font&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#E6E6E6;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=middle;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;swimlaneFillColor=none;gradientColor=none;gradientDirection=east;" vertex="1" parent="S8Pw8Tw3iUAq8b6uVJTt-1">
          <mxGeometry width="75" height="425" as="geometry">
            <mxRectangle width="75" height="425" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="S8Pw8Tw3iUAq8b6uVJTt-72" value="" style="group" vertex="1" connectable="0" parent="zuZuHAAaARETqynN6Csq-1">
          <mxGeometry x="95" y="10030" width="735" height="100" as="geometry" />
        </mxCell>
        <mxCell id="S8Pw8Tw3iUAq8b6uVJTt-13" value="" style="shape=table;startSize=0;container=1;collapsible=0;childLayout=tableLayout;fontSize=1;" vertex="1" parent="S8Pw8Tw3iUAq8b6uVJTt-72">
          <mxGeometry x="105" width="630" height="100" as="geometry" />
        </mxCell>
        <mxCell id="S8Pw8Tw3iUAq8b6uVJTt-14" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;swimlaneFillColor=none;" vertex="1" parent="S8Pw8Tw3iUAq8b6uVJTt-13">
          <mxGeometry width="630" height="75" as="geometry" />
        </mxCell>
        <mxCell id="S8Pw8Tw3iUAq8b6uVJTt-16" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;&amp;nbsp;- &quot;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;Hear, O Israel: The Lord our God, &lt;b&gt;the Lord is one&lt;/b&gt;.&quot; (Deut 6:4)&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;&amp;nbsp;- &quot;&#39;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;The most important one,&#39; answered Jesus, &#39;is this: ‘Hear, O Israel: &lt;b&gt;The Lord our God, the Lord is one&lt;/b&gt;.&#39;&quot; (Mark 12:29-31)&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;&amp;nbsp;- &quot;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;For &lt;b&gt;there is one God&lt;/b&gt; and one mediator between God and mankind, the man Christ Jesus&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&quot; (1 Timothy 2:5)&lt;/span&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=middle;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;swimlaneFillColor=none;gradientColor=none;gradientDirection=east;align=left;" vertex="1" parent="S8Pw8Tw3iUAq8b6uVJTt-14">
          <mxGeometry width="315" height="75" as="geometry">
            <mxRectangle width="315" height="75" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="S8Pw8Tw3iUAq8b6uVJTt-17" value="&lt;div style=&quot;&quot;&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;&amp;nbsp;- &quot;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&lt;b&gt;Your god is one God: There is no god but He&lt;/b&gt;, the All-Merciful, the Ever-Merciful.&quot; (Quran 2:163)&lt;/span&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;&amp;nbsp;- &quot;&lt;b&gt;That is God - your Lord! There is no god&lt;/b&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&lt;b&gt;&amp;nbsp;˹worthy of worship˺ except Him&lt;/b&gt;. ˹He is˺ the Creator of all things, &lt;b&gt;so worship Him ˹alone˺&lt;/b&gt;. And He is the Maintainer of everything.&quot; (Quran 6:102)&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- &quot;Say: &lt;b&gt;He is God, the One!&lt;/b&gt; God - the Sustainer&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;˹needed by all˺.&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;He neither begot any nor was He begotten,&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;&lt;b&gt;and there is none comparable unto Him&lt;/b&gt;.&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;&quot; (Quran 112)&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCE5FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=middle;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;swimlaneFillColor=none;gradientColor=none;gradientDirection=east;align=left;" vertex="1" parent="S8Pw8Tw3iUAq8b6uVJTt-14">
          <mxGeometry x="315" width="315" height="75" as="geometry">
            <mxRectangle width="315" height="75" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="S8Pw8Tw3iUAq8b6uVJTt-68" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;swimlaneFillColor=none;" vertex="1" parent="S8Pw8Tw3iUAq8b6uVJTt-13">
