        <mxCell id="QDhsdInRaVgg9gpE5JQB-28" parent="QDhsdInRaVgg9gpE5JQB-26" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#FFCCCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=top;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=-2;" value="&lt;font style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;Maybe&lt;/b&gt;&lt;/font&gt;&lt;div&gt;&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&lt;font style=&quot;color: rgb(102, 102, 102);&quot;&gt;Assuming &quot;speculation is&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;&lt;font color=&quot;#666666&quot;&gt;proof/&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(102, 102, 102), rgb(149, 149, 149)); font-size: 8px; background-color: transparent;&quot;&gt;refutation&quot;, then quantum randomness could explain whether or not we have an indeterministic will - although, this opens the door to all matter possessing such a will as well, as we are all made of the same materials.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&lt;font style=&quot;color: rgb(102, 102, 102);&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&lt;font style=&quot;color: rgb(102, 102, 102);&quot;&gt;Or, if that isn&#39;t it, then this inference can&#39;t be true, as our &quot;choices&quot; are simply a necessary effect of a long chain of complex (but ultimately deterministic) causes going back to the initial conditions of the universe.&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="161" x="163" as="geometry">
            <mxRectangle height="140" width="161" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="QDhsdInRaVgg9gpE5JQB-29" parent="QDhsdInRaVgg9gpE5JQB-26" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#FFFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=-2;" value="&lt;font style=&quot;color: rgb(153, 153, 153); font-size: 9px;&quot;&gt;&lt;b&gt;Yes&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;If we have a spiritual component that explains our phenomenal experience, then that is the source of our ability to make choices.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="163" x="324" as="geometry">
            <mxRectangle height="140" width="163" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="QDhsdInRaVgg9gpE5JQB-30" parent="QDhsdInRaVgg9gpE5JQB-26" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=-2;" value="&lt;font style=&quot;color: rgb(153, 153, 153); font-size: 9px;&quot;&gt;&lt;b&gt;Yes&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;The source of our awareness is the same source as that of our wills: the soul.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="161" x="487" as="geometry">
            <mxRectangle height="140" width="161" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="QDhsdInRaVgg9gpE5JQB-31" parent="QDhsdInRaVgg9gpE5JQB-26" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CBE2FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=-2;" value="&lt;font style=&quot;color: rgb(153, 153, 153); font-size: 9px;&quot;&gt;&lt;b&gt;Yes&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;The source of our awareness is the same source as that of our wills: the soul.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="162" x="648" as="geometry">
            <mxRectangle height="140" width="162" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="QDhsdInRaVgg9gpE5JQB-32" parent="QDhsdInRaVgg9gpE5JQB-19" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" vertex="1">
          <mxGeometry height="90" width="810.0000000000001" y="200" as="geometry" />
        </mxCell>
        <mxCell id="QDhsdInRaVgg9gpE5JQB-33" parent="QDhsdInRaVgg9gpE5JQB-32" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#D5D5D5;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;gradientColor=none;" value="&lt;div&gt;&lt;font style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;We have a disposition for concepts of morality&lt;/b&gt;&lt;/font&gt;&lt;b style=&quot;font-size: 9px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;.&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b style=&quot;font-size: 9px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;+&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;We have a disposition for concepts of justice&lt;/b&gt;&lt;/font&gt;&lt;b style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); background-color: transparent; font-size: 9px;&quot;&gt;.&lt;/b&gt;&lt;b style=&quot;font-size: 9px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="163" as="geometry">
            <mxRectangle height="90" width="163" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="QDhsdInRaVgg9gpE5JQB-34" parent="QDhsdInRaVgg9gpE5JQB-32" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#FFCCCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=top;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=-2;" value="&lt;font style=&quot;color: rgb(153, 153, 153); font-size: 9px;&quot;&gt;&lt;b&gt;Yes&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;This is a psychological artifact of evolution, in which our fundamental drive was survival. &quot;Morality&quot; and &quot;justice&quot; are fundamentally subjective (either to the individual or to the majority), without some objective &quot;god&quot; that arbitrarily decides what is right and wrong.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="161" x="163" as="geometry">
            <mxRectangle height="90" width="161" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="QDhsdInRaVgg9gpE5JQB-35" parent="QDhsdInRaVgg9gpE5JQB-32" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#FFFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=-2;" value="&lt;font style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;Maybe&lt;/b&gt;&lt;/font&gt;&lt;div&gt;&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&lt;font style=&quot;color: rgb(102, 102, 102);&quot;&gt;If the gods&#39; wills are all the same, then there is no issue: what is right is what the gods collectively will.&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&lt;font style=&quot;color: rgb(102, 102, 102);&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&lt;font style=&quot;color: rgb(102, 102, 102);&quot;&gt;Otherwise, if the gods&#39; wills differ, than the Euthyphro Dilemma becomes relevant, as contradictory wills = contradictory morality.&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="163" x="324" as="geometry">
            <mxRectangle height="90" width="163" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="QDhsdInRaVgg9gpE5JQB-36" parent="QDhsdInRaVgg9gpE5JQB-32" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=-2;" value="&lt;font style=&quot;color: rgb(153, 153, 153); font-size: 9px;&quot;&gt;&lt;b&gt;Yes&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;This is a result of our purpose (to willfully choose God) and the Holy Spirit, pulling us towards God.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="161" x="487" as="geometry">
            <mxRectangle height="90" width="161" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="QDhsdInRaVgg9gpE5JQB-37" parent="QDhsdInRaVgg9gpE5JQB-32" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CBE2FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=-2;" value="&lt;font style=&quot;color: rgb(153, 153, 153); font-size: 9px;&quot;&gt;&lt;b&gt;Yes&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;This is a result of our purpose (to willfully choose God) and the &lt;i&gt;fitrah&lt;/i&gt; (innate pull towards God) that He instilled in us.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="162" x="648" as="geometry">
            <mxRectangle height="90" width="162" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="QDhsdInRaVgg9gpE5JQB-38" parent="QDhsdInRaVgg9gpE5JQB-19" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" vertex="1">
          <mxGeometry height="80" width="810.0000000000001" y="290" as="geometry" />
        </mxCell>
        <mxCell id="QDhsdInRaVgg9gpE5JQB-39" parent="QDhsdInRaVgg9gpE5JQB-38" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#D5D5D5;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;gradientColor=none;" value="&lt;div&gt;&lt;b style=&quot;font-size: 9px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;There is a seen reality and an unseen reality.&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="80" width="163" as="geometry">
            <mxRectangle height="80" width="163" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="QDhsdInRaVgg9gpE5JQB-40" parent="QDhsdInRaVgg9gpE5JQB-38" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#FFCCCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=top;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=-2;" value="&lt;font style=&quot;color: rgb(153, 153, 153); font-size: 9px;&quot;&gt;&lt;b&gt;Yes&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;Inferences, logic and math, dark matter and energy, etc. are all examples of realities that we can&#39;t see. But (assuming &quot;speculation is proof/refutation&quot;), there is no evidence for unseen gods, angels, or demons - any non-physical, willful agent.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="80" width="161" x="163" as="geometry">
            <mxRectangle height="80" width="161" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="QDhsdInRaVgg9gpE5JQB-41" parent="QDhsdInRaVgg9gpE5JQB-38" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#FFFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=-2;" value="&lt;font style=&quot;color: rgb(153, 153, 153); font-size: 9px;&quot;&gt;&lt;b&gt;Yes&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;We can see the physical realm without being able to see the spiritual realm.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="80" width="163" x="324" as="geometry">
            <mxRectangle height="80" width="163" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="QDhsdInRaVgg9gpE5JQB-42" parent="QDhsdInRaVgg9gpE5JQB-38" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=-2;" value="&lt;font style=&quot;color: rgb(153, 153, 153); font-size: 9px;&quot;&gt;&lt;b&gt;Yes&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;There is a physical realm and a spiritual realm, with hierarchies of existence to both.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="80" width="161" x="487" as="geometry">
            <mxRectangle height="80" width="161" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="QDhsdInRaVgg9gpE5JQB-43" parent="QDhsdInRaVgg9gpE5JQB-38" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CBE2FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=-2;" value="&lt;font style=&quot;color: rgb(153, 153, 153); font-size: 9px;&quot;&gt;&lt;b&gt;Yes&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;There is what we see and what we can&#39;t see, with hierarchies of existence to both.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="80" width="162" x="648" as="geometry">
            <mxRectangle height="80" width="162" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="QDhsdInRaVgg9gpE5JQB-44" parent="QDhsdInRaVgg9gpE5JQB-19" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" vertex="1">
          <mxGeometry height="155" width="810.0000000000001" y="370" as="geometry" />
        </mxCell>
        <mxCell id="QDhsdInRaVgg9gpE5JQB-45" parent="QDhsdInRaVgg9gpE5JQB-44" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#D5D5D5;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;gradientColor=none;" value="&lt;div&gt;&lt;b style=&quot;font-size: 9px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Falsehood is easier and more common, while good is harder and more valued.&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="155" width="163" as="geometry">
            <mxRectangle height="155" width="163" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="QDhsdInRaVgg9gpE5JQB-46" parent="QDhsdInRaVgg9gpE5JQB-44" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#FFCCCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=top;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=-2;" value="&lt;font style=&quot;color: rgb(153, 153, 153); font-size: 9px;&quot;&gt;&lt;b&gt;Yes&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;It&#39;s impossible to know anything for certain, since there are an infinite number of falsehoods for each truth. And even with each truth, all models of understanding are inherently wrong as they fall short from the complexities of reality. Not only that, but we only experience the effects of things, not essences themselves - so it&#39;s impossible for us to know anything for certain.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="155" width="161" x="163" as="geometry">
            <mxRectangle height="155" width="161" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="QDhsdInRaVgg9gpE5JQB-47" parent="QDhsdInRaVgg9gpE5JQB-44" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#FFFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=-2;" value="&lt;font style=&quot;color: rgb(153, 153, 153); font-size: 9px;&quot;&gt;&lt;b&gt;Yes&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;There are more ways to disobey the gods than to obey them.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="155" width="163" x="324" as="geometry">
            <mxRectangle height="155" width="163" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="QDhsdInRaVgg9gpE5JQB-48" parent="QDhsdInRaVgg9gpE5JQB-44" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=-2;" value="&lt;font style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;Maybe&lt;/b&gt;&lt;/font&gt;&lt;div&gt;&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&lt;font style=&quot;color: rgb(102, 102, 102);&quot;&gt;We live in a broken world, fallen short of God&#39;s grace, where perfect righteousness is impossible and evil runs free. The only exception is the perfect goodness of Jesus (God in the human Person), who fulfilled the weight of human sin and allowed us to achieve salvation through belief in him.&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&lt;font style=&quot;color: rgb(102, 102, 102);&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&lt;font style=&quot;color: rgb(102, 102, 102);&quot;&gt;Having said that, &quot;good is harder and more valued&quot; doesn&#39;t quite fit this narrative, as it can only be applied here in the context of salvation through God&#39;s perfection&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(102, 102, 102), rgb(149, 149, 149)); font-size: 8px; background-color: transparent;&quot;&gt;&amp;nbsp;- not generally with human actions, as this inference implies.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="155" width="161" x="487" as="geometry">
            <mxRectangle height="155" width="161" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="QDhsdInRaVgg9gpE5JQB-49" parent="QDhsdInRaVgg9gpE5JQB-44" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CBE2FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=-2;" value="&lt;font style=&quot;color: rgb(153, 153, 153); font-size: 9px;&quot;&gt;&lt;b&gt;Yes&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;This world is a test of faith, to see if we will willingly choose to follow God&#39;s will instead of worldly distractions (both positive and negative). Even though evil is more prevalent than good, good is still weighted much more strongly than evil out of God&#39;s love and mercy. He always reveals His mercy before His punishment, from the first human being to us now.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="155" width="162" x="648" as="geometry">
            <mxRectangle height="155" width="162" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="QDhsdInRaVgg9gpE5JQB-50" parent="QDhsdInRaVgg9gpE5JQB-19" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" vertex="1">
