  </diagram>
  <diagram name="7. Non-Fundamental Comparison (3/7)" id="koprSnZA8Zx8r47souDI">
    <mxGraphModel dx="1016" dy="-9080" grid="1" gridSize="5" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" background="#CCCCCC" math="0" shadow="0" adaptiveColors="none">
      <root>
        <mxCell id="sYscbi_ctIr7rLCjfTU3-0" />
        <mxCell id="sYscbi_ctIr7rLCjfTU3-1" parent="sYscbi_ctIr7rLCjfTU3-0" />
        <UserObject label="Non-Fundamental Comparison: Christianity vs. Islam (3/7)" link="data:page/id,lkuSvPZcJC7dHRsydWrw" id="sYscbi_ctIr7rLCjfTU3-2">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#E6E6E6;fontSize=20;" parent="sYscbi_ctIr7rLCjfTU3-1" vertex="1">
            <mxGeometry x="20" y="9920" width="810" height="50" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="KHh0-gxxOiwRamkPE_v--0" value="" style="shape=table;startSize=0;container=1;collapsible=0;childLayout=tableLayout;fontSize=1;" parent="sYscbi_ctIr7rLCjfTU3-1" vertex="1">
          <mxGeometry x="20" y="10030" width="810" height="220" as="geometry" />
        </mxCell>
        <mxCell id="KHh0-gxxOiwRamkPE_v--1" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" parent="KHh0-gxxOiwRamkPE_v--0" vertex="1">
          <mxGeometry width="810" height="95" as="geometry" />
        </mxCell>
        <mxCell id="KHh0-gxxOiwRamkPE_v--2" value="&lt;font size=&quot;1&quot;&gt;&lt;b&gt;What status was Adam created in? Or, why was Adam created to begin with?&lt;/b&gt;&lt;/font&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#F8CECC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;gradientColor=#EA6B66;opacity=85;" parent="KHh0-gxxOiwRamkPE_v--1" vertex="1">
          <mxGeometry width="160" height="95" as="geometry">
            <mxRectangle width="160" height="95" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="KHh0-gxxOiwRamkPE_v--3" value="&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;b style=&quot;&quot;&gt;In a state of original perfection and holiness, being made in the image of God&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;Adam was formed from the ground, made in the image and likeness of God and given the breath of life, and was placed in Eden, being tasked with its till/keep, and given the dominion over all living creatures. This is interpreted as being created in a state of original, perfect holiness and justice (elevated friendship and communion with God).&lt;/span&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=top;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;" parent="KHh0-gxxOiwRamkPE_v--1" vertex="1">
          <mxGeometry x="160" width="255" height="95" as="geometry">
            <mxRectangle width="255" height="95" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="KHh0-gxxOiwRamkPE_v--4" value="&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;b style=&quot;&quot;&gt;In a state of honor and naturally inclined towards God, whose purpose is to be vicegerents on Earth&lt;/b&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;Adam was formed from the Earth and God&#39;s spirit in an honored state, being instilled with the &lt;i&gt;fitrah&lt;/i&gt; (natural inclination towards God) and created for him and his progeny to be vicegerents (someone representing and exercising delegated power on behalf of a sovereign/ruler) on Earth. God initially places Adam in Eden to enjoy a time of bliss.&lt;/font&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCE5FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;" parent="KHh0-gxxOiwRamkPE_v--1" vertex="1">
          <mxGeometry x="415" width="255" height="95" as="geometry">
            <mxRectangle width="255" height="95" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="NS1qVDsZFFGCCMZgjAUG-148" value="&lt;span style=&quot;font-size: 8px; background-color: rgba(204, 255, 204, 0.3);&quot;&gt;&lt;b style=&quot;&quot;&gt;Perfect holiness and communion with God, made to be in Heaven&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;font style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;br&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;vs.&lt;/span&gt;&lt;br&gt;&lt;font style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;br&gt;&lt;span style=&quot;font-size: 8px; background-color: rgba(204, 229, 255, 0.3);&quot;&gt;&lt;b style=&quot;&quot;&gt;Honor and natural inclination towards God, made to be tested on Earth&lt;/b&gt;&lt;/span&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#CCCCCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=middle;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;gradientColor=none;" parent="KHh0-gxxOiwRamkPE_v--1" vertex="1">
          <mxGeometry x="670" width="140" height="95" as="geometry">
            <mxRectangle width="140" height="95" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="KHh0-gxxOiwRamkPE_v--17" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" parent="KHh0-gxxOiwRamkPE_v--0" vertex="1">
          <mxGeometry y="95" width="810" height="125" as="geometry" />
        </mxCell>
        <mxCell id="KHh0-gxxOiwRamkPE_v--18" value="&lt;b style=&quot;font-size: x-small;&quot;&gt;What did God provide Adam with?&lt;/b&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#F8CECC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;gradientColor=#EA6B66;opacity=85;" parent="KHh0-gxxOiwRamkPE_v--17" vertex="1">
          <mxGeometry width="160" height="125" as="geometry">
            <mxRectangle width="160" height="125" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="KHh0-gxxOiwRamkPE_v--19" value="&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Preternatural gifts, dominion, a companion, and responsibility&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;Adam was given a garden with an abundance of accessible food and dominion over all living creatures, having the authority to name the animals himself. He was also given Eve as a companion, and the responsibility to till and keep the garden (a task that lacked toil and pain). This is interpreted as God giving Adam sanctifying grace (friendship with God), infused knowledge with preternatural gifts (ie. rightly ordered passions, freedom from suffering, immortality), and the inscription of the natural law (a rightly ordered conscience) on his heart.&lt;/span&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=top;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;" parent="KHh0-gxxOiwRamkPE_v--17" vertex="1">
          <mxGeometry x="160" width="255" height="125" as="geometry">
            <mxRectangle width="255" height="125" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="KHh0-gxxOiwRamkPE_v--20" value="&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Knowledge, elevated honor above the angels, a companion, a blissful life in Eden, and a warning them of Satan and how they can be expelled&lt;/b&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;Before placing Adam in Eden, God created Eve as a spouse, instilled the &lt;i&gt;fitrah&lt;/i&gt;&amp;nbsp;in him, and taught him the names of all things - knowledge the angels didn&#39;t have - and elevated him over them by commanding the angels to prostrate to him. Then, God places him in Eden, promising that he would experience bliss without hunger, thirst, scorching heat, or feeling naked or otherwise vulnerable - and with a clear warning about Satan&#39;s enmity and his desire to expel them from the garden.&lt;/font&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCE5FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;" parent="KHh0-gxxOiwRamkPE_v--17" vertex="1">
          <mxGeometry x="415" width="255" height="125" as="geometry">
            <mxRectangle width="255" height="125" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="NS1qVDsZFFGCCMZgjAUG-149" value="&lt;span style=&quot;font-size: 8px; background-color: rgba(204, 255, 204, 0.3);&quot;&gt;&lt;b style=&quot;&quot;&gt;Dominion, friendship with God, blissful responsibility, infused knowledge, immortality, and rightly ordered conscience&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;font style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;br&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;vs.&lt;/span&gt;&lt;br&gt;&lt;font style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;br&gt;&lt;span style=&quot;font-size: 8px; background-color: rgba(204, 229, 255, 0.3);&quot;&gt;&lt;b style=&quot;&quot;&gt;Bliss, elevated honor, taught knowledge of reality, and warning of Satan&lt;/b&gt;&lt;/span&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#CCCCCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=middle;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;gradientColor=none;" parent="KHh0-gxxOiwRamkPE_v--17" vertex="1">
          <mxGeometry x="670" width="140" height="125" as="geometry">
            <mxRectangle width="140" height="125" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_tAuc-q2iSTF11M6xx4O-0" value="" style="shape=table;startSize=0;container=1;collapsible=0;childLayout=tableLayout;fontSize=1;" parent="sYscbi_ctIr7rLCjfTU3-1" vertex="1">
          <mxGeometry x="20" y="10255" width="810" height="240" as="geometry" />
        </mxCell>
        <mxCell id="_tAuc-q2iSTF11M6xx4O-11" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" parent="_tAuc-q2iSTF11M6xx4O-0" vertex="1">
          <mxGeometry width="810" height="135" as="geometry" />
        </mxCell>
        <mxCell id="_tAuc-q2iSTF11M6xx4O-12" value="&lt;b style=&quot;font-size: x-small;&quot;&gt;What was Eden&#39;s purpose? Why did it come with a prohibition?&lt;/b&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#FFDEC9;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;gradientColor=#FFB663;opacity=85;" parent="_tAuc-q2iSTF11M6xx4O-11" vertex="1">
          <mxGeometry width="160" height="135" as="geometry">
            <mxRectangle width="160" height="135" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_tAuc-q2iSTF11M6xx4O-13" value="&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;b style=&quot;&quot;&gt;A place of perfect communion, where the prohibition serves as a test of filial trust&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;Eden was a dwelling place for man to till and keep (as a priestly responsibility) that is pleasant to the sight and good for food. God&#39;s only prohibition was from them eating from the Tree of the Knowledge of Good and&amp;nbsp; Evil, for doing so will cause them to die. This is interpreted as Eden being a holy place of perfect communion with God, where Adam is given free will and a moral test of filial trust (ie. assurance in God&#39;s love) and obedience. The choice to autonomously disobey God would then result in the loss of that sanctifying grace.&lt;/span&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=top;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;" parent="_tAuc-q2iSTF11M6xx4O-11" vertex="1">
          <mxGeometry x="160" width="255" height="135" as="geometry">
            <mxRectangle width="255" height="135" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_tAuc-q2iSTF11M6xx4O-14" value="&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;b style=&quot;&quot;&gt;A blissful dwelling place, where the prohibition serves as a study guide for their purpose on Earth&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;Eden was a dwelling place for Adam and Eve to experience bliss, ease, and to eat from whatever they wished - neither experiencing hunger, thirst, scorching heat, nor feeling naked or otherwise vulnerable. They were only prohibited from eating from a certain tree (its textual significance only in God&#39;s selection of it, in which Satan deceives them into thinking that it grants immortality and an everlasting kingdom), as well as being warned of Satan&#39;s enmity. This is interpreted as a training ground for Adam to learn what his relationship with God is, what his purpose in life is, and who his enemy is.&lt;/span&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCE5FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;" parent="_tAuc-q2iSTF11M6xx4O-11" vertex="1">
          <mxGeometry x="415" width="255" height="135" as="geometry">
            <mxRectangle width="255" height="135" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_tAuc-q2iSTF11M6xx4O-15" value="&lt;span style=&quot;font-size: 8px; background-color: rgba(204, 255, 204, 0.3);&quot;&gt;&lt;b&gt;Permanent home of perfected communion, with the prohibition as a test/indicator of trust&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;font style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;br&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;vs.&lt;/span&gt;&lt;br&gt;&lt;font style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;br&gt;&lt;span style=&quot;font-size: 8px; background-color: rgba(204, 229, 255, 0.3);&quot;&gt;&lt;b&gt;Temporary home as a study guide for the Earthly test, with the prohibition as a lesson&lt;/b&gt;&lt;/span&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#CCCCCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=middle;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;gradientColor=none;" parent="_tAuc-q2iSTF11M6xx4O-11" vertex="1">
          <mxGeometry x="670" width="140" height="135" as="geometry">
            <mxRectangle width="140" height="135" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_tAuc-q2iSTF11M6xx4O-16" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" parent="_tAuc-q2iSTF11M6xx4O-0" vertex="1">
          <mxGeometry y="135" width="810" height="105" as="geometry" />
        </mxCell>
        <mxCell id="_tAuc-q2iSTF11M6xx4O-17" value="&lt;b style=&quot;font-size: x-small;&quot;&gt;What changed about Adam&#39;s state when he sinned?&lt;/b&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#FFDEC9;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;gradientColor=#FFB663;opacity=85;" parent="_tAuc-q2iSTF11M6xx4O-16" vertex="1">
          <mxGeometry width="160" height="105" as="geometry">
            <mxRectangle width="160" height="105" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_tAuc-q2iSTF11M6xx4O-18" value="&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Loss of innocence, sanctifying grace, and preternatural gifts&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;Adam&#39;s eyes were opened to his nakedness, and he covered himself out of shame. His sin resulted in his expulsion from Eden, which&amp;nbsp; is interpreted as a rupture of communion: Adam effectively loses sanctifying grace, original justice/holiness, and the preternatural gifts. Human nature also becomes wounded as Adam&#39;s sin affects his progeny, where there is now a liability to suffering and death beyond Eden.&lt;/span&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=top;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;" parent="_tAuc-q2iSTF11M6xx4O-16" vertex="1">
          <mxGeometry x="160" width="255" height="105" as="geometry">
            <mxRectangle width="255" height="105" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_tAuc-q2iSTF11M6xx4O-19" value="&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Loss of ignorance, and gaining of knowledge of his need for God&#39;s mercy&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;Adam&#39;s nakedness became apparent, and he covered himself out of shame. His sin (a slip within the greater context of persistent obedience) brought him out of his blissfully ignorant state - now fully understanding the consequences of his sins and his need for God&#39;s mercy, forgiveness, and grace.&lt;/span&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCE5FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;" parent="_tAuc-q2iSTF11M6xx4O-16" vertex="1">
          <mxGeometry x="415" width="255" height="105" as="geometry">
            <mxRectangle width="255" height="105" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_tAuc-q2iSTF11M6xx4O-20" value="&lt;span style=&quot;font-size: 8px; background-color: rgba(204, 255, 204, 0.3);&quot;&gt;&lt;b&gt;Loss of innocence and sanctifying grace; ontological wounding of human nature&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;font style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;br&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;vs.&lt;/span&gt;&lt;br&gt;&lt;font style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;br&gt;&lt;span style=&quot;font-size: 8px; background-color: rgba(204, 229, 255, 0.3);&quot;&gt;&lt;b&gt;Loss of innocence and blissful ignorance; epistemological discovery of sin&#39;s consequences and need for God&#39;s mercy&lt;/b&gt;&lt;/span&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#CCCCCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=middle;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;gradientColor=none;" parent="_tAuc-q2iSTF11M6xx4O-16" vertex="1">
          <mxGeometry x="670" width="140" height="105" as="geometry">
            <mxRectangle width="140" height="105" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_tAuc-q2iSTF11M6xx4O-41" value="" style="shape=table;startSize=0;container=1;collapsible=0;childLayout=tableLayout;fontSize=1;" parent="sYscbi_ctIr7rLCjfTU3-1" vertex="1">
          <mxGeometry x="20" y="10500" width="810" height="220" as="geometry" />
        </mxCell>
        <mxCell id="_tAuc-q2iSTF11M6xx4O-62" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" parent="_tAuc-q2iSTF11M6xx4O-41" vertex="1">
          <mxGeometry width="810" height="115" as="geometry" />
        </mxCell>
        <mxCell id="_tAuc-q2iSTF11M6xx4O-63" value="&lt;b style=&quot;font-size: x-small;&quot;&gt;What was God&#39;s immediate response to Adam&#39;s sin?&lt;/b&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#FFF2CC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;gradientColor=#FFD966;opacity=85;" parent="_tAuc-q2iSTF11M6xx4O-62" vertex="1">
          <mxGeometry width="160" height="115" as="geometry">
            <mxRectangle width="160" height="115" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_tAuc-q2iSTF11M6xx4O-64" value="&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;b style=&quot;&quot;&gt;God gives him fair, judicial curses, clothes him out of his mercy, and expels him from Eden&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;God questions Adam - causing his confession. Then, He pronounces judicial curses upon Adam, Eve, and the serpent that deceived them, covers them in proper clothing, and promptly expels them from Eden - barring it with a flaming sword to prevent them from returning (to return to immortality). The clothing is interpreted as a mercy within the judgement, and the judgements are interpreted to be a&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;fair and just response, in order to uphold the moral order by protecting humanity from perpetuating a disordered state.&lt;/span&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=top;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;" parent="_tAuc-q2iSTF11M6xx4O-62" vertex="1">
          <mxGeometry x="160" width="255" height="115" as="geometry">
            <mxRectangle width="255" height="115" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_tAuc-q2iSTF11M6xx4O-65" value="&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;b style=&quot;&quot;&gt;God reminds Adam of his enemy, teaches him how to repent, and accepts his repentance&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;God questions Adam - causing his confession. Then, God reminds Adam of Satan&#39;s enmity, tenderly teaches him how to repent for his sins, and turns towards him - accepting his repentance and forgiving him. He then informs Adam, Eve, and Satan of their temporary stay on Earth (where their livelihood was specifically prepared for them out of God&#39;s mercy) where their true test of faith will begin - with Satan as their enemy, and God as their ever-near merciful guidance, presence, and comforter.&lt;/span&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCE5FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;" parent="_tAuc-q2iSTF11M6xx4O-62" vertex="1">
          <mxGeometry x="415" width="255" height="115" as="geometry">
            <mxRectangle width="255" height="115" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_tAuc-q2iSTF11M6xx4O-66" value="&lt;span style=&quot;font-size: 8px; background-color: rgba(204, 255, 204, 0.3);&quot;&gt;&lt;b&gt;Judicial curses, clothing out of mercy, and expulsion from Eden&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;font style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;br&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;vs.&lt;/span&gt;&lt;br&gt;&lt;font style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;br&gt;&lt;span style=&quot;font-size: 8px; background-color: rgba(204, 229, 255, 0.3);&quot;&gt;&lt;b&gt;Reminder of Satan&#39;s enmity, teaching of repentance, forgiveness out of mercy, and descent from Eden&lt;/b&gt;&lt;/span&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#CCCCCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=middle;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;gradientColor=none;" parent="_tAuc-q2iSTF11M6xx4O-62" vertex="1">
          <mxGeometry x="670" width="140" height="115" as="geometry">
            <mxRectangle width="140" height="115" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_tAuc-q2iSTF11M6xx4O-67" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" parent="_tAuc-q2iSTF11M6xx4O-41" vertex="1">
          <mxGeometry y="115" width="810" height="105" as="geometry" />
        </mxCell>
        <mxCell id="_tAuc-q2iSTF11M6xx4O-68" value="&lt;b style=&quot;font-size: x-small;&quot;&gt;Why wasn&#39;t Adam placed back into Eden? Or - was Adam actually forgiven in that moment, or otherwise saved or pardoned from his sin&#39;s consequences?&lt;/b&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#FFF2CC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;gradientColor=#FFD966;opacity=85;" parent="_tAuc-q2iSTF11M6xx4O-67" vertex="1">
          <mxGeometry width="160" height="105" as="geometry">
            <mxRectangle width="160" height="105" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_tAuc-q2iSTF11M6xx4O-69" value="&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;b style=&quot;&quot;&gt;No, or not explicitly - forgiveness comes later as a result of Jesus&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;God&#39;s warning to Adam was that, if the tree was eaten from, then he would surely die - which is precisely the world we live in today, where the end of each person is death. This means that Adam was not forgiven, since the consequences of his sin were not removed. However, the real risk is spiritual death (in which we die without proper faith in God), but we are saved from this out of God&#39;s mercy in Jesus fulfilling that burden.&amp;nbsp;&lt;/span&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=top;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;" parent="_tAuc-q2iSTF11M6xx4O-67" vertex="1">
          <mxGeometry x="160" width="255" height="105" as="geometry">
            <mxRectangle width="255" height="105" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_tAuc-q2iSTF11M6xx4O-70" value="&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Yes - the descent was not a punishment, but the next step in God&#39;s plan&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;God&#39;s warned Adam that Satan would try to expel them from Eden, which did occur - but this was a part of God&#39;s plan from the beginning (once Adam was taught who his enemy was and how to repent), and the text explicitly states that Adam was forgiven immediately after repenting to God anyway. Satan was similarly banished from Eden, but God cursed him instead (as instead of repenting, he persisted in arrogance).&lt;/span&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCE5FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;" parent="_tAuc-q2iSTF11M6xx4O-67" vertex="1">
          <mxGeometry x="415" width="255" height="105" as="geometry">
            <mxRectangle width="255" height="105" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_tAuc-q2iSTF11M6xx4O-71" value="&lt;span style=&quot;font-size: 8px; background-color: rgba(204, 255, 204, 0.3);&quot;&gt;&lt;b&gt;Adam wasn&#39;t forgiven from the temporal consequences, but saved from eternal, spiritual death (because of Jesus)&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;font style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;br&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;vs.&lt;/span&gt;&lt;br&gt;&lt;font style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;br&gt;&lt;span style=&quot;font-size: 8px; background-color: rgba(204, 229, 255, 0.3);&quot;&gt;&lt;b&gt;Adam was fully forgiven and was placed on Earth after learning the requisite knowledge to be successful&lt;/b&gt;&lt;/span&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#CCCCCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=middle;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;gradientColor=none;" parent="_tAuc-q2iSTF11M6xx4O-67" vertex="1">
          <mxGeometry x="670" width="140" height="105" as="geometry">
            <mxRectangle width="140" height="105" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_tAuc-q2iSTF11M6xx4O-82" value="" style="shape=table;startSize=0;container=1;collapsible=0;childLayout=tableLayout;fontSize=1;" parent="sYscbi_ctIr7rLCjfTU3-1" vertex="1">
          <mxGeometry x="20" y="10725" width="810" height="215" as="geometry" />
        </mxCell>
        <mxCell id="_tAuc-q2iSTF11M6xx4O-113" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" parent="_tAuc-q2iSTF11M6xx4O-82" vertex="1">
          <mxGeometry width="810" height="105" as="geometry" />
        </mxCell>
        <mxCell id="_tAuc-q2iSTF11M6xx4O-114" value="&lt;b style=&quot;font-size: x-small;&quot;&gt;What state are Adam&#39;s descendants born into?&lt;/b&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#D5E8D4;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;gradientColor=#97D077;opacity=85;" parent="_tAuc-q2iSTF11M6xx4O-113" vertex="1">
          <mxGeometry width="160" height="105" as="geometry">
            <mxRectangle width="160" height="105" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_tAuc-q2iSTF11M6xx4O-115" value="&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Same as Adam after the Fall: in a state of original/ancestral sin&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;Because Adam&#39;s Fall marks all humanity, we&#39;re all born in the same post-Fall condition that he was in: being placed on Earth (outside of Eden) and under the same judicial curses (mortality, cursed ground, pain and suffering, a world marked by sin and death). This is interpreted as us being born into a state of &quot;original sin&quot; or &quot;ancestral sin&quot; - inheriting the same consequences given to Adam.&lt;/span&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=top;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;" parent="_tAuc-q2iSTF11M6xx4O-113" vertex="1">
          <mxGeometry x="160" width="255" height="105" as="geometry">
            <mxRectangle width="255" height="105" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_tAuc-q2iSTF11M6xx4O-116" value="&lt;font style=&quot;&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Same as Adam after the Fall: in a state of original forgiveness&lt;/font&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;We&#39;re all born in the same post-Fall condition that Adam was in: being placed on Earth (outside of Eden) and under the same test that was intended for all humanity. No soul bears the burden of another, so each person (including Adam) begins life with the &lt;i&gt;fitrah&lt;/i&gt;&amp;nbsp;- a pure, natural disposition towards God - only&amp;nbsp;inheriting what was learned because of the descent (our needed relationship with God, with Satan as our enemy).&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCE5FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;" parent="_tAuc-q2iSTF11M6xx4O-113" vertex="1">
          <mxGeometry x="415" width="255" height="105" as="geometry">
            <mxRectangle width="255" height="105" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_tAuc-q2iSTF11M6xx4O-117" value="&lt;span style=&quot;font-size: 8px; background-color: rgba(204, 255, 204, 0.3);&quot;&gt;&lt;b&gt;Just like Adam: inheriting original/ancestral sin&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;font style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;br&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;vs.&lt;/span&gt;&lt;br&gt;&lt;font style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;br&gt;&lt;span style=&quot;font-size: 8px; background-color: rgba(204, 229, 255, 0.3);&quot;&gt;&lt;b&gt;Just like Adam: born pure, innocent, and being naturally inclined towards God&lt;/b&gt;&lt;/span&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#CCCCCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=middle;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;gradientColor=none;" parent="_tAuc-q2iSTF11M6xx4O-113" vertex="1">
          <mxGeometry x="670" width="140" height="105" as="geometry">
            <mxRectangle width="140" height="105" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_tAuc-q2iSTF11M6xx4O-118" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" parent="_tAuc-q2iSTF11M6xx4O-82" vertex="1">
          <mxGeometry y="105" width="810" height="110" as="geometry" />
        </mxCell>
        <mxCell id="_tAuc-q2iSTF11M6xx4O-119" value="&lt;b style=&quot;font-size: x-small;&quot;&gt;On what basis are Adam and his descendants ultimately saved&amp;nbsp;from their sins?&lt;/b&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#D5E8D4;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;gradientColor=#97D077;opacity=85;" parent="_tAuc-q2iSTF11M6xx4O-118" vertex="1">
          <mxGeometry width="160" height="110" as="geometry">
            <mxRectangle width="160" height="110" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_tAuc-q2iSTF11M6xx4O-120" value="&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;b style=&quot;&quot;&gt;God&#39;s grace through the death and resurrection of Christ - which reconciled humanity&#39;s penalty of sin and allowed our forgiveness - and our faith in that&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;Our forgiveness and salvation from ultimately come on the basis of God&#39;s grace through Jesus Christ, who died for our sins and defeated death (ie. the penalty of sin for humanity) through his resurrection. This act applies even to all who lived before Jesus (including Adam), and those who live after&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;&amp;nbsp;receive that grace only through faith and the fulfilment of the sacraments.&amp;nbsp;&lt;/span&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=top;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;" parent="_tAuc-q2iSTF11M6xx4O-118" vertex="1">
          <mxGeometry x="160" width="255" height="110" as="geometry">
            <mxRectangle width="255" height="110" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_tAuc-q2iSTF11M6xx4O-121" value="&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;b style=&quot;&quot;&gt;God&#39;s mercy through each person&#39;s faith, righteousness, and repentance&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;Our forgiveness and salvation ultimately comes on the basis of God&#39;s mercy and promise: for any one of us who repents, believes in God, and does good, God promises to forgive and pardon their bad deeds - for He is the Oft-Forgiving, Ever-Merciful. This applies to everyone who&#39;s ever lived, from Adam until now.&lt;/span&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCE5FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;" parent="_tAuc-q2iSTF11M6xx4O-118" vertex="1">
          <mxGeometry x="415" width="255" height="110" as="geometry">
            <mxRectangle width="255" height="110" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_tAuc-q2iSTF11M6xx4O-122" value="&lt;span style=&quot;font-size: 8px; background-color: rgba(204, 255, 204, 0.3);&quot;&gt;&lt;b&gt;Belief in Christ as our Savior from our sins&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;font style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;br&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;vs.&lt;/span&gt;&lt;br&gt;&lt;font style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;br&gt;&lt;span style=&quot;font-size: 8px; background-color: rgba(204, 229, 255, 0.3);&quot;&gt;&lt;b&gt;Belief in God and His all-encompassing mercy&lt;/b&gt;&lt;/span&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#CCCCCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=middle;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;gradientColor=none;" parent="_tAuc-q2iSTF11M6xx4O-118" vertex="1">
          <mxGeometry x="670" width="140" height="110" as="geometry">
            <mxRectangle width="140" height="110" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="zWazCNHewJX7HysrUeDO-0" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=default;" parent="sYscbi_ctIr7rLCjfTU3-1" vertex="1">
          <mxGeometry x="20" y="10250" width="810" height="5" as="geometry" />
