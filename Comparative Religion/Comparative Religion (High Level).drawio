        </mxCell>
        <UserObject label="" id="d4fRNK1CelngGn6CPc5I-2">
          <mxCell edge="1" parent="d4fRNK1CelngGn6CPc5I-0" style="shape=flexArrow;endArrow=classic;html=1;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=default;fillColor=#B3B3B3;">
            <mxGeometry height="50" relative="1" width="50" as="geometry">
              <mxPoint y="25.000000000000004" as="sourcePoint" />
