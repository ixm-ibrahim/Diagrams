        <mxCell id="an_TeZdyltkLNw7kslnf-23" parent="an_TeZdyltkLNw7kslnf-22" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=middle;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;swimlaneFillColor=none;gradientColor=none;gradientDirection=east;align=left;" value="&lt;span style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;b&gt;Formal clerical hierarchies exist (bishops, priests, deacons)&lt;/b&gt;, with a defined chain of sacramental ordination and institutional authority&lt;/span&gt;" vertex="1">
