        <mxCell id="pJg3SHPVufzG-P1PX_YF-357" parent="pJg3SHPVufzG-P1PX_YF-356" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#DCDBFC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=middle;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;gradientColor=#9393E0;align=center;strokeWidth=0;" value="&lt;b style=&quot;font-size: 12px;&quot;&gt;6.&amp;nbsp;&lt;/b&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;b&gt;Historical Comparison [New Testament vs. Quran]&lt;/b&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="30" width="810" as="geometry">
