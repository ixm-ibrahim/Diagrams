            <mxRectangle height="40" width="315" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="an_TeZdyltkLNw7kslnf-24" parent="an_TeZdyltkLNw7kslnf-22" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCE5FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=middle;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;swimlaneFillColor=none;gradientColor=none;gradientDirection=east;align=left;" value="&lt;span style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- &lt;b&gt;Religious authority is decentralized&lt;/b&gt;, without a central body of ordination&lt;/span&gt;&lt;div&gt;&lt;b style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/b&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;- &lt;b&gt;Religious leadership and authority resides in scholars, &lt;/b&gt;whose standing depends on knowledge, character, and recognition by peers and the community&lt;/span&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="40" width="315" x="420" as="geometry">
            <mxRectangle height="40" width="315" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
