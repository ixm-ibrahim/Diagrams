        </mxCell>
        <mxCell id="j6Lz0SjBER47GQh4H0wA-4" parent="j6Lz0SjBER47GQh4H0wA-3" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#E6D0DE;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=middle;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;swimlaneFillColor=none;gradientColor=#D5739D;gradientDirection=south;" value="&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;b&gt;Results&lt;/b&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="35" width="810" as="geometry">
            <mxRectangle height="35" width="810" as="alternateBounds" />
