        <mxCell id="oElzQHF2Izg0Ac3k5PHF-21" connectable="0" parent="W1TrKCJIQid8sVjI4NZf-1" style="group" value="" vertex="1">
          <mxGeometry height="290" width="810.0000000000001" x="20" y="150" as="geometry" />
        </mxCell>
        <mxCell id="W1TrKCJIQid8sVjI4NZf-55" parent="oElzQHF2Izg0Ac3k5PHF-21" style="shape=table;startSize=0;container=1;collapsible=0;childLayout=tableLayout;fontSize=1;" value="" vertex="1">
          <mxGeometry height="245" width="810" y="45" as="geometry" />
        </mxCell>
        <mxCell id="W1TrKCJIQid8sVjI4NZf-56" parent="W1TrKCJIQid8sVjI4NZf-55" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" value="" vertex="1">
          <mxGeometry height="65" width="810" as="geometry" />
        </mxCell>
        <mxCell id="W1TrKCJIQid8sVjI4NZf-57" parent="W1TrKCJIQid8sVjI4NZf-56" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#D5D5D5;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;gradientColor=none;" value="&lt;font size=&quot;1&quot;&gt;&lt;b&gt;What is the claim?&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="65" width="180" as="geometry">
            <mxRectangle height="65" width="180" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="W1TrKCJIQid8sVjI4NZf-58" parent="W1TrKCJIQid8sVjI4NZf-56" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=top;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;" value="&lt;font style=&quot;font-size: 9px;&quot;&gt;&lt;b style=&quot;&quot;&gt;The Bible possesses a textual and historical preservation that is&amp;nbsp;superior to all alternatives, which are not authorized by God&lt;br&gt;(ie. deceptive or demonic in origin).&lt;/b&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;Specifically: if the resurrection of Jesus is shown to be decisively true (without any reasonable alternative), then it incapacitates any argument that Jesus was not divine.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="65" width="315" x="180" as="geometry">
            <mxRectangle height="65" width="315" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="W1TrKCJIQid8sVjI4NZf-59" parent="W1TrKCJIQid8sVjI4NZf-56" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCE5FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;" value="&lt;font style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;The Quran possesses a preservation and inimitability that is superior to all alternatives, which are not authorized by God&lt;br&gt;(ie. deceptive or demonic in origin).&lt;/b&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;Specifically: if the Quran is shown to be perfectly preserved and cannot have been produced by a human being, then it incapacitates any argument that Jesus was divine.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="65" width="315" x="495" as="geometry">
            <mxRectangle height="65" width="315" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m2_hwUthmIpwnyIO0qzi-0" parent="W1TrKCJIQid8sVjI4NZf-55" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" vertex="1">
          <mxGeometry height="65" width="810" y="65" as="geometry" />
        </mxCell>
        <mxCell id="m2_hwUthmIpwnyIO0qzi-1" parent="m2_hwUthmIpwnyIO0qzi-0" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#D5D5D5;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;gradientColor=none;" value="&lt;b style=&quot;font-size: x-small;&quot;&gt;Is it ontologically possible and epistemologically attainable?&lt;/b&gt;" vertex="1">
          <mxGeometry height="65" width="180" as="geometry">
            <mxRectangle height="65" width="180" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m2_hwUthmIpwnyIO0qzi-2" parent="m2_hwUthmIpwnyIO0qzi-0" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=top;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;" value="&lt;font size=&quot;1&quot;&gt;&lt;b&gt;Yes&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;Texts and historical events can be preserved over time, and their preservation can be analyzed by eliminating alternatives for fabrication and falsehood .&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="65" width="315" x="180" as="geometry">
            <mxRectangle height="65" width="315" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m2_hwUthmIpwnyIO0qzi-3" parent="m2_hwUthmIpwnyIO0qzi-0" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCE5FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;" value="&lt;font style=&quot;&quot;&gt;&lt;font size=&quot;1&quot;&gt;&lt;b&gt;Yes&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;Texts and historical events can be preserved over time, and their preservation can be analyzed by eliminating alternatives for fabrication and falsehood&lt;/font&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;Additionally, humans have a hard limit to what they are capable of doing, so anything that falls beyond that limit would verify inimitability.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="65" width="315" x="495" as="geometry">
            <mxRectangle height="65" width="315" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="oElzQHF2Izg0Ac3k5PHF-0" parent="W1TrKCJIQid8sVjI4NZf-55" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" vertex="1">
          <mxGeometry height="115" width="810" y="130" as="geometry" />
        </mxCell>
        <mxCell id="oElzQHF2Izg0Ac3k5PHF-1" parent="oElzQHF2Izg0Ac3k5PHF-0" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#D5D5D5;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;gradientColor=none;" value="&lt;b style=&quot;font-size: x-small;&quot;&gt;What are the criteria for success&lt;br&gt;and failure?&lt;/b&gt;" vertex="1">
          <mxGeometry height="115" width="180" as="geometry">
            <mxRectangle height="115" width="180" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="oElzQHF2Izg0Ac3k5PHF-2" parent="oElzQHF2Izg0Ac3k5PHF-0" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=top;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;" value="&lt;font style=&quot;&quot;&gt;&lt;font size=&quot;1&quot;&gt;&lt;b style=&quot;&quot;&gt;Truth is defined/identified by consistency and reality, and falsehood by inconsistency and contradiction with reality.&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;If the Bible is authorized by God, then it must be the epitome of consistency and correspondence with reality. As a result, if all falsehoods necessarily contradict with reality, then the Quran cannot possess the same level of consistency and coherence as the Bible.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;Therefore, &lt;b style=&quot;&quot;&gt;success&lt;/b&gt;&amp;nbsp;is showing that the Bible has a better form of preservation than the Quran and is more consistent and coherent. &lt;b style=&quot;&quot;&gt;Failure&lt;/b&gt;&amp;nbsp;is if the Quran&#39;s preservation and inimitability are stronger than the Bible&#39;s, since no manmade effort can ever surpass God&#39;s power.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="115" width="315" x="180" as="geometry">
            <mxRectangle height="115" width="315" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="oElzQHF2Izg0Ac3k5PHF-3" parent="oElzQHF2Izg0Ac3k5PHF-0" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCE5FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;" value="&lt;font style=&quot;&quot;&gt;&lt;font size=&quot;1&quot;&gt;&lt;b&gt;Truth is defined/identified by consistency and reality, and falsehood by inconsistency and contradiction with reality.&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;If the Quran is authorized by God, then it must be the epitome of consistency and correspondence with reality. As a result, if all falsehoods necessarily contradict with reality, then the Bible cannot possess the same level of consistency and coherence as the Quran.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;Therefore,&amp;nbsp;&lt;b style=&quot;&quot;&gt;success&lt;/b&gt;&amp;nbsp;is showing that the Quran is truly inimitable, has a better form of preservation than the Bible, and is more consistent and coherent.&amp;nbsp;&lt;b style=&quot;&quot;&gt;Failure&lt;/b&gt;&amp;nbsp;is if the Quran could have been manmade, or if Bible&#39;s preservation and historical reliability are stronger than the Quran&#39;s - since no manmade effort can ever surpass God&#39;s power.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="115" width="315" x="495" as="geometry">
            <mxRectangle height="115" width="315" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <UserObject label="&lt;b&gt;&lt;font&gt;1. Textual/Historical Claim&lt;/font&gt;&lt;/b&gt;" link="data:page/id,vzxsm3Ze7Mdvi2NmskRt" id="W1TrKCJIQid8sVjI4NZf-98">
          <mxCell parent="oElzQHF2Izg0Ac3k5PHF-21" style="rounded=0;whiteSpace=wrap;html=1;fontSize=18;fillColor=#f8cecc;gradientColor=#ea6b66;strokeColor=#b85450;" vertex="1">
            <mxGeometry height="44.9999999999999" width="810.0000000000001" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="Wt12i36qYriK0fRUsXj2-4" connectable="0" parent="W1TrKCJIQid8sVjI4NZf-1" style="group" value="" vertex="1">
          <mxGeometry height="630" width="810.0000000000001" x="20" y="455" as="geometry" />
        </mxCell>
        <mxCell id="oElzQHF2Izg0Ac3k5PHF-23" parent="Wt12i36qYriK0fRUsXj2-4" style="shape=table;startSize=0;container=1;collapsible=0;childLayout=tableLayout;fontSize=1;" value="" vertex="1">
          <mxGeometry height="585" width="810" y="45" as="geometry" />
        </mxCell>
        <mxCell id="oElzQHF2Izg0Ac3k5PHF-24" parent="oElzQHF2Izg0Ac3k5PHF-23" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" value="" vertex="1">
          <mxGeometry height="75" width="810" as="geometry" />
        </mxCell>
        <mxCell id="oElzQHF2Izg0Ac3k5PHF-25" parent="oElzQHF2Izg0Ac3k5PHF-24" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#D5D5D5;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;gradientColor=none;" value="&lt;font size=&quot;1&quot;&gt;&lt;b&gt;Who were the eyewitnesses, and what did they bear witness to?&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="75" width="180" as="geometry">
            <mxRectangle height="75" width="180" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="oElzQHF2Izg0Ac3k5PHF-26" parent="oElzQHF2Izg0Ac3k5PHF-24" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=top;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;" value="&lt;font style=&quot;font-size: 9px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Three significant events: Jesus&#39; 3-year earthly ministry, 40 days&amp;nbsp;of Jesus&#39; resurrection, and the post-resurrection vision that appeared to Paul&lt;/b&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;Thousands of people witnessed Jesus&#39;s ministry (about 3 years long), while over 500 witnessed his 40-day bodily resurrection (between 30-33 AD). Finally, Paul witnessed a spiritual and personal vision of Jesus (between 33-36 AD).&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="75" width="315" x="180" as="geometry">
            <mxRectangle height="75" width="315" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="oElzQHF2Izg0Ac3k5PHF-27" parent="oElzQHF2Izg0Ac3k5PHF-24" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCE5FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;" value="&lt;font size=&quot;1&quot;&gt;&lt;b&gt;Two significant events: the Quran&#39;s revelation to the Prophet Muhammad over 23 years, and his character, personality, and ministry in that time period&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;Tens of thousands of people witnessed the Quran&#39;s revelation to the Prophet Muhammad (which were unique, context-specific events that occurred from 610-632 AD), and even more witnessed his ministry in that time.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="75" width="315" x="495" as="geometry">
            <mxRectangle height="75" width="315" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="oElzQHF2Izg0Ac3k5PHF-28" parent="oElzQHF2Izg0Ac3k5PHF-23" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" vertex="1">
          <mxGeometry height="205" width="810" y="75" as="geometry" />
        </mxCell>
        <mxCell id="oElzQHF2Izg0Ac3k5PHF-29" parent="oElzQHF2Izg0Ac3k5PHF-28" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#D5D5D5;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;gradientColor=none;" value="&lt;font size=&quot;1&quot;&gt;&lt;b&gt;How reliable was the cultural&lt;br&gt;context for preserving oral tradition accurately?&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="205" width="180" as="geometry">
            <mxRectangle height="205" width="180" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="oElzQHF2Izg0Ac3k5PHF-30" parent="oElzQHF2Izg0Ac3k5PHF-28" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=top;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;" value="&lt;font size=&quot;1&quot;&gt;&lt;b&gt;Jewish oral tradition preserved core concepts, without verbatim&amp;nbsp;transmission&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;The Jewish culture at the time had a strong tradition of oral preservation - and their preserved texts meant that verbatim oral transmission was unnecessary.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;The Bible largely reflects this: at least 35-80 years had passed after Jesus&#39; ministry before the Gospels were written, in which cultural and linguistic barriers were crossed (transitioning from Jewish and Aramaic to Greek and Roman). Given the oral tradition before the texts were written and their standardization in a foreign language, this supports the claim that core concepts were preserved.&lt;br&gt;&lt;/span&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;T&lt;/font&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;his makes verbatim preservation unlikely, but this is in line with classical views, as the tradition is seen as &quot;living&quot; where the core is preserved without significant corruption.&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="205" width="315" x="180" as="geometry">
            <mxRectangle height="205" width="315" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="oElzQHF2Izg0Ac3k5PHF-31" parent="oElzQHF2Izg0Ac3k5PHF-28" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCE5FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;" value="&lt;font style=&quot;&quot;&gt;&lt;font size=&quot;1&quot;&gt;&lt;b&gt;Verbatim preservation with the Quran, semi-verbatim preservation with the Prophet&#39;s life and character&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;The 7th century Arabian culture already had an exceptionally strong tradition of oral preservation, as they lacked any written and textual presence before the Quran - which was the first completed written work of&amp;nbsp;&lt;/font&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;Arabic&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;literature ever written. This meant that their oral literature before (and during) the Quran&#39;s revelation relied heavily on verbatim memorization in order to be preserved.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;The Quran largely reflects this: it was memorized verbatim by all witnesses, with daily, audible, and communal prayers serving as a living verification by the community, in a language that continues to exist today and is geographically widespread. It was also preserved only in the Arabic that it was revealed in - with its &lt;i&gt;rasm&lt;/i&gt;&amp;nbsp;(consonantal skeleton) serving as its preservation in written form&amp;nbsp;(and all translations only being considered as exegeses of the Arabic recitation) - thus eliminating possibilities of mythologization and gradual shifts in translation.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;As for the Prophet&#39;s life and character, its oral tradition lasted for 100-200 years before being written and codified. As such, what is recorded isn&#39;t necessarily a verbatim transmission of what the original narrators said (with more room for fabrication and error)&amp;nbsp;- the core narrative&amp;nbsp;being reliably preserved, but requiring specialized scholarly effort to authenticate.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="205" width="315" x="495" as="geometry">
            <mxRectangle height="205" width="315" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="dUPqMebB6uiEhU2GmSwQ-0" parent="oElzQHF2Izg0Ac3k5PHF-23" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" vertex="1">
          <mxGeometry height="170" width="810" y="280" as="geometry" />
        </mxCell>
        <mxCell id="dUPqMebB6uiEhU2GmSwQ-1" parent="dUPqMebB6uiEhU2GmSwQ-0" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#D5D5D5;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;gradientColor=none;" value="&lt;font size=&quot;1&quot;&gt;&lt;b&gt;When was the text written and standardized, and by whom?&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="170" width="180" as="geometry">
            <mxRectangle height="170" width="180" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="dUPqMebB6uiEhU2GmSwQ-2" parent="dUPqMebB6uiEhU2GmSwQ-0" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=top;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;" value="&lt;font size=&quot;1&quot;&gt;&lt;b&gt;Written by multiple authors (not Jesus) sometime 10-70 years after Jesus&#39; ministry, while the canon was standardized in 382 AD by the Council of Rome&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;The earliest New Testament texts were written 7-12 years after Jesus&#39; ministry (in the earliest estimates), and were likely Galatians, Thessalonians (both by Paul), and possibly even James (although this is not a majority view). However (excluding James), Paul was not a witness to Jesus&#39; earthly ministry nor his resurrection - and since the Gospels&lt;/font&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;(eyewitness accounts of Jesus&#39; ministry)&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&amp;nbsp;were written 10-70 years after Jesus (considering both early and late dating), this puts them being written at a later time than the non-eyewitness accounts. This also means that none of the texts are authored by Jesus himself.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;Meanwhile, heresies were prevalent from Paul&#39;s ministry and continued into 400 AD, with many heretical/apocryphal works being written. This resulted in a gradual process of standardization that culminated in the Council of Rome in 382 AD, establishing the New Testament canon (which was first proposed by Irenaeus in 180 AD).&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="170" width="315" x="180" as="geometry">
            <mxRectangle height="170" width="315" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="dUPqMebB6uiEhU2GmSwQ-3" parent="dUPqMebB6uiEhU2GmSwQ-0" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCE5FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;" value="&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Three significant events:&amp;nbsp;&lt;/b&gt;&lt;b&gt;the writing and ordering of the Quran during the Prophet Muhammad&#39;s life, the first complete written Quran being codified 2 years after his death, and the written standardization of the dialect/accent 20 years after his death&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;While the Quran was primarily memorized verbatim by the community, it was also written by the Prophet&#39;s scribes - namely, Zaid b. Thabit and his team - shortly after the revelation occurred. After his death, Abu Bakr (the first caliph after the Prophet) compiled the first written text of the entire Quran, as it was textually fragmented so far (because the Quran was revealed in context-specific situations). Finally, as Islam began to spread to the non-Arabian world, the dialect and diacritics were standardized 20 years after the Prophet&#39;s death by the fourth caliph, Uthman.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;As for the Prophet&#39;s life and character, this started to be written down within 100 years after the Prophet&#39;s death, with the most rigorous works (the 6 Sahih Collections) were written 200 years after his death (or 300-500 years for the Shia collections).&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="170" width="315" x="495" as="geometry">
            <mxRectangle height="170" width="315" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="oElzQHF2Izg0Ac3k5PHF-32" parent="oElzQHF2Izg0Ac3k5PHF-23" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" vertex="1">
          <mxGeometry height="135" width="810" y="450" as="geometry" />
        </mxCell>
        <mxCell id="oElzQHF2Izg0Ac3k5PHF-33" parent="oElzQHF2Izg0Ac3k5PHF-32" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#D5D5D5;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;gradientColor=none;" value="&lt;font size=&quot;1&quot;&gt;&lt;b&gt;What corroborating archaeological finds are there?&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="135" width="180" as="geometry">
            <mxRectangle height="135" width="180" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="oElzQHF2Izg0Ac3k5PHF-34" parent="oElzQHF2Izg0Ac3k5PHF-32" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=top;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;" value="&lt;font style=&quot;&quot;&gt;&lt;font size=&quot;1&quot;&gt;&lt;b style=&quot;&quot;&gt;Strong historical and cultural corroboration, with earliest manuscripts of the New Testament dating to 125 AD&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;Some non-Christian writers (namely, Josephus and Tacitus, around 100 AD) reference Jesus in their historical works - although, none of them mention his resurrection or divinity&amp;nbsp;&lt;/font&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;(one passage in Josephus is debated)&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;. Moreover, the locations of cities, cultural practices of the Jews and Romans, and inscriptions of historical people all corroborate what is mentioned in the New Testament. Meanwhile, the earliest manuscript we have dates to 125 AD, although that is the exception: the vast majority of them are between 300-400 AD.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;Therefore, as each of the New Testament books are claimed to have been written long before 125 AD, the primary means of dating when they were written is a purely logical endeavor, without corroborating archaeological manuscripts to verify.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="135" width="315" x="180" as="geometry">
            <mxRectangle height="135" width="315" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="oElzQHF2Izg0Ac3k5PHF-35" parent="oElzQHF2Izg0Ac3k5PHF-32" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCE5FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;" value="&lt;font style=&quot;&quot;&gt;&lt;font size=&quot;1&quot;&gt;&lt;b&gt;Overwhelming historical and cultural corroboration, with the earliest manuscripts dating to the Prophet&#39;s life&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;The Islamic Golden Age was a direct result of the Prophet&#39;s legacy, leaving us with overwhelming evidence of Islam&#39;s influence. Moreover, every single geographical location relevant to the Prophet&#39;s life is well known and corroborated, as well as extensive knowledge into the Prophet&#39;s life and the practices of the early Muslims. Finally, the earliest Quranic manuscript we have dates to the Prophet&#39;s own lifetime (which is verbatim of what we have now), although the vast majority of them are between 100-200 years after the Prophet&#39;s death.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;Therefore, not only is the Quran reliably preserved verbatim by communal memorization, it is also soundly verifiable through archaeological means.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="135" width="315" x="495" as="geometry">
            <mxRectangle height="135" width="315" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <UserObject label="&lt;b&gt;&lt;font&gt;2. Oral, Written, and Archeological Presence&lt;/font&gt;&lt;/b&gt;" link="data:page/id,vzxsm3Ze7Mdvi2NmskRt" id="iLSEIGw3KWHkjSkyQQ1m-8">
          <mxCell parent="Wt12i36qYriK0fRUsXj2-4" style="rounded=0;whiteSpace=wrap;html=1;fontSize=18;fillColor=#FFDEC9;gradientColor=#FFB663;strokeColor=#D69555;" vertex="1">
            <mxGeometry height="44.9999999999999" width="810.0000000000001" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="Q5fPuT3i9zYJUYlqrMij-0" parent="W1TrKCJIQid8sVjI4NZf-1" style="rounded=0;whiteSpace=wrap;html=1;pointerEvents=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=1;fillColor=#f5f5f5;gradientColor=#b3b3b3;strokeColor=#666666;" value="&lt;font style=&quot;font-size: 10px;&quot;&gt;Note that the following sections only compare trinitarianism (sourced by the New Testament) and monotheism (sourced by the Quran). Even though Atheism&#39;s rebuttals fit the natural data, it neither explains why reality exists, nor does it actually refute (or reduce confidence in) the alignment of a transcendent creator with reality. And Polytheism is set aside becuase&amp;nbsp;a plurality of ultimate powers doesn’t naturally yield the unified, law-governed order we actually observe - and multiplying ultimate agents introduces unexplained conflict/coordination that the world’s tight regularities don’t display.&lt;/font&gt;" vertex="1">
          <mxGeometry height="55" width="810" x="20" y="80" as="geometry" />
        </mxCell>
        <UserObject label="" link="data:page/id,wMXEoENK0W1JxD-Q2Zpp" id="IPzkpQmEjNJdxfdVscHV-0">
          <mxCell connectable="0" parent="W1TrKCJIQid8sVjI4NZf-1" style="group" vertex="1">
            <mxGeometry height="50" width="50" x="780" y="20" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="IPzkpQmEjNJdxfdVscHV-1" parent="IPzkpQmEjNJdxfdVscHV-0" style="rounded=0;whiteSpace=wrap;html=1;pointerEvents=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=12;fontColor=default;fillColor=#E6E6E6;gradientColor=none;strokeColor=none;rotation=-180;opacity=1;" value="" vertex="1">
          <mxGeometry height="50" width="50" y="3.552713678800501e-15" as="geometry" />
        </mxCell>
        <UserObject label="" id="IPzkpQmEjNJdxfdVscHV-2">
          <mxCell edge="1" parent="IPzkpQmEjNJdxfdVscHV-0" style="shape=flexArrow;endArrow=classic;html=1;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=default;fillColor=#B3B3B3;">
            <mxGeometry height="50" relative="1" width="50" as="geometry">
              <mxPoint y="25.000000000000004" as="sourcePoint" />
