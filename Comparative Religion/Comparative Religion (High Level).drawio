          <mxCell style="text;html=1;whiteSpace=wrap;strokeColor=#808080;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=1;strokeWidth=0.25;" vertex="1" parent="EdFTTNA31_R32S0u9zr8-2">
