          <mxGeometry x="260" y="10240" width="330" height="50" as="geometry" />
        </mxCell>
        <mxCell id="btzmwWplPZqXSAAF93Z9-0" value="God&#39;s love in Islam" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" parent="qMC6YvhsLQJmbLbbi-6q-1" vertex="1">
          <mxGeometry x="260" y="10390" width="330" height="50" as="geometry" />
        </mxCell>
        <mxCell id="btzmwWplPZqXSAAF93Z9-1" value="Exegesis of Quran 30-39" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" parent="qMC6YvhsLQJmbLbbi-6q-1" vertex="1">
          <mxGeometry x="260" y="10440" width="330" height="50" as="geometry" />
        </mxCell>
        <mxCell id="btzmwWplPZqXSAAF93Z9-2" value="Euthyprho&#39;s Dillemma" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" parent="qMC6YvhsLQJmbLbbi-6q-1" vertex="1">
          <mxGeometry x="260" y="10490" width="330" height="50" as="geometry" />
        </mxCell>
        <mxCell id="btzmwWplPZqXSAAF93Z9-6" value="Gospel sources" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" parent="qMC6YvhsLQJmbLbbi-6q-1" vertex="1">
          <mxGeometry x="260" y="10340" width="330" height="50" as="geometry" />
        </mxCell>
        <mxCell id="btzmwWplPZqXSAAF93Z9-7" value="Consideration for the christian" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" parent="qMC6YvhsLQJmbLbbi-6q-1" vertex="1">
