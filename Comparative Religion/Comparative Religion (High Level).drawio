        <mxCell id="h2RVPG1P-ozCtyoppiS8-3" value="&lt;font style=&quot;color: rgb(153, 153, 153); font-size: 9px;&quot;&gt;&lt;b&gt;Yes&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;The complexity of reality reflects the creativity of the gods.&lt;/font&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#FFFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=-2;" parent="h2RVPG1P-ozCtyoppiS8-0" vertex="1">
