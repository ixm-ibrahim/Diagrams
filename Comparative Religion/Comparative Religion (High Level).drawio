        </mxCell>
        <mxCell id="h2RVPG1P-ozCtyoppiS8-1" value="&lt;font style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;Intelligence correlates with&lt;br&gt;success and purposeful/conscious complexity.&lt;/b&gt;&lt;/font&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#D5D5D5;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;gradientColor=none;" parent="h2RVPG1P-ozCtyoppiS8-0" vertex="1">
