        <UserObject label="" id="ZnwhzGI6euWCY74tuuJZ-2">
          <mxCell style="shape=flexArrow;endArrow=classic;html=1;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=default;fillColor=#B3B3B3;" edge="1" parent="ZnwhzGI6euWCY74tuuJZ-0">
