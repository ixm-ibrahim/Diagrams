              <mxPoint x="50" y="24.670000000000073" as="sourcePoint" />
              <mxPoint x="10" y="24.670000000000073" as="targetPoint" />
            </mxGeometry>
          </mxCell>
        </UserObject>
        <mxCell id="KwOw5QolJIjtXPDDMoCl-0" value="" style="rounded=0;whiteSpace=wrap;html=1;pointerEvents=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=12;fontColor=default;fillColor=none;gradientColor=none;strokeColor=none;" vertex="1" parent="KwOw5QolJIjtXPDDMoCl-2">
          <mxGeometry width="50" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="6. Historical Comparison (1/10)" id="UnD5iH2WOAX1UBhe1G6C">
    <mxGraphModel dx="1242" dy="828" grid="1" gridSize="5" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" background="#CCCCCC" math="0" shadow="0" adaptiveColors="none">
      <root>
        <mxCell id="W1TrKCJIQid8sVjI4NZf-0" />
        <mxCell id="W1TrKCJIQid8sVjI4NZf-1" parent="W1TrKCJIQid8sVjI4NZf-0" />
        <UserObject label="Historicity Comparison: Bible vs. Quran (1/10)" link="data:page/id,lkuSvPZcJC7dHRsydWrw" id="W1TrKCJIQid8sVjI4NZf-2">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#E6E6E6;fontSize=20;" parent="W1TrKCJIQid8sVjI4NZf-1" vertex="1">
            <mxGeometry x="20" y="25" width="810" height="50" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="oElzQHF2Izg0Ac3k5PHF-21" value="" style="group" parent="W1TrKCJIQid8sVjI4NZf-1" vertex="1" connectable="0">
          <mxGeometry x="20" y="155" width="810.0000000000001" height="290" as="geometry" />
        </mxCell>
        <mxCell id="W1TrKCJIQid8sVjI4NZf-55" value="" style="shape=table;startSize=0;container=1;collapsible=0;childLayout=tableLayout;fontSize=1;" parent="oElzQHF2Izg0Ac3k5PHF-21" vertex="1">
          <mxGeometry y="45" width="810" height="245" as="geometry" />
        </mxCell>
        <mxCell id="W1TrKCJIQid8sVjI4NZf-56" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" parent="W1TrKCJIQid8sVjI4NZf-55" vertex="1">
          <mxGeometry width="810" height="65" as="geometry" />
        </mxCell>
        <mxCell id="W1TrKCJIQid8sVjI4NZf-57" value="&lt;font size=&quot;1&quot;&gt;&lt;b&gt;What is the claim?&lt;/b&gt;&lt;/font&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#D5D5D5;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;gradientColor=none;" parent="W1TrKCJIQid8sVjI4NZf-56" vertex="1">
          <mxGeometry width="180" height="65" as="geometry">
            <mxRectangle width="180" height="65" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="W1TrKCJIQid8sVjI4NZf-58" value="&lt;font style=&quot;font-size: 9px;&quot;&gt;&lt;b style=&quot;&quot;&gt;The Bible possesses a textual and historical preservation that is&amp;nbsp;superior to all alternatives, which are not authorized by God&lt;br&gt;(ie. deceptive or demonic in origin).&lt;/b&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;Specifically: if the resurrection of Jesus is shown to be decisively true (without any reasonable alternative), then it incapacitates any argument that Jesus was not divine.&lt;/font&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=top;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;" parent="W1TrKCJIQid8sVjI4NZf-56" vertex="1">
          <mxGeometry x="180" width="315" height="65" as="geometry">
            <mxRectangle width="315" height="65" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="W1TrKCJIQid8sVjI4NZf-59" value="&lt;font style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;The Quran possesses a preservation and inimitability that is superior to all alternatives, which are not authorized by God&lt;br&gt;(ie. deceptive or demonic in origin).&lt;/b&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;Specifically: if the Quran is shown to be perfectly preserved and cannot have been produced by a human being, then it incapacitates any argument that Jesus was divine.&lt;/font&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCE5FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;" parent="W1TrKCJIQid8sVjI4NZf-56" vertex="1">
          <mxGeometry x="495" width="315" height="65" as="geometry">
            <mxRectangle width="315" height="65" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m2_hwUthmIpwnyIO0qzi-0" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" parent="W1TrKCJIQid8sVjI4NZf-55" vertex="1">
          <mxGeometry y="65" width="810" height="65" as="geometry" />
        </mxCell>
        <mxCell id="m2_hwUthmIpwnyIO0qzi-1" value="&lt;b style=&quot;font-size: x-small;&quot;&gt;Is it ontologically possible and epistemologically attainable?&lt;/b&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#D5D5D5;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;gradientColor=none;" parent="m2_hwUthmIpwnyIO0qzi-0" vertex="1">
          <mxGeometry width="180" height="65" as="geometry">
            <mxRectangle width="180" height="65" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m2_hwUthmIpwnyIO0qzi-2" value="&lt;font size=&quot;1&quot;&gt;&lt;b&gt;Yes&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;Texts and historical events can be preserved over time, and their preservation can be analyzed by eliminating alternatives for fabrication and falsehood .&lt;/font&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=top;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;" parent="m2_hwUthmIpwnyIO0qzi-0" vertex="1">
          <mxGeometry x="180" width="315" height="65" as="geometry">
            <mxRectangle width="315" height="65" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m2_hwUthmIpwnyIO0qzi-3" value="&lt;font style=&quot;&quot;&gt;&lt;font size=&quot;1&quot;&gt;&lt;b&gt;Yes&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;Texts and historical events can be preserved over time, and their preservation can be analyzed by eliminating alternatives for fabrication and falsehood&lt;/font&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;Additionally, humans have a hard limit to what they are capable of doing, so anything that falls beyond that limit would verify inimitability.&lt;/font&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCE5FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;" parent="m2_hwUthmIpwnyIO0qzi-0" vertex="1">
          <mxGeometry x="495" width="315" height="65" as="geometry">
            <mxRectangle width="315" height="65" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="oElzQHF2Izg0Ac3k5PHF-0" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" parent="W1TrKCJIQid8sVjI4NZf-55" vertex="1">
          <mxGeometry y="130" width="810" height="115" as="geometry" />
        </mxCell>
        <mxCell id="oElzQHF2Izg0Ac3k5PHF-1" value="&lt;b style=&quot;font-size: x-small;&quot;&gt;What are the criteria for success&lt;br&gt;and failure?&lt;/b&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#D5D5D5;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;gradientColor=none;" parent="oElzQHF2Izg0Ac3k5PHF-0" vertex="1">
          <mxGeometry width="180" height="115" as="geometry">
            <mxRectangle width="180" height="115" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="oElzQHF2Izg0Ac3k5PHF-2" value="&lt;font style=&quot;&quot;&gt;&lt;font size=&quot;1&quot;&gt;&lt;b style=&quot;&quot;&gt;Truth is defined/identified by consistency and reality, and falsehood by inconsistency and contradiction with reality.&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;If the Bible is authorized by God, then it must be the epitome of consistency and correspondence with reality. As a result, if all falsehoods necessarily contradict with reality, then the Quran cannot possess the same level of consistency and coherence as the Bible.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;Therefore, &lt;b style=&quot;&quot;&gt;success&lt;/b&gt;&amp;nbsp;is showing that the Bible has a better form of preservation than the Quran and is more consistent and coherent. &lt;b style=&quot;&quot;&gt;Failure&lt;/b&gt;&amp;nbsp;is if the Quran&#39;s preservation and inimitability are stronger than the Bible&#39;s, since no manmade effort can ever surpass God&#39;s power.&lt;/font&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=top;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;" parent="oElzQHF2Izg0Ac3k5PHF-0" vertex="1">
          <mxGeometry x="180" width="315" height="115" as="geometry">
            <mxRectangle width="315" height="115" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="oElzQHF2Izg0Ac3k5PHF-3" value="&lt;font style=&quot;&quot;&gt;&lt;font size=&quot;1&quot;&gt;&lt;b&gt;Truth is defined/identified by consistency and reality, and falsehood by inconsistency and contradiction with reality.&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;If the Quran is authorized by God, then it must be the epitome of consistency and correspondence with reality. As a result, if all falsehoods necessarily contradict with reality, then the Bible cannot possess the same level of consistency and coherence as the Quran.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;Therefore,&amp;nbsp;&lt;b style=&quot;&quot;&gt;success&lt;/b&gt;&amp;nbsp;is showing that the Quran is truly inimitable, has a better form of preservation than the Bible, and is more consistent and coherent.&amp;nbsp;&lt;b style=&quot;&quot;&gt;Failure&lt;/b&gt;&amp;nbsp;is if the Quran could have been manmade, or if Bible&#39;s preservation and historical reliability are stronger than the Quran&#39;s - since no manmade effort can ever surpass God&#39;s power.&lt;/font&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCE5FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;" parent="oElzQHF2Izg0Ac3k5PHF-0" vertex="1">
          <mxGeometry x="495" width="315" height="115" as="geometry">
            <mxRectangle width="315" height="115" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="W1TrKCJIQid8sVjI4NZf-98" value="&lt;b&gt;&lt;font&gt;1. Textual/Historical Claim&lt;/font&gt;&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=18;fillColor=#f8cecc;gradientColor=#ea6b66;strokeColor=#b85450;" parent="oElzQHF2Izg0Ac3k5PHF-21" vertex="1">
          <mxGeometry width="810.0000000000001" height="44.9999999999999" as="geometry" />
        </mxCell>
        <mxCell id="Wt12i36qYriK0fRUsXj2-4" value="" style="group" vertex="1" connectable="0" parent="W1TrKCJIQid8sVjI4NZf-1">
          <mxGeometry x="20" y="460" width="810.0000000000001" height="630" as="geometry" />
        </mxCell>
        <mxCell id="oElzQHF2Izg0Ac3k5PHF-23" value="" style="shape=table;startSize=0;container=1;collapsible=0;childLayout=tableLayout;fontSize=1;" parent="Wt12i36qYriK0fRUsXj2-4" vertex="1">
          <mxGeometry y="45" width="810" height="585" as="geometry" />
        </mxCell>
        <mxCell id="oElzQHF2Izg0Ac3k5PHF-24" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" parent="oElzQHF2Izg0Ac3k5PHF-23" vertex="1">
          <mxGeometry width="810" height="75" as="geometry" />
        </mxCell>
        <mxCell id="oElzQHF2Izg0Ac3k5PHF-25" value="&lt;font size=&quot;1&quot;&gt;&lt;b&gt;Who were the eyewitnesses, and what did they bear witness to?&lt;/b&gt;&lt;/font&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#D5D5D5;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;gradientColor=none;" parent="oElzQHF2Izg0Ac3k5PHF-24" vertex="1">
          <mxGeometry width="180" height="75" as="geometry">
            <mxRectangle width="180" height="75" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="oElzQHF2Izg0Ac3k5PHF-26" value="&lt;font style=&quot;font-size: 9px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Three significant events: Jesus&#39; 3-year earthly ministry, 40 days&amp;nbsp;of Jesus&#39; resurrection, and the post-resurrection vision that appeared to Paul&lt;/b&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;Thousands of people witnessed Jesus&#39;s ministry (about 3 years long), while over 500 witnessed his 40-day bodily resurrection (between 30-33 AD). Finally, Paul witnessed a spiritual and personal vision of Jesus (between 33-36 AD).&lt;/font&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=top;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;" parent="oElzQHF2Izg0Ac3k5PHF-24" vertex="1">
          <mxGeometry x="180" width="315" height="75" as="geometry">
            <mxRectangle width="315" height="75" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="oElzQHF2Izg0Ac3k5PHF-27" value="&lt;font size=&quot;1&quot;&gt;&lt;b&gt;Two significant events: the Quran&#39;s revelation to the Prophet Muhammad over 23 years, and his character, personality, and ministry in that time period&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;Tens of thousands of people witnessed the Quran&#39;s revelation to the Prophet Muhammad (which were unique, context-specific events that occurred from 610-632 AD), and even more witnessed his ministry in that time.&lt;/font&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCE5FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;" parent="oElzQHF2Izg0Ac3k5PHF-24" vertex="1">
          <mxGeometry x="495" width="315" height="75" as="geometry">
            <mxRectangle width="315" height="75" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="oElzQHF2Izg0Ac3k5PHF-28" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" parent="oElzQHF2Izg0Ac3k5PHF-23" vertex="1">
          <mxGeometry y="75" width="810" height="205" as="geometry" />
        </mxCell>
        <mxCell id="oElzQHF2Izg0Ac3k5PHF-29" value="&lt;font size=&quot;1&quot;&gt;&lt;b&gt;How reliable was the cultural&lt;br&gt;context for preserving oral tradition accurately?&lt;/b&gt;&lt;/font&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#D5D5D5;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;gradientColor=none;" parent="oElzQHF2Izg0Ac3k5PHF-28" vertex="1">
          <mxGeometry width="180" height="205" as="geometry">
            <mxRectangle width="180" height="205" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="oElzQHF2Izg0Ac3k5PHF-30" value="&lt;font size=&quot;1&quot;&gt;&lt;b&gt;Jewish oral tradition preserved core concepts, without verbatim&amp;nbsp;transmission&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;The Jewish culture at the time had a strong tradition of oral preservation - and their preserved texts meant that verbatim oral transmission was unnecessary.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;The Bible largely reflects this: at least 35-80 years had passed after Jesus&#39; ministry before the Gospels were written, in which cultural and linguistic barriers were crossed (transitioning from Jewish and Aramaic to Greek and Roman). Given the oral tradition before the texts were written and their standardization in a foreign language, this supports the claim that core concepts were preserved.&lt;br&gt;&lt;/span&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;T&lt;/font&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;his makes verbatim preservation unlikely, but this is in line with classical views, as the tradition is seen as &quot;living&quot; where the core is preserved without significant corruption.&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=top;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;" parent="oElzQHF2Izg0Ac3k5PHF-28" vertex="1">
          <mxGeometry x="180" width="315" height="205" as="geometry">
            <mxRectangle width="315" height="205" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="oElzQHF2Izg0Ac3k5PHF-31" value="&lt;font style=&quot;&quot;&gt;&lt;font size=&quot;1&quot;&gt;&lt;b&gt;Verbatim preservation with the Quran, semi-verbatim preservation with the Prophet&#39;s life and character&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;The 7th century Arabian culture already had an exceptionally strong tradition of oral preservation, as they lacked any written and textual presence before the Quran - which was the first completed written work of&amp;nbsp;&lt;/font&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;Arabic&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;literature ever written. This meant that their oral literature before (and during) the Quran&#39;s revelation relied heavily on verbatim memorization in order to be preserved.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;The Quran largely reflects this: it was memorized verbatim by all witnesses, with daily, audible, and communal prayers serving as a living verification by the community, in a language that continues to exist today and is geographically widespread. It was also preserved only in the Arabic that it was revealed in - with its &lt;i&gt;rasm&lt;/i&gt;&amp;nbsp;(consonantal skeleton) serving as its preservation in written form&amp;nbsp;(and all translations only being considered as exegeses of the Arabic recitation) - thus eliminating possibilities of mythologization and gradual shifts in translation.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;As for the Prophet&#39;s life and character, its oral tradition lasted for 100-200 years before being written and codified. As such, what is recorded isn&#39;t necessarily a verbatim transmission of what the original narrators said (with more room for fabrication and error)&amp;nbsp;- the core narrative&amp;nbsp;being reliably preserved, but requiring specialized scholarly effort to authenticate.&lt;/span&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCE5FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;" parent="oElzQHF2Izg0Ac3k5PHF-28" vertex="1">
          <mxGeometry x="495" width="315" height="205" as="geometry">
            <mxRectangle width="315" height="205" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="dUPqMebB6uiEhU2GmSwQ-0" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" parent="oElzQHF2Izg0Ac3k5PHF-23" vertex="1">
          <mxGeometry y="280" width="810" height="170" as="geometry" />
        </mxCell>
        <mxCell id="dUPqMebB6uiEhU2GmSwQ-1" value="&lt;font size=&quot;1&quot;&gt;&lt;b&gt;When was the text written and standardized, and by whom?&lt;/b&gt;&lt;/font&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#D5D5D5;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;gradientColor=none;" parent="dUPqMebB6uiEhU2GmSwQ-0" vertex="1">
          <mxGeometry width="180" height="170" as="geometry">
            <mxRectangle width="180" height="170" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="dUPqMebB6uiEhU2GmSwQ-2" value="&lt;font size=&quot;1&quot;&gt;&lt;b&gt;Written by multiple authors (not Jesus) sometime 10-70 years after Jesus&#39; ministry, while the canon was standardized in 382 AD by the Council of Rome&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;The earliest New Testament texts were written 7-12 years after Jesus&#39; ministry (in the earliest estimates), and were likely Galatians, Thessalonians (both by Paul), and possibly even James (although this is not a majority view). However (excluding James), Paul was not a witness to Jesus&#39; earthly ministry nor his resurrection - and since the Gospels&lt;/font&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;(eyewitness accounts of Jesus&#39; ministry)&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&amp;nbsp;were written 10-70 years after Jesus (considering both early and late dating), this puts them being written at a later time than the non-eyewitness accounts. This also means that none of the texts are authored by Jesus himself.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;Meanwhile, heresies were prevalent from Paul&#39;s ministry and continued into 400 AD, with many heretical/apocryphal works being written. This resulted in a gradual process of standardization that culminated in the Council of Rome in 382 AD, establishing the New Testament canon (which was first proposed by Irenaeus in 180 AD).&lt;/span&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=top;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;" parent="dUPqMebB6uiEhU2GmSwQ-0" vertex="1">
          <mxGeometry x="180" width="315" height="170" as="geometry">
            <mxRectangle width="315" height="170" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="dUPqMebB6uiEhU2GmSwQ-3" value="&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Three significant events:&amp;nbsp;&lt;/b&gt;&lt;b&gt;the writing and ordering of the Quran during the Prophet Muhammad&#39;s life, the first complete written Quran being codified 2 years after his death, and the written standardization of the dialect/accent 20 years after his death&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;While the Quran was primarily memorized verbatim by the community, it was also written by the Prophet&#39;s scribes - namely, Zaid b. Thabit and his team - shortly after the revelation occurred. After his death, Abu Bakr (the first caliph after the Prophet) compiled the first written text of the entire Quran, as it was textually fragmented so far (because the Quran was revealed in context-specific situations). Finally, as Islam began to spread to the non-Arabian world, the dialect and diacritics were standardized 20 years after the Prophet&#39;s death by the fourth caliph, Uthman.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;As for the Prophet&#39;s life and character, this started to be written down within 100 years after the Prophet&#39;s death, with the most rigorous works (the 6 Sahih Collections) were written 200 years after his death (or 300-500 years for the Shia collections).&lt;/span&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCE5FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;" parent="dUPqMebB6uiEhU2GmSwQ-0" vertex="1">
          <mxGeometry x="495" width="315" height="170" as="geometry">
            <mxRectangle width="315" height="170" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="oElzQHF2Izg0Ac3k5PHF-32" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" parent="oElzQHF2Izg0Ac3k5PHF-23" vertex="1">
          <mxGeometry y="450" width="810" height="135" as="geometry" />
        </mxCell>
        <mxCell id="oElzQHF2Izg0Ac3k5PHF-33" value="&lt;font size=&quot;1&quot;&gt;&lt;b&gt;What corroborating archaeological finds are there?&lt;/b&gt;&lt;/font&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#D5D5D5;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;gradientColor=none;" parent="oElzQHF2Izg0Ac3k5PHF-32" vertex="1">
          <mxGeometry width="180" height="135" as="geometry">
            <mxRectangle width="180" height="135" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="oElzQHF2Izg0Ac3k5PHF-34" value="&lt;font style=&quot;&quot;&gt;&lt;font size=&quot;1&quot;&gt;&lt;b style=&quot;&quot;&gt;Strong historical and cultural corroboration, with earliest manuscripts of the New Testament dating to 125 AD&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;Some non-Christian writers (namely, Josephus and Tacitus, around 100 AD) reference Jesus in their historical works - although, none of them mention his resurrection or divinity&amp;nbsp;&lt;/font&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;(one passage in Josephus is debated)&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;. Moreover, the locations of cities, cultural practices of the Jews and Romans, and inscriptions of historical people all corroborate what is mentioned in the New Testament. Meanwhile, the earliest manuscript we have dates to 125 AD, although that is the exception: the vast majority of them are between 300-400 AD.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;Therefore, as each of the New Testament books are claimed to have been written long before 125 AD, the primary means of dating when they were written is a purely logical endeavor, without corroborating archaeological manuscripts to verify.&lt;/font&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=top;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;" parent="oElzQHF2Izg0Ac3k5PHF-32" vertex="1">
          <mxGeometry x="180" width="315" height="135" as="geometry">
            <mxRectangle width="315" height="135" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="oElzQHF2Izg0Ac3k5PHF-35" value="&lt;font style=&quot;&quot;&gt;&lt;font size=&quot;1&quot;&gt;&lt;b&gt;Overwhelming historical and cultural corroboration, with the earliest manuscripts dating to the Prophet&#39;s life&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;The Islamic Golden Age was a direct result of the Prophet&#39;s legacy, leaving us with overwhelming evidence of Islam&#39;s influence. Moreover, every single geographical location relevant to the Prophet&#39;s life is well known and corroborated, as well as extensive knowledge into the Prophet&#39;s life and the practices of the early Muslims. Finally, the earliest Quranic manuscript we have dates to the Prophet&#39;s own lifetime (which is verbatim of what we have now), although the vast majority of them are between 100-200 years after the Prophet&#39;s death.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;Therefore, not only is the Quran reliably preserved verbatim by communal memorization, it is also soundly verifiable through archaeological means.&lt;/font&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCE5FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;" parent="oElzQHF2Izg0Ac3k5PHF-32" vertex="1">
          <mxGeometry x="495" width="315" height="135" as="geometry">
            <mxRectangle width="315" height="135" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="iLSEIGw3KWHkjSkyQQ1m-8" value="&lt;b&gt;&lt;font&gt;2. Oral, Written, and Archeological Presence&lt;/font&gt;&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=18;fillColor=#FFDEC9;gradientColor=#FFB663;strokeColor=#D69555;" parent="Wt12i36qYriK0fRUsXj2-4" vertex="1">
          <mxGeometry width="810.0000000000001" height="44.9999999999999" as="geometry" />
        </mxCell>
        <mxCell id="Q5fPuT3i9zYJUYlqrMij-0" value="&lt;font style=&quot;font-size: 10px;&quot;&gt;Note that the following sections only compare trinitarianism (sourced by the New Testament) and monotheism (sourced by the Quran). Even though Atheism&#39;s rebuttals fit the natural data, it neither explains why reality exists, nor does it actually refute (or reduce confidence in) the alignment of a transcendent creator with reality. And Polytheism is set aside becuase&amp;nbsp;a plurality of ultimate powers doesn’t naturally yield the unified, law-governed order we actually observe - and multiplying ultimate agents introduces unexplained conflict/coordination that the world’s tight regularities don’t display.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;pointerEvents=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=1;fillColor=#f5f5f5;gradientColor=#b3b3b3;strokeColor=#666666;" vertex="1" parent="W1TrKCJIQid8sVjI4NZf-1">
          <mxGeometry x="20" y="85" width="810" height="55" as="geometry" />
        </mxCell>
        <UserObject label="" link="data:page/id,wMXEoENK0W1JxD-Q2Zpp" id="KNi4WDPT7FqtEF7PLTvg-0">
          <mxCell style="group;rotation=-180;" vertex="1" connectable="0" parent="W1TrKCJIQid8sVjI4NZf-1">
            <mxGeometry x="780" y="25" width="50" height="50" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" id="KNi4WDPT7FqtEF7PLTvg-1">
          <mxCell style="shape=flexArrow;endArrow=classic;html=1;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=default;fillColor=#B3B3B3;" edge="1" parent="KNi4WDPT7FqtEF7PLTvg-0">
            <mxGeometry width="50" height="50" relative="1" as="geometry">
              <mxPoint y="25" as="sourcePoint" />
              <mxPoint x="40" y="25" as="targetPoint" />
            </mxGeometry>
          </mxCell>
        </UserObject>
        <mxCell id="KNi4WDPT7FqtEF7PLTvg-2" value="" style="rounded=0;whiteSpace=wrap;html=1;pointerEvents=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=12;fontColor=default;fillColor=none;gradientColor=none;strokeColor=none;rotation=-180;" vertex="1" parent="KNi4WDPT7FqtEF7PLTvg-0">
          <mxGeometry width="50" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="6. Historical Comparison (2/10)" id="wMXEoENK0W1JxD-Q2Zpp">
    <mxGraphModel dx="1242" dy="-272" grid="1" gridSize="5" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" background="#CCCCCC" math="0" shadow="0" adaptiveColors="none">
      <root>
        <mxCell id="owdOerk8Vaj5sQZDSKtN-0" />
        <mxCell id="owdOerk8Vaj5sQZDSKtN-1" parent="owdOerk8Vaj5sQZDSKtN-0" />
        <UserObject label="Historicity&amp;nbsp;Comparison: Bible vs. Quran (2/10)" link="data:page/id,lkuSvPZcJC7dHRsydWrw" id="owdOerk8Vaj5sQZDSKtN-19">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#E6E6E6;fontSize=20;" vertex="1" parent="owdOerk8Vaj5sQZDSKtN-1">
            <mxGeometry x="20" y="1125" width="810" height="50" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="owdOerk8Vaj5sQZDSKtN-158" value="" style="group" vertex="1" connectable="0" parent="owdOerk8Vaj5sQZDSKtN-1">
          <mxGeometry x="20" y="1190" width="810.0000000000001" height="1005.0000000000009" as="geometry" />
        </mxCell>
        <mxCell id="owdOerk8Vaj5sQZDSKtN-159" value="" style="shape=table;startSize=0;container=1;collapsible=0;childLayout=tableLayout;fontSize=1;" vertex="1" parent="owdOerk8Vaj5sQZDSKtN-158">
          <mxGeometry y="40" width="810" height="965.0000000000007" as="geometry" />
        </mxCell>
        <mxCell id="owdOerk8Vaj5sQZDSKtN-160" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" vertex="1" parent="owdOerk8Vaj5sQZDSKtN-159">
          <mxGeometry width="810" height="170" as="geometry" />
        </mxCell>
        <mxCell id="owdOerk8Vaj5sQZDSKtN-161" value="&lt;font size=&quot;1&quot;&gt;&lt;b&gt;How many independent streams of transmission are there, leading to&lt;br&gt;the text&#39;s standardization?&lt;/b&gt;&lt;/font&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#D5D5D5;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;gradientColor=none;" vertex="1" parent="owdOerk8Vaj5sQZDSKtN-160">
          <mxGeometry width="180" height="170" as="geometry">
            <mxRectangle width="180" height="170" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="owdOerk8Vaj5sQZDSKtN-162" value="&lt;div&gt;&lt;font size=&quot;1&quot;&gt;&lt;b&gt;3 main streams (the synoptic, johannine, and pauline chains) that merge with Irenaeus, leading directly to the Council of Rome&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;span style=&quot;font-size: 2px; text-align: left;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- The &lt;b&gt;synoptic stream&amp;nbsp;&lt;/b&gt;goes from: Jesus&lt;/font&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;→&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&amp;nbsp;Peter&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&amp;nbsp;(and the other Apostles) → Mark&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;→&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&amp;nbsp;Matthew &amp;amp; Luke&lt;/span&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;→ Papias&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;→&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;&amp;nbsp;Polycarp of Smyrna&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;→&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;Irenaeus of Lyons&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- The &lt;b&gt;johannine&amp;nbsp;&lt;/b&gt;&lt;b&gt;stream&amp;nbsp;&lt;/b&gt;goes from: Jesus&lt;/font&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;→&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;&amp;nbsp;John the Apostle&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;→&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;&amp;nbsp;Polycarp of Smyrna&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;→&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;Irenaeus of Lyons&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- The&amp;nbsp;&lt;b&gt;pauline&amp;nbsp;&lt;/b&gt;&lt;b&gt;stream&amp;nbsp;&lt;/b&gt;goes from: Jesus (post-resurrection vision)&lt;/font&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;→&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;&amp;nbsp;Paul&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;→&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;&amp;nbsp;Clement of Rome&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); background-color: transparent; font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); background-color: transparent; font-size: 8px;&quot;&gt;→&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); background-color: transparent; font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;Ignatius of Antioch &amp;amp; Polycarp of Smyrna&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;→&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;Irenaeus of Lyons&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- From &lt;b&gt;Irenaeus&lt;/b&gt; (from all three streams), we get: Irenaeus&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;→&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;&amp;nbsp;Tertullian&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;→&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;&amp;nbsp;Origen of Alexandria&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;→&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;&amp;nbsp;Eusebius&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;→&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;&amp;nbsp;Athanasius of Alexandria&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;→&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;&amp;nbsp;the Council of Rome (led by Pope Damascus I).&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;Notes: Irenaeus was the earliest to list the 4 gospels and Paul&#39;s letters as canon, while Athanasius made the first known list of the mainstream New Testament canon.&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;Also, Matthew also was an eyewitness, but uses Mark&#39;s work (and other unknowns) as a reference&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;.&lt;/span&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=top;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;" vertex="1" parent="owdOerk8Vaj5sQZDSKtN-160">
          <mxGeometry x="180" width="315" height="170" as="geometry">
            <mxRectangle width="315" height="170" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="owdOerk8Vaj5sQZDSKtN-163" value="&lt;font size=&quot;1&quot;&gt;&lt;b&gt;2 main streams: the Quran and Hadith&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- The &lt;b&gt;Quranic&amp;nbsp;&lt;/b&gt;&lt;b&gt;stream&amp;nbsp;&lt;/b&gt;goes from: Muhammad&lt;/font&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;→&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;&amp;nbsp;scribes (led by Zaid b. Thabit) and memorizers (thousands, with hundreds memorizing the whole Quran)&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;→&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;&amp;nbsp;Abu Bakr&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;→&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;&amp;nbsp;Hafsah b. Umar&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;→&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;&amp;nbsp;Uthman b. Affan.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- The&amp;nbsp;&lt;b&gt;Hadith&amp;nbsp;&lt;/b&gt;&lt;b&gt;stream&amp;nbsp;&lt;/b&gt;goes from: Muhammad&lt;/font&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); background-color: transparent; font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); background-color: transparent; font-size: 8px;&quot;&gt;→&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); background-color: transparent; font-size: 8px;&quot;&gt;&amp;nbsp;first generation Muslims (who met the Prophet)&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); background-color: transparent; font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); background-color: transparent; font-size: 8px;&quot;&gt;→ second generation Muslims (and their texts)&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); background-color: transparent; font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); background-color: transparent; font-size: 8px;&quot;&gt;→&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); background-color: transparent; font-size: 8px;&quot;&gt;&amp;nbsp;third generation Muslims (and their texts)&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); background-color: transparent; font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); background-color: transparent; font-size: 8px;&quot;&gt;→&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); background-color: transparent; font-size: 8px;&quot;&gt;&amp;nbsp;the 6 standardized compilations (by Bukhari, Muslim, Abu Dawood, Al-Trimidhi, Al-Nasa&#39;i, and Ibn Majah).&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;Notes: the Quran is claimed to be authored by God (ie. infallible), while the hadith are the works of men (ie. fallible). The Quranic scribes were led by Zaid b. Thabit (writing almost immediately after each revelation), and thousands memorized these revelations (with hundreds who memorized the entire Quran). Abu Bakr (with Zaid b. Thabit) was the first to standardize a full, written copy of the Quran (verified by those who directly witnessed the Quran&#39;s revelation), with Hafsah (one of the Prophet&#39;s wives) being its guardian. Lastly, Uthman was the one to textually standardize the Quran&#39;s accent/diacritics.&lt;/span&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCE5FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;" vertex="1" parent="owdOerk8Vaj5sQZDSKtN-160">
          <mxGeometry x="495" width="315" height="170" as="geometry">
            <mxRectangle width="315" height="170" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="owdOerk8Vaj5sQZDSKtN-164" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" vertex="1" parent="owdOerk8Vaj5sQZDSKtN-159">
          <mxGeometry y="170" width="810" height="275" as="geometry" />
        </mxCell>
        <mxCell id="owdOerk8Vaj5sQZDSKtN-165" value="&lt;font size=&quot;1&quot;&gt;&lt;b&gt;Are there competing claims, and if so, what are their streams of transmission?&lt;/b&gt;&lt;/font&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#D5D5D5;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;gradientColor=none;" vertex="1" parent="owdOerk8Vaj5sQZDSKtN-164">
          <mxGeometry width="180" height="275" as="geometry">
            <mxRectangle width="180" height="275" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="owdOerk8Vaj5sQZDSKtN-166" value="&lt;div&gt;&lt;font size=&quot;1&quot;&gt;&lt;b&gt;Yes - the Jewish Christians and Gnostics&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;span style=&quot;font-size: 2px; text-align: left;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- The&amp;nbsp;&lt;b&gt;Jewish Christians&lt;/b&gt;&amp;nbsp;believed in Jesus&#39; virgin birth and that he was the Messiah, but rejected Paul as a heretic and practiced Mosaic Law. As we don&#39;t have their text, it is also debated whether or not they believed that Jesus was divine.&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- Their chain goes from: Jesus&lt;/font&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;→&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&amp;nbsp;James&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&amp;nbsp;(with Peter and the other Apostles) → oral transmission&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;→&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;written texts (now lost)&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- The&amp;nbsp;&lt;b&gt;Gnostics&lt;/b&gt;&amp;nbsp;believed that Jesus was purely divine, and the god of the Old Testament was a flawed creator, lesser than the true, transcendent God.&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- Their chain&amp;nbsp;goes from: Jesus&lt;/font&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;→&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;&amp;nbsp;secret knowledge to a chose disciple&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;→&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;&amp;nbsp;private line of enlightened teachers&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;→&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;Gnostic gospels&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;Notes: all Jewish Christian writings are lost, and what is known about them only comes from hostile sources, making much of it debated - including whether the &quot;human Jesus&quot; belief was early or later. The Ebionites were a noteworthy sect within the Jewish Christians, only differing by rejecting the virgin birth. After the Bar Kokhba revolt, they (along with the Jews in Rome) were expelled and dispersed throughout Africa, the Mediterranean, and parts of the Arab world. As a result, very little is known about them with a strong certainty, with the only other possible references originating in later 7th-century Arab history.&lt;/font&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=top;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;" vertex="1" parent="owdOerk8Vaj5sQZDSKtN-164">
          <mxGeometry x="180" width="315" height="275" as="geometry">
            <mxRectangle width="315" height="275" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="owdOerk8Vaj5sQZDSKtN-167" value="&lt;font size=&quot;1&quot;&gt;&lt;b&gt;No with the Quran, yes with the Hadith (Shia vs. Sunni)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;There are no competing claims for the reliability or content of the Quran.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;The closest comparison is the &lt;i&gt;qira&#39;at&lt;/i&gt; (diffferent accentual/dialectical recitations) that the Prophet himself is reported to have used, but they are all accepted as authentic and even continue to be openly recited today.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;The only other comparison is the report of the Satanic verses, mentioned by Muslim historians 100–250 years after the Prophet&#39;s death. When surah&lt;i&gt; al-Najm&lt;/i&gt; was revealed (which ends with the command to prostrate to God) and the Prophet recited it publicly, the Makkan pagans are reported to have prostrated in awe of the Quran, their hearts touched by its power. Out of embarrassment, they later claimed they had heard 1-2 pagan-affirming verses and prostrated for that reason, alleging that Muhammad was tricked by Satan without realizing. However, this is a weak biographical report with no supporting transmission, no parallel incident in the historical record, and a motive (pagan embarrassment) that aligns more closely with their behavior outside of this incident. As such, it is not considered a successful challenge to the Quran&#39;s reliability or authority.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;There was also the Shia/Sunni split, but they differed over the nature of Ali b. Abi Talib, which is who the Shia assert was the rightful caliph after the Prophet&#39;s death. They believed that those closest to the Prophet corrupted the religion after he died, fabricating reports in his name to gain political power. As such, they have their own set of hadith compilations, in which the Prophet entrusted the true interpretation of the religion with Ali and his descendants (including Fatima, the Prophet&#39;s daughter and Ali&#39;s wife).&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;The &lt;b&gt;Shia Hadith&amp;nbsp;&lt;/b&gt;&lt;b style=&quot;text-align: left;&quot;&gt;stream&amp;nbsp;&lt;/b&gt;goes from: Muhammad&lt;/font&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); background-color: transparent; font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); background-color: transparent; font-size: 8px;&quot;&gt;→&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); background-color: transparent; font-size: 8px;&quot;&gt;&amp;nbsp;Ali b. Abi Talib&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); background-color: transparent; font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); background-color: transparent; font-size: 8px;&quot;&gt;→ Hasan &amp;amp; Husain b. Ali&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); background-color: transparent; font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); background-color: transparent; font-size: 8px;&quot;&gt;→&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); background-color: transparent; font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;Ali Zayn al-Abidin&lt;/span&gt;&lt;font color=&quot;rgba(0, 0, 0, 0)&quot;&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); background-color: transparent; font-size: 8px;&quot;&gt;→&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font color=&quot;rgba(0, 0, 0, 0)&quot;&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;Muhammad al-Baqir&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); background-color: transparent; font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); background-color: transparent; font-size: 8px;&quot;&gt;→&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;Jafar al-Sadiq&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;→ (the remaining Twelver imams) → Al-Kulayni (compiler of Shia hadith).&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCE5FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;" vertex="1" parent="owdOerk8Vaj5sQZDSKtN-164">
          <mxGeometry x="495" width="315" height="275" as="geometry">
            <mxRectangle width="315" height="275" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="owdOerk8Vaj5sQZDSKtN-168" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" vertex="1" parent="owdOerk8Vaj5sQZDSKtN-159">
          <mxGeometry y="445" width="810" height="520" as="geometry" />
        </mxCell>
        <mxCell id="owdOerk8Vaj5sQZDSKtN-169" value="&lt;font size=&quot;1&quot;&gt;&lt;b&gt;What are the strongest, independent chains of custodianship for each stream of transmission?&lt;/b&gt;&lt;/font&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#D5D5D5;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;gradientColor=none;" vertex="1" parent="owdOerk8Vaj5sQZDSKtN-168">
          <mxGeometry width="180" height="520" as="geometry">
            <mxRectangle width="180" height="520" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="owdOerk8Vaj5sQZDSKtN-170" value="&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot; size=&quot;1&quot;&gt;&lt;b&gt;Custodianship converges with Irenaeus, Eusebius, and Paul&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;span style=&quot;font-size: 2px; text-align: left;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&lt;b&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;Synoptic Chain (Mark)&lt;/font&gt;&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- Eusebius&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;→&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;&amp;nbsp;Papias (now lost)&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;→&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;&amp;nbsp; unnamed &quot;Elder&quot;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;→&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;&amp;nbsp;Mark&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;→&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;&amp;nbsp;Gospel of Mark&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;→ Peter&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;→ Jesus&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- &lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;Irenaeus&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;→&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;&amp;nbsp;unknown oral transmission (likely Polycarp&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;→&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;&amp;nbsp;Papias)&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;→&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;&amp;nbsp;Mark&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;→&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;Gospel of Mark&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;→ Peter&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;→ Jesus&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;span style=&quot;font-size: 2px; text-align: left;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&lt;b&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;Synoptic Chain (Matthew)&lt;/font&gt;&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- Eusebius&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;→&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;&amp;nbsp;Papias (now lost)&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;→&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;&amp;nbsp; unknown oral tradition&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;→&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;&amp;nbsp;Matthew&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;→&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;&amp;nbsp;Q/Logia (now lost, written in Hebrew or Aramaic)&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;→&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;Jesus&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;font style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;Irenaeus&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;→&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;&amp;nbsp;unknown oral transmission (likely Polycarp&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;→&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;&amp;nbsp;Papias)&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;→&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;&amp;nbsp;Matthew&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;→&lt;/span&gt;&lt;/font&gt;&lt;/di