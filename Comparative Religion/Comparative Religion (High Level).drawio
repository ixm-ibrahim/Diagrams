        <mxCell id="pEZGA_nxw4-GkV9pIiue-9" parent="pEZGA_nxw4-GkV9pIiue-8" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#E6E6E6;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=middle;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;swimlaneFillColor=none;gradientColor=none;gradientDirection=east;align=center;" value="&lt;span style=&quot;font-size: 11px;&quot;&gt;&lt;b&gt;Continuity of Apparent Miracles&lt;/b&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="65" width="105" as="geometry">
            <mxRectangle height="65" width="105" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="pEZGA_nxw4-GkV9pIiue-10" parent="pEZGA_nxw4-GkV9pIiue-8" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=middle;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;swimlaneFillColor=none;gradientColor=none;gradientDirection=east;align=left;" value="&lt;span style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;b style=&quot;font-size: 8px;&quot;&gt;Healing and intervention miracles with saints&lt;/b&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;, before and after their death&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- &lt;b&gt;Incorrupt bodies (ie. dead bodies that don&#39;t decompose properly) of certain saints&lt;/b&gt;, which are signs of sanctity and divine intervention&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- &lt;b&gt;Marian apparitions and other private revelations&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="65" width="315" x="105" as="geometry">
            <mxRectangle height="65" width="315" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="pEZGA_nxw4-GkV9pIiue-11" parent="pEZGA_nxw4-GkV9pIiue-8" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCE5FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=middle;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;swimlaneFillColor=none;gradientColor=none;gradientDirection=east;align=left;" value="&lt;div&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- &lt;b&gt;The Quran&#39;s unique style of revelation, literary eloquence, and naturalistic accuracy is far beyond the capacity of any 7th century Arabian to produce&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- &lt;b&gt;The Zamzam well is the world&#39;s oldest continuously flowing spring of its magnitude&lt;/b&gt;, flowing uninterrupted for 4000-5000 years despite being in a desert and only being 30 meters deep - yet supplying water for millions of people per year&lt;/span&gt;&lt;div&gt;&lt;b style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/b&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;- &lt;b&gt;Prophetic dreams&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="65" width="315" x="420" as="geometry">
            <mxRectangle height="65" width="315" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="QJBDpBy5fV4E1rT_YNH9-11" parent="j_oFuNdxFaeKGMjj7mMN-1" style="shape=table;startSize=0;container=1;collapsible=0;childLayout=tableLayout;fontSize=1;" value="" vertex="1">
          <mxGeometry height="80" width="690" x="140" y="10595" as="geometry" />
        </mxCell>
        <mxCell id="QJBDpBy5fV4E1rT_YNH9-12" parent="QJBDpBy5fV4E1rT_YNH9-11" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" value="" vertex="1">
          <mxGeometry height="40" width="690" as="geometry" />
        </mxCell>
        <mxCell id="QJBDpBy5fV4E1rT_YNH9-14" parent="QJBDpBy5fV4E1rT_YNH9-12" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=top;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;align=left;" value="&lt;span style=&quot;font-size: 8px;&quot;&gt;&lt;b&gt;2.&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&lt;b style=&quot;font-size: 8px;&quot;&gt;Sin incurs a real debt (ie. death, loss of sanctifying grace) that we can&#39;t pay on our own, so God personally satisfies that burden for us&lt;/b&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;(out of His love and to preserve perfect justice, such that we can be forgiven while also not leaving the debt unsettled)&lt;/span&gt;" vertex="1">
          <mxGeometry height="40" width="345" as="geometry">
            <mxRectangle height="40" width="345" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="QJBDpBy5fV4E1rT_YNH9-15" parent="QJBDpBy5fV4E1rT_YNH9-12" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCE5FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;align=left;" value="&lt;font style=&quot;font-size: 9px;&quot;&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&lt;b&gt;2.&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&lt;b style=&quot;font-size: 8px;&quot;&gt;God holds us accountable only to our own actions, rewarding righteousness and condemning sin&lt;/b&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;(such that the path to forgiveness is opened before the path to punishment, and good deeds can erase and transform bad deeds - both out of His mercy)&lt;/span&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="40" width="345" x="345" as="geometry">
            <mxRectangle height="40" width="345" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="12O9KAhvBZucQ_TWsCz2-9" parent="QJBDpBy5fV4E1rT_YNH9-11" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" vertex="1">
          <mxGeometry height="40" width="690" y="40" as="geometry" />
        </mxCell>
        <mxCell id="12O9KAhvBZucQ_TWsCz2-10" parent="12O9KAhvBZucQ_TWsCz2-9" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=top;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;align=left;" value="&lt;span style=&quot;font-size: 8px;&quot;&gt;&lt;b&gt;3.&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&lt;b style=&quot;font-size: 8px;&quot;&gt;Adam earned the debt of original sin, which God (in the Person of Jesus) fulfilled its settlement and defeated death on our behalf&lt;/b&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;(as finite mankind can&#39;t recreate a divine grace when lost, which can only be supplied by God)&lt;/span&gt;" vertex="1">
          <mxGeometry height="40" width="345" as="geometry">
            <mxRectangle height="40" width="345" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="12O9KAhvBZucQ_TWsCz2-11" parent="12O9KAhvBZucQ_TWsCz2-9" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCE5FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;align=left;" value="&lt;span style=&quot;font-size: 8px;&quot;&gt;&lt;b&gt;3.&amp;nbsp;Adam slipped in his obedience to God, immediately repented, and was forgiven by God:&amp;nbsp;&lt;/b&gt;an experience meant to teach him - and all mankind - of what his relationship with God is, what his purpose in life is, and who his enemy is&lt;/span&gt;" vertex="1">
          <mxGeometry height="40" width="345" x="345" as="geometry">
            <mxRectangle height="40" width="345" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="QJBDpBy5fV4E1rT_YNH9-16" parent="j_oFuNdxFaeKGMjj7mMN-1" style="shape=table;startSize=0;container=1;collapsible=0;childLayout=tableLayout;fontSize=1;" value="" vertex="1">
          <mxGeometry height="30.000000000000007" width="690" x="140" y="10565" as="geometry" />
        </mxCell>
        <mxCell id="QJBDpBy5fV4E1rT_YNH9-17" parent="QJBDpBy5fV4E1rT_YNH9-16" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" value="" vertex="1">
          <mxGeometry height="30" width="690" as="geometry" />
        </mxCell>
        <mxCell id="QJBDpBy5fV4E1rT_YNH9-18" parent="QJBDpBy5fV4E1rT_YNH9-17" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=middle;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;gradientColor=#CCE5FF;gradientDirection=east;align=left;" value="&lt;span style=&quot;font-size: 8px;&quot;&gt;&lt;b&gt;1. Both religions differ in salvific mechanism but achieve the same result&lt;/b&gt;: God is One, just, merciful, loving, holds us accountable to our own actions, merits righteousness and condemns sin, and requires faith to be eligible for salvation.&lt;/span&gt;" vertex="1">
          <mxGeometry height="30" width="690" as="geometry">
            <mxRectangle height="30" width="690" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="OwSggUmYe3_3DyWU2Ez6-0" connectable="0" parent="j_oFuNdxFaeKGMjj7mMN-1" style="group" value="" vertex="1">
          <mxGeometry height="50" width="690" x="140" y="10675" as="geometry" />
        </mxCell>
        <mxCell id="WN0YriMYqXRXFmRxLebv-7" parent="OwSggUmYe3_3DyWU2Ez6-0" style="shape=table;startSize=0;container=1;collapsible=0;childLayout=tableLayout;fontSize=1;" value="" vertex="1">
          <mxGeometry height="30" width="690" as="geometry" />
        </mxCell>
        <mxCell id="WN0YriMYqXRXFmRxLebv-8" parent="WN0YriMYqXRXFmRxLebv-7" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" value="" vertex="1">
          <mxGeometry height="30" width="690" as="geometry" />
        </mxCell>
        <mxCell id="WN0YriMYqXRXFmRxLebv-9" parent="WN0YriMYqXRXFmRxLebv-8" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=top;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;align=left;" value="&lt;span style=&quot;font-size: 8px;&quot;&gt;&lt;b&gt;4.&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&lt;b style=&quot;font-size: 8px;&quot;&gt;Justice is fundamentally about settlement&lt;/b&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;(sin creates a spiritual debt that must be satisfied - such that it can be paid for by an eligible substitute [in Christ])&lt;/span&gt;" vertex="1">
          <mxGeometry height="30" width="345" as="geometry">
            <mxRectangle height="30" width="345" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="WN0YriMYqXRXFmRxLebv-10" parent="WN0YriMYqXRXFmRxLebv-8" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCE5FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;align=left;" value="&lt;span style=&quot;font-size: 8px;&quot;&gt;&lt;b&gt;4.&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&lt;b style=&quot;font-size: 8px;&quot;&gt;Justice is fundamentally about accountability&amp;nbsp;&lt;/b&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;(every soul bears only its own burden, such that both the debt of sin and reward of righteousness are borne only by the guilty)&lt;/span&gt;" vertex="1">
          <mxGeometry height="30" width="345" x="345" as="geometry">
            <mxRectangle height="30" width="345" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="RFqWR5YNHUVcKUKohpcg-0" parent="OwSggUmYe3_3DyWU2Ez6-0" style="shape=table;startSize=0;container=1;collapsible=0;childLayout=tableLayout;fontSize=1;" value="" vertex="1">
          <mxGeometry height="20.000000000000004" width="690" y="30" as="geometry" />
        </mxCell>
        <mxCell id="RFqWR5YNHUVcKUKohpcg-1" parent="RFqWR5YNHUVcKUKohpcg-0" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" value="" vertex="1">
          <mxGeometry height="20" width="690" as="geometry" />
        </mxCell>
        <mxCell id="RFqWR5YNHUVcKUKohpcg-2" parent="RFqWR5YNHUVcKUKohpcg-1" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCE5FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=middle;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;gradientColor=none;gradientDirection=east;align=left;" value="&lt;span style=&quot;font-size: 8px;&quot;&gt;&lt;b&gt;4.&amp;nbsp;Islam accomplishes everything the Christian Jesus does, but with a more perfect form of accountability, consistency, and better fitting the mold of a &quot;loving father&quot;&lt;/b&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="20" width="690" as="geometry">
            <mxRectangle height="20" width="690" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="fMtiQ8aYU-Kinl-B8Urg-0" parent="j_oFuNdxFaeKGMjj7mMN-1" style="shape=table;startSize=0;container=1;collapsible=0;childLayout=tableLayout;fontSize=1;" value="" vertex="1">
          <mxGeometry height="20.00000000000001" width="690" x="140" y="10725" as="geometry" />
        </mxCell>
        <mxCell id="fMtiQ8aYU-Kinl-B8Urg-1" parent="fMtiQ8aYU-Kinl-B8Urg-0" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" value="" vertex="1">
          <mxGeometry height="20" width="690" as="geometry" />
        </mxCell>
        <mxCell id="fMtiQ8aYU-Kinl-B8Urg-2" parent="fMtiQ8aYU-Kinl-B8Urg-1" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=middle;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;gradientColor=#CCE5FF;gradientDirection=east;align=left;" value="&lt;span style=&quot;font-size: 8px;&quot;&gt;&lt;b&gt;5. Both religions affirm God&#39;s perfect justice and the need for God&#39;s grace and mercy - but they are redirected differently in both narratives&lt;/b&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="20" width="690" as="geometry">
            <mxRectangle height="20" width="690" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="OwSggUmYe3_3DyWU2Ez6-2" parent="j_oFuNdxFaeKGMjj7mMN-1" style="shape=table;startSize=0;container=1;collapsible=0;childLayout=tableLayout;fontSize=1;" value="" vertex="1">
          <mxGeometry height="40" width="690" x="140" y="10745" as="geometry" />
        </mxCell>
        <mxCell id="OwSggUmYe3_3DyWU2Ez6-3" parent="OwSggUmYe3_3DyWU2Ez6-2" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" value="" vertex="1">
          <mxGeometry height="40" width="690" as="geometry" />
        </mxCell>
        <mxCell id="OwSggUmYe3_3DyWU2Ez6-4" parent="OwSggUmYe3_3DyWU2Ez6-3" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=top;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;align=left;" value="&lt;span style=&quot;font-size: 8px;&quot;&gt;&lt;b&gt;5.&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;Relative to Christianity, &lt;/span&gt;&lt;b style=&quot;font-size: 8px;&quot;&gt;Islam &lt;/b&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&lt;b&gt;&lt;i&gt;sharpens&lt;/i&gt; God&#39;s oneness and rationality, &lt;i&gt;magnifies&lt;/i&gt; mercy and accountability, and &lt;i&gt;diminishes&lt;/i&gt; the emphasis on Satan&#39;s power&lt;/b&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="40" width="345" as="geometry">
            <mxRectangle height="40" width="345" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="OwSggUmYe3_3DyWU2Ez6-5" parent="OwSggUmYe3_3DyWU2Ez6-3" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCE5FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;align=left;" value="&lt;span style=&quot;font-size: 8px;&quot;&gt;&lt;b&gt;5.&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;Relative to Islam, &lt;/span&gt;&lt;b style=&quot;font-size: 8px;&quot;&gt;Christianity&amp;nbsp;&lt;/b&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&lt;b&gt;&lt;i&gt;increases&lt;/i&gt; God&#39;s expectations, &lt;i&gt;emphasizes&lt;/i&gt; Satan&#39;s power, &lt;i&gt;reduces&lt;/i&gt; God&#39;s oneness and original mercy, and &lt;i&gt;diminishes&lt;/i&gt; the salvific function of our good deeds, our spiritual status, and rationality&lt;/b&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="40" width="345" x="345" as="geometry">
            <mxRectangle height="40" width="345" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="OwSggUmYe3_3DyWU2Ez6-6" parent="j_oFuNdxFaeKGMjj7mMN-1" style="shape=table;startSize=0;container=1;collapsible=0;childLayout=tableLayout;fontSize=1;" value="" vertex="1">
          <mxGeometry height="20.000000000000004" width="690" x="140" y="10785" as="geometry" />
        </mxCell>
        <mxCell id="OwSggUmYe3_3DyWU2Ez6-7" parent="OwSggUmYe3_3DyWU2Ez6-6" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" value="" vertex="1">
          <mxGeometry height="20" width="690" as="geometry" />
        </mxCell>
        <mxCell id="OwSggUmYe3_3DyWU2Ez6-8" parent="OwSggUmYe3_3DyWU2Ez6-7" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCE5FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=middle;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;gradientColor=none;gradientDirection=east;align=left;" value="&lt;span style=&quot;font-size: 8px;&quot;&gt;&lt;b&gt;5.&amp;nbsp;Christianity looks more like a corrupted version of Islam, while Islam looks more like a corrected version of Christianity&lt;/b&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="20" width="690" as="geometry">
            <mxRectangle height="20" width="690" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uQ5QaMLYbG1i-gNb17ki-24" parent="j_oFuNdxFaeKGMjj7mMN-1" style="shape=table;startSize=0;container=1;collapsible=0;childLayout=tableLayout;fontSize=1;" value="" vertex="1">
          <mxGeometry height="185" width="120" x="20" y="10810" as="geometry" />
        </mxCell>
        <mxCell id="uQ5QaMLYbG1i-gNb17ki-25" parent="uQ5QaMLYbG1i-gNb17ki-24" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" value="" vertex="1">
          <mxGeometry height="185" width="120" as="geometry" />
        </mxCell>
        <mxCell id="uQ5QaMLYbG1i-gNb17ki-26" parent="uQ5QaMLYbG1i-gNb17ki-25" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#E6E6E6;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=middle;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;Results&lt;/b&gt;" vertex="1">
          <mxGeometry height="185" width="120" as="geometry">
            <mxRectangle height="185" width="120" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uQ5QaMLYbG1i-gNb17ki-27" parent="j_oFuNdxFaeKGMjj7mMN-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=default;" value="" vertex="1">
          <mxGeometry height="5" width="810" x="20" y="10805" as="geometry" />
        </mxCell>
        <mxCell id="BthCZnvn9CFvYLfUr9kn-0" parent="j_oFuNdxFaeKGMjj7mMN-1" style="shape=table;startSize=0;container=1;collapsible=0;childLayout=tableLayout;fontSize=1;" value="" vertex="1">
          <mxGeometry height="185" width="690" x="140" y="10810" as="geometry" />
        </mxCell>
        <mxCell id="BthCZnvn9CFvYLfUr9kn-1" parent="BthCZnvn9CFvYLfUr9kn-0" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;swimlaneFillColor=none;" vertex="1">
          <mxGeometry height="185" width="690" as="geometry" />
        </mxCell>
        <mxCell id="BthCZnvn9CFvYLfUr9kn-2" parent="BthCZnvn9CFvYLfUr9kn-1" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=middle;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;swimlaneFillColor=none;gradientColor=#CCE5FF;gradientDirection=east;align=center;" value="&lt;div&gt;&lt;font size=&quot;1&quot;&gt;&lt;b&gt;As with prior sections, all results converge on the same observation: Islam delivers a more internally and externally consistent message while achieving the same intended outcome Christianity seeks: justice alongside mercy.&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;Both traditions emphasize God’s love, mercy, justice, and grace, yet diverge in the &lt;i&gt;mechanism&lt;/i&gt; by which these attributes operaten&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;- and s&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;ince our purpose in life is directly related to God&#39;s soteriology, these differences reveal several significant observations at the fundamental level.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;br&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;Most notably, Christianity distinguishes between law and grace, while Islam does not. In Christianity, the law condemns while grace saves; in Islam, God and His law fully governs both salvation and condemnation - opening the door to forgiveness before punishment by His grace. In Christianity, Adam was punished for his sin; in Islam, he was forgiven. And in Christianity, salvific forgiveness requires God to fulfill the burden&amp;nbsp;&lt;/span&gt;&lt;i style=&quot;font-size: 8px;&quot;&gt;we earned&amp;nbsp;&lt;/i&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;on our behalf, while in Islam, we are held fully accountable to both our sins and righteousness (without any part of the burden being transferred to another) - with God&#39;s mechanism for forgiveness established through Adam from the start.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;From the lens of effectiveness, these differences reveal that Islam’s salvific narrative accomplishes everything Christianity’s does, but more consistently. It preserves justice by holding deeds accountable, while manifesting mercy without original sin, vicarious substitution, God becoming a man, or a law that is framed primarily against us - avoiding the portrayal of God in a pagan way, His justice with deflected accountability,&amp;nbsp;and His law negatively - all just to heighten God’s love that was already there (in Islam&#39;s narrative). Put differently: if original sin and atonement are removed from the Christian narrative (since atonement is a response to sin’s asymmetrical gravity), the Islamic narrative becomes exposed.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp; Finally, this comparison also allows us to identify which religion looks more like a corruption of the other - with Christianity diminishing the salvific function of our good deeds and introducing an intermediary between us and God in the form of a man - which is indistinguishable from Satan&#39;s goal of getting us to worship creation instead of the Creator. Moreover,&amp;nbsp;Islam&#39;s God better fits the concept of a &quot;loving father&quot;: He reminded Adam about Satan, taught him of the consequences for both sin and righteousness, and forgave him upon his sincere repentance - just as a loving father would to a righteous and sincerely repentant child for his first offense.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;If the True religion must be distinguishable from falsehood, it will maximize internal and external consistency; and as with each prior section, Islam appears superior to Christianity in this respect.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="185" width="690" as="geometry">
            <mxRectangle height="185" width="690" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="Results &amp; Conclusion (1/3)" id="R44VZf4XfXH4xPomtI6w">
    <mxGraphModel dx="961" dy="-9035" grid="1" gridSize="5" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" background="#CCCCCC" math="0" shadow="0" adaptiveColors="none">
      <root>
        <mxCell id="vXm2kpI-il_o7RX6dSA9-0" />
        <mxCell id="vXm2kpI-il_o7RX6dSA9-1" parent="vXm2kpI-il_o7RX6dSA9-0" />
        <UserObject label="Results and Conclusion (1/3&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;)&lt;/span&gt;" link="data:page/id,lkuSvPZcJC7dHRsydWrw" id="vXm2kpI-il_o7RX6dSA9-2">
          <mxCell parent="vXm2kpI-il_o7RX6dSA9-1" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#E6E6E6;fontSize=20;" vertex="1">
            <mxGeometry height="50" width="810" x="20" y="9920" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="gYT5Y22KyUmHbeMBvNfj-0" parent="vXm2kpI-il_o7RX6dSA9-1" style="rounded=0;whiteSpace=wrap;html=1;pointerEvents=0;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=1;fillColor=#f5f5f5;gradientColor=#b3b3b3;strokeColor=#666666;spacingTop=4;spacingLeft=6;spacingRight=6;" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;This project began with a simple question: &lt;b style=&quot;&quot;&gt;How can we distinguish between truth and falsehood?&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;Not &quot;what do I prefer&quot; or &quot;what comforts me&quot; or even &quot;what affirms my beliefs&quot;, but identifying what is actually true - &lt;/span&gt;&lt;b style=&quot;font-size: 10px;&quot;&gt;by the same standards we use to distinguish truth anywhere else&lt;/b&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;. In practical terms, we want to figure out: &quot;&lt;/span&gt;&lt;b style=&quot;font-size: 10px;&quot;&gt;given the abundance of information (where much of it false and only some of it true), &lt;/b&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;&lt;b&gt;what conditions are required to reliably and confidently filter falsehood from truth&lt;/b&gt;&lt;/span&gt;&lt;b style=&quot;font-size: 10px;&quot;&gt;?&lt;/b&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;&quot;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;This project functions as that progressive filter, where each section adds a set of necessary conditions for truth to remain distinguishable from fabrication. When any of these necessary constraints are rejected, the original question collapses - because what remains can be used to justify both truth and falsehood, making them indistinguishable (thus allowing us to validly defend false beliefs, without realizing). What follows is the path that allows us to derive the natural conclusions from narrowing these hierarchical constraints.&lt;/font&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="810" x="20" y="9985" as="geometry" />
        </mxCell>
        <mxCell id="pJg3SHPVufzG-P1PX_YF-141" parent="vXm2kpI-il_o7RX6dSA9-1" style="shape=table;startSize=0;container=1;collapsible=0;childLayout=tableLayout;fontSize=1;" value="" vertex="1">
          <mxGeometry height="30" width="810" x="20" y="10130" as="geometry" />
        </mxCell>
        <mxCell id="pJg3SHPVufzG-P1PX_YF-142" parent="pJg3SHPVufzG-P1PX_YF-141" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" value="" vertex="1">
          <mxGeometry height="30" width="810" as="geometry" />
        </mxCell>
        <mxCell id="pJg3SHPVufzG-P1PX_YF-143" parent="pJg3SHPVufzG-P1PX_YF-142" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#DFDFDF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=middle;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;gradientColor=none;align=center;strokeWidth=0;" value="&lt;div&gt;&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Results&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="305" as="geometry">
            <mxRectangle height="30" width="305" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="pJg3SHPVufzG-P1PX_YF-144" parent="pJg3SHPVufzG-P1PX_YF-142" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#DFDFDF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=middle;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;gradientColor=none;align=center;strokeWidth=0;" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;What this Eliminates&lt;/font&gt;&lt;/b&gt;" vertex="1">
          <mxGeometry height="30" width="265" x="305" as="geometry">
            <mxRectangle height="30" width="265" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="pJg3SHPVufzG-P1PX_YF-145" parent="pJg3SHPVufzG-P1PX_YF-142" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#DFDFDF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=middle;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;gradientColor=none;align=center;strokeWidth=0;" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Why this Opens the Next Section&lt;/font&gt;&lt;/b&gt;" vertex="1">
          <mxGeometry height="30" width="240" x="570" as="geometry">
            <mxRectangle height="30" width="240" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="6SWEsmhpVgZ_iy8dqvlR-0" connectable="0" parent="vXm2kpI-il_o7RX6dSA9-1" style="group" value="" vertex="1">
          <mxGeometry height="110" width="810" x="20" y="10160" as="geometry" />
        </mxCell>
        <mxCell id="pJg3SHPVufzG-P1PX_YF-105" parent="6SWEsmhpVgZ_iy8dqvlR-0" style="shape=table;startSize=0;container=1;collapsible=0;childLayout=tableLayout;fontSize=1;" value="" vertex="1">
          <mxGeometry height="80" width="810" y="30" as="geometry" />
        </mxCell>
        <mxCell id="pJg3SHPVufzG-P1PX_YF-106" parent="pJg3SHPVufzG-P1PX_YF-105" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" value="" vertex="1">
          <mxGeometry height="80" width="810" as="geometry" />
        </mxCell>
        <mxCell id="pJg3SHPVufzG-P1PX_YF-108" parent="pJg3SHPVufzG-P1PX_YF-106" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#DFDFDF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;gradientColor=none;align=left;strokeWidth=0;" value="&lt;div&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&amp;nbsp;- The pursuit of truth starts with me: if I&#39;m not willing to be corrected or recognize that my beliefs could be wrong, then I&#39;m not really pursuing truth - I am only pursuing affirmation (comfort, loyalty, fear-management, aesthetics, tribe, etc.).&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&amp;nbsp;- Truth is external to me, defined by reality (rather than preference).&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="80" width="305" as="geometry">
            <mxRectangle height="80" width="305" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="pJg3SHPVufzG-P1PX_YF-109" parent="pJg3SHPVufzG-P1PX_YF-106" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#DFDFDF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;gradientColor=none;align=left;strokeWidth=0;" value="&lt;font style=&quot;font-size: 10px;&quot;&gt;&amp;nbsp;- Selecting (or sticking to a belief) [solely] from affirmation, whether from comfort, fear, aesthetics, cultural inheritance, tribe, or familiarity.&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="265" x="305" as="geometry">
            <mxRectangle height="80" width="265" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="pJg3SHPVufzG-P1PX_YF-110" parent="pJg3SHPVufzG-P1PX_YF-106" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#DFDFDF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;gradientColor=none;align=left;strokeWidth=0;" value="&lt;font style=&quot;font-size: 10px;&quot;&gt;&amp;nbsp;- Once you are committed to being corrected by reality (ie. a neutral, external standard [to your preferences]), we can now define reality itself.&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="240" x="570" as="geometry">
            <mxRectangle height="80" width="240" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="pJg3SHPVufzG-P1PX_YF-182" parent="6SWEsmhpVgZ_iy8dqvlR-0" style="shape=table;startSize=0;container=1;collapsible=0;childLayout=tableLayout;fontSize=1;" value="" vertex="1">
          <mxGeometry height="30" width="810" as="geometry" />
        </mxCell>
        <mxCell id="pJg3SHPVufzG-P1PX_YF-183" parent="pJg3SHPVufzG-P1PX_YF-182" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" value="" vertex="1">
          <mxGeometry height="30" width="810" as="geometry" />
        </mxCell>
        <mxCell id="pJg3SHPVufzG-P1PX_YF-184" parent="pJg3SHPVufzG-P1PX_YF-183" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#F8CECC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=middle;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;gradientColor=#EA6B66;align=center;strokeWidth=0;" value="&lt;b style=&quot;font-size: 12px;&quot;&gt;1. Pursuit of [Any] Truth&lt;/b&gt;" vertex="1">
          <mxGeometry height="30" width="810" as="geometry">
            <mxRectangle height="30" width="810" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="6SWEsmhpVgZ_iy8dqvlR-1" connectable="0" parent="vXm2kpI-il_o7RX6dSA9-1" style="group" value="" vertex="1">
          <mxGeometry height="110" width="810" x="20" y="10270" as="geometry" />
        </mxCell>
        <mxCell id="pJg3SHPVufzG-P1PX_YF-187" parent="6SWEsmhpVgZ_iy8dqvlR-1" style="shape=table;startSize=0;container=1;collapsible=0;childLayout=tableLayout;fontSize=1;" value="" vertex="1">
          <mxGeometry height="30" width="810" as="geometry" />
        </mxCell>
        <mxCell id="pJg3SHPVufzG-P1PX_YF-188" parent="pJg3SHPVufzG-P1PX_YF-187" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" value="" vertex="1">
          <mxGeometry height="30" width="810" as="geometry" />
        </mxCell>
        <mxCell id="pJg3SHPVufzG-P1PX_YF-189" parent="pJg3SHPVufzG-P1PX_YF-188" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#FFDEC9;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=middle;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;gradientColor=#FFB663;align=center;strokeWidth=0;" value="&lt;b style=&quot;font-size: 12px;&quot;&gt;2. Discovering Reality&lt;/b&gt;" vertex="1">
          <mxGeometry height="30" width="810" as="geometry">
            <mxRectangle height="30" width="810" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="pJg3SHPVufzG-P1PX_YF-190" parent="6SWEsmhpVgZ_iy8dqvlR-1" style="shape=table;startSize=0;container=1;collapsible=0;childLayout=tableLayout;fontSize=1;" value="" vertex="1">
          <mxGeometry height="80" width="810" y="30" as="geometry" />
        </mxCell>
        <mxCell id="pJg3SHPVufzG-P1PX_YF-196" parent="pJg3SHPVufzG-P1PX_YF-190" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" vertex="1">
          <mxGeometry height="80" width="810" as="geometry" />
        </mxCell>
        <mxCell id="pJg3SHPVufzG-P1PX_YF-198" parent="pJg3SHPVufzG-P1PX_YF-196" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#DFDFDF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;gradientColor=none;align=left;strokeWidth=0;" value="&lt;div&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&amp;nbsp;- We have phenomenological awareness (senses, memory, imagination, reasoning) and limitations in perception (bias, error, ignorance, forgetfulness).&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&amp;nbsp;- Reality (ie. what is phenomenologically observed) presents stable patterns, allowing us to infer about reality&#39;s structure.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="80" width="305" as="geometry">
            <mxRectangle height="80" width="305" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="pJg3SHPVufzG-P1PX_YF-199" parent="pJg3SHPVufzG-P1PX_YF-196" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#DFDFDF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;gradientColor=none;align=left;strokeWidth=0;" value="&lt;div&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&amp;nbsp;- Separating truth/reality from awareness (ie. associating speculation with truth), allowing falsehood to be justified.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&amp;nbsp;- &quot;Perception = truth&quot; (given our limitations) as well as &quot;perception = inability to arrive at truth&quot; (given our ability to detect patterns).&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="80" width="265" x="305" as="geometry">
            <mxRectangle height="80" width="265" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="pJg3SHPVufzG-P1PX_YF-200" parent="pJg3SHPVufzG-P1PX_YF-196" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#DFDFDF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;gradientColor=none;align=left;strokeWidth=0;" value="&lt;span style=&quot;font-size: 10px;&quot;&gt;&amp;nbsp;- Given our limitations in perception, we need to define an approach that builds confidence in the patterns we do notice - without granting falsehood the same privileges as truth.&lt;/span&gt;" vertex="1">
          <mxGeometry height="80" width="240" x="570" as="geometry">
            <mxRectangle height="80" width="240" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="6SWEsmhpVgZ_iy8dqvlR-2" connectable="0" parent="vXm2kpI-il_o7RX6dSA9-1" style="group" value="" vertex="1">
          <mxGeometry height="190" width="810" x="20" y="10380" as="geometry" />
        </mxCell>
        <mxCell id="pJg3SHPVufzG-P1PX_YF-226" parent="6SWEsmhpVgZ_iy8dqvlR-2" style="shape=table;startSize=0;container=1;collapsible=0;childLayout=tableLayout;fontSize=1;" value="" vertex="1">
          <mxGeometry height="30" width="810" as="geometry" />
        </mxCell>
        <mxCell id="pJg3SHPVufzG-P1PX_YF-227" parent="pJg3SHPVufzG-P1PX_YF-226" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" value="" vertex="1">
          <mxGeometry height="30" width="810" as="geometry" />
        </mxCell>
        <mxCell id="pJg3SHPVufzG-P1PX_YF-228" parent="pJg3SHPVufzG-P1PX_YF-227" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#FFF2CC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=middle;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;gradientColor=#FFD966;align=center;strokeWidth=0;" value="&lt;b style=&quot;font-size: 12px;&quot;&gt;3. Building Confidence&amp;nbsp;[in Logical and Historical Claims]&lt;/b&gt;" vertex="1">
          <mxGeometry height="30" width="810" as="geometry">
            <mxRectangle height="30" width="810" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="pJg3SHPVufzG-P1PX_YF-229" parent="6SWEsmhpVgZ_iy8dqvlR-2" style="shape=table;startSize=0;container=1;collapsible=0;childLayout=tableLayout;fontSize=1;" value="" vertex="1">
          <mxGeometry height="160" width="810" y="30" as="geometry" />
        </mxCell>
        <mxCell id="pJg3SHPVufzG-P1PX_YF-240" parent="pJg3SHPVufzG-P1PX_YF-229" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" vertex="1">
          <mxGeometry height="160" width="810" as="geometry" />
        </mxCell>
        <mxCell id="pJg3SHPVufzG-P1PX_YF-242" parent="pJg3SHPVufzG-P1PX_YF-240" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#DFDFDF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;gradientColor=none;align=left;strokeWidth=0;" value="&lt;div&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&amp;nbsp;- Claims (ie. information that are true or false) can&#39;t be justified by assuming itself - that is assertion, not justification or proof.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&amp;nbsp;- Any approach that can be used to &quot;prove&quot; falsehood makes truth and falsehood indistinguishable.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&amp;nbsp;- Logical confidence&amp;nbsp;requires axioms grounded in reality, premises grounded in axioms, internal and external consistency, and absence of valid objections and alternative explanations.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&amp;nbsp;- Historical confidence requires&amp;nbsp;&lt;span style=&quot;background-color: transparent;&quot;&gt;eyewitnesses and archaeology, independent corroboration, traceable and unbroken chains, and strong resistance to fabrication&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="160" width="305" as="geometry">
            <mxRectangle height="160" width="305" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="pJg3SHPVufzG-P1PX_YF-243" parent="pJg3SHPVufzG-P1PX_YF-240" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#DFDFDF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;gradientColor=none;align=left;strokeWidth=0;" value="&lt;div&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&amp;nbsp;- Circular (ie. baseless) logic and authentication - allowing liars and fabricators to justify any false belief.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&amp;nbsp;- Confidence based on speculation (ie. ignorance) and untrustworthy (ie. unreliable) sources.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="160" width="265" x="305" as="geometry">
            <mxRectangle height="160" width="265" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="pJg3SHPVufzG-P1PX_YF-244" parent="pJg3SHPVufzG-P1PX_YF-240" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#DFDFDF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;gradientColor=none;align=left;strokeWidth=0;" value="&lt;span style=&quot;font-size: 10px;&quot;&gt;&amp;nbsp;- Using this approach, we can now build confidence in defining reality&#39;s source (ie. God), as well as our purpose in it (ie. religion).&lt;/span&gt;" vertex="1">
          <mxGeometry height="160" width="240" x="570" as="geometry">
            <mxRectangle height="160" width="240" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="6SWEsmhpVgZ_iy8dqvlR-3" connectable="0" parent="vXm2kpI-il_o7RX6dSA9-1" style="group" value="" vertex="1">
          <mxGeometry height="110" width="810" x="20" y="10570" as="geometry" />
        </mxCell>
        <mxCell id="pJg3SHPVufzG-P1PX_YF-265" parent="6SWEsmhpVgZ_iy8dqvlR-3" style="shape=table;startSize=0;container=1;collapsible=0;childLayout=tableLayout;fontSize=1;" value="" vertex="1">
          <mxGeometry height="30" width="810" as="geometry" />
        </mxCell>
        <mxCell id="pJg3SHPVufzG-P1PX_YF-266" parent="pJg3SHPVufzG-P1PX_YF-265" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" value="" vertex="1">
          <mxGeometry height="30" width="810" as="geometry" />
        </mxCell>
        <mxCell id="pJg3SHPVufzG-P1PX_YF-267" parent="pJg3SHPVufzG-P1PX_YF-266" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#D5E8D4;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=middle;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;gradientColor=#97D077;align=center;strokeWidth=0;" value="&lt;b style=&quot;font-size: 12px;&quot;&gt;4. Defining God&lt;/b&gt;" vertex="1">
          <mxGeometry height="30" width="810" as="geometry">
            <mxRectangle height="30" width="810" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="pJg3SHPVufzG-P1PX_YF-304" parent="6SWEsmhpVgZ_iy8dqvlR-3" style="shape=table;startSize=0;container=1;collapsible=0;childLayout=tableLayout;fontSize=1;" value="" vertex="1">
          <mxGeometry height="80" width="810" y="30" as="geometry" />
        </mxCell>
        <mxCell id="pJg3SHPVufzG-P1PX_YF-305" parent="pJg3SHPVufzG-P1PX_YF-304" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" vertex="1">
          <mxGeometry height="80" width="810" as="geometry" />
        </mxCell>
        <mxCell id="pJg3SHPVufzG-P1PX_YF-307" parent="pJg3SHPVufzG-P1PX_YF-305" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#DFDFDF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;gradientColor=none;align=left;strokeWidth=0;" value="&lt;div&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&amp;nbsp;- God possesses ultimate power and intelligence, transcends time and space, and built realty by His will.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&amp;nbsp;- The True religion corresponds to God&#39;s will, distinguishes mysteries from contradictions, and requires faith supported by reason&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="80" width="305" as="geometry">
            <mxRectangle height="80" width="305" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="pJg3SHPVufzG-P1PX_YF-308" parent="pJg3SHPVufzG-P1PX_YF-305" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#DFDFDF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;gradientColor=none;align=left;strokeWidth=0;" value="&lt;div&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&amp;nbsp;- Any worldview that lacks this description of God, and any religion that lacks these requirements.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Faith without reason (allowing faith in falsehood - with no possible mechanism for detection - with the only response to valid doubt [to that falsehood] being to &quot;believe harder&quot;).&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="80" width="265" x="305" as="geometry">
            <mxRectangle height="80" width="265" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="pJg3SHPVufzG-P1PX_YF-309" parent="pJg3SHPVufzG-P1PX_YF-305" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#DFDFDF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;gradientColor=none;align=left;strokeWidth=0;" value="&lt;span style=&quot;font-size: 10px;&quot;&gt;&amp;nbsp;- We&#39;ve made our prediction of God and the True religion - now we can identify which worldview aligns with it.&lt;/span&gt;" vertex="1">
          <mxGeometry height="80" width="240" x="570" as="geometry">
            <mxRectangle height="80" width="240" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="6SWEsmhpVgZ_iy8dqvlR-4" connectable="0" parent="vXm2kpI-il_o7RX6dSA9-1" style="group" value="" vertex="1">
          <mxGeometry height="135" width="810" x="20" y="10680" as="geometry" />
        </mxCell>
        <mxCell id="pJg3SHPVufzG-P1PX_YF-325" parent="6SWEsmhpVgZ_iy8dqvlR-4" style="shape=table;startSize=0;container=1;collapsible=0;childLayout=tableLayout;fontSize=1;" value="" vertex="1">
          <mxGeometry height="30" width="810" as="geometry" />
        </mxCell>
        <mxCell id="pJg3SHPVufzG-P1PX_YF-326" parent="pJg3SHPVufzG-P1PX_YF-325" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" value="" vertex="1">
          <mxGeometry height="30" width="810" as="geometry" />
        </mxCell>
        <mxCell id="pJg3SHPVufzG-P1PX_YF-327" parent="pJg3SHPVufzG-P1PX_YF-326" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#DAE8FC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=middle;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;gradientColor=#7EA6E0;align=center;strokeWidth=0;" value="&lt;b style=&quot;font-size: 12px;&quot;&gt;5.&amp;nbsp;&lt;/b&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;b&gt;Alignment with Reality&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&lt;b style=&quot;font-size: 12px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;[Atheism, Polytheism, Trinitarianism, and Monotheism]&lt;/b&gt;" vertex="1">
          <mxGeometry height="30" width="810" as="geometry">
            <mxRectangle height="30" width="810" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="pJg3SHPVufzG-P1PX_YF-328" parent="6SWEsmhpVgZ_iy8dqvlR-4" style="shape=table;startSize=0;container=1;collapsible=0;childLayout=tableLayout;fontSize=1;" value="" vertex="1">
          <mxGeometry height="105" width="810" y="30" as="geometry" />
        </mxCell>
        <mxCell id="pJg3SHPVufzG-P1PX_YF-329" parent="pJg3SHPVufzG-P1PX_YF-328" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" vertex="1">
          <mxGeometry height="105" width="810" as="geometry" />
        </mxCell>
        <mxCell id="pJg3SHPVufzG-P1PX_YF-331" parent="pJg3SHPVufzG-P1PX_YF-329" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#DFDFDF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;gradientColor=none;align=left;strokeWidth=0;" value="&lt;div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&amp;nbsp;- Trinitarianism and Monotheism both align with our inferences from reality, with Monotheism aligning more clearly.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&amp;nbsp;- Trinitarianism requires superior textual authority and preservation over Monotheism to possess greater confidence, as well as an additional inference that &quot;inferring about reality doesn&#39;t lead to spiritual truth&quot; (but, if superior textual authority is not established, then note that this inference can be used to justify any false belief).&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="105" width="305" as="geometry">
            <mxRectangle height="105" width="305" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="pJg3SHPVufzG-P1PX_YF-332" parent="pJg3SHPVufzG-P1PX_YF-329" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#DFDFDF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;gradientColor=none;align=left;strokeWidth=0;" value="&lt;div&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&amp;nbsp;- Atheism, which requires us to infer (contradictingly) that &quot;speculation is proof/refutation&quot;.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Polytheism, whose narrative of multiple transcendent wills doesn&#39;t align with the ordered and singularly universal nature of reality.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="105" width="265" x="305" as="geometry">
            <mxRectangle height="105" width="265" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="pJg3SHPVufzG-P1PX_YF-333" parent="pJg3SHPVufzG-P1PX_YF-329" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#DFDFDF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;gradientColor=none;align=left;strokeWidth=0;" value="&lt;span style=&quot;font-size: 10px;&quot;&gt;&amp;nbsp;- If choosing between the two depends on historical analysis, then we need to comparatively assess the historicity of both the New Testament and Quran.&lt;/span&gt;" vertex="1">
          <mxGeometry height="105" width="240" x="570" as="geometry">
            <mxRectangle height="105" width="240" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="6SWEsmhpVgZ_iy8dqvlR-5" connectable="0" parent="vXm2kpI-il_o7RX6dSA9-1" style="group" value="" vertex="1">
          <mxGeometry height="100" width="810" x="20" y="10815" as="geometry" />
        </mxCell>
        <mxCell id="pJg3SHPVufzG-P1PX_YF-344" parent="6SWEsmhpVgZ_iy8dqvlR-5" style="shape=table;startSize=0;container=1;collapsible=0;childLayout=tableLayout;fontSize=1;" value="" vertex="1">
          <mxGeometry height="70" width="810" y="30" as="geometry" />
        </mxCell>
        <mxCell id="pJg3SHPVufzG-P1PX_YF-345" parent="pJg3SHPVufzG-P1PX_YF-344" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" vertex="1">
          <mxGeometry height="70" width="810" as="geometry" />
        </mxCell>
        <mxCell id="pJg3SHPVufzG-P1PX_YF-347" parent="pJg3SHPVufzG-P1PX_YF-345" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#DFDFDF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;gradientColor=none;align=left;strokeWidth=0;" value="&lt;div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&amp;nbsp;- The preservation of the New Testament requires speculation to be true (in the reliability of unknown links over other unknown links).&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&amp;nbsp;- The preservation of the Quran requires speculation to be false (in unsupported possibilities over established historical constraints)&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="305" as="geometry">
            <mxRectangle height="70" width="305" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="pJg3SHPVufzG-P1PX_YF-348" parent="pJg3SHPVufzG-P1PX_YF-345" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#DFDFDF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;gradientColor=none;align=left;strokeWidth=0;" value="&lt;span style=&quot;font-size: 10px;&quot;&gt;&amp;nbsp;- Trinitarianism, as it is not historically superior to the Quran&#39;s pure Monotheism.&lt;/span&gt;" vertex="1">
          <mxGeometry height="70" width="265" x="305" as="geometry">
            <mxRectangle height="70" width="265" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="pJg3SHPVufzG-P1PX_YF-349" parent="pJg3SHPVufzG-P1PX_YF-345" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#DFDFDF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;gradientColor=none;align=left;strokeWidth=0;" value="&lt;span style=&quot;font-size: 10px;&quot;&gt;&amp;nbsp;- If Monotheism is the only remaining possible option, then it should also stand out as the most coherent when compared with Trinitarianism.&lt;/span&gt;" vertex="1">
          <mxGeometry height="70" width="240" x="570" as="geometry">
            <mxRectangle height="70" width="240" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
