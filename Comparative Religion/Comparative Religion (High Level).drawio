        <mxCell id="DHazi4g6tnZFVyByypoz-49" parent="DHazi4g6tnZFVyByypoz-48" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=middle;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;swimlaneFillColor=none;gradientColor=none;gradientDirection=east;align=left;" value="&lt;span style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- &lt;b&gt;Catholicism is 14.4%&lt;/b&gt;, all Protestants at 10.6%, and Orthodox at 3.5%&lt;/span&gt;" vertex="1">
          <mxGeometry height="20" width="315" as="geometry">
