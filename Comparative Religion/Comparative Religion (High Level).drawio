        <mxCell id="Aw4qQZnFIbvZ1GE5txsA-0" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" parent="YZqMC-y3LvAAL2BY0nUx-2" vertex="1">
          <mxGeometry y="480" width="810.0000000000001" height="90" as="geometry" />
        </mxCell>
        <mxCell id="Aw4qQZnFIbvZ1GE5txsA-1" value="&lt;div&gt;&lt;font style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;Every thing that has a beginning&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;b style=&quot;font-size: 9px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;has a preceding cause.&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b style=&quot;font-size: 9px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;+&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b style=&quot;font-size: 9px;&quot;&gt;All things are contingent on their causes (that are not the thing).&lt;/b&gt;&lt;b style=&quot;font-size: 9px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;/b&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#D5D5D5;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;gradientColor=none;" parent="Aw4qQZnFIbvZ1GE5txsA-0" vertex="1">
          <mxGeometry width="163" height="90" as="geometry">
            <mxRectangle width="163" height="90" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Aw4qQZnFIbvZ1GE5txsA-2" value="&lt;font style=&quot;color: rgb(153, 153, 153); font-size: 9px;&quot;&gt;&lt;b&gt;Yes&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;Assuming &quot;speculation is refutation&quot;, then the universe could be the one exception that was created by an infinite regress.&lt;/font&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#FFCCCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=top;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=-2;" parent="Aw4qQZnFIbvZ1GE5txsA-0" vertex="1">
          <mxGeometry x="163" width="161" height="90" as="geometry">
            <mxRectangle width="161" height="90" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Aw4qQZnFIbvZ1GE5txsA-3" value="&lt;font style=&quot;color: rgb(153, 153, 153);&quot;&gt;&lt;b style=&quot;font-size: 9px;&quot;&gt;Yes&lt;/b&gt;&lt;br&gt;&lt;/font&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&lt;font style=&quot;color: rgb(153, 153, 153);&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px; color: rgb(153, 153, 153);&quot;&gt;The universe was created by a non-universe, the gods. And they never began, therefore they don&#39;t have a cause.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px; color: rgb(153, 153, 153);&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px; color: rgb(153, 153, 153);&quot;&gt;If some of the gods were created by others, then there is still some uncaused god that was the source of all the others.&lt;/font&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#FFFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=-2;" parent="Aw4qQZnFIbvZ1GE5txsA-0" vertex="1">
          <mxGeometry x="324" width="163" height="90" as="geometry">
            <mxRectangle width="163" height="90" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Aw4qQZnFIbvZ1GE5txsA-4" value="&lt;font style=&quot;color: rgb(153, 153, 153); font-size: 9px;&quot;&gt;&lt;b&gt;Yes&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;The universe was created by a non-universe, God. And because He never began, He doesn&#39;t have a cause.&lt;/font&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=-2;" parent="Aw4qQZnFIbvZ1GE5txsA-0" vertex="1">
          <mxGeometry x="487" width="161" height="90" as="geometry">
            <mxRectangle width="161" height="90" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Aw4qQZnFIbvZ1GE5txsA-5" value="&lt;font style=&quot;color: rgb(153, 153, 153); font-size: 9px;&quot;&gt;&lt;b&gt;Yes&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;The universe was created by a non-universe, God. And because He never began, He doesn&#39;t have a cause.&lt;/font&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CBE2FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=-2;" parent="Aw4qQZnFIbvZ1GE5txsA-0" vertex="1">
          <mxGeometry x="648" width="162" height="90" as="geometry">
            <mxRectangle width="162" height="90" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Aw4qQZnFIbvZ1GE5txsA-12" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" parent="YZqMC-y3LvAAL2BY0nUx-2" vertex="1">
          <mxGeometry y="570" width="810.0000000000001" height="60" as="geometry" />
        </mxCell>
        <mxCell id="Aw4qQZnFIbvZ1GE5txsA-13" value="&lt;font style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;Reality has a universally applicable set of fundamental laws.&lt;/b&gt;&lt;/font&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#D5D5D5;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;gradientColor=none;" parent="Aw4qQZnFIbvZ1GE5txsA-12" vertex="1">
          <mxGeometry width="163" height="60" as="geometry">
            <mxRectangle width="163" height="60" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Aw4qQZnFIbvZ1GE5txsA-14" value="&lt;font style=&quot;color: rgb(153, 153, 153); font-size: 9px;&quot;&gt;&lt;b&gt;Yes&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;Natural laws are very consistent and universally applicable. They don&#39;t need some &quot;god&quot; explanation to make sense.&lt;/font&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#FFCCCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=top;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=-2;" parent="Aw4qQZnFIbvZ1GE5txsA-12" vertex="1">
          <mxGeometry x="163" width="161" height="60" as="geometry">
            <mxRectangle width="161" height="60" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Aw4qQZnFIbvZ1GE5txsA-15" value="&lt;font style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;No&lt;/b&gt;&lt;/font&gt;&lt;div&gt;&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;If multiple gods exist, and reality is &quot;made of&quot; the gods&#39; wills, then reality must fundamentally be reduced to each of their wills - ie. many fundamental laws.&lt;/font&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#FFFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=-2;" parent="Aw4qQZnFIbvZ1GE5txsA-12" vertex="1">
          <mxGeometry x="324" width="163" height="60" as="geometry">
            <mxRectangle width="163" height="60" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Aw4qQZnFIbvZ1GE5txsA-16" value="&lt;font style=&quot;color: rgb(153, 153, 153); font-size: 9px;&quot;&gt;&lt;b&gt;Yes&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;God&#39;s will is what reality is &quot;made of&quot;, so His will is the fundamental and universal law that affects all things.&lt;/font&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=-2;" parent="Aw4qQZnFIbvZ1GE5txsA-12" vertex="1">
          <mxGeometry x="487" width="161" height="60" as="geometry">
            <mxRectangle width="161" height="60" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Aw4qQZnFIbvZ1GE5txsA-17" value="&lt;font style=&quot;color: rgb(153, 153, 153); font-size: 9px;&quot;&gt;&lt;b&gt;Yes&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;God&#39;s will is what reality is &quot;made of&quot;, so His will is the fundamental and universal law that affects all things.&lt;/font&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CBE2FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=-2;" parent="Aw4qQZnFIbvZ1GE5txsA-12" vertex="1">
          <mxGeometry x="648" width="162" height="60" as="geometry">
            <mxRectangle width="162" height="60" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Aw4qQZnFIbvZ1GE5txsA-18" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" parent="YZqMC-y3LvAAL2BY0nUx-2" vertex="1">
          <mxGeometry y="630" width="810.0000000000001" height="110" as="geometry" />
        </mxCell>
        <mxCell id="Aw4qQZnFIbvZ1GE5txsA-19" value="&lt;font style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;Consciousness can&#39;t be reduced to purely physical components.&amp;nbsp;&lt;/b&gt;&lt;/font&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#D5D5D5;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;gradientColor=none;" parent="Aw4qQZnFIbvZ1GE5txsA-18" vertex="1">
          <mxGeometry width="163" height="110" as="geometry">
            <mxRectangle width="163" height="110" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Aw4qQZnFIbvZ1GE5txsA-20" value="&lt;font style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;Maybe&lt;/b&gt;&lt;/font&gt;&lt;div&gt;&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&lt;font style=&quot;color: rgb(102, 102, 102);&quot;&gt;Consciousness is observed to correlate with the brain, therefore it could be an emergent property from how it&#39;s structured.&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&lt;font style=&quot;color: rgb(102, 102, 102);&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&lt;font style=&quot;color: rgb(102, 102, 102);&quot;&gt;However, this still doesn&#39;t explain phenomenal consciousness, and if &quot;speculation is refutation&quot;, then it could be because of some natural process that we simply don&#39;t know yet.&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#FFCCCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=top;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=-2;" parent="Aw4qQZnFIbvZ1GE5txsA-18" vertex="1">
          <mxGeometry x="163" width="161" height="110" as="geometry">
            <mxRectangle width="161" height="110" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Aw4qQZnFIbvZ1GE5txsA-21" value="&lt;font style=&quot;color: rgb(153, 153, 153); font-size: 9px;&quot;&gt;&lt;b&gt;Yes&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;Just as the gods are spiritual in nature, so are we.&lt;/font&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#FFFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=-2;" parent="Aw4qQZnFIbvZ1GE5txsA-18" vertex="1">
          <mxGeometry x="324" width="163" height="110" as="geometry">
            <mxRectangle width="163" height="110" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Aw4qQZnFIbvZ1GE5txsA-22" value="&lt;font style=&quot;color: rgb(153, 153, 153); font-size: 9px;&quot;&gt;&lt;b&gt;Yes&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;God breathed the breath of life in us, such that our spirit is immortal (or, at the very least, connected with eternality in some way).&lt;/font&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=-2;" parent="Aw4qQZnFIbvZ1GE5txsA-18" vertex="1">
          <mxGeometry x="487" width="161" height="110" as="geometry">
            <mxRectangle width="161" height="110" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Aw4qQZnFIbvZ1GE5txsA-23" value="&lt;font style=&quot;color: rgb(153, 153, 153); font-size: 9px;&quot;&gt;&lt;b&gt;Yes&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;God breathed His spirit in us, such that our souls are unseen in the spiritual realm.&lt;/font&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CBE2FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=-2;" parent="Aw4qQZnFIbvZ1GE5txsA-18" vertex="1">
