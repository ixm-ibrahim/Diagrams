        <UserObject label="" link="data:page/id,7nG7OUVYZ8CD-lsfqKBI" id="xpxPvFw1KCywsOg1OESM-0">
          <mxCell style="group;rotation=-180;" vertex="1" connectable="0" parent="0ffwS5z20CiL1abtpJwu-1">
