        <mxCell id="QDhsdInRaVgg9gpE5JQB-59" parent="QDhsdInRaVgg9gpE5JQB-56" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#FFFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=-2;" value="&lt;font style=&quot;color: rgb(153, 153, 153); font-size: 9px;&quot;&gt;&lt;b&gt;Yes&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;The gods will judge us as they please.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="65" width="163" x="324" as="geometry">
            <mxRectangle height="65" width="163" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="QDhsdInRaVgg9gpE5JQB-60" parent="QDhsdInRaVgg9gpE5JQB-56" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=-2;" value="&lt;font style=&quot;color: rgb(153, 153, 153); font-size: 9px;&quot;&gt;&lt;b&gt;Yes&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;Life is our opportunity to decide, without coercion, if we want to believe in and love God or not. Death and the Hereafter is where we will be judged accordingly.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="65" width="161" x="487" as="geometry">
            <mxRectangle height="65" width="161" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="QDhsdInRaVgg9gpE5JQB-61" parent="QDhsdInRaVgg9gpE5JQB-56" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CBE2FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=-2;" value="&lt;font style=&quot;color: rgb(153, 153, 153); font-size: 9px;&quot;&gt;&lt;b&gt;Yes&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;color: rgb(153, 153, 153);&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;Life is our opportunity to decide, without coercion, if we want to believe in and love God or not. Death and the Hereafter is where we will be judged accordingly.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="65" width="162" x="648" as="geometry">
            <mxRectangle height="65" width="162" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="QDhsdInRaVgg9gpE5JQB-62" parent="2zrmlTedtAoeB5MO0e5B-2" style="rounded=0;whiteSpace=wrap;html=1;fontSize=18;fillColor=#f5f5f5;gradientColor=#b3b3b3;strokeColor=#666666;" value="&lt;font style=&quot;&quot;&gt;&lt;b&gt;Alignment with Inferences from Reality&lt;/b&gt; (continued)&lt;/font&gt;" vertex="1">
          <mxGeometry height="44.9999999999999" width="810.0000000000001" as="geometry" />
        </mxCell>
        <mxCell id="2zrmlTedtAoeB5MO0e5B-3" connectable="0" parent="QDhsdInRaVgg9gpE5JQB-1" style="group" value="" vertex="1">
          <mxGeometry height="300" width="810.0000000000001" x="20" y="1890" as="geometry" />
        </mxCell>
        <mxCell id="QDhsdInRaVgg9gpE5JQB-10" parent="2zrmlTedtAoeB5MO0e5B-3" style="shape=table;startSize=0;container=1;collapsible=0;childLayout=tableLayout;fontSize=1;spacingBottom=0;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="" vertex="1">
          <mxGeometry height="254.9999999999999" width="810.0000000000001" y="45" as="geometry" />
        </mxCell>
        <mxCell id="QDhsdInRaVgg9gpE5JQB-11" parent="QDhsdInRaVgg9gpE5JQB-10" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" vertex="1">
          <mxGeometry height="255" width="810.0000000000001" as="geometry" />
        </mxCell>
        <mxCell id="QDhsdInRaVgg9gpE5JQB-12" parent="QDhsdInRaVgg9gpE5JQB-11" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#D5D5D5;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;gradientColor=none;" value="&lt;div&gt;&lt;font size=&quot;1&quot;&gt;&lt;b&gt;Does the belief system align&lt;br&gt;with reality?&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="255" width="163" as="geometry">
            <mxRectangle height="255" width="163" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="QDhsdInRaVgg9gpE5JQB-13" parent="QDhsdInRaVgg9gpE5JQB-11" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#FFCCCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=top;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=0;" value="&lt;font style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;No (internally contradictory)&lt;/b&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;Every argument essentially reduces to &quot;any explanation with a supernatural god can be refuted with the possibility of a natural explanation&quot;. As such, to make Atheism align with reality, we are required to assume that &quot;speculation is proof/refutation&quot; - thus equally weighting knowledge with ignorance.&lt;br&gt;&lt;br&gt;While this does allow us to dismiss arguments for God&#39;s existence in favor of unobserved possibilities that fit the data, it also doesn&#39;t actually refute the opposing claim (that God is real), nor does it prevent the opposition from making the same kind of argument in return (that God&#39;s existence explains those possibilities and could have created those &quot;natural processes&quot; as well).&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;As such, both a claim and its opposite can be valid under this argument, making truth fundamentally indistinguishable from falsehood and invalidating Atheism&#39;s authority to make claims about reality.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="255" width="161" x="163" as="geometry">
            <mxRectangle height="255" width="161" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="QDhsdInRaVgg9gpE5JQB-14" parent="QDhsdInRaVgg9gpE5JQB-11" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#FFFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=0;" value="&lt;font style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;No (not the best fit)&lt;/b&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;Reality doesn&#39;t support inferring a Polytheistic source of reality. Reality can be observed to operate under fundamental, universally applicable behaviors, and we were created with the capacity for logic that seeks and recognizes a single, fundamental cause for all things.&lt;br&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;Furthermore, the possibility for the gods&#39; wills to contradict each other doesn&#39;t align with reality either, as no contradictions in reality have ever been observed.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;As such, while the existence of multiple atemporal gods seems speculatively valid, it can&#39;t be the best explanation for reality&#39;s source.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="255" width="163" x="324" as="geometry">
            <mxRectangle height="255" width="163" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="QDhsdInRaVgg9gpE5JQB-15" parent="QDhsdInRaVgg9gpE5JQB-11" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=1;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=0;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;" value="&lt;font style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;Yes&lt;br&gt;(pending superior textual authority)&lt;/b&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;This methodology revealed that properly inferring about reality necessarily leads to the discovery of a single, transcendent source of the universe (of course, assuming the inferences are true without omitting any that are significant).&lt;br&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;As for the concept of Personhood (which originates from scripture), it requires us to infer that&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;&quot;inferring about reality doesn&#39;t lead to spiritual truth&quot;, as there is no rationally coherent, identifiable distinction between the 3 Persons. This extra inference allows&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 8px;&quot;&gt;&amp;nbsp;the Trinity to become an exception to &quot;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 8px;&quot;&gt;things are identified (or known) by distinguishing their properties from others&quot;.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;As such, because truth still needs to be distinguishable from falsehood,&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;its truth now becomes entirely contingent upon proving that its historical and textual authority is sound and superior to all alternatives.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="255" width="161" x="487" as="geometry">
            <mxRectangle height="255" width="161" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="QDhsdInRaVgg9gpE5JQB-16" parent="QDhsdInRaVgg9gpE5JQB-11" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CBE2FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;spacingRight=1;spacingBottom=0;spacingLeft=1;spacingTop=0;" value="&lt;font style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;Yes&lt;/b&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;This methodology shows that properly inferring about reality necessarily leads to the discovery of a single, transcendent source of the universe.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;It also seems to be initially superior to Trinitarianism, as Monotheism can more clearly assert that truth is fundamentally distinguishable from falsehood. However, this will be verified (or refuted) in the next step, as the properties of the textual evidence will need to be compared. Because God is necessarily consistent, and this is reflected in the coherence and consistency of reality, we can expect that the True religion will reflect the same coherence and consistency.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="255" width="162" x="648" as="geometry">
            <mxRectangle height="255" width="162" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="QDhsdInRaVgg9gpE5JQB-17" parent="2zrmlTedtAoeB5MO0e5B-3" style="rounded=0;whiteSpace=wrap;html=1;fontSize=18;fillColor=#f5f5f5;gradientColor=#b3b3b3;strokeColor=#666666;" value="&lt;b&gt;&lt;font&gt;Conclusions&lt;/font&gt;&lt;/b&gt;" vertex="1">
          <mxGeometry height="44.9999999999999" width="810.0000000000001" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
