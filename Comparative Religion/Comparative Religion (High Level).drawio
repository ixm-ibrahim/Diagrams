        <mxCell id="fJFOEOjyfabwSS2oxoq5-10" edge="1" parent="mIenp-yJnPnNglZ723Zf-1" source="fJFOEOjyfabwSS2oxoq5-1" style="edgeStyle=elbowEdgeStyle;shape=connector;rounded=1;jumpSize=6;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;strokeColor=default;strokeWidth=1.5;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;endSize=3;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="fJFOEOjyfabwSS2oxoq5-5">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="425" y="370" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="H6fex6OkFIkZ9tdlZG7G-5" edge="1" parent="mIenp-yJnPnNglZ723Zf-1" source="fJFOEOjyfabwSS2oxoq5-5" style="edgeStyle=elbowEdgeStyle;shape=connector;rounded=1;jumpSize=6;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=default;strokeWidth=1.5;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;endSize=3;" target="H6fex6OkFIkZ9tdlZG7G-1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="YRzhiTUIqB8d7NvKOcMi-5" edge="1" parent="mIenp-yJnPnNglZ723Zf-1" source="fJFOEOjyfabwSS2oxoq5-5" style="edgeStyle=elbowEdgeStyle;shape=connector;rounded=1;jumpSize=6;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=default;strokeWidth=1.5;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;endSize=3;" target="YRzhiTUIqB8d7NvKOcMi-1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="YRzhiTUIqB8d7NvKOcMi-11" edge="1" parent="mIenp-yJnPnNglZ723Zf-1" source="YRzhiTUIqB8d7NvKOcMi-1" style="edgeStyle=elbowEdgeStyle;shape=connector;rounded=1;jumpSize=6;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=default;strokeWidth=1.5;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;endSize=3;" target="YRzhiTUIqB8d7NvKOcMi-7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="YRzhiTUIqB8d7NvKOcMi-12" edge="1" parent="mIenp-yJnPnNglZ723Zf-1" source="H6fex6OkFIkZ9tdlZG7G-1" style="edgeStyle=elbowEdgeStyle;shape=connector;rounded=1;jumpSize=6;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=default;strokeWidth=1.5;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;endSize=3;" target="YRzhiTUIqB8d7NvKOcMi-7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="YRzhiTUIqB8d7NvKOcMi-6" connectable="0" parent="mIenp-yJnPnNglZ723Zf-1" style="group" value="" vertex="1">
          <mxGeometry height="30" width="210" x="320" y="510" as="geometry" />
        </mxCell>
        <mxCell id="YRzhiTUIqB8d7NvKOcMi-7" collapsed="1" parent="YRzhiTUIqB8d7NvKOcMi-6" style="rounded=1;whiteSpace=wrap;html=1;comic=0;strokeColor=#996185;fontSize=8;fillColor=#E6D0DE;gradientColor=#D5739D;arcSize=50;treeMoving=1;treeFolding=0;strokeWidth=0.5;fontStyle=1" value="&lt;span style=&quot;font-size: 10px;&quot;&gt;The True religion is accessible to everyone&amp;nbsp;(whether they seek it or not).&lt;/span&gt;" vertex="1">
          <mxGeometry height="30" width="210" as="geometry" />
        </mxCell>
        <mxCell id="YRzhiTUIqB8d7NvKOcMi-8" collapsed="1" parent="YRzhiTUIqB8d7NvKOcMi-6" style="swimlane;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;gradientColor=#FFD966;swimlaneFillColor=#E6E6E6;connectable=1;allowArrows=0;treeFolding=0;treeMoving=1;expand=0;" value="" vertex="1">
          <mxGeometry height="5" width="210" y="20" as="geometry">
            <mxRectangle height="3.333333333333333" width="50.00000000000001" y="20" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="YRzhiTUIqB8d7NvKOcMi-9" parent="YRzhiTUIqB8d7NvKOcMi-8" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;" value="&lt;div&gt;Help me finish this:&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp;- We are able to identify God&#39;s properties based on reality&#39;s properties because creations are limited by the capacity of their creators...&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- ... and we are able to use such logic because we&#39;ve already inferred that???&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;I&#39;m not sure how to address this, as I&#39;m wrestling with apparent counterexamples to this. Can&#39;t I create a machine that could kill me, or do stronger feats of strength than me (for example, highlighting the property of strength)? also, what about the idea that everything contingent emerges from something that isn&#39;t the thing? Like if the universe is temporal, then its source must be atemporal. So if the universe is consistent, why can&#39;t I say that its source must be inconsistent?&lt;/div&gt;" vertex="1">
          <mxGeometry height="230" width="310" x="155" y="390" as="geometry" />
        </mxCell>
        <mxCell id="YRzhiTUIqB8d7NvKOcMi-10" parent="YRzhiTUIqB8d7NvKOcMi-8" style="text;html=1;strokeColor=default;fillColor=#E6E6E6;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=1;treeFolding=0;expand=1;" value="&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Observations&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;i&gt;Required Inferences&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- &quot;The True religion corresponds with reality&quot;.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- &quot;The True religion is distinguishable from false religions&quot;.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Things are defined (or known) by their consistent properties.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Things are identified (or known) by distinguishing their properties from others.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- We are capable of intelligence, to form abstractions from observations.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Our perception is susceptible to normalization and adaptation.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Proper reasoning corresponds with reality.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Reality is ordered, operating on consistent and intelligible laws.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Reality has a universally applicable set of fundamental laws.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;i&gt;Specific Observations&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- If God created us for a purpose, then that purpose needs to be discoverable and attainable.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- The alternative would be that God created us for a purpose without making fulfilling that purpose possible, which cannot be inferred if we have the ability to discover God and identify His True religion through reason (which is possible, as the methodology shows).&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- The way reality works can be known by anyone, as they are known by finding pattern in personal observations.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Humans are predisposed for identifying patterns, and if we all experience reality, we are all capable of recognizing this methodology&#39;s inferences (either by identifying them ourselves or discovering them through others&#39; experiences).&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- If the foundation of reality can be understood by anyone, then false religions necessarily rely on exclusivity, esoteric knowledge, or cultural gatekeeping to avoid being detected as false.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Historical and contemporary examples show that profound insights into reality (like basic moral intuitions like &quot;murder is wrong&quot; or existential questions like &quot;why do I exist?&quot;) arise spontaneously in diverse populations, pointing to an underlying, accessible structure.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Normalization and adaptation mean that constant exposure to reality&#39;s order can make it seem &quot;ordinary,&quot; but this does not negate its accessibility - it merely requires a shift in perspective, which is available to all.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Humble, accumulative, iterative reasoning necessarily converges on the Truth while filtering out falsehoods.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&lt;b style=&quot;&quot;&gt;The Deduction (and why)&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;- &lt;i&gt;The True religion is accessible to everyone (whether they seek it or not).&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- Since God&#39;s will is the foundation of reality, and proper reasoning allows us to understand that reality, then reality itself serves as a universal and perpetual revelation from God: it&#39;s the common ground accessible to every person.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- God’s intentional subtlety does not mean He is hidden, but rather that He does not coerce belief - meaning that people can choose not to believe if they don&#39;t want to.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Yet if humble, iterative reasoning necessarily converges on the Truth, then the choice to embark on that journey is still accessible to everyone.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- As such, the universality of inferences and dispositions indicates an open invitation by anyone who wishes to use their reason properly.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- This means that the True religion&#39;s foundation (correspondence with reality) is inherently democratic: it does not depend on privileged access, secret knowledge, or elite interpretation, but on the shared human capacity to observe, abstract, and reason.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Even for those who do not actively seek it, the Truth remains accessible in the sense that reality&#39;s order is constantly present, waiting to be noticed through a humble shift in perspective away from normalized assumptions.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- This also means that the True religion can be interpreted as being embedded in the fabric of existence itself, distinguishable through properties that anyone can identify with proper reasoning.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Addressing Objections and Alternatives&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;b&gt;1. If the True religion is truly accessible to everyone, why do so many people follow false religions or reject religion altogether? Wouldn&#39;t accessibility imply universal agreement?&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- This objection conflates accessibility with acceptance:&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- &quot;Accessibility&quot; means that the opportunity to know is present, not that the conclusion is automatic or coerced.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- &quot;Acceptance&quot; is the internal decision that someone makes to consider a belief to be true.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- As such, if so many people follow false religions (or reject them altogether), it can only be because they do not use their reason properly.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- We&#39;ve already inferred that falsehoods are easier to arrive at than truth, and that perception is susceptible to normalization and adaptation.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- This means that they can become accustomed to false religions through cultural immersion, emotional comfort, lazy reasoning, arrogance, or prioritizing comfort over humble reasoning - all of which cause the wrong inferences to be made, preventing the Truth from being reached.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- Universal agreement would require coercion, which contradicts God&#39;s subtlety - He allows free choice, including the choice to ignore or reject what&#39;s accessible.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Therefore, so many people follow false religions because that is what they chose to do with their wills,&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Note that this statement refers to those who have the freedom to pursue knowledge yet fundamentally choose not to, not those who internally desire to seek proper knowledge and are inherently limited by their circumstances.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;b&gt;2. Religions often require deep study, scriptures, or experts to understand fully - how can that be accessible to illiterate, isolated, oppressed, or uneducated people?&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- This mistakes formal education for the innate capacity for reason.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- One does not need to be a physicist to observe gravity, nor a theologian to feel a sense of justice: the core data for making the foundational inferences is embedded in the act of living.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- Accessibility is about the starting point of the journey, not the immediate mastery of all its complexities.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- There are actually many historical and contemporary examples where people are oppressed, yet still pursue their beliefs despite their oppression.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- If reality truly is created such that someone can truly limit the capacity for another&#39;s knowledge that God will hold them accountable for, then the True religion will need to be able to explain what is truly happening and/or why God allows that.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- If God has a hierarchy of belief, in the sense that He only requires of us of what we&#39;re capable of (ie. the opportunities He allowed for us), then this question is resolved.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;b&gt;3. Cultural, linguistic, or geographical barriers make religions inaccessible to outsiders - for example, a religion tied to a specific language or region can&#39;t be universal.&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- This conflates the universal foundation of the True religion with the secondary details of specific, organized faiths.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- The primary &quot;scripture&quot; of the True religion is reality itself, which is universal: the laws of cause and effect, innate sense of morality, and search for purpose are not confined to any culture or language.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- As such, the True religion must be founded on principles that transcend these barriers.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- If the True religion was revealed in a particular language, time, or region, then it requires perfect preservation and accessibility in order to be considered trustworthy and reliable.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- If a belief system&#39;s fundamental claims are truly inseparable from a specific culture or require knowledge of a particular inaccessible language, then it cannot be the True religion as this methodology contradicts the universal nature of God&#39;s creation and His will.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;b&gt;4. This framework seems to favor intellectuals. Is the True religion then truly accessible even to the uneducated or those with cognitive limitations?&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- The methodology&#39;s foundation is not elite academic theory, but personal observation of reality - a process that is available to anyone who observes their senses while being aware of it.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- These universal human experiences are the primary data: you don&#39;t need to have a degree in ethics to have an innate disposition towards concepts of morality, nor do you need to be a physicist to recognize that reality is ordered.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- As such, this process is scalable to each individual: it starts with simple observations anyone can make, building abstractions at a pace suited to the individual, with continual refinement the more they learn about the world (relative to their humility and desire to pursue Truth).&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- If our purpose is to use our wills, humility, and reason to discover God, and He&#39;s the one that gave us that capacity to begin with (and endowed us with different levels of intelligence as well), then we can only fulfill our purpose in accordance with the capacity that God allowed us.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Therefore, if God is both consistent and subtle, then He will not hold us accountable for a capacity that we can&#39;t achieve.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- This means that an uneducated person who lives honestly and seeks goodness is more aligned with the Truth than a brilliant academic who uses their intellect to justify falsehood.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- This also means that, when we realize that we are weak in a particular area (regardless of innate intellectual talent), we need to supplement it through those who are more knowledgeable than us (at least, until we can replicate their knowledge ourselves).&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;b&gt;5. If most people are raised in a specific religion, aren&#39;t social and psychological barriers so strong that the True religion is effectively inaccessible?&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- This question acknowledges real barriers, but presents them as impossible to overcome - when that capacity is decided for each individual.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- While it&#39;s true that our perception is susceptible to normalization (making it easy to accept an upbringing as the default truth), it is also true that this conditioning is constantly being checked by external and internal forces.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Since truth is defined by reality, a person&#39;s lived experience serves as a constant, external arbiter: a significant contradiction between a conditioned belief and an observable fact can act as a catalyst for questioning.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- If God endowed us with an innate disposition towards justice and morality, then someone raised in a system that is fundamentally unjust will introduce an internal dissonance that prompts re-evaluation.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- If any falsehood eventually reveals a contradiction with reality, then anyone who is persistent in humility (ie. doesn&#39;t remain in their comfortable beliefs out of arrogance) and utilizes the reason they&#39;ve learned will converge on the Truth (with enough time).&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- This means that social barriers are external, not inherent blocks to internal reasoning (unless you allow it to become a barrier).&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- This aligns with God&#39;s subtlety: He allows choice, including the freedom to cling to falsehoods, but provides persistent tools (reason, dispositions, reality itself) for those willing to humbly reflect.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- There are many historical and contemporary examples of people defying norms (religious, political, or cultural), often driven by bravery rather than superior intelligence - showing that the will to question is a universal capacity, independent of intellect.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- Accessibility means the possibility of questioning and breaking from conditioning always exists, even if it is difficult.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- In short: these barriers may indeed be strong, but they are not absolute, as everyone has accessibility to the tools to overcome them.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Reason, dispositions, reality&#39;s persistence are universally available to anyone who is willing to humbly reflect, allowing convergence to the Truth even from entrenched positions.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="855" width="660" y="15" as="geometry" />
        </mxCell>
        <mxCell id="H6fex6OkFIkZ9tdlZG7G-0" connectable="0" parent="mIenp-yJnPnNglZ723Zf-1" style="group" value="" vertex="1">
          <mxGeometry height="30" width="210" x="200" y="440" as="geometry" />
        </mxCell>
        <mxCell id="H6fex6OkFIkZ9tdlZG7G-1" collapsed="1" parent="H6fex6OkFIkZ9tdlZG7G-0" style="rounded=1;whiteSpace=wrap;html=1;comic=0;strokeColor=#8381BF;fontSize=8;fillColor=#DCDBFC;gradientColor=#9393E0;arcSize=50;treeMoving=1;treeFolding=0;strokeWidth=0.5;fontStyle=1" value="&lt;span style=&quot;font-size: 10px;&quot;&gt;The True religion corresponds with reality.&lt;/span&gt;" vertex="1">
          <mxGeometry height="30" width="210" as="geometry" />
        </mxCell>
        <mxCell id="H6fex6OkFIkZ9tdlZG7G-2" collapsed="1" parent="H6fex6OkFIkZ9tdlZG7G-0" style="swimlane;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;gradientColor=#FFD966;swimlaneFillColor=#E6E6E6;connectable=1;allowArrows=0;treeFolding=0;treeMoving=1;expand=0;" value="" vertex="1">
          <mxGeometry height="5" width="210" y="20" as="geometry">
            <mxRectangle height="3.333333333333333" width="50.00000000000001" y="20" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="H6fex6OkFIkZ9tdlZG7G-3" parent="H6fex6OkFIkZ9tdlZG7G-2" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;" value="&lt;div&gt;Help me finish this:&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp;- We are able to identify God&#39;s properties based on reality&#39;s properties because creations are limited by the capacity of their creators...&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- ... and we are able to use such logic because we&#39;ve already inferred that???&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;I&#39;m not sure how to address this, as I&#39;m wrestling with apparent counterexamples to this. Can&#39;t I create a machine that could kill me, or do stronger feats of strength than me (for example, highlighting the property of strength)? also, what about the idea that everything contingent emerges from something that isn&#39;t the thing? Like if the universe is temporal, then its source must be atemporal. So if the universe is consistent, why can&#39;t I say that its source must be inconsistent?&lt;/div&gt;" vertex="1">
          <mxGeometry height="230" width="310" x="155" y="390" as="geometry" />
        </mxCell>
        <mxCell id="H6fex6OkFIkZ9tdlZG7G-4" parent="H6fex6OkFIkZ9tdlZG7G-2" style="text;html=1;strokeColor=default;fillColor=#E6E6E6;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=1;treeFolding=0;expand=1;" value="&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Observations&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;i&gt;Required Inferences&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- &quot;Any True religion corresponds to the purpose that God created us for&quot;.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- All information comes from a source.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Things are defined (or known) by their consistent properties.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Things are identified (or known) by distinguishing their properties from others.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Proper reasoning corresponds with reality.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Truth is associated with good, while falsehood is associated with evil.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;i&gt;Specific Observations&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- A logical chain has been established that links God, reality, and truth with each other:&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- &quot;Truth&quot; is defined by its correspondence with &quot;Reality&quot;.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- &quot;Reality&quot; is a sustained expression of &quot;God&#39;s will&quot;.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- &quot;Truth&quot; corresponds with &quot;God&#39;s will&quot;.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- The &quot;True religion&quot; is the framework that aligns with &quot;God&#39;s Will&quot;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Its core claims about God, purpose, morality, and existence must not contradict the consistent, intelligible order we observe in the universe.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- A claim that contradicts empirical observations or fundamental inferences necessarily false and introduces contradictions.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- The only alternative approach to identifying the true religion would fundamentally reduce to what &quot;feels right&quot;.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- The True religion acts as an accurate interpretive framework for reality: it explains why we experience duality, why we have dispositions toward justice and purpose, and why we fear death despite its inevitability - all while aligning with logical inferences like non-contradiction and causality within their limits.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&lt;b style=&quot;&quot;&gt;The Deduction (and why)&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;- &lt;i&gt;The True religion corresponds with reality.&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- This conclusion is a matter of logical necessity based on the preceding inferences:&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- If a religion is &quot;true,&quot; it must align with the definition of truth, which is correspondence with reality.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- A belief system that is inconsistent with reality is, by definition, false (or, at the very least, indistinguishable from a false religion).&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- This provides the most powerful objective criterion for evaluating religious claims, elevating the process beyond subjective feelings or cultural preferences and grounding it in the external, verifiable arbiter of reality itself.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- As a result, the True religion will not demand that we believe in contradictions: any claims about unseen things must be logically consistent with the principles inferred from observable things.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Addressing Objections and Alternatives&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;b&gt;1. Religion is about faith in the unseen, not empirical facts. You can&#39;t test spiritual truth with physical reality.&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- This objection creates a false dichotomy between faith and reason, assuming they are inherently opposed, but it overlooks how faith can be rational and grounded in reality without requiring empirical coercion.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- If things are identified by distinguishing their properties from others, and proper reasoning corresponds with reality, then spiritual truths (unseen realities) must be distinguishable from falsehoods through their consistency with seen realities.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Otherwise, they become indistinguishable from invented fantasies or emotional preferences - how else would you distinguish between a true metaphysical claim and a false one?&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- If a single, consistent God is the author of both dimensions (seen and unseen), then they cannot be in fundamental contradiction.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- Faith, in the context of the True religion, is not blind (ie. blind to reason) but built on trustworthy sources that align with God&#39;s will.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- If reality is an expression of God&#39;s will, and truth corresponds to it, then genuine faith extends inferences from observable properties to unseen ones without contradiction.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- If spiritual truth couldn&#39;t correspond at all, there would be no epistemological bridge between the reality we experience and the spiritual, contradicting the intentionality of God&#39;s creation, where all information comes from His will - the same source that sustains a unified reality.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;b&gt;2. What if the True religion involves mysteries or aspects that transcend reality, meaning it doesn&#39;t need to fully correspond with what we observe or infer?&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- This confuses a &quot;mystery&quot; with a &quot;contradiction&quot;, misinterpreting &quot;transcendence&quot; as a blanket exemption from utilizing proper reason.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Both mysteries and contradictions appear as profoundly deep concepts, yet they are distinguishable based on their correspondence with reality.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Mysteries have depth because they cause us to reflect on our own limits, relative to God&#39;s ultimate power and transcendence.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Contradictions have depth because justifying them requires an infinite regress of explanations, or fundamentally appealing to emotion rather than correspondence with proper reason.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- A &quot;mystery&quot; is a paradoxical gap in our knowledge that is beyond our limited human comprehension, which is expected to happen (as we&#39;ve inferred that &quot;perception, memory, and reasoning are imperfect and subject to error&quot;).&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- A &quot;contradiction&quot; is where the distinguishable difference between two things is also shared by them (like a square triangle), which cannot happen in the True religion.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- If a religion does not provide a meaningful distinguishing factor between &quot;mysteries&quot; and &quot;contradictions&quot;, then it is fundamentally indistinguishable from a false religion, as any falsehood&#39;s &quot;contradiction&quot; can now be justified as a &quot;mystery&quot; - without detection.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- Ultimately, transcendence enhances correspondence: unseen claims build on seen foundations logically, ensuring the framework interprets reality accurately without demanding belief in impossibilities.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- If no correspondence were needed, the True religion would be unverifiable - making it equivalent to any false one that invokes &quot;mystery&quot; to evade scrutiny - contradicting God&#39;s subtlety (which allows discovery through reason) and our capacity to distinguish good (truth-aligned) from evil (falsehood-aligned).&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;b&gt;3. Reality is subjective or illusory, so the True religion could redefine reality based on enlightenment or detachment.&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- This position is self-defeating, as &quot;reality is an illusion&quot; is itself a truth-claim about reality that one must arrive at through reason and observation.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- It requires trusting one&#39;s own cognitive faculties to conclude that those same faculties cannot be trusted.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- A True religion might re-contextualize reality, but it cannot negate it entirely without making all knowledge (including knowledge of the religion itself) impossible.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- In essence, subjectivity is a product of imperfect perception, not reality itself: proper reasoning filters it out, converging on the True religion as the framework that explains illusions without denying the objective foundation.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;b&gt;4. Miracles, by definition, violate the laws of reality. If a religion includes miracles, doesn&#39;t that prove it fails to correspond with reality?&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- This misinterprets the hierarchy of laws, and the context and limits by which the natural laws we inferred are understood.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- The &quot;laws of nature&quot; are our inferred descriptions of how reality operates under God&#39;s consistent, sustaining will.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- By means of those laws, we discover that the ultimate &quot;law&quot; is God&#39;s will itself - the fundamental &quot;stuff&quot; of reality.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- As such, a True miracle is not a violation of reality but rather a direct, purposeful, and exceptional act of God&#39;s will upon the reality He continuously sustains.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- An exception doesn&#39;t disprove the rule; it highlights the existence of a &quot;higher&quot; law that encompasses both.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Therefore, the possibility of miracles reinforces the deduction that reality is contingent upon a transcendent will, rather than contradicting it.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- However, this doesn&#39;t mean that we should accept all exceptional phenomena as &quot;miracles&quot;:&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- A &quot;miracle&quot; is, fundamentally, a unique phenomenon (usually corresponding to a significant event) that contradicts human capacity to replicate it.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- If truth is distinguishable from falsehood, and the True religion is distinguishable from false religions, then true miracles must also be distinguishable from false miracles.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- If a religion advocates for a &quot;miracle&quot; that a human at the time could replicate to the same degree (or tricking others into thinking they could), then it can&#39;t be classified as a &quot;miracle&quot;.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- A true miracle could be parting the Red Sea, or bringing the dead back to life, or surviving being thrown into a raging fire (ie. producing any phenomenon that a human can&#39;t produce).&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Ultimately, miracles test distinguishability: false religions might fabricate unverifiable ones appealing to feelings, while the True one&#39;s align with reality&#39;s order, associating with good (truth-revealing) rather than evil (deceptive).&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- If no miracles were possible, God&#39;s power would actually be limited by His own laws, contradicting transcendence.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="700" width="595" y="15" as="geometry" />
        </mxCell>
        <mxCell id="YRzhiTUIqB8d7NvKOcMi-0" connectable="0" parent="mIenp-yJnPnNglZ723Zf-1" style="group" value="" vertex="1">
          <mxGeometry height="30" width="210" x="440" y="440" as="geometry" />
        </mxCell>
        <mxCell id="YRzhiTUIqB8d7NvKOcMi-1" collapsed="1" parent="YRzhiTUIqB8d7NvKOcMi-0" style="rounded=1;whiteSpace=wrap;html=1;comic=0;strokeColor=#8381BF;fontSize=8;fillColor=#DCDBFC;gradientColor=#9393E0;arcSize=50;treeMoving=1;treeFolding=0;strokeWidth=0.5;fontStyle=1" value="&lt;span style=&quot;font-size: 10px;&quot;&gt;The True religion is distinguishable from false religions.&lt;/span&gt;" vertex="1">
          <mxGeometry height="30" width="210" as="geometry" />
        </mxCell>
        <mxCell id="YRzhiTUIqB8d7NvKOcMi-2" collapsed="1" parent="YRzhiTUIqB8d7NvKOcMi-0" style="swimlane;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;gradientColor=#FFD966;swimlaneFillColor=#E6E6E6;connectable=1;allowArrows=0;treeFolding=0;treeMoving=1;expand=0;" value="" vertex="1">
          <mxGeometry height="5" width="210" y="20" as="geometry">
            <mxRectangle height="3.333333333333333" width="50.00000000000001" y="20" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="YRzhiTUIqB8d7NvKOcMi-3" parent="YRzhiTUIqB8d7NvKOcMi-2" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;" value="&lt;div&gt;Help me finish this:&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp;- We are able to identify God&#39;s properties based on reality&#39;s properties because creations are limited by the capacity of their creators...&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- ... and we are able to use such logic because we&#39;ve already inferred that???&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;I&#39;m not sure how to address this, as I&#39;m wrestling with apparent counterexamples to this. Can&#39;t I create a machine that could kill me, or do stronger feats of strength than me (for example, highlighting the property of strength)? also, what about the idea that everything contingent emerges from something that isn&#39;t the thing? Like if the universe is temporal, then its source must be atemporal. So if the universe is consistent, why can&#39;t I say that its source must be inconsistent?&lt;/div&gt;" vertex="1">
          <mxGeometry height="230" width="310" x="155" y="390" as="geometry" />
        </mxCell>
        <mxCell id="YRzhiTUIqB8d7NvKOcMi-4" parent="YRzhiTUIqB8d7NvKOcMi-2" style="text;html=1;strokeColor=default;fillColor=#E6E6E6;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=1;treeFolding=0;expand=1;" value="&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Observations&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;i&gt;Required Inferences&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- &quot;Any True religion corresponds to the purpose that God created us for&quot;.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- All information comes from a source.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Things are defined (or known) by their consistent properties.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Things are identified (or known) by distinguishing their properties from others.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Perception, memory, and reasoning are imperfect and subject to error.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Reality is ordered, operating on consistent and intelligible laws.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Reality has a universally applicable set of fundamental laws.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Proper reasoning corresponds with reality.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Falsehood is easier and more common, while good is harder and more valued.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;i&gt;Specific Observations&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- The most fundamental principle of knowledge is that for something to be known, it must possess distinct properties that separate it from what it is not.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- As such, if a &quot;True religion&quot; exists and is knowable, it must therefore have distinguishing characteristics that false religions lack.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- The primary distinguishing characteristic between any truth and falsehood has been identified: correspondence with reality.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- A false religion, by its nature as a falsehood, will inevitably contradict reality at a fundamental level.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- God’s intentional subtlety ensures that false religions will exist as viable and often appealing options, making the act of distinguishing them a meaningful exercise of our reason and will.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- False religions can often be identified by their methodology: they necessarily demand belief through means that bypass or suppress proper reason on a fundamental level, such as appeals to pure emotion, blind authority, or unfalsifiable claims that are immune to rational verification.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Human imperfections in perception and reasoning make us susceptible to falsehood (knowingly or unknowingly), but our capacity for choice and dispositions toward truth, morality, and justice provide tools to differentiate.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Since falsehood is more common and easier (requiring less effort to accept), false religions may be more common than true ones, but their contradictions with reality allow distinction from the True one - allowing converges on the Truth through reason.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- It&#39;s like navigating a maze: if you navigate blindly without reason, maybe you&#39;ll randomly find the way out (if at all), but if you utilize your reason properly - mapping paths, noting dead ends, and refining based on evidence - you will converge on the way out more quickly and reliably.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- If all information comes from a source, then the sources of a religion&#39;s fundamental claims (e.g., scriptures, traditions, or personal revelations), must be verified for reliability and trustworthiness (ie. the basis of faith).&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- A True religion&#39;s source would align with God&#39;s subtlety and intentionality (non-coercive, discoverable via reason), while false ones would need to rely on manipulation or emotional appeals, unverifiable assertions, or contradictions with unseen realities.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&lt;b style=&quot;&quot;&gt;The Deduction (and why)&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;- &lt;i&gt;The True religion is distinguishable from false religions.&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- This follows directly from the nature of truth itself: since the True religion has the essential property of corresponding with reality and internal consistency, and false religions lack this property, a clear distinction must exist.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- This means that the True religion necessarily possesses the same properties as God when it comes to Truth: it will be both internally and externally consistent without any contradictions, reflecting the ordered, intelligible nature of reality.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Meanwhile, false religions will clash with observable facts, inferences, or innate dispositions (e.g., a claim that ignores justice or purpose), making them identifiable as falsehoods defined by their inconsistencies.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- This means we can use tools like source evaluation, logical evaluation, and empirical testing to filter between religions.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- The True religion will remain authoritative without fundamental breaking down, while false ones will reveal flaws under examination.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- As such, even though falsehood may be more prevalent than truth, it shows that humble, iterative reasoning will necessarily converge on the Truth, aligning with God&#39;s subtlety in allowing Himself to be discoverable without coercion.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Addressing Objections and Alternatives&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;b&gt;1. This sounds like a bias. Since all religions claim to be the &quot;true&quot; one, yet they fundamentally rely on faith in something unseen, isn&#39;t this &quot;distinguishing&quot; process just a way to rationalize a pre-selected belief?&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- This objection conflates blind faith with rational faith, forgetting that for faith to be valid, it requires rational assessment of a source&#39;s trustworthiness.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- If truth is defined by reality (not feelings nor intuition), and proper reasoning corresponds with reality, then the distinguishing process is objective: religions can be tested against contradictions with observations and inferences - rather than starting from a pre-selected belief.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- This whole methodology aims to check our own biases: it explicitly forbids starting with a chosen belief, requiring us to start with identifying universal observations of reality before assessing religions that align with those observations.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- This is how blind faith is distinguished from rational faith: the former doesn&#39;t use reason to verify a source&#39;s correspondence with reality, while the latter does.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;b&gt;2. False religions can mimic the True one closely (ex. through sophisticated rationalizations or partial truths), making true distinguishability impractical or impossible for imperfect humans.&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- While mimics can certainly appear genuine on the surface by appealing to certain truths in order to justify well-crafted falsehoods (and human ignorance and imperfection can delay detection), their integration will ultimately and necessarily reveal contradictions under deeper scrutiny (as falsehoods are inherently defined by their contradiction with reality).&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- If God is the author of both reality and the True religion, and all are consistent without contradiction, then any false religion will necessarily possess contradictions.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- Distinguishability is practical through iterative reasoning: the accumulation of new knowledge will seamlessly integrate with the True religion, while mimics will necessarily accumulate flaws.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- The possibility of distinguishing truth from falsehood supports God&#39;s subtlety: because falsehoods are more common than truths while also being identifiable with reason, then consistent, humble, and rational evaluation will necessarily converge on the Truth.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;b&gt;3. Religions are too plentiful and complex for a normal person to evaluate. How can anyone distinguish them without being an expert in theology, history, and science?&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- This assumes that all aspects require specialized expertise, when the fundamentals of any belief are accessible to everyday reason.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- You don&#39;t need to be an expert in philosophy to know that true things are not false things, or that you have a phenomenal experience, or that there&#39;s an underlying order in life.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- If you&#39;ve identified an area that you are weak in, you would need to supplement that weakness with a reliable source - until you&#39;ve learned enough about it to verify the foundational claims.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Prevalent deception may indeed limit personal efforts, but if you have the humility to learn from reliable sources and to refine your beliefs as you discover better methodologies, then with enough time and struggle, the Truth can be converged to.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- It&#39;s like english, math, or any field of study: you don&#39;t have to know calculus to know that 1+1=2, or that 1 != 2 - in fact, it&#39;s the other way around; you need to know the fundamentals of any field of study before you can learn more complex ideas.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- It&#39;s the same with the True religion: according to this methodology, its foundation is truth (ie. correspondence with reality), and we are all experts in our own lives to know something about reality.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Any further knowledge requires education, struggle, and humility - without requiring specialized expertise to pursue.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;b&gt;4. In a world with so many religions, distinguishability leads to dogmatism or conflict - it&#39;s better to assume they&#39;re indistinguishable to promote tolerance.&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- Firstly, true tolerance is respecting the right of people to be wrong - not pretending that contradictions don&#39;t exist.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- If God wants us to pursue Truth, and He created both us and those who we think are wrong, then His will has a more right to be obeyed than those who will be intolerant towards us to pursuing the truth.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- This aligns with God&#39;s subtlety: if God wants us to arrive to the Truth without coercion, then forced conversions are meaningless, as they don&#39;t change what people internally believe.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- As such, the true source of conflict primarily arises when rational differences in beliefs transform into arrogance, not when two different people discuss their differences with humility.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- If God intentionally created reality like this, and He wants us to pursue the Truth despite sensual distractions (ie. pleasure and pain, how others treat us, etc.), then God is essentially testing our commitment to the Truth by means of how others treat us.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="730" width="595" y="15" as="geometry" />
        </mxCell>
        <mxCell id="fJFOEOjyfabwSS2oxoq5-4" connectable="0" parent="mIenp-yJnPnNglZ723Zf-1" style="group" value="" vertex="1">
          <mxGeometry height="30" width="210" x="320" y="370" as="geometry" />
        </mxCell>
        <mxCell id="fJFOEOjyfabwSS2oxoq5-5" collapsed="1" parent="fJFOEOjyfabwSS2oxoq5-4" style="rounded=1;whiteSpace=wrap;html=1;comic=0;strokeColor=#6C8EBF;fontSize=8;fillColor=#DAE8FC;gradientColor=#7EA6E0;arcSize=50;treeMoving=1;treeFolding=0;strokeWidth=0.5;fontStyle=1" value="&lt;span style=&quot;font-size: 10px;&quot;&gt;Any True religion corresponds to the purpose that God created us for.&lt;/span&gt;" vertex="1">
          <mxGeometry height="30" width="210" as="geometry" />
        </mxCell>
        <mxCell id="fJFOEOjyfabwSS2oxoq5-6" collapsed="1" parent="fJFOEOjyfabwSS2oxoq5-4" style="swimlane;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;gradientColor=#FFD966;swimlaneFillColor=#E6E6E6;connectable=1;allowArrows=0;treeFolding=0;treeMoving=1;expand=0;" value="" vertex="1">
          <mxGeometry height="5" width="210" y="20" as="geometry">
            <mxRectangle height="3.333333333333333" width="50.00000000000001" y="20" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="fJFOEOjyfabwSS2oxoq5-7" parent="fJFOEOjyfabwSS2oxoq5-6" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;" value="&lt;div&gt;Help me finish this:&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp;- We are able to identify God&#39;s properties based on reality&#39;s properties because creations are limited by the capacity of their creators...&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- ... and we are able to use such logic because we&#39;ve already inferred that???&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;I&#39;m not sure how to address this, as I&#39;m wrestling with apparent counterexamples to this. Can&#39;t I create a machine that could kill me, or do stronger feats of strength than me (for example, highlighting the property of strength)? also, what about the idea that everything contingent emerges from something that isn&#39;t the thing? Like if the universe is temporal, then its source must be atemporal. So if the universe is consistent, why can&#39;t I say that its source must be inconsistent?&lt;/div&gt;" vertex="1">
          <mxGeometry height="230" width="310" x="155" y="390" as="geometry" />
        </mxCell>
        <mxCell id="fJFOEOjyfabwSS2oxoq5-8" parent="fJFOEOjyfabwSS2oxoq5-6" style="text;html=1;strokeColor=default;fillColor=#E6E6E6;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=1;treeFolding=0;expand=1;" value="&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Observations&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;i&gt;Required Inferences&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- &quot;Truth and proper reason correspond with God&#39;s will&quot;.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- &quot;God gave us a will to choose the values that govern how we live our lives.&quot;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Things are defined (or known) by their consistent properties.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Things are identified (or known) by distinguishing their properties from others.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- We have the capacity to make choices, based on our knowledge and desires.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Reality is a mixture of pleasure &amp;amp; pain, as well as good &amp;amp; evil.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Proper reasoning corresponds with reality.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- We have a disposition towards concepts of morality.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- We have a disposition towards concepts of justice.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- We have a disposition for having a purpose and feeling wanted.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Truth is associated with good, while falsehood is associated with evil.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Our actions are a sign of our moral values.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- We fear death, yet we will all die.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;i&gt;Specific Observations&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- The more we implement proper reason, the more falsehood we filter out and the closer we converge on the True understanding of reality.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- If God intentionally created us with wills, then that capacity to make decisions has some purpose.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- This means that some decisions are objectively better than others, as they either align or misalign with that God-given purpose.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Our inferred association between truth and good reinforces this; the &quot;good&quot; choice is the one that corresponds with the &quot;truth&quot; of our purpose.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- A &quot;religion&quot; is a way of life that is governed by a set of beliefs and values.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- We are created with the capacity to choose between different religions...&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- ... In a world where false religions are real options.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- This choice is not coerced: even if we feel compelled to believe in something externally, we can still choose what to believe internally.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Any True religion will be fundamentally founded on using proper reason to believe in God.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- &quot;Fundamental&quot; here means that the religion&#39;s core appeals and invitations can be reduced to proper reasoning - thus allowing it to be distinguished from falsehood in this subtle reality.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Appeals to emotion or intuition can exist, but they must operate within the framework of proper reasoning, not as a substitute for it.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- An appeal to &quot;comfort,&quot; for example, is only valid if the comfort comes from something that is also true - not that something is true only because it feels comfortable (as we are capable of having false beliefs and misguided desires).&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Any religion that requires alternative approaches that abandon reason in favor of pure feeling, comfort, or blind authority would be indistinguishable from a well-crafted falsehood that appeals towards those same feelings.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- We fear death yet will inevitably die, which intensifies our search for purpose.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&lt;b style=&quot;&quot;&gt;The Deduction (and why)&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;- &lt;i&gt;Any True religion corresponds to the purpose that God created us for.&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- If God intentionally created us with wills to choose between values and ways of life, and these values cover a spectrum between truth and falsehood, then God wants us to freely pursue the Truth.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- This also means that there are two levels to God&#39;s will: one that is the driving force for reality itself (Ontological Will), and one that represents a destination that we are expected to arrive at (Prescriptive Will).&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- In other words: the way we are supposed to live our lives corresponds with our purpose in life (which God defined).&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- The &quot;True religion&quot; is therefore the name we give to the framework that correctly identifies this God-given purpose and prescribes the way of life that achieves it&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- It would be the guide/map that corresponds to the territory of reality and how we should be navigating it.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;- As such, identifying the True religion is synonymous with identifying our ultimate purpose.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- The more we implement proper reason, the more falsehood we filter out and the close we converge on the True religion.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- If such a True religion exists, it will perfectly correspond with reality and what is necessarily true of God.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- This means that we can expect the True religion to transcend comfort and culture, as it guides towards what is right and true.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Addressing Objections and Alternatives&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;b&gt;1. What if there is no &quot;True&quot; religion - what if God doesn&#39;t have a specific purpose for us, or doesn&#39;t care how we live our lives?&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- This objection is inconsistent with the properties of God we have already deduced from reality.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- If we know that God has ultimate knowledge and power and wanted the universe to be created as it is (including us, and our desire for purpose), then that contradicts the claim that God is &quot;indifferent&quot;.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- If God was indifferent to His creation, then to Him, the universe as it is now would be meaningfully equivalent to any other universe (in which we wouldn&#39;t be alive) that He could have created.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- If reality is sustained fundamentally on God&#39;s will - in a reality that requires active maintenance to fight against its tendency towards disorder - then He is intentionally maintaining reality, which contradicts what we would expect from a fundamentally indifferent God.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Without a prescriptive purpose, our dispositions toward morality, justice, and meaning would be unexplained anomalies: why would God create beings who yearn for a purpose that doesn&#39;t exist, or who can distinguish good from evil without an objective standard to align with?&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- This fundamentally reduces reality to a contingent accident rather than an intentional creation - which has been addressed in previous nodes.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- In short, if there is no True religion (as a way of life aligned with God&#39;s prescriptive will), then God would be indifferent to falsehood and evil, which contradicts the inference that truth is good and corresponds with His will.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Such indifference would make God&#39;s subtlety pointless, as there would be no &quot;right&quot; path to discover through reason - contradicting the link between &quot;will&quot; and &quot;purpose&quot;.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;b&gt;2. Why assume there is only one True religion - couldn&#39;t multiple religions correspond to God&#39;s purpose, or be culturally relative paths to the same truth?&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- This position, while appealing (in terms of comfort), is logically untenable when confronted with the fundamental nature of truth.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- We inferred that &quot;things are identified (or known) by distinguishing their properties from others&quot;, which is the basis for the Principle of Non-Contradiction: a thing cannot be both &#39;A&#39; and &#39;not-A&#39; at the same time and in the same respect.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- When observing the claims of world religions, they support contradictory properties about the ultimate nature of God, the nature of humanity, and the path to truth, salvation, or enlightenment.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- If truth is defined by reality, and reality is observed to be consistent, then the fundamental differences in competing religions cannot all be true.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- For example, if one religion claims God is personal and another impersonal, or if one prescribes certain moral actions as good while another deems them evil, these cannot both align with God&#39;s consistent will, as reality (ie. God&#39;s ontological will) cannot contain contradictions.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- As such, in line with the fact that reality operates on universal principles, only one set of fundamental claims can correspond to a singular, consistent reality of God&#39;s will.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- If multiple religions were valid, they would need to converge on the same fundamental properties of God and purpose when reduced through reason.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- But, in practice, their distinctions would make them indistinguishable from partial falsehoods, preventing convergence on an ultimate truth.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- If there are differences between religions that all share the same fundamental truths, it would be more accurate to classify those differences as different sects of the same religion, in line with the principle that non-fundamental details need to be interpreted through the context of the fundamental beliefs.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;b&gt;3. This deduction seems to favor rationalist religions over mystical or faith-based ones - what if the True religion requires a leap of faith beyond reason?&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- This objection mischaracterizes the relationship between reason and faith as established within this framework. It assumes they are opposites, when in fact they are sequential.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- &quot;Faith&quot; is simply a belief in which the foundational premise relies on the trustworthiness or knowledge rather than empirical observations.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- For example, theists have faith in God -&amp;nbsp; not because they empirically see Him, but because they believe their scriptures are trustworthy with divine authority.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Another example would be the scientific principles this very process requires: we have faith that the laws we observe are universally applicable, even though we haven&#39;t actually observed every moment in reality to verify it ourselves.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- As such, faith is actually a fundamental requirement in the pursuit of truth, where we put our faith into what we learn is consistent and trustworthy - which requires reason to identify.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- If a religion demands faith by utilizing reason properly, then it corresponds with reality.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- This exposes two different kinds of faith, blind faith, and rational faith - the fundamental difference being whether or not you&#39;ve used reason to establish trustworthiness.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Therefore, a religion that demands a leap of faith against or without reason has no mechanism to distinguish itself from a well-crafted falsehood that appeals to the same emotions or desires.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- This violates the principle that God&#39;s will corresponds with proper reason and truth, which violates the more fundamental inference that truth is distinguishable from falsehood.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Anything that is otherwise irrational could then be interpreted as a metaphysical mystery or limits of our reason, preventing you from a means of knowing if your beliefs are wrong.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;b&gt;4. I don&#39;t need an organized religion. My purpose and my relationship with God are personal and subjective.&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- This view confuses personal application with objective truth, conflicting with the inferences that truth is defined by reality (not feelings) and that our purpose is God-given, not self-defined.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- If the True religion corresponds to God&#39;s prescriptive will for how we live, it must be grounded in objective properties of God and reality, accessible through reason: a purely subjective &quot;religion&quot; would be limited by personal ignorance or biases (personal or cultural), preventing alignment with the ultimate purpose.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; - Our dispositions toward morality and justice imply a shared, universal standard: a personal approach risks rationalizing falsehood, as it lacks the humility to learn from more knowledgeable sources (especially, if there exists some source that is authorized by God Himself).&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- In short, a personal religion might feel more intimately personal and fulfilling, but without corresponding to God&#39;s objective purpose, it becomes indistinguishable from wishful thinking or self-deception.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;b&gt;5. If the True religion corresponds to our purpose, why does reality include so much suffering and evil - wouldn&#39;t a purposeful God create a world where the True path is obvious and free of pain?&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- This question (like the previous nodes before this one that have an iteration of this question) conflates our desires with God&#39;s will: if pain exists, and God created everything intentionally, then it exists for a purpose.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- To claim that the existence of pain implies a purposeless God requires us to correspond our desire for pleasure and comfort with God&#39;s will - as if, because we desire pleasure, God must necessarily satisfy that desire.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- However, this claim contradicts the observation that our desires do not necessarily correlate with morality: if reality is independent of our desires, then we may desire something that is objectively bad or false, or hate something that is objectively good or true.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- As such, if God intentionally allows us to feel pain, yet also wants us to pursue truth, then perhaps He wants us to not let the pain we feel compel us from not pursuing the Truth.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- This would make the purpose of our lives akin to a test - to see if we will stay steadfast on the pursuit of truth despite any feeling we experience, whether pain or pleasure.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- This seems aligned with reality, as innocent people exist (ie. people who appear not to have the capacity to choose right from wrong) yet they still experience pain - which poses no conflict between our predisposed sense of justice and reality.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Another alternative could be that God&#39;s purpose for pain is to be a punishment for us - which requires defining what actions deserve which punishments.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- This seems misaligned with reality, as innocent people exist (ie. people who appear not to have the capacity to choose right from wrong) - meaning that if this pain is fundamentally a punishment, it would be for an action that we didn&#39;t commit (ie. something we didn&#39;t consciously choose to make) - which appears to contradict our predisposed sense of justice.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; - Regardless of what possibilities there are, it would need to be defined by the True religion.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- In short: whatever the answer truly is, it would be defined by the True religion, not by our desires.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; - As such, we can&#39;t conclude that God us fundamentally purposeless from an argument that simply reduces to &quot;we don&#39;t like pain&quot;.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; - Considering that world religions often claim that God is good, loving or merciful (which can seem antithetical to a God that would allow innocent people to feel pain), they would need to be assessed by the consistency of their narratives and whether their poses result in fundamental contradictions or not.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="925" width="750" y="15" as="geometry" />
        </mxCell>
        <mxCell id="ubzgAVXnB17UkmDap0Xm-1" connectable="0" parent="mIenp-yJnPnNglZ723Zf-1" style="group" value="" vertex="1">
          <mxGeometry height="30" width="210" x="200" y="300" as="geometry" />
        </mxCell>
        <mxCell id="ubzgAVXnB17UkmDap0Xm-2" collapsed="1" parent="ubzgAVXnB17UkmDap0Xm-1" style="rounded=1;whiteSpace=wrap;html=1;comic=0;strokeColor=#82B366;fontSize=8;fillColor=#D5E8D4;gradientColor=#97D077;arcSize=50;treeMoving=1;treeFolding=0;strokeWidth=0.5;fontStyle=1" value="&lt;span style=&quot;font-size: 10px;&quot;&gt;Truth and proper reason correspond with God&#39;s will.&lt;/span&gt;" vertex="1">
          <mxGeometry height="30" width="210" as="geometry" />
        </mxCell>
        <mxCell id="ubzgAVXnB17UkmDap0Xm-3" collapsed="1" parent="ubzgAVXnB17UkmDap0Xm-1" style="swimlane;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;gradientColor=#FFD966;swimlaneFillColor=#E6E6E6;connectable=1;allowArrows=0;treeFolding=0;treeMoving=1;expand=0;" value="" vertex="1">
          <mxGeometry height="5" width="210" y="20" as="geometry">
            <mxRectangle height="3.333333333333333" width="50.00000000000001" y="20" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ubzgAVXnB17UkmDap0Xm-4" parent="ubzgAVXnB17UkmDap0Xm-3" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;" value="&lt;div&gt;Help me finish this:&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp;- We are able to identify God&#39;s properties based on reality&#39;s properties because creations are limited by the capacity of their creators...&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- ... and we are able to use such logic because we&#39;ve already inferred that???&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;I&#39;m not sure how to address this, as I&#39;m wrestling with apparent counterexamples to this. Can&#39;t I create a machine that could kill me, or do stronger feats of strength than me (for example, highlighting the property of strength)? also, what about the idea that everything contingent emerges from something that isn&#39;t the thing? Like if the universe is temporal, then its source must be atemporal. So if the universe is consistent, why can&#39;t I say that its source must be inconsistent?&lt;/div&gt;" vertex="1">
          <mxGeometry height="230" width="310" x="155" y="390" as="geometry" />
        </mxCell>
        <mxCell id="ubzgAVXnB17UkmDap0Xm-5" parent="ubzgAVXnB17UkmDap0Xm-3" style="text;html=1;strokeColor=default;fillColor=#E6E6E6;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=1;treeFolding=0;expand=1;" value="&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Observations&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;i&gt;Required Inferences&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- &quot;God is consistent.&quot;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- &quot;God&#39;s will is the fundamental material of reality&quot;.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- &quot;God is intentionally subtle&quot;.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Phenomenal/conscious experience corresponds with reality.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Truth is defined by reality, not by feelings or intuition.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Falsehood is defined by its contradiction, not by feelings or intuition.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Proper reasoning corresponds with reality.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Reality is ordered, operating on consistent and intelligible laws.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Truth is associated with good, while falsehood is associated with evil.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;i&gt;Specific Observations&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Proper reasoning leads to the truth.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- What is true = what is real.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- What is real = God&#39;s will.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Proper reasoning corresponds with reality.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&lt;b style=&quot;&quot;&gt;The Deduction (and why)&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;- &lt;i&gt;Truth and proper reason correspond with God&#39;s will.&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- If &quot;truth&quot; is defined by &quot;what is real&quot;, and &quot;God&#39;s will&quot; defines &quot;what is real&quot;, then &quot;God&#39;s will&quot; defines the &quot;truth&quot;.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- To understand a truth about reality, is to understand an aspect of God&#39;s sustained, willed expression.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- If proper reason corresponds with reality, and God&#39;s will defines reality, then proper reasoning corresponds with God&#39;s will.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- To implement proper reasoning is to align our minds with His will.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- This also means that rationalizing falsehood is an act that does not correspond with God&#39;s will...&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- ... Which allows to discover that God is not the author of confusion.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Addressing Objections and Alternatives&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;b&gt;1. Truth and reason are human constructs: different cultures and individuals have different &quot;truths&quot;, so they can&#39;t correspond to a universal God&#39;s will.&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- This claim contradicts with our inferences - especially &quot;what is real = what is true&quot; - as there are no observed contradictions in reality (but we do observe contradictions in human thought).&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- If a &quot;truth&quot; differs between different cultures, yet both occur, then there is some &quot;unifying truth&quot; or linguistic variation that explains both of them.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- If a &quot;truth&quot; differs between different cultures, yet one or neither actually occur, then it can&#39;t be considered &quot;truth&quot; just because a large group of people do.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- If a &quot;truth&quot; differs between different cultures, and it refers to a metaphysical claim, then this whole process will need to be applied to both of them to see which is more valid.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;b&gt;2.1. Is something true because God wills it, or does God will it because it is true? (The Euthyphro Dilemma for truth)&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- Something is true because God wills it.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- &quot;God wills it because it is true&quot; would either be circular reasoning or tautological (depending on how you look at it), as God defines what is true.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- This is really saying &quot;God wills it because it is true, and it is true because God wills it&quot; - or, more fundamentally, &quot;God wills it because He wills it&quot;.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;b&gt;2.2. So then, isn&#39;t God&#39;s will arbitrary (meaningless and subjective, as it follows no objective standard)?&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- This is a false dilemma, as it is a category error to apply the standards of God&#39;s creations onto Himself.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- If God is the one who defines what is true, then it is both objectively and subjectively true: objective in that it is real and true, and subjective in that this truth is relative to God.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- As such, none of this implies that God&#39;s will is meaningless or without purpose - quite the opposite, actually.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- A will, by definition, is what defines purpose in something: for example, if I bake a cake for others to eat it, then its purpose is to be eaten.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- If reality is a manifestation of God&#39;s will, then reality itself must be purposeful by definition.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;b&gt;3. If truth and reason correspond with God&#39;s will, why do they sometimes lead to conclusions that seem to contradict religious claims?&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- This will be addressed more thoroughly in future nodes, but to summarize:&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- If there is a True religion, then there cannot be any contradictions between it and reality, as both are authored by God and He is necessarily consistent.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- As such, if there are any apparent contradictions, it can only be for one of three reasons: because you lack the humility to change your mind/heart towards the truth, or because you don&#39;t have all the information required to realize that there&#39;s no contradiction, or because the religion you&#39;re following is actually false.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Therefore, in order to know the answer to this question, you need to be equipped with a methodology that is grounded in reality that allows you to distinguish between the 3 options (which this whole process aims to do).&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;b&gt;4. If truth corresponds to God&#39;s will, and people do evil things, does this mean God wills evil things to be true?&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- This will be addressed more thoroughly in future nodes, but to summarize:&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Reality can only occur as God intends - so, if evil occurs, then God must have allowed its existence.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- The underlying question to this is, &quot;if God allows evil things to exist, then does He want us to suffer, or does He want us to do evil things?&quot;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- To answer to this question, we need to first define &quot;evil&quot;, and identify what its purpose is.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- &quot;Evil = what doesn&#39;t correspond with God&#39;s will&quot;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- If God&#39;s will is the underlying fabric of reality, it means that He does allow people to do actions that go against His will.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- The next question here would be, &quot;why? And how can He allow us to go against His will if His will decides all things?&quot;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- The second question goes back to, &quot;how can God give us free will if He wills all things?&quot;, which fundamentally requires us to experience atemporality - this is addressed in the parallel node.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- As for why, it requires us to know our purpose in life - which aligns with the True religion (discussed in future nodes).&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="620" width="475" y="15" as="geometry" />
        </mxCell>
        <mxCell id="fJFOEOjyfabwSS2oxoq5-0" connectable="0" parent="mIenp-yJnPnNglZ723Zf-1" style="group" value="" vertex="1">
          <mxGeometry height="30" width="210" x="440" y="300" as="geometry" />
        </mxCell>
        <mxCell id="fJFOEOjyfabwSS2oxoq5-1" collapsed="1" parent="fJFOEOjyfabwSS2oxoq5-0" style="rounded=1;whiteSpace=wrap;html=1;comic=0;strokeColor=#82B366;fontSize=8;fillColor=#D5E8D4;gradientColor=#97D077;arcSize=50;treeMoving=1;treeFolding=0;strokeWidth=0.5;fontStyle=1" value="&lt;span style=&quot;font-size: 10px;&quot;&gt;God gave us a will to choose the values that govern how we live our lives.&lt;/span&gt;" vertex="1">
          <mxGeometry height="30" width="210" as="geometry" />
        </mxCell>
        <mxCell id="fJFOEOjyfabwSS2oxoq5-2" collapsed="1" parent="fJFOEOjyfabwSS2oxoq5-0" style="swimlane;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;gradientColor=#FFD966;swimlaneFillColor=#E6E6E6;connectable=1;allowArrows=0;treeFolding=0;treeMoving=1;expand=0;" value="" vertex="1">
          <mxGeometry height="5" width="210" y="20" as="geometry">
            <mxRectangle height="3.333333333333333" width="50.00000000000001" y="20" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="fJFOEOjyfabwSS2oxoq5-3" parent="fJFOEOjyfabwSS2oxoq5-2" style="text;html=1;strokeColor=default;fillColor=#E6E6E6;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=1;treeFolding=0;expand=1;" value="&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Observations&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;i&gt;Required Inferences&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- &quot;God is consistent.&quot;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- &quot;God&#39;s will is the fundamental material of reality&quot;.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- &quot;God is intentionally subtle&quot;.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- &quot;Truth and proper reason correspond with God&#39;s will&quot;.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Things are defined (or known) by their consistent properties.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Things are identified (or known) by distinguishing their properties from others.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Consciousness can&#39;t be reduced to purely physical components.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- We have the capacity to make choices, based on our knowledge and desires.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Reality is a mixture of pleasure &amp;amp; pain, as well as good &amp;amp; evil.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- We have a disposition towards concepts of morality.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- We have a disposition towards concepts of justice.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Morality does not necessarily correlate with our intentions and behavior.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Truth is associated with good, while falsehood is associated with evil.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- We have a disposition for having a purpose and feeling wanted.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;i&gt;Specific Observations&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- God is subtle: He created a reality where His existence is not empirically forced upon us, yet He is still discoverable through proper reason and humility...&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- ... In a reality (that He created) where there are alternative approaches with false beliefs.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- God created us with the capacity to make choices, based on our knowledge and desires...&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- ... While also creating us with a disposition towards morality and justice - meaning that we understand that some choices are better than others.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Regardless of which objective moral system we use, there is always the possibility of a struggle between what we desire and what we think is &quot;right&quot;.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Note the use of &quot;objective&quot;: in subjective systems, &quot;what we feel = what is right&quot; - which leads to future contradictions, as future nodes address.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&lt;b style=&quot;&quot;&gt;The Deduction (and why)&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;- &lt;i&gt;God gave us a will to choose the values that govern how we live our lives.&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- If we can choose between believing in God and not believing in God, and He intentionally created us that way (such that our belief is not coerced), then He allows us the capacity to pursue falsehood if we choose to use our reason improperly.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- And, if reality is a mixture of good and evil, and we can choose which moral systems to accept, then God also allows us to pursue good or evil as we wish.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Addressing Objections and Alternatives&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;b&gt;1. If God&#39;s will is the fundamental material of reality, and everything is contingent on it, then how can we have a genuine will to choose - wouldn&#39;t all choices be predetermined by God&#39;s will?&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- Firstly, let&#39;s ground ourselves in God&#39;s necessary properties - specifically, His transcendence (atemporality and spatiality).&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Our perception of causality is grounded within time (since effects comes &lt;b&gt;after&lt;/b&gt; their causes) - meaning that this understanding doesn&#39;t apply to God, who is outside of time.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- This also means that we can&#39;t comprehend what&#39;s possible or not in an atemporal context, outside of recognizing its existence based on what we phenomenally experience and infer.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- Secondly: if our wills are fundamentally determined by physical processes that we don&#39;t otherwise control, then that contradicts our disposition for justice and morality or even having a &quot;choice&quot;.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- To &quot;choose&quot;, fundamentally, is to want something without coercion.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- As such, we can&#39;t classify actions that are &quot;coerced&quot; by external processes to be a &quot;choice&quot;.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- This shows that the apparent conflict only exists if we assume our will is a temporal, physical process (which &lt;b&gt;would&lt;/b&gt; be determined by prior causes).&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Considering that &quot;atemporality&quot; is the only option we currently have that transcends physical processes (and thus our perception of causality), this conflict would be resolved if our wills possessed an atemporal component to them.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- As a result, our wills must be &quot;between&quot; God and the observable/temporal universe: distinct from God (ie. is contingent on Him), and distinct from our perception of time and causality (ie. is fundamentally atemporal).&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- This means that our wills fall under God&#39;s will in an atemporal context - which is beyond our comprehension of causality...&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- ... Which means that our wills are directly linked to God&#39;s will, such that our wills can be interpreted as &quot;seeking permission&quot; from Him to manifest in reality.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- This also aligns with our inference that &quot;consciousness can&#39;t be reduced to purely physical components&quot;...&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- ... Which also suggests that the source of our phenomenal awareness is the same source as that of our wills.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- So: we witness our own capacity for choices, the knowledge that reality that is temporal and atemporal (and seen and unseen), and the knowledge that God&#39;s will encompasses all of that reality...&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- ... While simultaneously being unable to comprehend atemporality, hierarchies within atemporality, or their integration with our wills in an atemporal context.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- Therefore, this is a paradox, not a contradiction - its source being our inability to comprehend atemporality.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- This understanding actually resolves common misunderstandings with predestination and destiny:&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; - Destiny is how one is currently oriented - a temporal perspective.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; - Predestiny is how one is ultimately oriented - an atemporal perspective.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; - Both exist and refer to the same phenomenon, only differing on the temporal/atemporal perspective by which you view it.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;b&gt;2. This sounds like assuming free will exists just because we feel it does - what if it&#39;s an illusion, and all is determined by emergent physical causes?&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- This question conflates what&#39;s real with what you feel: even if you were only a brain in a jar right now (such that all stimuli are artificially produced - or, in other words, an emergent illusion), you can still distinguish multiple levels to your will that appear to transcend what is physical.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- If you can distinguish between volition and compulsion, then you have identified that there is some component of your will that is internal, not external.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- If you can choose not to satisfy or pursue some internal desire, then you have identified that there is some component of your will that is more fundamental than that of your internal, physical desires.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- If you can distinguish between your capacity to choose when in a dream, hallucinating, or drunk in some way, versus when you&#39;re not, then you have identified that there is some component of your will that appears relative to your level of consciousness.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- As a result, the relationship between phenomenal awareness and our wills seem to have a really convenient harmony - which leads to an understanding that can provide a naturally-driven explanation that an illusionary claim does not have.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;b&gt;3. Why would God give us this will if it allows for evil and suffering - couldn&#39;t He have made us automatically choose good?&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- If God intentionally created everything, including our wills to choose between good and evil, then there is some purpose to our ability to choose (as defined in previous nodes: &quot;will = purpose&quot;).&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- This seems to be tied to God&#39;s subtlety, as if God was empirically apparent to us at all times, we would be less compelled to make a wrong choice when the right choice is so sensually obvious.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- This also seems to be tied to our own purpose in life, as we tend to identify ourselves based on our strongest values.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- This requires us to ask, &quot;what does God want us to do with our lives? What is our purpose?&quot;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Considering that religions (a way of life according to a moral system) tend to address this question, the following node will identify the properties of the True religion: the way of life that corresponds with God&#39;s will.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="695" width="555" y="15" as="geometry" />
        </mxCell>
        <mxCell id="ZOOYuR8evA332wrBml-1-0" connectable="0" parent="mIenp-yJnPnNglZ723Zf-1" style="group" value="" vertex="1">
          <mxGeometry height="30" width="210" x="560" y="230" as="geometry" />
        </mxCell>
        <mxCell id="ZOOYuR8evA332wrBml-1-1" collapsed="1" parent="ZOOYuR8evA332wrBml-1-0" style="rounded=1;whiteSpace=wrap;html=1;comic=0;strokeColor=#D6B656;fontSize=8;fillColor=#FFF2CC;gradientColor=#FFD966;arcSize=50;treeMoving=1;treeFolding=0;strokeWidth=0.5;fontStyle=1" value="&lt;span style=&quot;font-size: 10px;&quot;&gt;God is intentionally subtle.&lt;/span&gt;" vertex="1">
          <mxGeometry height="30" width="210" as="geometry" />
        </mxCell>
        <mxCell id="ZOOYuR8evA332wrBml-1-2" collapsed="1" parent="ZOOYuR8evA332wrBml-1-0" style="swimlane;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;gradientColor=#FFD966;swimlaneFillColor=#E6E6E6;connectable=1;allowArrows=0;treeFolding=0;treeMoving=1;expand=0;" value="" vertex="1">
          <mxGeometry height="5" width="210" y="20" as="geometry">
            <mxRectangle height="3.333333333333333" width="50.00000000000001" y="20" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ZOOYuR8evA332wrBml-1-3" parent="ZOOYuR8evA332wrBml-1-2" style="text;html=1;strokeColor=default;fillColor=#E6E6E6;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=1;treeFolding=0;expand=1;" value="&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Observations&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;i&gt;Required Inferences&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- &quot;God wanted the universe to be created exactly as it is&quot;.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- There is a seen reality, and an unseen reality.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- &quot;We have a disposition for having a purpose and feeling wanted&quot;.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Reality could have been different.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;i&gt;Specific Observations&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- We can&#39;t empirically observe God...&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- ... Yet we can still use reason to define Him, and seem predisposed to do so.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- ... Yet we have in us a disposition to want to know our purpose in life, feeling an existential loneliness otherwise.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- ... And He wanted reality to be that way.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&lt;b style=&quot;&quot;&gt;The Deduction (and why)&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;- &lt;i&gt;God is intentionally subtle.&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- If God transcends time and space with encompassing power and intelligence over all reality, and wanted the universe exactly as it is, then His presence must be deliberately veiled.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- Otherwise, if He wanted Himself to be known in the same way as we know rocks and apples exist, then that is how reality would be.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Addressing Objections and Alternatives&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;b&gt;1. Isn&#39;t this claim unfalsifiable? Any amount of evidence for God can be cited, while any lack of evidence is just re-interpreted as &quot;subtlety.&quot;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- No, as all these claims depend on the premises we&#39;ve observed: if God wanted the universe to be as it is, and His will is the fundamental &quot;stuff&quot; of reality (see parallel nodes), then any emergent property of that universe must be intended as well.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- This argument (as well as all other deductive arguments) doesn&#39;t stand on its own: if these premises are wrong, or if the whole logical structure is not correct (in which case, you&#39;ll have a problem with all these nodes, not just this one), only then could this claim be challenged.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;b&gt;2. If God gave us the disposition to seek Him, why not just reveal Himself more plainly, instead of us having to rely on reason?&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- This question can be reduced to, &quot;why did God make reality like this?&quot;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- As such, it will be addressed more thoroughly in the following node.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- To summarize: if God endowed us with both reason and will, and put us in a world where we can choose not to believe in Him, then this world must be a test for us to see what we&#39;ll choose to do and if we&#39;ll use our reason properly.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;b&gt;3. What if God is just hiding, and none of this matters?&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- The fact that we experience a universe where God is not empirically obvious, yet we are still driven to seek Him by use of reason, contradicts the idea of a completely hidden creator.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- If God has ultimate power, and He wants this world to be the way it is, then if He wanted to be completely hidden, no one would believe in Him or even know about Him.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- If God has ultimate power over reality, and we exist within reality, then He has complete power over us: if He wanted to, he wouldn&#39;t have given us that drive to seek Him.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="390" width="380" y="15" as="geometry" />
        </mxCell>
        <mxCell id="ZOOYuR8evA332wrBml-1-5" connectable="0" parent="mIenp-yJnPnNglZ723Zf-1" style="group" value="" vertex="1">
          <mxGeometry height="30" width="210" x="320" y="230" as="geometry" />
        </mxCell>
        <mxCell id="ZOOYuR8evA332wrBml-1-6" collapsed="1" parent="ZOOYuR8evA332wrBml-1-5" style="rounded=1;whiteSpace=wrap;html=1;comic=0;strokeColor=#D6B656;fontSize=8;fillColor=#FFF2CC;gradientColor=#FFD966;arcSize=50;treeMoving=1;treeFolding=0;strokeWidth=0.5;fontStyle=1" value="&lt;span style=&quot;font-size: 10px;&quot;&gt;God&#39;s will is the fundamental material of reality.&lt;/span&gt;" vertex="1">
          <mxGeometry height="30" width="210" as="geometry" />
        </mxCell>
        <mxCell id="ZOOYuR8evA332wrBml-1-7" collapsed="1" parent="ZOOYuR8evA332wrBml-1-5" style="swimlane;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;gradientColor=#FFD966;swimlaneFillColor=#E6E6E6;connectable=1;allowArrows=0;treeFolding=0;treeMoving=1;expand=0;" value="" vertex="1">
          <mxGeometry height="5" width="210" y="20" as="geometry">
            <mxRectangle height="3.333333333333333" width="50.00000000000001" y="20" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ZOOYuR8evA332wrBml-1-8" parent="ZOOYuR8evA332wrBml-1-7" style="text;html=1;strokeColor=default;fillColor=#E6E6E6;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=1;treeFolding=0;expand=1;" value="&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Observations&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;i&gt;Required Inferences&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- &quot;God transcends time and space&quot;.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- &quot;God wanted the universe to be created exactly as it is&quot;.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Proper reasoning corresponds with reality.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- There is a seen reality, and an unseen reality.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- All things are contingent on their causes.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Everything that has a beginning has a preceding cause.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Reality has a universally applicable set of fundamental laws.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Reality tends to progress from order to disorder.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;i&gt;Specific Observations&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- If the universe had a beginning and came from a transcendent source, then it must have been created without pre-existing materials by some transcendent means.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Reality is comprised of more than just physical objects, as it also includes:&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Unseen forces&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Natural and inferred laws, both local and fundamental&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Phenomenal experience&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- The universe&#39;s existence is not a one-time event but a continuous process.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- This continuous process depends on precise, unchanging laws that could have been otherwise - yet persist without fail.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- These laws govern everything from the subatomic to the cosmic scale, requiring constant &quot;upkeep&quot; against the natural tendency toward disorder.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- The fact that reality persists moment to moment, despite the natural tendency toward disorder, suggests an active, ongoing &quot;force&quot; is required to sustain its existence and order.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Without this sustained order, reality would collapse into chaos, as even minor deviations in fundamental constants would prevent the formation of matter, stars, or life.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- This &quot;force&quot; would be unseen and manifest at the smallest/deepest level of reality, comprising all things and the unseen structure between them.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&lt;b style=&quot;&quot;&gt;The Deduction (and why)&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;- &lt;i&gt;God&#39;s will is the fundamental material of reality.&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- If the universe was created from a state of non-existence with no pre-existing matter, and God is the transcendent source, then the &quot;substance&quot; of creation cannot be purely temporal or physical: it must derive from something atemporal and non-material.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- And, as there is nothing fundamentally else except Him, this &quot;substance&quot; can only be God&#39;s will.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- Therefore, we can interpret &quot;reality = God&#39;s will&quot; at a fundamental level.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- This will is not a physical material like atoms or energy but the foundational &quot;stuff&quot; from which reality emerges: an atemporal force that imposes order, laws, and purpose onto what would otherwise be chaos or non-existence.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- This also means that the purpose of our phenomenal senses is to translate God&#39;s will into our awareness.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- Consequently, the consistent laws of nature we observe are a direct reflection of God&#39;s unchanging will, while the ongoing persistence of reality against disorder demonstrates His sustained intentionality.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- This means that reality is not self-sustaining or accidental, but rather a direct expression of God&#39;s consistent will and completely dependent on it.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- This is also the reason that allows us to infer God&#39;s necessary properties from the structure of reality.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Addressing Objections and Alternatives&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;b&gt;1. Science explains reality through fundamental laws and matter, without needing a &quot;will&quot; as material: this is just a God-of-the-gaps argument.&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- Firstly, science reduces to making inferences (using math, logic, etc.) that are useful enough that allow us to make predictions that come true, and you don&#39;t need to know everything in order for a science to be useful.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Quantum mechanics is a perfect example of this, as we don&#39;t know why the quantum wave function fundamentally collapses, yet we can still observe statistical/probabilistic trends that allow us to create cutting-edge technology.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- This is universally applicable, as you don&#39;t need to be an expert in how something fundamentally works: you don&#39;t need to have a PHD in math in order to make a circle or a wheel, nor do you need to have a PHD in logic to know that &quot;apples are not rocks&quot;, etc.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- As such, to make this statement more accurate: &quot;science is useful in our lives even without knowing how reality fundamentally operates&quot;.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- Secondly, a quick aside into the God-of-the-gaps argument (that unexplained phenomena are due to divine intervention, rather than scientific understanding):&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- This argument presupposes its premise (that reality is explained by science without needing God), as it challenges the claim that whatever we know occurs because of science, while whatever we don&#39;t know must occur because of God (ie. the more we know about reality, the less God is necessary to explain it).&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- The popular example of this is when Isaac Newton was discovering his laws of gravity, he would notice minor variations that his math could not explain, so he attributed those variations to God Himself - yet we can now explain those variations with Einstein&#39;s theories of relativity.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- However, this claim has no basis: if reality truly is shaped by God, then both what we know and what we don&#39;t know are governed by His will.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- As such, it would be wrong to assume that unexplained phenomena are due to divine intervention rather than scientific understanding, but not because all things can be explained without God, but rather because all phenomena can be explained with divine intervention, including what is known.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- To conclude: just because we can benefit from science without knowing the full picture doesn&#39;t mean the full picture doesn&#39;t exist.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Science is the study of reality, while God&#39;s will is the explanation for why science functions the way it does: there is no contradiction between the two.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;b&gt;2. This sounds like pantheism or panentheism, where God is identical to or infused in the universe in some way.&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- Not necessarily, as God is still transcendent: if the universe didn&#39;t exist, that doesn&#39;t necessitate that God doesn&#39;t exist - only that we won&#39;t exist to discover Him.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- There is no basis for this inference, as we don&#39;t observe creators fundamentally becoming what they create.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- This would be like saying an author is the book itself because the story is entirely composed of his creativity, or that he needs to physically become the ink and paper in order to compose a story.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;b&gt;3. If God&#39;s will is the fundamental material of reality, does this mean our wills are fully determined by God - undermining our inferred capacity for free choice?&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- So far, this node focuses on the relationship between reality and God&#39;s will as a whole, without addressing the specifics of our wills yet or what free agency means - this is discussed further in a future node.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- For now, this raises an open question that must be carefully framed to avoid premature conclusions. The dilemma reduces to:&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- If God&#39;s will determines everything, then our wills are actually determined by God - meaning that our wills aren&#39;t actually &quot;free&quot; (from determinism).&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- But if we have &quot;free&quot; will, then it would need to be &quot;free&quot; from being determined by a prior cause - seemingly conflicting with God being the cause of all things.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; -&amp;nbsp; This becomes significant because, if we don&#39;t have &quot;free&quot; will, then that appears to&amp;nbsp;&lt;/font&gt;&lt;span style=&quot;font-size: 7px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;conflict with our prior inferences about morality, justice, and responsibility - how can our choices be considered &quot;good&quot; or &quot;bad&quot; if we don&#39;t have a choice in our actions? How can we be held accountable to them if none of us can choose otherwise?&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- As such, the question fundamentally reduces to: can God determine/cause/create something that is indeterministic or atemporal?&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- In other words, can our wills be dependent on God while &lt;b&gt;also&lt;/b&gt;&amp;nbsp;being &quot;free&quot; from reality&#39;s cause-and-effect?&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;nbsp;If this is possible, then it would require that our wills must exist in a unique &quot;layer&quot; of reality - one that is still created by God (and thus distinct from Him), but not part of the physical, deterministic universe (and thus distinct from it).&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- If God is transcendent - capable of operating beyond the temporal rules He created - then we can&#39;t limit Him by those rules.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Furthermore, our prior inference that identifies an &quot;unseen&quot; reality already establishes that our direct experience is limited and doesn&#39;t capture all of existence - thus allowing such a &quot;layer&quot; of reality to be possible.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- As such, to truly resolve this question, we would need to directly experience atemporality to observe if there is an hierarchy of atemporal things or not.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- However, because we are limited in experiencing time linearly without being able to &quot;see&quot; the source of our phenomenal experience, we aren&#39;t equipped to properly answer that question - one way or another.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- As such, this question can be interpreted as a paradox - the source of its resolution being direct experience with atemporality.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="715" width="560" y="15" as="geometry" />
        </mxCell>
        <mxCell id="YdMphQ4ud1DiJM4NY9TI-3" connectable="0" parent="mIenp-yJnPnNglZ723Zf-1" style="group" value="" vertex="1">
          <mxGeometry height="30" width="210" x="80" y="230" as="geometry" />
        </mxCell>
        <mxCell id="YdMphQ4ud1DiJM4NY9TI-4" collapsed="1" parent="YdMphQ4ud1DiJM4NY9TI-3" style="rounded=1;whiteSpace=wrap;html=1;comic=0;strokeColor=#D6B656;fontSize=8;fillColor=#FFF2CC;gradientColor=#FFD966;arcSize=50;treeMoving=1;treeFolding=0;strokeWidth=0.5;fontStyle=1" value="&lt;span style=&quot;font-size: 10px;&quot;&gt;God is consistent.&lt;/span&gt;" vertex="1">
          <mxGeometry height="30" width="210" as="geometry" />
        </mxCell>
        <mxCell id="YdMphQ4ud1DiJM4NY9TI-5" collapsed="1" parent="YdMphQ4ud1DiJM4NY9TI-3" style="swimlane;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;gradientColor=#FFD966;swimlaneFillColor=#E6E6E6;connectable=1;allowArrows=0;treeFolding=0;treeMoving=1;expand=0;startSize=23;" value="" vertex="1">
          <mxGeometry height="5" width="210" y="20" as="geometry">
            <mxRectangle height="3.333333333333333" width="50.00000000000001" y="20" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="9kDELX67St6hsKLf1r5v-1" parent="YdMphQ4ud1DiJM4NY9TI-5" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;" value="&lt;div&gt;Help me finish this:&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp;- We are able to identify God&#39;s properties based on reality&#39;s properties because creations are limited by the capacity of their creators...&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- ... and we are able to use such logic because we&#39;ve already inferred that???&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;I&#39;m not sure how to address this, as I&#39;m wrestling with apparent counterexamples to this. Can&#39;t I create a machine that could kill me, or do stronger feats of strength than me (for example, highlighting the property of strength)? also, what about the idea that everything contingent emerges from something that isn&#39;t the thing? Like if the universe is temporal, then its source must be atemporal. So if the universe is consistent, why can&#39;t I say that its source must be inconsistent?&lt;/div&gt;" vertex="1">
          <mxGeometry height="230" width="310" x="155" y="390" as="geometry" />
        </mxCell>
        <mxCell id="YdMphQ4ud1DiJM4NY9TI-6" parent="YdMphQ4ud1DiJM4NY9TI-5" style="text;html=1;strokeColor=default;fillColor=#E6E6E6;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=1;treeFolding=0;expand=1;" value="&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Observations&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;i&gt;Required Inferences&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- &quot;God transcends time and space&quot;.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- All information comes from a source.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Things are defined (or known) by their consistent properties.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Things are identified (or known) by distinguishing their properties from others.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Reality is ordered, operating on consistent and intelligible laws.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Reality has a universally applicable set of fundamental laws.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Proper reasoning corresponds with reality.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Time, as we experience it, is linear and progresses asymmetrically.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;i&gt;Specific Observations&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- The universe operates under unchanging, discoverable laws that apply universally without exception or contradiction.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- These laws remain consistent over time, allowing predictions and scientific progress.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- The concept of &quot;change&quot; is a temporal concept, as it requires a difference between &quot;before&quot; and &quot;after&quot;.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- &quot;Consistency&quot; is the opposite of &quot;change&quot;, as something without a difference between &quot;before&quot; and &quot;after&quot; remains unchanging.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&lt;b style=&quot;&quot;&gt;The Deduction (and why)&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;- &lt;i&gt;God is consistent.&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- If &quot;change&quot; requires time to occur, and God is beyond time, then God is beyond change.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- This also means that God doesn&#39;t &quot;change His mind&quot;, as we do - when we are surprised or learn about a better approach to something.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- Reality&#39;s laws are observed to be consistent, which can only reflect the consistency of their creator (as a fundamentally changing/chaotic agent would not be capable of creating long-term consistency).&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Addressing Objections and Alternatives&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;b&gt;1. Consistency is just a human projection onto reality: we can&#39;t identify God&#39;s properties by it.&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- If consistency was limited to perception, everyone would perceive different things.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Observations from independent observers serve to challenge biases in perception: if everyone observes the same thing, then a bias in perception can&#39;t be concluded.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Note that this is not claiming that &quot;mass perception = 100% understanding&quot;, as it is possible for us to possess limits in our perception that limit our understanding.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Rather, this is claiming that, because the inferences you&#39;ve made, biases in perception can be resolved with further study and observation until consistency is observed.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- For us to be able to infer God&#39;s properties from reality, we need to ask, &quot;what properties would a universe-creator need to create our universe?&quot;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- This question comes with the observation that a creation&#39;s properties reflects the knowledge and abilities of its creator, as we&#39;ve already inferred that &quot;intelligence correlates with success and purposeful/conscious complexity&quot;.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- The strength of a house reflects the architectural knowledge of its creator; the realism of a painting reflects the creator&#39;s eye for detail, etc.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- As such, if the universe is fundamentally consistent, then its creator must have the capacity to create consistency - otherwise, if its creator was fundamentally inconsistent, then he wouldn&#39;t have the focus necessary to produce consistent creations.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;b&gt;2. If God is consistent, why does reality include apparent paradoxes, like quantum randomness?&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- Firstly, paradoxes occur at the limits of our knowledge because we observe behaviors that our inferred laws don&#39;t fully explain.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- This requires further study and guided observation to resolve - as opposed to a &quot;contradiction&quot;, in which it can never be resolved.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- As such, paradoxes should be interpreted as a sign of our own ignorance, not as a sign of a fundamental contradiction in reality.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- This is supported by almost every inference we&#39;ve made so far - the most fundamental of them being &quot;truth is defined by reality&quot;.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- According to this inference, it is inconceivable - a category error - for reality to possess a contradiction.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- Secondly, to address quantum behavior: even though we can&#39;t predict the outcome of a single quantum event, the statistical probabilities that model quantum systems are themselves consistent (ie. the rules of randomness are not random themselves).&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- This objection conflates unpredictability with inconsistency: while a single quantum event may be unpredictable to us, the statistical laws that govern quantum mechanics are incredibly stable and consistent.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Furthermore, this inability to predict quantum behavior fundamentally stems from ignorance on why the quantum wave function collapses - which means that, as of now, quantum randomness is a paradox, not a contradiction.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;b&gt;3. God&#39;s consistency implies predictability, limiting omnipotence.&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- This is misapplying what we mean by &quot;consistent&quot;:&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- If God is atemporal, then He is beyond time - not that He is completely frozen within time, such that He never changes.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Rather, properties that are fundamental to Him are consistent - like His power is consistent, His presence is consistent, etc.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- As such, &quot;consistency&quot; here means that God cannot be self-contradictory, not that it means God&#39;s actions are monotonously predictable.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- &quot;Consistency&quot; here doesn&#39;t mean that there can be no diversity in how His properties manifest - actually, this is very much not true.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- We initially started by making observations of reality, and reducing the complexities to consistent rules that we noticed.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- This consistency that we noticed is observed to be fundamental/structural - some abstract law that independent systems seem to follow, even though those systems are incredibly complex and diverse.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; - As such, God&#39;s consistency doesn&#39;t contradict His power - especially since we&#39;re observing His consistency by means of how He chooses to use His power!&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- A good analogy is the game of chess: its rules are perfectly consistent and never change, but these unchanging rules allow for a near-infinite number of unique and creative games.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Similarly, God&#39;s consistent nature is the foundation from which a vast diversity of actions and creations can originate - meaning His consistency is the source of His reliable power, not a limit upon it.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;b&gt;4. Wouldn&#39;t a miracle be an act of inconsistency?&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- Assuming &quot;miracle&quot; here is in the context of religion, then it depends: is there an underlying, fundamental rule that encompass both &quot;miracles&quot; and &quot;non-miracles&quot;?&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- If not, then yes. But if so, then both of these types of phenomena would fall under that inference - avoiding the challenge of inconsistency.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- The &quot;God&#39;s will is the fundamental material of reality&quot; node would be that inference - however, since this question is most likely referring to miracles in the context of religion, future nodes down the line will address that element.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="645" width="505" y="15" as="geometry" />
        </mxCell>
        <mxCell id="kXGbjwJ6K_rhmKNq67j1-0" connectable="0" parent="mIenp-yJnPnNglZ723Zf-1" style="group" value="" vertex="1">
          <mxGeometry height="30" width="210" x="200" y="160" as="geometry" />
        </mxCell>
        <mxCell id="kXGbjwJ6K_rhmKNq67j1-1" collapsed="1" parent="kXGbjwJ6K_rhmKNq67j1-0" style="rounded=1;whiteSpace=wrap;html=1;comic=0;strokeColor=#D69555;fontSize=8;fillColor=#FFDEC9;gradientColor=#FFB663;arcSize=50;treeMoving=1;treeFolding=0;strokeWidth=0.5;fontStyle=1" value="&lt;span style=&quot;font-size: 10px;&quot;&gt;&lt;span&gt;God transcends time and space.&lt;/span&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="30" width="210" as="geometry" />
        </mxCell>
        <mxCell id="kXGbjwJ6K_rhmKNq67j1-2" collapsed="1" parent="kXGbjwJ6K_rhmKNq67j1-0" style="swimlane;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;gradientColor=#FFD966;swimlaneFillColor=#E6E6E6;connectable=1;allowArrows=0;treeFolding=0;treeMoving=1;expand=0;" value="" vertex="1">
          <mxGeometry height="5" width="210" y="20" as="geometry">
            <mxRectangle height="3.333333333333333" width="50.00000000000001" y="20" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="kXGbjwJ6K_rhmKNq67j1-3" parent="kXGbjwJ6K_rhmKNq67j1-2" style="text;html=1;strokeColor=default;fillColor=#E6E6E6;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=1;treeFolding=0;expand=1;" value="&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Observations&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;i&gt;Required Inferences&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- &quot;God possesses power and intelligence that encompasses all of reality&quot;.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Speculation isn&#39;t refutation.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Every inference has a limit.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- All information comes from a source.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- All things are contingent on their causes (that are not the thing).&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Time, as we experience it, is linear and progresses asymmetrically.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- There is a seen reality, and an unseen reality.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Time, as we experience it, is linear and progresses asymmetrically.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Every thing that has a beginning has a preceding cause.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Consciousness can&#39;t be reduced to purely physical components.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;i&gt;Specific Observations&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- The universe is observed to have a fundamental beginning, which requires a trigger to cause its existence (as something can&#39;t come from nothing).&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- It would also require the trigger to be something that is fundamentally not the universe.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- All things are contingent, originating from something else that is not the thing:&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Chickens and eggs come from each other - except for the first egg, which came from a non-chicken.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Animals come from other animals - except for the first animal, which came from a non-animal.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Life comes from other life - except for the first living thing, which came from a non-living thing.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Temporal things are made from other temporal things - except for the first temporal thing, which came from a non-temporal thing.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Our laws of causality are inferred from events within time, so they can&#39;t be applied to a reality that may exist outside of time.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- In other words, all things are contingent on something else that is also contingent, except for the universe itself, which is contingent on something that isn&#39;t contingent itself.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Unseen &quot;things&quot; like laws of physics, mathematics, and consciousness operate independently of physical constraints yet govern or emerge within them.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- The universe&#39;s order and laws apply universally, suggesting a source not limited by the spatial or temporal boundaries it creates.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&lt;b style=&quot;&quot;&gt;The Deduction (and why)&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;- &lt;i&gt;God transcends time and space.&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- If the universe is temporal and spatial, and the source of the universe must fundamentally be a non-universe, then the source of the universe must be atemporal and aspatial.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- If we define &quot;God&quot; as the source of the universe, and the source of the universe is atemporal and aspatial, then God must be atemporal and aspatial.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- This has a number of implications:&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- God is eternal, experiencing no past, present, or future: He simply is (but not like how we imagine someone frozen in time, where they can&#39;t do anything).&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- God is immaterial, as he is not composed, caused, or governed by physical processes.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- God must be uncaused, as causation does not apply to atemporal beings.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Not to mention that God would be the one to invent the reality of causation to begin with.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- God is limitless/infinite, as any limit we can conceive of is structured within time and space - which He inherently transcends.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- As such, no temporal terms/concepts/language can be applied to God without introducing inconsistencies.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Addressing Objections and Alternatives&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;b&gt;1. There is no such thing as &quot;atemporality&quot; and &quot;aspatiality&quot;.&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- If you&#39;ve inferred that all created things fundamentally come from something different (taken from &quot;all inferences have limits&quot;), as well as the fact that reality only operates under a specific set of finely-tuned parameters, then the deduction that the universe must be caused by something that isn&#39;t the universe necessarily follows.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; - The universe is fundamentally composed of a spatial dimension and a temporal dimension - all space for all time.&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; - Therefore, it must have originated from an atemporal and aspatial source, to be consistent with your inferences.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; - To claim something like &quot;atemporality doesn&#39;t really exist because we can&#39;t experience it&quot; is like saying &quot;gravity doesn&#39;t really exist because we can&#39;t experience it&quot;: in both cases, we infer that the effects must have come from some unseen fundamental cause, to which we&#39;re simply identifying/putting a name to it.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;b&gt;2. God could be part of time and space, perhaps as an advanced being within a larger cosmos.&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- This claim makes God akin to an advanced alien, who could potentially have the technological power to simulate a reality that we all experience.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- As such, this would make God contingent on prior causes.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- This being would not then be identified as God to begin with, as this alternative explanation doesn&#39;t resolve the fundamental question of the universe&#39;s fundamental cause.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;b&gt;3. The concept of existing &quot;outside time and space&quot; is meaningless, as we can&#39;t comprehend what that means.&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- Firstly, it is a false equivalence to equate the limits of our understanding to the limits of reality - if you&#39;ve previously inferred that &quot;perception, memory, and reasoning are imperfect and subject to error&quot;.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- Secondly, transcendence is not meaningless because we can still define it by what it&#39;s not - if you&#39;ve previously inferred that &quot;things are identified (or known) by distinguishing their properties from others&quot;.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- If you&#39;re inferred that &quot;all things are contingent on their causes (that are not the thing)&quot;, then you must infer that the origin of anything you observe must have an origin that is fundamentally not the thing.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- If the universe is fundamental temporal and spatial, then its source must be atemporal and aspatial.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Note that this understanding doesn&#39;t require complete knowledge of how transcendence works in totality - it merely identifies fundamental properties that are useful for us to understand.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- This is like our current understanding of quantum mechanics: we don&#39;t currently know what causes the collapse of the wave function, nor do we have a means to know if it&#39;s deterministic or indeterministic - yet we can still develop cutting-edge technology based on the little that we do know.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;b&gt;4. If God is outside of time, how can He cause an event in time, like the universe&#39;s beginning?&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- A more encompassing and useful question would be: how could God create the universe without prior &quot;materials&quot;?&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- God is transcendent, so we can&#39;t project our notions of causality onto Him.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- As such, the &quot;how&quot; is incomprehensible to us - we would first need the capacity to explore atemporality in the same way an atemporal being could.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- This is akin to knowing about &quot;infinity&quot;: we may be able to rationalize and define &quot;infinity&quot;, but we can never truly wrap our minds around comprehending it to its full extent.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- We can only visualize infinity by its relationship to the numbers we can conceive of (ie. numbers can be increased without end, so &quot;infinity&quot; is that limit - if we could do so).&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- As a result, this is a paradox: we are incapable of answering this question given our incapacity to test atemporal phenomena, yet we know it must have occurred given that the universe must have had a beginning (that isn&#39;t the universe).&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="680" width="515" y="15" as="geometry" />
        </mxCell>
        <mxCell id="EHY3XnCysVSyneqZfFhU-1" connectable="0" parent="mIenp-yJnPnNglZ723Zf-1" style="group" value="" vertex="1">
          <mxGeometry height="30" width="210" x="440" y="160" as="geometry" />
        </mxCell>
        <mxCell id="EHY3XnCysVSyneqZfFhU-2" collapsed="1" parent="EHY3XnCysVSyneqZfFhU-1" style="rounded=1;whiteSpace=wrap;html=1;comic=0;strokeColor=#D69555;fontSize=8;fillColor=#FFDEC9;gradientColor=#FFB663;arcSize=50;treeMoving=1;treeFolding=0;strokeWidth=0.5;fontStyle=1" value="&lt;span style=&quot;font-size: 10px;&quot;&gt;God wanted the universe to be created exactly as it is.&lt;/span&gt;" vertex="1">
          <mxGeometry height="30" width="210" as="geometry" />
        </mxCell>
        <mxCell id="EHY3XnCysVSyneqZfFhU-3" collapsed="1" parent="EHY3XnCysVSyneqZfFhU-1" style="swimlane;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;gradientColor=#FFD966;swimlaneFillColor=#E6E6E6;connectable=1;allowArrows=0;treeFolding=0;treeMoving=1;expand=0;" value="" vertex="1">
          <mxGeometry height="5" width="210" y="20" as="geometry">
            <mxRectangle height="3.333333333333333" width="50.00000000000001" y="20" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="EHY3XnCysVSyneqZfFhU-4" parent="EHY3XnCysVSyneqZfFhU-3" style="text;html=1;strokeColor=default;fillColor=#E6E6E6;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=1;treeFolding=0;expand=1;" value="&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Observations&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;i&gt;Required Inferences&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- &quot;God possesses power and intelligence that encompasses all of reality&quot;.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Speculation isn&#39;t refutation.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- All things are contingent on their causes (that are not the thing).&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Reality tends to progress from order to disorder.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Biological structures are goal-oriented.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Intelligence correlates with success and purposeful/conscious complexity.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- There is a seen reality, and an unseen reality.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- We fear death, yet we will all die.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Reality could have been different.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;i&gt;Specific Observations&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- If the universe depends on precise tuning to exist, and the tuned values could have been different, then the universe could have been different.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Destruction is an easier task than creation and maintaining order, so these tunings exist despite that pattern.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- All things are contingent, originating from something else that is not the thing.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- The universe is unique in that, while everything else must be contingent on another contingent thing, the universe itself must be contingent on something that is non-contingent itself.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- All things are intelligible under a teleogical (goal-oriented) framework, including biological structures (like our eyes and organs), physical structures (like the Earth and stars), and logical structures (like epistemology and fallacies).&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Even metaphysical concepts can be seen teleologically, such as our own consciousness and our innate drive to search for our purpose.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&lt;b style=&quot;&quot;&gt;The Deduction (and why)&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;- &lt;i&gt;God wanted the universe to be created exactly as it is.&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- If the universe could have been different, and God consciously created the universe, then God could have wanted the universe to be different.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- In other words, the universe is a product/result of God&#39;s will: He must have willfully/intentionally chosen this universe to exist as it does.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Additionally, if reality tends towards disorder and requires intelligent care to maintain its order, then the universe&#39;s maintenance must also be reduced to God&#39;s will.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- This means that God intentionally created us, and with the desire to know our purpose (ie. to know what is wanted of us).&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Addressing Objections and Alternatives&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;b&gt;1. There is no governing will: it&#39;s all just random development.&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- To use the concept of &quot;randomness&quot; is to proactively remove &quot;purpose&quot;, &quot;will&quot;, and &quot;determinism&quot; from the system - regardless if they are there or not.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- For example, when we say that a coin toss is &quot;random&quot;, we&#39;re saying that &quot;we are ignoring the determining factors and looking at trends&quot; of the coin toss.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- As such, the universe could be both random development &lt;b&gt;and&lt;/b&gt; guided by a governing will, without contradiction, as the governing will could be choosing to create phenomena that we would classify as &quot;random&quot; (from our own limits).&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Even if we assume that there is a contradiction, then this claim is less supported by our inferences than the claim that there is a will, especially &quot;intelligence correlates with success and purposeful/conscious complexity&quot; in light of &quot;reality tends to progress from order to disorder&quot; and &quot;all things are contingent on their causes (that are not the thing)&quot;.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;b&gt;2. God could have wanted a different universe, with this one being an accident/error or some subconscious action - or, He only created the initial conditions without knowing how they evolve over time.&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- If God has such transcendent power to create the vast universe without prior &quot;materials&quot;, and that destruction is an easier task than creation, then if God had so willed, He could have more easily destroyed this universe than to have created it.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- If God is beyond time (ie. He sees the entirety of the universe&#39;s timeline all at once), then we can&#39;t conclude that God can somehow be surprised by what He creates (ie. He creates something He didn&#39;t know would happen in the future) - which this claim requires in order to be true.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Furthermore, if the universe was created subconsciously, not only would this mean that God is somehow unaware that the universe exists, but it would also require some &quot;higher&quot; or &quot;parallel&quot; force that God is not aware of (akin to how we are consciously unaware of what our brains actually do).&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- This means that this &quot;God&quot; we were defining was actually this &quot;passsive atemporal brain&quot; all along - which reduces this claim to &quot;the universe was created by some unconscious process, not a conscious creator&quot;.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- As such, there is no basis for this claim - see &quot;God possesses power and intelligence that encompasses all of reality&quot; for the more complete explanation.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- If God has the knowledge and intelligence to know how His creations function, while also having the power to make it function any way He wants, then there is no basis to conclude that God can be surprised by anything He creates.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;b&gt;3. This is just the Anthropic Principle: we only observe a fine-tuned universe because we wouldn&#39;t exist to observe it otherwise.&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- While this theory certainly addresses an observational bias in why we observe our specific conditions, it&#39;s still limited by being unable to explain the fundamental question of causality.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- It&#39;s like saying we won some cosmic lottery: just because we&#39;re here to see it doesn&#39;t explain how or why the lottery was set up at all.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- As such, the Anthropic principle is true within a temporal context, but does not address the source of that temporal context.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- This means that God&#39;s will is a more encompassing explanation (as God would have authored the Anthropic Principle to begin with) - addressing both the source of our phenomenal consciousness and why the universe exists as it does to begin with.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;b&gt;4. If reality is contingent, then it must operate according to its cause - meaning it couldn&#39;t have been different.&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- Our &quot;could be different&quot; observation comes from two sources:&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Applying hypothesis and reasoning with the fine-tuning of the universe, allowing us to visualize what could occur according to the inferences and laws we know, if they were different.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Recognizing that what the universe is contingent on is fundamentally atemporal, meaning we can&#39;t project our understanding of cause and effect into that transcendent scope.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- As such, this statement is misunderstanding where the &quot;possible difference&quot; is actually located, since the source of the difference must be transcendent (ie. what caused the universe to occur) rather than within the universe.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- A more precise statement would be, &quot;if reality is contingent on a transcendent cause, then it can&#39;t operate any differently than what that transcendent cause requires&quot;.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;b&gt;5. If God wanted the universe &quot;exactly as it is&quot;, why did He choose to do it?&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- This requires a different approach - a different source of information to answer - which is addressed in future nodes.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- When we ask &quot;why&quot; of anything, we&#39;re really asking , &quot;what is its purpose?&quot;, or, &quot;for what reason is it wanted?&quot;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- This is different than asking &quot;how&quot; of something, as we&#39;re really asking, &quot;what caused its existence?&quot;, or, &quot;what are the laws or physical processes that explain how it came into existence?&quot;, or, &quot;what causal sequence of &#39;why&#39;s lead to its occurrence?&quot;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- As such, if we want to know the universe&#39;s purpose, we would need to identify what God wants with it.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- This question seems directly linked to our drive to define our own purpose in life.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="680" width="530" y="15" as="geometry" />
        </mxCell>
        <mxCell id="AGBN_yRrD6I4HZXZdgja-0" connectable="0" parent="mIenp-yJnPnNglZ723Zf-1" style="group" value="" vertex="1">
          <mxGeometry height="30" width="210" x="320" y="95" as="geometry" />
        </mxCell>
        <mxCell id="AGBN_yRrD6I4HZXZdgja-1" collapsed="1" parent="AGBN_yRrD6I4HZXZdgja-0" style="rounded=1;whiteSpace=wrap;html=1;comic=0;strokeColor=#B85450;fontSize=8;fillColor=#F8CECC;gradientColor=#EA6B66;arcSize=50;treeMoving=1;treeFolding=0;strokeWidth=0.5;fontStyle=1" value="&lt;span style=&quot;font-size: 10px;&quot;&gt;God possesses power and intelligence&lt;br&gt;that encompasses all of reality.&lt;/span&gt;" vertex="1">
          <mxGeometry height="30" width="210" as="geometry" />
        </mxCell>
        <mxCell id="AGBN_yRrD6I4HZXZdgja-2" collapsed="1" parent="AGBN_yRrD6I4HZXZdgja-0" style="swimlane;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;gradientColor=#FFD966;swimlaneFillColor=#E6E6E6;connectable=1;allowArrows=0;treeFolding=0;treeMoving=1;expand=0;" value="" vertex="1">
          <mxGeometry height="5" width="210" y="20" as="geometry">
            <mxRectangle height="3.333333333333333" width="50.00000000000001" y="20" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="AGBN_yRrD6I4HZXZdgja-3" parent="AGBN_yRrD6I4HZXZdgja-2" style="text;html=1;strokeColor=default;fillColor=#E6E6E6;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=1;treeFolding=0;expand=1;spacingLeft=0;" value="&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Observations&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;i&gt;Required Inferences&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Speculation isn&#39;t refutation.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Reality is ordered, operating on consistent and intelligible laws.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Reality tends to progress from order to disorder.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Reality has a universally applicable set of fundamental laws.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Reality (and life) is a hierarchy of deeply interconnected systems.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Life comes from other life, yet originated from non-life.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Intelligence correlates with success and purposeful/conscious complexity.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Everything that has a beginning has a preceding cause.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Every inference has a limit.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;i&gt;Specific Observations&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- The universe exists at a scale physically beyond human comprehension...&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- ... With a granularity/precision that exists at a scale beyond human comprehension.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- ... With interconnected components that require epistemological probability to understand (from our inability to model all the variables).&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- ... Such that all things obey fundamental, intelligible, and discoverable laws...&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- ... With those laws so finely tuned that any tiny variation would cause a universal collapse...&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- ... Which are most evident in the formation of life, which must have required incredibly specific conditions to form.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- ... Such that reality constantly maintains that tuning with an unwavering precision at an incomprehensibly massive scale of time.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- ... In a world where careful, intelligence, and conscious maintenance is required to counteract the tendency to disorder.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- ... In a world where consistent complexity is a sign of conscious intelligence, while inherent disorder is a sign of the lack thereof.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- The universe is observed to have a fundamental beginning, which requires a trigger to cause its existence (as something can&#39;t come from nothing).&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- It would also require the trigger to be something that is fundamentally not the universe.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Whatever the fundamental source of the universe is, it is defined with the label of &quot;God&quot;.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&lt;b style=&quot;&quot;&gt;The Deduction (and why)&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;- &lt;i&gt;God possesses power and intelligence that encompasses all of reality.&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- The vastness, tuning, and consistency of the universe requires power, intelligence, and maintenance on an ultimate scale, as the tiniest of changes would cause a universal collapse.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- The magnitude of this precision compounds over time exponentially, as every moment could be the one with reality collapses, yet it still persists.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- Bringing the entire cosmos, its universal laws, and life itself into being from a state of non-being is the ultimate expression of power, as it demonstrates a power that is not limited by space nor time.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- This also demonstrates supreme conscious intelligence, as a creation of such consistently interconnected complexity requires knowledge of how to avoid the infinitely other alternatives that would cause the universe to crash and burn.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Addressing Objections and Alternatives&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;- These objections generally rely on the speculation that &quot;valid possibilities exist because we don&#39;t know otherwise&quot;, but that&#39;s an argument from ignorance: it doesn&#39;t disprove the inductive inferences from what we observe in reality.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;- Without clear counterexamples that invalidate the patterns (and to iteratively converge upon the truth, such that it is distinguishable from falsehood), we favor the best-fit explanation: a transcendent God as the source, which explains the data with fewer assumptions than multiplying unverified options.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;b&gt;1. The universe is just the result of random chance, meaning the universe is an unconscious &quot;accident&quot;.&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- This claim solely depends on the assumption that there is no basis to believe in something that can&#39;t be seen when there are natural alternatives to consider, as &quot;God&quot; can&#39;t be seen and so it is irrational to consider Him as the universe&#39;s cause over possible theoretically natural explanations.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- The issue with this assumption is that it is equally metaphysical/unseen as the concept of God, yet it is so much less supported by reality and the useful inferences we can make.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- This claim can&#39;t be supported by reality, as the inherent, intelligible, and discoverable order within the universe indicates otherwise.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Moreover, the speed at which random events statistically progress (ex. like with the theory of human evolution) is much slower than what reality presents (ex. for humans to have evolved from single-cell organisms, it must have taken 2-3 billion years - which still relies on staggering improbabilities that would have otherwise took much, much longer), which further supports the inference of conscious intelligence over unconscious randomness.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- And this is all occurring within the staggering improbability of abiogenesis itself (how life began), within the staggering improbabilities of the Earth being hospitable and the even more staggering chance of the universe&#39;s fundamental constants being tuned as they are.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- As such, this objection is just speculation without counterexamples: saying &quot;random chance could explain it&quot; doesn&#39;t disprove the inductive pattern of order requiring intelligence, as we observe no unguided examples of such complexity emerging.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;b&gt;2. We can explain our fine-tuned universe with multiverse theory (as it would be just like the Earth is with other planets) as a rare universe among infinite universes in which life is possible.&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- This doesn&#39;t explain anything, as it just redirects the discussion of the source of the universe back one layer: how then did the multiverse form?&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- Moreover, a &quot;multiverse&quot; is a theoretical, speculative, and unobserved concept, which we can&#39;t derive valid inferences from - as we can with reality.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- Finally, even if we assume that this multiverse is somehow &quot;uncreated&quot; (as with God), it still is a less powerful explanation than that of God, as multiverse theory still doesn&#39;t explain phenomenal consciousness.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- And we can&#39;t really conceive of an &quot;uncreated&quot; universe anyways, as something can&#39;t be caused by nothing - so a multiverse just introduces more &quot;things&quot; that need an explanation for how they came to be.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- As such, this is an argument from ignorance - claiming &quot;infinite universes could exist&quot; treats lack of knowledge as refutation, but without counterexamples from reality, it doesn&#39;t invalidate the best-fit explanation of a single, intentional source.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;b&gt;3. If everything has a cause, then God must have a cause as well.&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- This is more thoroughly addressed in future deductions, but in short: this is a category error, as this inference requires the flow of time to occur, and so if God is atemporal, then it would be irrational to apply the same requirements of temporality to something atemporal.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- As such, demanding a cause (ie. a temporal property) for an atemporal being is speculation: no counterexample exists to show that atemporal &quot;things&quot; need causes, so the inductive rule holds only for temporal reality.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&lt;b&gt;4. There could be limits to God&#39;s power.&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- We are limited by time and space, yet the origin of the universe can&#39;t be limited by time nor space (as it transcends them) - meaning God is not limited by time nor space.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- We are unable to conceive of a reality beyond time and space, so it is impossible for us to conceive of limits to God&#39;s power - especially with the vastness, tuning, and intelligence required to create the universe indicates that He could have made it any way He wanted.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- It is impossible for us to rationally define a limit to the power of a being that is atemporal and non-physical; from our vantage point, this power is functionally infinite.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 7px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- In short: speculating on limits without evidence doesn&#39;t refute the inference.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="680" width="550" y="15" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="5. Religious Comparison (1/2)" id="wpfU1qMn-CJc2hLsmo2Y">
    <mxGraphModel dx="1573" dy="961" grid="1" gridSize="5" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" background="#CCCCCC" math="0" shadow="0" adaptiveColors="none">
      <root>
        <mxCell id="xU8i5WHc9yBozkm9Jjk--0" />
        <mxCell id="xU8i5WHc9yBozkm9Jjk--1" parent="xU8i5WHc9yBozkm9Jjk--0" />
        <UserObject label="Religious Comparison: Alignment with Reality (1/2)" link="data:page/id,lkuSvPZcJC7dHRsydWrw" id="KNzCLVDFt8i13XY0lh30-0">
          <mxCell parent="xU8i5WHc9yBozkm9Jjk--1" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#E6E6E6;fontSize=20;" vertex="1">
            <mxGeometry height="50" width="810" x="20" y="20" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="7UjfAEiuPamlVw0oCuij-0" parent="xU8i5WHc9yBozkm9Jjk--1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=1;fontColor=default;labelBackgroundColor=none;gradientColor=#FFD966;fillColor=#FFF2CC;strokeColor=#D6B656;fontStyle=1;verticalAlign=top;spacingTop=12;strokeWidth=2;" value="&lt;span style=&quot;font-size: 20px;&quot;&gt;Polytheism&lt;/span&gt;&lt;div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;span style=&quot;font-weight: normal;&quot;&gt;Reality originated from multiple, transcendent creators (often competing with one another), without a higher, all-encompassing creator above them.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="115" width="185" x="230" y="90" as="geometry" />
        </mxCell>
        <mxCell id="7UjfAEiuPamlVw0oCuij-3" parent="xU8i5WHc9yBozkm9Jjk--1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=1;fontColor=default;labelBackgroundColor=none;gradientColor=#EA6B66;fillColor=#F8CECC;strokeColor=#B85450;fontStyle=1;verticalAlign=top;spacingTop=12;strokeWidth=2;" value="&lt;div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Atheism&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;span style=&quot;font-weight: normal;&quot;&gt;There is no transcendent, willful, or intelligent source of reality: all phenomena are the result of unguided material processes and laws.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="115" width="185" x="25" y="90" as="geometry" />
        </mxCell>
        <mxCell id="YZqMC-y3LvAAL2BY0nUx-0" parent="xU8i5WHc9yBozkm9Jjk--1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=1;fontColor=default;labelBackgroundColor=none;gradientColor=#7EA6E0;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;verticalAlign=top;spacingTop=12;strokeWidth=2;" value="&lt;span style=&quot;font-size: 20px;&quot;&gt;Monotheism&lt;/span&gt;&lt;div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 10px; font-weight: 400;&quot;&gt;There is a single, transcendent, willful, and intelligent source of reality - without divisibility, partners, and equals.&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="115" width="185" x="640" y="90" as="geometry" />
        </mxCell>
        <mxCell id="7UjfAEiuPamlVw0oCuij-1" parent="xU8i5WHc9yBozkm9Jjk--1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=1;fontColor=default;labelBackgroundColor=none;gradientColor=#97D077;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;verticalAlign=top;spacingTop=12;strokeWidth=2;" value="&lt;span style=&quot;font-size: 20px;&quot;&gt;Trinitarianism&lt;/span&gt;&lt;div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;span style=&quot;font-weight: normal;&quot;&gt;There is a single, transcendent, willful, and intelligent source of reality, who exist as 3 Persons - distinct neither in essence/substance nor form/mask/body.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="115" width="185" x="435" y="90" as="geometry" />
        </mxCell>
        <UserObject label="" link="data:page/id,4td7CR43rWQwDV4hspUf" id="RBYZg5LPsvG7Azx1tScC-0">
          <mxCell connectable="0" parent="xU8i5WHc9yBozkm9Jjk--1" style="group" vertex="1">
            <mxGeometry height="50" width="50" x="780" y="19.999999999999996" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="QugWGYgKjgL4qu_BndqV-2" parent="RBYZg5LPsvG7Azx1tScC-0" style="rounded=0;whiteSpace=wrap;html=1;pointerEvents=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=12;fontColor=default;fillColor=#E6E6E6;gradientColor=none;strokeColor=none;rotation=-180;opacity=1;" value="" vertex="1">
          <mxGeometry height="50" width="50" y="3.552713678800501e-15" as="geometry" />
        </mxCell>
        <UserObject label="" id="QugWGYgKjgL4qu_BndqV-1">
          <mxCell edge="1" parent="RBYZg5LPsvG7Azx1tScC-0" style="shape=flexArrow;endArrow=classic;html=1;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=default;fillColor=#B3B3B3;">
            <mxGeometry height="50" relative="1" width="50" as="geometry">
              <mxPoint y="25.000000000000004" as="sourcePoint" />
              <mxPoint x="40" y="25.000000000000004" as="targetPoint" />
            </mxGeometry>
          </mxCell>
        </UserObject>
        <mxCell id="X1hAK5IwmxZukM20bW0x-0" connectable="0" parent="xU8i5WHc9yBozkm9Jjk--1" style="group" value="" vertex="1">
          <mxGeometry height="865.0000000000002" width="810.0000000000001" x="20" y="225" as="geometry" />
        </mxCell>
        <mxCell id="YZqMC-y3LvAAL2BY0nUx-2" parent="X1hAK5IwmxZukM20bW0x-0" style="shape=table;startSize=0;container=1;collapsible=0;childLayout=tableLayout;fontSize=1;" value="" vertex="1">
          <mxGeometry height="820.0000000000003" width="810.0000000000001" y="44.999999999999886" as="geometry" />
        </mxCell>
        <mxCell id="YZqMC-y3LvAAL2BY0nUx-3" parent="YZqMC-y3LvAAL2BY0nUx-2" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" value="" vertex="1">
          <mxGeometry height="215" width="810.0000000000001" as="geometry" />
        </mxCell>
        <mxCell id="YZqMC-y3LvAAL2BY0nUx-4" parent="YZqMC-y3LvAAL2BY0nUx-3" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#D5D5D5;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;gradientColor=none;" value="&lt;font style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;Things are identified (or known) by distinguishing their properties from others.&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="215" width="163" as="geometry">
            <mxRectangle height="215" width="163" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="YZqMC-y3LvAAL2BY0nUx-5" parent="YZqMC-y3LvAAL2BY0nUx-3" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#FFCCCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=top;fontColor=#999999;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;" value="&lt;font style=&quot;font-size: 9px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Yes&lt;/b&gt;&lt;/font&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;The universe is created from other natural processes, each distinct from the next.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="215" width="161" x="163" as="geometry">
            <mxRectangle height="215" width="161" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="YZqMC-y3LvAAL2BY0nUx-15" parent="YZqMC-y3LvAAL2BY0nUx-3" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#FFFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;fontColor=#999999;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;" value="&lt;font style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;Yes&lt;/b&gt;&lt;/font&gt;&lt;div&gt;&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;The universe is created from a collective effort of distinct gods, or the efforts of one&lt;br&gt;of them without&amp;nbsp;the others.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="215" width="163" x="324" as="geometry">
            <mxRectangle height="215" width="163" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="YZqMC-y3LvAAL2BY0nUx-18" parent="YZqMC-y3LvAAL2BY0nUx-3" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;" value="&lt;font style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;Maybe&lt;/b&gt;&lt;/font&gt;&lt;div&gt;&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&lt;font style=&quot;color: rgb(102, 102, 102);&quot;&gt;&quot;1 God, 3 Persons&quot; defines a distinction&lt;br&gt;that is neither fundamental nor superficial (ie. neither consistent nor inconsistent, thus eliminating all valid possibilities), which is indistinguishable from a contradiction or false belief.&lt;br&gt;&lt;br&gt;This requires us to infer that&amp;nbsp;&quot;inferring about reality doesn&#39;t reliably lead to spiritual truth&quot;, allowing the Trinity to be an exception to the rule. As such, the basis of verification shifts&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;&lt;font color=&quot;#666666&quot;&gt;&amp;nbsp;from rational inference to textual authority, as&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;font style=&quot;color: rgb(102, 102, 102);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;&lt;font style=&quot;&quot;&gt;its truth now becomes entirely contingent upon proving that its scriptural source is perfectly preserved and divinely inspired. And, if truth is still distinguishable from falsehood, then the evidence must be superior against all other alternatives (which would all necessarily be false and pose some contradiction with reality).&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="215" width="161" x="487" as="geometry">
            <mxRectangle height="215" width="161" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="YZqMC-y3LvAAL2BY0nUx-21" parent="YZqMC-y3LvAAL2BY0nUx-3" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CBE2FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;fontColor=#999999;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;" value="&lt;font style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;Yes&lt;/b&gt;&lt;/font&gt;&lt;div&gt;&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;The universe is created from one God, who is fundamentally distinct from all creation.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="215" width="162" x="648" as="geometry">
            <mxRectangle height="215" width="162" as="alternateBounds" />
          </mxGeometry>
