        <mxCell id="xpxPvFw1KCywsOg1OESM-1" value="" style="rounded=0;whiteSpace=wrap;html=1;pointerEvents=0;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=12;fontColor=default;fillColor=#E6E6E6;gradientColor=none;strokeColor=none;rotation=-360;opacity=1;" vertex="1" parent="xpxPvFw1KCywsOg1OESM-0">
