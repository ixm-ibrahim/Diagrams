        <mxCell id="ev5vojVGDBCjoDU-CP_1-5" parent="ev5vojVGDBCjoDU-CP_1-4" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#E6E6E6;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=middle;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;swimlaneFillColor=none;gradientColor=none;gradientDirection=east;align=center;" value="&lt;b style=&quot;font-size: 11px;&quot;&gt;Faith and Reason&lt;/b&gt;" vertex="1">
