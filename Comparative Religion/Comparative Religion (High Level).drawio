        </mxCell>
        <mxCell id="I55OHFyqlXbNXwQoPFCH-22" value="&lt;b style=&quot;font-size: 11px;&quot;&gt;Humans sin and need God&#39;s forgiveness.&lt;/b&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=middle;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;swimlaneFillColor=none;gradientColor=#CCE5FF;gradientDirection=east;" vertex="1" parent="I55OHFyqlXbNXwQoPFCH-21">
          <mxGeometry width="105" height="95" as="geometry">
            <mxRectangle width="105" height="95" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="I55OHFyqlXbNXwQoPFCH-24" value="" style="group" vertex="1" connectable="0" parent="zuZuHAAaARETqynN6Csq-1">
          <mxGeometry x="95" y="10700" width="735" height="110" as="geometry" />
        </mxCell>
        <mxCell id="I55OHFyqlXbNXwQoPFCH-25" value="" style="shape=table;startSize=0;container=1;collapsible=0;childLayout=tableLayout;fontSize=1;" vertex="1" parent="I55OHFyqlXbNXwQoPFCH-24">
          <mxGeometry x="105" width="630" height="110" as="geometry" />
        </mxCell>
        <mxCell id="I55OHFyqlXbNXwQoPFCH-26" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;swimlaneFillColor=none;" vertex="1" parent="I55OHFyqlXbNXwQoPFCH-25">
          <mxGeometry width="630" height="80" as="geometry" />
        </mxCell>
        <mxCell id="I55OHFyqlXbNXwQoPFCH-27" value="&lt;div style=&quot;&quot;&gt;&lt;font&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;&amp;nbsp;- &quot;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;Therefore &lt;b&gt;no one will be declared righteous in God’s sight by the works of the law&lt;/b&gt;; rather, through the law we become conscious of our sin.&quot; (Romans 3:20)&lt;/span&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- &quot;&lt;/span&gt;&lt;/span&gt;&lt;/font&gt;&lt;font style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;For &lt;b&gt;it is by grace you have been saved, through faith—and this is not from yourselves, it is the gift of God—not by works&lt;/b&gt;, so that no one can boast.&quot; (&lt;/span&gt;&lt;/font&gt;&lt;font style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;Ephesians 2:8-10)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=middle;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;swimlaneFillColor=none;gradientColor=none;gradientDirection=east;align=left;" vertex="1" parent="I55OHFyqlXbNXwQoPFCH-26">
          <mxGeometry width="315" height="80" as="geometry">
            <mxRectangle width="315" height="80" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="I55OHFyqlXbNXwQoPFCH-28" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;&amp;nbsp;- On Aisha, who reported that God&#39;s Messenger used to say:&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;&quot;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;Observe moderation (in doing deeds), and if you fail to observe it perfectly, try to do as much as you can do (to live up to this ideal of moderation) and &lt;b&gt;be happy for none would be able to get into Paradise because of his deeds alone&lt;/b&gt;. They (the Companions of the Holy Prophet) said: God&#39;s Messenger, not even you? Thereupon he said: Not even I, but that &lt;b&gt;God wraps me in His Mercy, and bear this in mind that the deed loved most by God is one which is done constantly even though it is small&lt;/b&gt;.&quot; (Sahih Muslim 2818a)&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCE5FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=middle;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;swimlaneFillColor=none;gradientColor=none;gradientDirection=east;align=left;" vertex="1" parent="I55OHFyqlXbNXwQoPFCH-26">
          <mxGeometry x="315" width="315" height="80" as="geometry">
            <mxRectangle width="315" height="80" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="I55OHFyqlXbNXwQoPFCH-29" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;swimlaneFillColor=none;" vertex="1" parent="I55OHFyqlXbNXwQoPFCH-25">
          <mxGeometry y="80" width="630" height="30" as="geometry" />
        </mxCell>
        <mxCell id="I55OHFyqlXbNXwQoPFCH-30" value="&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;&amp;nbsp;- Salvation is fundamentally grace through faith, where works are only its fruit/&lt;br&gt;evidence.&lt;/span&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=middle;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;swimlaneFillColor=none;gradientColor=none;gradientDirection=east;align=left;" vertex="1" parent="I55OHFyqlXbNXwQoPFCH-29">
          <mxGeometry width="315" height="30" as="geometry">
            <mxRectangle width="315" height="30" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="I55OHFyqlXbNXwQoPFCH-31" value="&lt;span style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- Salvation is fundamentally by God&#39;s mercy, which manifests through God&#39;s love of righteousness and weighing of our deeds&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;.&lt;/span&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCE5FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=middle;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;swimlaneFillColor=none;gradientColor=none;gradientDirection=east;align=left;" vertex="1" parent="I55OHFyqlXbNXwQoPFCH-29">
          <mxGeometry x="315" width="315" height="30" as="geometry">
            <mxRectangle width="315" height="30" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="I55OHFyqlXbNXwQoPFCH-32" value="" style="shape=table;startSize=0;container=1;collapsible=0;childLayout=tableLayout;fontSize=1;" vertex="1" parent="I55OHFyqlXbNXwQoPFCH-24">
          <mxGeometry width="105" height="110" as="geometry" />
        </mxCell>
        <mxCell id="I55OHFyqlXbNXwQoPFCH-33" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;swimlaneFillColor=none;" vertex="1" parent="I55OHFyqlXbNXwQoPFCH-32">
          <mxGeometry width="105" height="110" as="geometry" />
        </mxCell>
        <mxCell id="I55OHFyqlXbNXwQoPFCH-34" value="&lt;b style=&quot;font-size: 11px;&quot;&gt;God merits righteousness, but no one &quot;earns&quot; Paradise/Heaven by human merit alone (ie. without God&#39;s grace).&lt;/b&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=middle;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;swimlaneFillColor=none;gradientColor=#CCE5FF;gradientDirection=east;" vertex="1" parent="I55OHFyqlXbNXwQoPFCH-33">
          <mxGeometry width="105" height="110" as="geometry">
            <mxRectangle width="105" height="110" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="S8Pw8Tw3iUAq8b6uVJTt-102" value="" style="shape=table;startSize=0;container=1;collapsible=0;childLayout=tableLayout;fontSize=1;" vertex="1" parent="zuZuHAAaARETqynN6Csq-1">
          <mxGeometry x="200" y="10455" width="630" height="150" as="geometry" />
        </mxCell>
        <mxCell id="S8Pw8Tw3iUAq8b6uVJTt-103" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;swimlaneFillColor=none;" vertex="1" parent="S8Pw8Tw3iUAq8b6uVJTt-102">
          <mxGeometry width="630" height="120" as="geometry" />
        </mxCell>
        <mxCell id="S8Pw8Tw3iUAq8b6uVJTt-104" value="&lt;div style=&quot;&quot;&gt;&lt;font&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;&amp;nbsp;- &quot;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;The one who sins is the one who will die. The child will not share the guilt of the parent, nor will the parent share the guilt of the child. &lt;/span&gt;&lt;b style=&quot;font-size: 8px;&quot;&gt;The righteousness of the righteous will be credited to them, and the wickedness of the wicked will be charged against them&lt;/b&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;.&quot; (Ezekiel 18:20)&lt;/span&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- &quot;&lt;/span&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;For we will all stand before God’s judgment seat. It is written:&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&#39;As surely as I live, [says the Lord],&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;every knee will bow before me;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;every tongue will acknowledge God.&#39;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;So then, &lt;b&gt;each of us will give an account of ourselves to God&lt;/b&gt;.&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&quot; (Romans 14:10-12)&lt;/span&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;&amp;nbsp;- &quot;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;When tempted, no one should say, &#39;God is tempting me.&#39; For God cannot be tempted by evil, nor does he tempt anyone; but &lt;b&gt;each person is tempted when they are dragged away by their own evil desire and enticed&lt;/b&gt;.&lt;/span&gt;&lt;font style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&quot; (&lt;/span&gt;&lt;/font&gt;&lt;font style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;James 1:13-14)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=middle;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;swimlaneFillColor=none;gradientColor=none;gradientDirection=east;align=left;" vertex="1" parent="S8Pw8Tw3iUAq8b6uVJTt-103">
          <mxGeometry width="315" height="120" as="geometry">
            <mxRectangle width="315" height="120" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="S8Pw8Tw3iUAq8b6uVJTt-105" value="&lt;div style=&quot;&quot;&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;&amp;nbsp;- &quot;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;God does not charge a soul except [with that within] its capacity. I&lt;b&gt;t will have [the consequence of] what [good] it has gained, and it will bear [the consequence of] what [evil] it has earned&lt;/b&gt;.&lt;/span&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&quot; (Quran 2:286)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 8px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&amp;nbsp;- &quot;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;For him [i.e., each one] are successive [angels] before and behind him who protect him by the decree of God. Indeed, &lt;b&gt;God will not change the condition of a people until they change what is in themselves.&lt;/b&gt; And when God intends for a people ill, there is no repelling it. And there is not for them besides Him any patron.&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;&quot; (Quran 13:11)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- &quot;&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&lt;b&gt;Whoever chooses to be guided, it is only for their own good. And whoever chooses to stray, it is only to their own loss.&lt;/b&gt; No soul burdened with sin will bear the burden of another. And We would never punish ˹a people˺ until We have sent a messenger ˹to warn them˺.&quot;&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;(Quran 17:15)&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCE5FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=middle;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;swimlaneFillColor=none;gradientColor=none;gradientDirection=east;align=left;" vertex="1" parent="S8Pw8Tw3iUAq8b6uVJTt-103">
          <mxGeometry x="315" width="315" height="120" as="geometry">
            <mxRectangle width="315" height="120" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="S8Pw8Tw3iUAq8b6uVJTt-106" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;swimlaneFillColor=none;" vertex="1" parent="S8Pw8Tw3iUAq8b6uVJTt-102">
          <mxGeometry y="120" width="630" height="30" as="geometry" />
        </mxCell>
        <mxCell id="S8Pw8Tw3iUAq8b6uVJTt-107" value="&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 8px;&quot;&gt;&amp;nbsp;- Salvation is achieved through Jesus&#39; atonement, not by our own righteousness - by God&#39;s grace.&amp;nbsp;&lt;/span&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=middle;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;swimlaneFillColor=none;gradientColor=none;gradientDirection=east;align=left;" vertex="1" parent="S8Pw8Tw3iUAq8b6uVJTt-106">
          <mxGeometry width="315" height="30" as="geometry">
            <mxRectangle width="315" height="30" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="S8Pw8Tw3iUAq8b6uVJTt-108" value="&lt;span style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- Salvation is achieved by personal righteousness, made possible by God&#39;s mercy - by God&#39;s grace.&lt;/span&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCE5FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=middle;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;swimlaneFillColor=none;gradientColor=none;gradientDirection=east;align=left;" vertex="1" parent="S8Pw8Tw3iUAq8b6uVJTt-106">
          <mxGeometry x="315" width="315" height="30" as="geometry">
            <mxRectangle width="315" height="30" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="S8Pw8Tw3iUAq8b6uVJTt-109" value="" style="shape=table;startSize=0;container=1;collapsible=0;childLayout=tableLayout;fontSize=1;" vertex="1" parent="zuZuHAAaARETqynN6Csq-1">
          <mxGeometry x="95" y="10455" width="105" height="150" as="geometry" />
        </mxCell>
        <mxCell id="S8Pw8Tw3iUAq8b6uVJTt-110" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;swimlaneFillColor=none;" vertex="1" parent="S8Pw8Tw3iUAq8b6uVJTt-109">
          <mxGeometry width="105" height="150" as="geometry" />
        </mxCell>
        <mxCell id="S8Pw8Tw3iUAq8b6uVJTt-111" value="&lt;b style=&quot;font-size: 11px;&quot;&gt;Humans are morally responsible agents.&lt;/b&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=middle;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;swimlaneFillColor=none;gradientColor=#CCE5FF;gradientDirection=east;" vertex="1" parent="S8Pw8Tw3iUAq8b6uVJTt-110">
          <mxGeometry width="105" height="150" as="geometry">
            <mxRectangle width="105" height="150" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="7. Non-Fundamental Comparison (2/7)" id="XbJ0z0nIzhYvPX_4MN__">
    <mxGraphModel dx="914" dy="-8935" grid="1" gridSize="5" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" background="#CCCCCC" math="0" shadow="0" adaptiveColors="none">
      <root>
        <mxCell id="0ffwS5z20CiL1abtpJwu-0" />
        <mxCell id="0ffwS5z20CiL1abtpJwu-1" parent="0ffwS5z20CiL1abtpJwu-0" />
        <UserObject label="Non-Fundamental Comparison: Christianity vs. Islam (2/7)" link="data:page/id,lkuSvPZcJC7dHRsydWrw" id="0ffwS5z20CiL1abtpJwu-2">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#E6E6E6;fontSize=20;" parent="0ffwS5z20CiL1abtpJwu-1" vertex="1">
            <mxGeometry x="20" y="9920" width="810" height="50" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="hrkE1YlLufl5ihLmMU30-3" value="" style="group" parent="0ffwS5z20CiL1abtpJwu-1" vertex="1" connectable="0">
          <mxGeometry x="20" y="9985" width="810.0000000000001" height="560" as="geometry" />
        </mxCell>
        <mxCell id="fdP4uL2IWqcHji0CoqKW-13" value="" style="shape=table;startSize=0;container=1;collapsible=0;childLayout=tableLayout;fontSize=1;" parent="hrkE1YlLufl5ihLmMU30-3" vertex="1">
          <mxGeometry y="45" width="810" height="515" as="geometry" />
        </mxCell>
        <mxCell id="fdP4uL2IWqcHji0CoqKW-14" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" parent="fdP4uL2IWqcHji0CoqKW-13" vertex="1">
          <mxGeometry width="810" height="240" as="geometry" />
        </mxCell>
        <mxCell id="fdP4uL2IWqcHji0CoqKW-16" value="&lt;font style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;Out of God&#39;s love for us, He opens the path to forgiveness by personally satisfying the debt of our sins, saving us from a burden we can&#39;t repay without sacrificing justice&lt;/b&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&lt;b&gt;Justice&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- Giving everyone what they deserve (ie. what they have a right to experience, based on how well they fulfilled their responsibilities).&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- More specifically: the debt of sin must be satisfied with a punishment - proportional to the sin&#39;s weight. And considering that every sin is against an infinite God, the weight of each sin is fundamentally beyond our limited capacity to pay.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&lt;b&gt;Forgiveness&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- When the punishment for a sin is removed.&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- This can only occur&amp;nbsp;&lt;i&gt;after&lt;/i&gt;&amp;nbsp;the debt is satisfied (ie. the punishment is experienced) - either when the offender experiences it himself, or if someone else who&#39;s qualified willingly intercedes and experiences it on their behalf (ie. vicarious satisfaction).&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- As a result, God can&#39;t &quot;simply&quot; forgive (ie. waiving punishment) - that would be unjust, as the cost from our sins is still not being paid for.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&lt;b&gt;Love/Mercy&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- God is love itself: the very essence of affectionately desiring our salvation and happiness. He loves all people, while reserving a special, two-sided love for those deemed &quot;Children of God&quot; to those who enter Heaven.&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- This is ultimately manifested in the Atonement, in which Jesus (the filiation - Person of the Son) personally satisfied humanity&#39;s debt through his death and resurrection (by defeating death - the ultimate result of Adam and Eve&#39;s original sin) - changing the fundamental salvific requirement from &quot;impossibly perfect righteousness and repentance&quot; to &quot;faith in Jesus Christ&quot; (ie. belief and trust in his divinity).&lt;/font&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=top;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;" parent="fdP4uL2IWqcHji0CoqKW-14" vertex="1">
          <mxGeometry width="405" height="240" as="geometry">
            <mxRectangle width="405" height="240" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="fdP4uL2IWqcHji0CoqKW-17" value="&lt;div&gt;&lt;font style=&quot;font-size: 9px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Out of God’s mercy, He opens the path to forgiveness through sincere repentance and good deeds - each soul answering only for its own actions - so justice is preserved without the loss of any righteous act&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&lt;b&gt;Justice&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- Giving everyone what they deserve (ie. what they have a right to experience, based on how well they fulfilled their responsibilities).&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- More specifically: we only sin against ourselves, and we are only righteous to our own benefit in the same way.&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- We are the only ones affected by our own actions, as God is neither benefited nor harmed by our deeds.&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- No soul bears the burden of another: we are held accountable only for our own actions.&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- All actions are accounted for, no matter how small.&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- Justice is two-sided and proportional: righteousness is rewarded, while sin is punished.&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&lt;b&gt;Forgiveness&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- When the punishment for a sin is removed.&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- This can only occur when sincere repentance and restitution has occurred (to the best of ability), or when the weight of a superfluous righteous deed is heavier than the weight (or lack thereof) of the sin.&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- Since God is the Just, and He is the only one who truly knows the weight of our own deeds, then He forgives whom He wills and punishes whom He wills - without dismissing or causing our righteous actions to go to waste.&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&lt;b&gt;Love/Mercy&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- God is the all-merciful, the ever-merciful: His mercy (a one-sided form of love) encompasses all things, opening the path to forgiveness (ie. delaying punishment) before opening the path to punishment. He also reserves a special, two-sided love for those who enter Paradise.&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- The path to forgiveness is open for as long as we&#39;re alive: good deeds are multiplied, punishment is delayed, and even the smallest of good deeds have the potential to outweigh bad deeds - all out of God&#39;s mercy.&lt;/font&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCE5FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;" parent="fdP4uL2IWqcHji0CoqKW-14" vertex="1">
          <mxGeometry x="405" width="405" height="240" as="geometry">
            <mxRectangle width="405" height="240" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="6EO3iycbL_vFDhKmOSQg-0" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" parent="fdP4uL2IWqcHji0CoqKW-13" vertex="1">
          <mxGeometry y="240" width="810" height="275" as="geometry" />
        </mxCell>
        <mxCell id="6EO3iycbL_vFDhKmOSQg-1" value="&lt;font style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;Examples&lt;/b&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;br style=&quot;font-size: 8px;&quot;&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&amp;nbsp;- &quot;The Lord is slow to anger, abounding in love and forgiving sin and rebellion. Yet he does not leave the guilty unpunished; he punishes the children for the sin of the parents to the third and fourth generation.&quot; (Numbers 14:18)&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&amp;nbsp;- &quot;The one who sins is the one who will die. The child will not share the guilt of the parent, nor will the parent share the guilt of the child. The righteousness of the righteous will be credited to them, and the wickedness of the wicked will be charged against them.&quot; (Ezekiel 18:20)&lt;br&gt;&amp;nbsp;- &quot;For even the Son of Man did not come to be served, but to serve, and to give his life as a ransom for many.&quot; (Mark 10:45)&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&amp;nbsp;- &quot;For God so loved the world that he gave his one and only Son, that whoever believes in him shall not perish but have eternal life.&quot; (John 3:16)&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&amp;nbsp;- &quot;Jesus said to her, &#39;I am the resurrection and the life. The one who believes in me will live, even though they die.&quot; (John 11:25)&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&amp;nbsp;- &quot;For what I received I passed on to you as of first importance: that Christ died for our sins according to the Scriptures&quot; (1 Corinthians 15:3)&lt;br&gt;&amp;nbsp;- &quot;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; text-align: center; font-size: 8px;&quot;&gt;God made him who had no sin to be sin for us, so that in him we might become the righteousness of God.&quot; (2 Corinthians 5:21)&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- &quot;God presented Christ as a sacrifice of atonement, through the shedding of his blood—to be received by faith.&quot; (Romans 3:25)&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- &quot;But God demonstrates his own love for us in this: While we were still sinners, Christ died for us.&quot; (Romans 5:8)&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- &quot;For just as through the disobedience of the one man the many were made sinners, so also through the obedience of the one man the many will be made righteous.&quot; (Romans 5:19)&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- &quot;For the wages of sin is death, but the gift of God is eternal life in Christ Jesus our Lord.&quot; (Romans 6:23)&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- &quot;For whoever keeps the whole law and yet stumbles at just one point is guilty of breaking all of it.&quot; (James 2:10)&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- &quot;The law requires that ... without the shedding of blood there is no forgiveness.&quot; (Hebrews 9:22)&lt;br&gt;&amp;nbsp;- &quot;&#39;He himself bore our sins&#39; in his body on the cross, so that we might die to sins and live for righteousness; &#39;by his wounds you have been healed.&#39;&quot; (1 Peter 24)&lt;br&gt;&lt;/font&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=top;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;" parent="6EO3iycbL_vFDhKmOSQg-0" vertex="1">
          <mxGeometry width="405" height="275" as="geometry">
            <mxRectangle width="405" height="275" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="6EO3iycbL_vFDhKmOSQg-2" value="&lt;font style=&quot;font-size: 9px;&quot;&gt;&lt;b&gt;Examples&lt;/b&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;br style=&quot;font-size: 8px;&quot;&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; text-align: center; font-size: 8px;&quot;&gt;&quot;God does not charge a soul except [with that within] its capacity. It will have [the consequence of] what [good] it has gained, and it will bear [the consequence of] what [evil] it has earned.&quot; (Quran 2:286)&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; text-align: center; font-size: 8px;&quot;&gt;&amp;nbsp;- &quot;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; text-align: center; font-size: 8px;&quot;&gt;Say, ˹O Prophet,˺ &#39;If you ˹sincerely˺ love God, then follow me; God will love you and forgive your sins. For God is All-Forgiving, Most Merciful.&#39;&quot; (Quran 3:31)&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; text-align: center; font-size: 8px;&quot;&gt;&amp;nbsp;- &quot;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; text-align: center; font-size: 8px;&quot;&gt;And those who, when they happen to commit a shameful act or wrong themselves, remember God, then, seek forgiveness for their sins-and who is there to forgive sins except God?-and do not persist in what they have done, knowingly.&quot; (Quran 3:135)&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; text-align: center; font-size: 8px;&quot;&gt;&amp;nbsp;- &quot;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; text-align: center; font-size: 8px;&quot;&gt;Indeed, God never wrongs ˹anyone˺—even by an atom’s weight. And if it is a good deed, He will multiply it many times over and will give a great reward out of His grace.&quot; (Quran 4:40)&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; text-align: center; font-size: 8px;&quot;&gt;&amp;nbsp;- &quot;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; text-align: center; font-size: 8px;&quot;&gt;Whoever comes with a good deed will be rewarded tenfold. But whoever comes with a bad deed will be punished for only one. None will be wronged.&quot; (Quran 6:160)&lt;br&gt;&amp;nbsp;- &quot;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; text-align: center; font-size: 8px;&quot;&gt;Establish prayer ˹O Prophet˺ at both ends of the day and in the early part of the night. Surely good deeds wipe out evil deeds. That is a reminder for the mindful.&quot; (Quran 11:114)&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; text-align: center; font-size: 8px;&quot;&gt;&amp;nbsp;- &quot;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; text-align: center; font-size: 8px;&quot;&gt;Your Lord is the All-Forgiving, Full of Mercy. If He were to seize them ˹immediately˺ for what they commit, He would have certainly hastened their punishment. But they have an appointed time, from which they will find no refuge.&quot; (Quran 18:58)&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; text-align: center; font-size: 8px;&quot;&gt;&amp;nbsp;- &quot;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; text-align: center; font-size: 8px;&quot;&gt;As for those who repent, believe, and do good deeds, they are the ones whose evil deeds God will change into good deeds. For God is All-Forgiving, Most Merciful.&quot; (Quran 25:70)&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; text-align: center; font-size: 8px;&quot;&gt;&amp;nbsp;- &quot;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; text-align: center; font-size: 8px;&quot;&gt;O mankind! it is you who stand in need of God. But God is Rich (Free of all needs), Worthy of all praise.&quot; (Quran 35:15)&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; text-align: center; font-size: 8px;&quot;&gt;&amp;nbsp;- &quot;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; text-align: center; font-size: 8px;&quot;&gt;Say: &#39;O my Servants who have transgressed against their souls! Despair not of the Mercy of God: for God forgives all sins: for He is Oft-Forgiving, Most Merciful.&#39;&quot; (Quran 39:53)&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; text-align: center; font-size: 8px;&quot;&gt;&amp;nbsp;- &quot;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; text-align: center; font-size: 8px;&quot;&gt;Whoever does good, it is to their own benefit. And whoever does evil, it is to their own loss. Your Lord is never unjust to ˹His˺ creation.&quot; (Quran 41:46)&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; text-align: center; font-size: 8px;&quot;&gt;&amp;nbsp;- &quot;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; text-align: center; font-size: 8px;&quot;&gt;So whoever does an atom’s weight of good will see it.&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; text-align: center; font-size: 8px;&quot;&gt;And whoever does an atom’s weight of evil will see it.&quot; (Quran 99:7-8)&lt;/span&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCE5FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;" parent="6EO3iycbL_vFDhKmOSQg-0" vertex="1">
          <mxGeometry x="405" width="405" height="275" as="geometry">
            <mxRectangle width="405" height="275" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="GFbXLaLzuziWuIplYJXH-9" value="&lt;b&gt;2. What is the relationship between God&#39;s mercy/love, justice, and forgiveness (soteriology)?&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=18;fillColor=#FFDEC9;gradientColor=#FFB663;strokeColor=#D69555;" vertex="1" parent="hrkE1YlLufl5ihLmMU30-3">
          <mxGeometry width="810.0000000000001" height="44.9999999999999" as="geometry" />
        </mxCell>
        <mxCell id="O9XxhuduouKi74YElKZB-1" value="" style="group" parent="0ffwS5z20CiL1abtpJwu-1" vertex="1" connectable="0">
          <mxGeometry x="20" y="10560" width="810.0000000000001" height="420" as="geometry" />
        </mxCell>
        <mxCell id="jy06Roj5z7HLByKl-m8C-0" value="" style="shape=table;startSize=0;container=1;collapsible=0;childLayout=tableLayout;fontSize=1;" parent="O9XxhuduouKi74YElKZB-1" vertex="1">
          <mxGeometry y="45" width="810" height="375" as="geometry" />
        </mxCell>
        <mxCell id="jy06Roj5z7HLByKl-m8C-1" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" parent="jy06Roj5z7HLByKl-m8C-0" vertex="1">
          <mxGeometry width="810" height="295" as="geometry" />
        </mxCell>
        <mxCell id="jy06Roj5z7HLByKl-m8C-2" value="&lt;div&gt;&lt;font style=&quot;font-size: 9px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Adam earned the debt of original sin against an infinite god - making it impossible for a finite mankind to redeem themselves - which is why God gifted us with Jesus Christ (the perfect, divine man) as our Redeemer&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&lt;b&gt;Adam&#39;s Fall from Grace&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- God created Adam and Eve in original perfection, holiness, and justice - in perfect obedience and friendship with God, and in perfect harmony with God&#39;s creation.&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- They enjoyed perfect bliss, with Adam assigning names to everything - including his wife.&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- The were given one commandment - not to eat from the Tree of the Knowledge Good and Evil - yet they succumbed to the serpent&#39;s temptation (with Eve tempting Adam) and ate from it, freely choosing to disobey God.&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- And when they were caught, they instantly started blaming each other.&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- The fundamental sin is that they preferred self-rule over God&#39;s rule - offending against the infinite God - thus earning them an infinite debt.&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- In that act, they earned &quot;original sin&quot;: the loss of their original sanctifying grace (the life of God in the soul) and rupturing the friendship with God that sustained their original state of perfect holiness.&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- This choice has long-term consequences, affecting the state of all of their descendants (ie. they will be born in this broken state, lacking what Adam lost).&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- The Fall is also considered a &quot;happy fault&quot; (felix culpa), due to the gifts God continually bestows upon us - despite our broken nature - ultimately culminating in sending Jesus Christ as our Redeemer.&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&lt;b&gt;Consequences of the Fall&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- God swiftly and justly judges them for their disobedience, expelling them from Eden to Earth and punishing them with suffering, toil, ignorance, and concupiscence (the inclination to sin, even after baptism).&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- The main consequence is the earning of &quot;death&quot;: the spiritual separation from God, with bodily death also entering human history (as well as the risk of permanent &quot;death&quot; in the Hereafter).&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- This is why we can&#39;t &quot;save&quot; ourselves: there is no act of righteousness nor act of repentance that we can do to fully redeem ourselves from our sins.&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- Finite, limited creatures can&#39;t fully satisfy an offense against an infinite God.&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- This is why God gifted us with Jesus Christ - a redemption we didn&#39;t deserve - a &quot;second Adam&quot; who perfectly fulfilled God&#39;s covenants (unlike the first Adam) and defeated death (the consequence of Adam&#39;s sin) by means of his resurrection.&lt;/font&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=top;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;" parent="jy06Roj5z7HLByKl-m8C-1" vertex="1">
          <mxGeometry width="405" height="295" as="geometry">
            <mxRectangle width="405" height="295" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="jy06Roj5z7HLByKl-m8C-3" value="&lt;div&gt;&lt;font style=&quot;font-size: 9px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Adam slipped in his obedience to God, immediately repented, and was forgiven by God; an experience meant to teach him - and all mankind - of what his relationship with God is, what his purpose in life is, and who his enemy is&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&lt;b&gt;Adam&#39;s Slip and Forgiveness&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- God intends for mankind to be placed on Earth as vicegerents (ie. caretakers, representatives of God).&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- The angels question this, mentioning that they already worship God perfectly while mankind will only cause corruption - to which God replies that he knows something they don&#39;t know.&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- God then created Adam with honor, innocence, and a natural inclination to God (ie. the &lt;i&gt;fitrah&lt;/i&gt;) - teaching him the names of all things and placing him in a blissful garden.&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- All of creation was subjugated to them, including the angels - except for Satan, who was arrogant and racially envious of how God honored Adam.&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- They were given one commandment - to not eat from a particular tree - and a warning that Satan was their enemy, yet they slipped in their obedience to God by Satan&#39;s temptation and willingly ate from the tree.&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- Satan lied to them, marketing the tree as the tree of life that would grant them an eternal kingdom.&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- They were remorseful, and God taught them how to seek repentance - to which they sincerely repented to God.&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&lt;b&gt;Consequences of the Slip&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- God accepted their repentance and forgave them - for God is the Oft-Forgiving, the All-Merciful.&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- Their mistake is described as a &quot;slip&quot; for this reason: they were in perfect obedience to God for some time, momentarily broke that obedience, and upon realizing, sought repentance and God&#39;s forgiveness.&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- This is what the angels neglected to see - mankind&#39;s positive attributes and willful inclination towards God.&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- God then informs them of His plan: for them to live temporarily on Earth - where it was already prepared for them, rich with blessings from a bountiful Lord - in which they will be tested in their actions for their ultimate fate.&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- Those who resist Satan&#39;s temptation, love and worship God alone, and pursue truth and righteousness will enter a blissful Paradise by His mercy and earning His two-sided love; and those who disbelieve and succumb to his temptation will be admitted into Hell - a wicked destination.&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- This is why every Prophet and Messenger came with the same message: to worship God alone, pursue truth and righteousness, and to abstain from the corruptions that were prevalent at their times.&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;- This is what &quot;Islam&quot; and &quot;Muslim&quot; mean: to willingly submit to God&#39;s will against one&#39;s own desires - to resist worldly temptation and to have faith in God and the hereafter and to do good works.&lt;/font&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCE5FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;" parent="jy06Roj5z7HLByKl-m8C-1" vertex="1">
          <mxGeometry x="405" width="405" height="295" as="geometry">
            <mxRectangle width="405" height="295" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="hrkE1YlLufl5ihLmMU30-0" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" parent="jy06Roj5z7HLByKl-m8C-0" vertex="1">
          <mxGeometry y="295" width="810" height="80" as="geometry" />
        </mxCell>
        <mxCell id="hrkE1YlLufl5ihLmMU30-1" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;b style=&quot;font-size: 9px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;Examples&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&amp;nbsp;- The creation of Adam and Eve (Genesis 1:26-31; 2:7-25).&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&amp;nbsp;- God&#39;s command to Adam, the serpent&#39;s temptation, and their disobedience (Genesis 2:16-17; 3:1-6).&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&amp;nbsp;- Adam and Eve&#39;s excuses, God&#39;s judgement, and their expulsion from the garden (Genesis 3:7-25).&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&amp;nbsp;- &quot;For there is no one who does not sin.&quot; (1 Kings 8:46, 2 Chronicles 6:36)&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&amp;nbsp;- &quot;Surely I was sinful at birth / sinful from the time my mother conceived me.&quot; (Psalm 51:5)&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&amp;nbsp;- &quot;Know that a person is not justified by the works of the law, but by faith in Jesus Christ.&quot; (Galatians 2:16)&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=top;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;align=left;" parent="hrkE1YlLufl5ihLmMU30-0" vertex="1">
          <mxGeometry width="405" height="80" as="geometry">
            <mxRectangle width="405" height="80" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="hrkE1YlLufl5ihLmMU30-2" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;b style=&quot;font-size: 9px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;Examples&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 2px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&amp;nbsp;- God&#39;s purpose of mankind on Earth, the angels&#39; question, and teaching Adam the names (Quran 2:30-33).&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&amp;nbsp;- God honoring mankind and subjugating the angels (Quran 2:34, 17:70, 20:116, 49:13).&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&amp;nbsp;- Satan&#39;s arrogance, temptation, and God&#39;s warning (Quran 2:34-36, 7:12-18,20-22, 18:50, 20:117,120).&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&amp;nbsp;- Adam&#39;s slip, repentance, and God&#39;s response in teaching &amp;amp; forgiveness (Quran 2:36-69, 7:22-27, 20:117-124).&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&amp;nbsp;- &quot;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px;&quot;&gt;We have indeed made whatever is on earth as an adornment ...&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 8px; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;˹He is the One˺ Who created death and life in order to test which of you is best in deeds. And He is the Almighty, All-Forgiving.&quot; (Quran 18:7, 67:2)&lt;/span&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCE5FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;verticalAlign=top;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;align=left;" parent="hrkE1YlLufl5ihLmMU30-0" vertex="1">
          <mxGeometry x="405" width="405" height="80" as="geometry">
            <mxRectangle width="405" height="80" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="XDnQNUXUmKr4uib3tcu8-0" value="&lt;b&gt;3. What is the source of the fundamental, theological difference in soteriology?&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=18;fillColor=#FFF2CC;gradientColor=#FFD966;strokeColor=#D6B656;" vertex="1" parent="O9XxhuduouKi74YElKZB-1">
          <mxGeometry width="810.0000000000001" height="44.9999999999999" as="geometry" />
        </mxCell>
