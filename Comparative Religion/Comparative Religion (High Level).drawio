        <mxCell id="ev5vojVGDBCjoDU-CP_1-36" parent="j_oFuNdxFaeKGMjj7mMN-1" style="shape=table;startSize=0;container=1;collapsible=0;childLayout=tableLayout;fontSize=1;" value="" vertex="1">
          <mxGeometry height="45" width="735" x="95" y="10390" as="geometry" />
        </mxCell>
        <mxCell id="ev5vojVGDBCjoDU-CP_1-37" parent="ev5vojVGDBCjoDU-CP_1-36" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;swimlaneFillColor=none;" vertex="1">
          <mxGeometry height="45" width="735" as="geometry" />
        </mxCell>
        <mxCell id="ev5vojVGDBCjoDU-CP_1-38" parent="ev5vojVGDBCjoDU-CP_1-37" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#E6E6E6;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=middle;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;swimlaneFillColor=none;gradientColor=none;gradientDirection=east;align=center;" value="&lt;span style=&quot;font-size: 11px;&quot;&gt;&lt;b&gt;Origin of&lt;br&gt;Religion&#39;s Name&lt;/b&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="45" width="105" as="geometry">
            <mxRectangle height="45" width="105" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ev5vojVGDBCjoDU-CP_1-39" parent="ev5vojVGDBCjoDU-CP_1-37" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCFFCC;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=middle;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;swimlaneFillColor=none;gradientColor=none;gradientDirection=east;align=left;" value="&lt;span style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;b style=&quot;font-size: 8px;&quot;&gt;&quot;Christian&quot; originates from early followers of Jesus being called so by outsiders in Antioch&lt;/b&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;, emphasizing Christ as the focal point of salvation and idenity&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- &lt;b&gt;Jesus Christ practiced Judaism religiously, correcting it from its corrupt implementation and completing the faith with the New Covenant&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="45" width="315" x="105" as="geometry">
            <mxRectangle height="45" width="315" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ev5vojVGDBCjoDU-CP_1-40" parent="ev5vojVGDBCjoDU-CP_1-37" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#CCE5FF;top=1;left=1;bottom=1;right=1;pointerEvents=1;fontSize=1;strokeWidth=1;verticalAlign=middle;fontColor=#000000;spacing=2;spacingLeft=1;spacingRight=1;spacingBottom=0;spacingTop=-2;swimlaneFillColor=none;gradientColor=none;gradientDirection=east;align=left;" value="&lt;span style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;- &lt;b&gt;&quot;Islam&quot; (ie. willful submission) is what God names His religion in the Quran&lt;/b&gt;, which is the covenant God ordained for all mankind (from Adam to now)&lt;/span&gt;&lt;div&gt;&lt;b style=&quot;font-size: 8px;&quot;&gt;&amp;nbsp;&lt;/b&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;- &lt;b&gt;All previous Prophets and Messengers were &quot;Muslim&quot;&lt;/b&gt;: they submitted their will to God&#39;s will, and worshipped Him alone (even if their respective laws differed)&lt;/span&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="45" width="315" x="420" as="geometry">
            <mxRectangle height="45" width="315" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ev5vojVGDBCjoDU-CP_1-41" parent="j_oFuNdxFaeKGMjj7mMN-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=default;" value="" vertex="1">
