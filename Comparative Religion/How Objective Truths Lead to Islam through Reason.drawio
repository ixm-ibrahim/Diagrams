        <UserObject label="&lt;span style=&quot;font-size: 12px;&quot;&gt;Understanding is an internal model of reality.&lt;/span&gt;" link="data:page/id,ktynhSzzUmXId41NQhS_" id="iJ3tdISiJrQzXHI7dPVi-1">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFDEC9;gradientColor=#FFB663;strokeColor=#D69555;strokeWidth=2;fontSize=1;" parent="uaGaVBngoMjA7IRcVmLT-1" vertex="1">
            <mxGeometry x="460" y="340" width="250" height="50" as="geometry" />
