        <mxCell id="7jwuDECKpDgqieylm1P--256" value="The soundness/truthfulness of an axiom is shown through the consistency of the system that follows it, while&amp;nbsp;an untrue or false axiom is one leads to inconsistent or contradictory deductions" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="-5140" y="-1570" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--257" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.75;entryY=0;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;labelBackgroundColor=none;fontColor=default;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--219" target="7jwuDECKpDgqieylm1P--256">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-4690" y="-1600" as="sourcePoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--258" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.75;entryY=0;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;labelBackgroundColor=none;fontColor=default;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--260" target="7jwuDECKpDgqieylm1P--210">
          <mxGeometry relative="1" as="geometry">
