        <UserObject label="&lt;b style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 32px;&quot;&gt;How Objective Truths Lead to Islam Through Reason&lt;br&gt;&lt;/span&gt;&lt;font style=&quot;font-size: 4px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;i style=&quot;font-size: 12px;&quot;&gt;&lt;font style=&quot;font-size: 18px; color: rgb(102, 102, 102);&quot;&gt;Language and Education (Node 1)&lt;/font&gt;&lt;/i&gt;&lt;/b&gt;" link="data:page/id,q1TZ7uQ2KXKU_8ORelwv" id="uaGaVBngoMjA7IRcVmLT-2">
