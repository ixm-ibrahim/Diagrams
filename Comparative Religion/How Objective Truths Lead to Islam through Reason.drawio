        <mxCell id="7jwuDECKpDgqieylm1P--177" value="Language is simply a dynamic communication protocol for sharing models of mutual experiences" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" parent="1" vertex="1">
