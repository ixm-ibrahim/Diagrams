        <UserObject label="&lt;span style=&quot;font-size: 12px;&quot;&gt;A contradiction is a statement that can&#39;t be simultaneously true with another.&lt;/span&gt;" link="data:page/id,UETkfCh4AJosU-Qw8zd5" id="W3f5UINCB4utkoovJ-PE-19">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;gradientColor=#b3b3b3;strokeColor=#666666;strokeWidth=2;fontSize=1;fontStyle=0" parent="mExRIxhNE1BHIPu0LiUs-1" vertex="1">
            <mxGeometry x="4500" y="4920" width="220" height="50" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;span style=&quot;font-size: 12px;&quot;&gt;Logical systems are consistent in the absence of contradictions.&lt;/span&gt;" link="data:page/id,UETkfCh4AJosU-Qw8zd5" id="W3f5UINCB4utkoovJ-PE-21">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;gradientColor=#b3b3b3;strokeColor=#666666;strokeWidth=2;fontSize=1;fontStyle=0" parent="mExRIxhNE1BHIPu0LiUs-1" vertex="1">
