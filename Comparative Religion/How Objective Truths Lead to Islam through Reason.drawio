        <mxCell id="7jwuDECKpDgqieylm1P--207" value="To experience reality is for reality to transmit information that our senses recieve" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1">
          <mxGeometry x="2120" y="-2000" width="240" height="60" as="geometry" />
