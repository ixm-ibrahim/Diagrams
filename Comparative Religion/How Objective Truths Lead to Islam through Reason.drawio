        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--1048" value="The Problem of Evil" style="rounded=0;whiteSpace=wrap;html=1;opacity=50;fillColor=#9933FF;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;glass=0;shadow=0;fontSize=18;fontStyle=1" vertex="1" parent="7jwuDECKpDgqieylm1P--1027">
          <mxGeometry x="40" y="760" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--1049" value="We don&#39;t deserve anything (God could have chosen to give all of us more pain than we already experience), and so it&#39;s a part of His mercy to grant us pleasure or relief at all" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="-2200" y="5220" width="360" height="90" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--1050" value="Why can&#39;t God hate us and want us to feel pain? because he didn&#39;t put us in hell from the start and he could have, if His goal was to make us feel pain&lt;br&gt;every breath we take, cell that functions, etc." style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="-2200" y="5330" width="360" height="90" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--1051" value="Considering that most religions advocate for a hypersensual afterlife in which we either experience a paradise or hell, this introduces another iteration of the Problem of Evil: why would a benevolent and just God create Hell, an existence in which its primary purpose is to cause eternal suffering?&amp;nbsp;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="-2200" y="5450" width="360" height="100" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--1052" value="Our desires could be as little as wanting to eat an apple or disliking a scratch or as big as enduring significant pain or desiring to survive in the face of death: without an objective source of morality, it is unsound to attach morality to any desire such that we can claim that we deserve any good or claim that any desire we may have are good or bad&amp;nbsp;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;arcSize=10;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="-2470" y="2570" width="320" height="110" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--1053" value="Relationship between emotion and logic: there are hidden contradictions between our emotions and reality on some level" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="380" y="-1480" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--1054" value="why? because your desires in this life are not God&#39;s priority, rather your choice to choose success" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="-5680" y="-2042" width="540" height="30" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--1055" value="your inability to choose success is not God&#39;s fault for determining that for you, but your utilization of your free will" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="-5680" y="-2012" width="620" height="30" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--1056" value="utilization of free will is chosen to be determined by desires" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="-5540" y="-1985" width="340" height="30" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--1057" value="purpose is to overcome our desires: pain or pleasure" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="-5520" y="-1960" width="300" height="30" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--1058" value="axiom that freedom is the purpose, not submission" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="-5515" y="-1940" width="290" height="30" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--1059" value="need to restructure the chart with the technical terms, common terms, examples, and Quran references: goal is to word it for atheist, theist, and muslim audiences" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="-5810" y="-1920" width="880" height="30" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--1060" value="most of the work is for the edge cases" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="-5485" y="-1895" width="230" height="30" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--1061" value="start with base information that can be known&lt;div&gt;&lt;br/&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="-5500" y="-1880" width="260" height="40" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--1062" value="&lt;div&gt;randomness is just our inability to identify a pattern or to predict the future with precision&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="-5615" y="-1860" width="490" height="30" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--1063" value="&lt;div&gt;we don&#39;t learn new words in a vacuum, but rather we encounter what we don&#39;t know first and use what we do know to define them&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="-5680" y="-2122" width="710" height="30" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--1064" value="&lt;div&gt;it&#39;s your own fault if you go to hell, knowing all you do and still choosing to do oltherwise&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="-5830" y="-1830" width="490" height="30" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--1065" value="&lt;div&gt;seen vs unseen is the same as dunning-kruger effect where we think we have enough to know what&#39;s going on&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="-5930" y="-1800" width="610" height="30" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--1066" value="&lt;div&gt;math vs physics example is more intuitive as writing vs reality&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="-5800" y="-1760" width="350" height="30" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--1067" value="&lt;div&gt;saying that all things must have a start is no different than saying the sun must rise the next day or that physics equations are real&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="-5980" y="-1720" width="710" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
