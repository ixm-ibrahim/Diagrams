          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;gradientColor=#ffd966;strokeColor=#d6b656;strokeWidth=2;fontSize=1;" parent="xCnwdoKPpG8b0vwkaMOA-1" vertex="1">
