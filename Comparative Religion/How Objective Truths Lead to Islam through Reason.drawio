        </UserObject>
        <mxCell id="FNOzr5G4gKBUT3OswJa5-13" style="edgeStyle=elbowEdgeStyle;shape=connector;curved=0;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=default;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;dashed=1;" edge="1" parent="FNOzr5G4gKBUT3OswJa5-1" source="FNOzr5G4gKBUT3OswJa5-15" target="FNOzr5G4gKBUT3OswJa5-18">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="585" y="320" as="sourcePoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="FNOzr5G4gKBUT3OswJa5-14" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;div style=&quot;font-size: 11px;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;b&gt;Notes&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 11px; text-align: left;&quot;&gt;&lt;ul style=&quot;padding-left: 20px; margin-top: 4px;&quot;&gt;&lt;li&gt;This node introduces &quot;understanding&quot; as how &quot;information&quot; (the content of our experiences) is processed&lt;/li&gt;&lt;ul style=&quot;padding-left: 20px; margin-left: 0px; margin-bottom: 4px;&quot;&gt;&lt;li&gt;&lt;font style=&quot;color: light-dark(rgb(77, 77, 77), rgb(171, 171, 171));&quot;&gt;&lt;b&gt;Information&lt;/b&gt;: the content of our experiences&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;color: light-dark(rgb(77, 77, 77), rgb(171, 171, 171));&quot;&gt;&lt;b&gt;Understanding&lt;/b&gt;: an internal model of reality&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;color: light-dark(rgb(77, 77, 77), rgb(171, 171, 171));&quot;&gt;The content of our experiences builds an internal model of reality&lt;/font&gt;&lt;/li&gt;&lt;ul style=&quot;padding-left: 20px; margin-bottom: 4px;&quot;&gt;&lt;li&gt;&lt;font style=&quot;color: light-dark(rgb(77, 77, 77), rgb(171, 171, 171));&quot;&gt;Just like how a map models (and is judged by how well it represents) the terrain, our understanding models (and can be judged by how well it reflects) reality&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;li&gt;Every node in this chart is a model of reality, simulated using the medium of writing&lt;/li&gt;&lt;ul style=&quot;padding-left: 20px; margin-bottom: 4px;&quot;&gt;&lt;li&gt;&lt;span style=&quot;color: light-dark(rgb(77, 77, 77), rgb(171, 171, 171)); background-color: transparent;&quot;&gt;Information could be perfectly preserved or be corrupted or faulty, or come from a deterministic source or a non-deterministic one, or even a random source or a willful one&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;div&gt;&lt;font color=&quot;#4d4d4d&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=1;labelBackgroundColor=none;align=left;fillColor=#e6d0de;gradientColor=#d5739d;strokeColor=#996185;gradientDirection=north;verticalAlign=top;" vertex="1" parent="FNOzr5G4gKBUT3OswJa5-1">
