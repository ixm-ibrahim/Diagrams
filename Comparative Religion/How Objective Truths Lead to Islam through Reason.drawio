        <UserObject label="&lt;span style=&quot;font-size: 12px;&quot;&gt;Truth is not falsehood.&lt;/span&gt;" link="data:page/id,s4b5a8lz5EKkWFNapb_4" id="8GN2kHdML_jIbyp9E5i6-0">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;gradientColor=#7ea6e0;strokeColor=#6c8ebf;strokeWidth=2;fontSize=1;" parent="squETe9dAdE64J5XPLQU-1" vertex="1">
