          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--153" value="Without a logical protocol for distinguishing true from false observations, our senses can&#39;t be objectively trusted - and without a protocol for identifying truth from falsehood, we can&#39;t objectively know anything" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="1280" y="-860" width="240" height="90" as="geometry" />
        </mxCell>
