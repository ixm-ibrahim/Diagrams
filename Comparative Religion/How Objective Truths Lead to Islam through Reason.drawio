          </mxCell>
        </UserObject>
        <UserObject label="&lt;font style=&quot;font-size: 14px;&quot;&gt;An external reality exists.&lt;/font&gt;" link="data:page/id,nwnlQaXgrGs-5OhVyxBg" id="X--VHpJq4IpHabeX2C67-11">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;gradientColor=#7ea6e0;strokeColor=#6c8ebf;strokeWidth=2;fontSize=1;" vertex="1" parent="X--VHpJq4IpHabeX2C67-1">
