          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;gradientColor=#ea6b66;strokeColor=#b85450;strokeWidth=2;fontSize=1;" parent="VRDFq0wFc6pFJHJ383-H-1" vertex="1">
