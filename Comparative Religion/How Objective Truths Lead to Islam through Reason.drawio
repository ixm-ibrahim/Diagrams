        <UserObject label="&lt;font style=&quot;font-size: 14px;&quot;&gt;We exist.&lt;/font&gt;" link="data:page/id,mfmMcbX07sLiCTksEZJi" id="X--VHpJq4IpHabeX2C67-10">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;gradientColor=#97d077;strokeColor=#82b366;strokeWidth=2;fontSize=1;" vertex="1" parent="X--VHpJq4IpHabeX2C67-1">
