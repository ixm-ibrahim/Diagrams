        <mxCell id="X--VHpJq4IpHabeX2C67-5" value="&lt;span style=&quot;font-size: 12px;&quot;&gt;This node is not derived rationally nor caused by reason. It can only be known by experience: it either occurs, or it does not.&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;gradientColor=#ea6b66;strokeColor=#b85450;strokeWidth=2;fontSize=1;" vertex="1" parent="X--VHpJq4IpHabeX2C67-1">
          <mxGeometry x="460" y="240" width="250" height="60" as="geometry" />
        </mxCell>
        <mxCell id="X--VHpJq4IpHabeX2C67-6" style="edgeStyle=elbowEdgeStyle;shape=connector;curved=0;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=default;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" edge="1" parent="X--VHpJq4IpHabeX2C67-1" source="X--VHpJq4IpHabeX2C67-3" target="X--VHpJq4IpHabeX2C67-14">
