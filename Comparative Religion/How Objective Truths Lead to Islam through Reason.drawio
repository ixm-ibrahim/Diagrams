          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;gradientColor=#ea6b66;strokeColor=#b85450;strokeWidth=2;fontSize=1;" parent="xCnwdoKPpG8b0vwkaMOA-1" vertex="1">
