          </mxCell>
        </UserObject>
        <mxCell id="W3f5UINCB4utkoovJ-PE-31" value="change does not include the context of reality... it&#39;s subjective!" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;" parent="mExRIxhNE1BHIPu0LiUs-1" vertex="1">
          <mxGeometry x="5950" y="3730" width="320" height="30" as="geometry" />
        </mxCell>
        <mxCell id="W3f5UINCB4utkoovJ-PE-32" value="A tool is verified when repeated tests show the same outside cause‑class yields the same sensed effect‑class." style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;" parent="mExRIxhNE1BHIPu0LiUs-1" vertex="1">
          <mxGeometry x="3240" y="4390" width="560" height="30" as="geometry" />
        </mxCell>
        <mxCell id="W3f5UINCB4utkoovJ-PE-33" value="patterns -&amp;gt; cause-effect? see deduction?" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;" parent="mExRIxhNE1BHIPu0LiUs-1" vertex="1">
          <mxGeometry x="3420" y="4410" width="220" height="30" as="geometry" />
        </mxCell>
        <mxCell id="W3f5UINCB4utkoovJ-PE-34" value="extending cause/effect into the unseen?" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;" parent="mExRIxhNE1BHIPu0LiUs-1" vertex="1">
          <mxGeometry x="4610" y="4478" width="220" height="30" as="geometry" />
        </mxCell>
        <UserObject label="&lt;span style=&quot;font-size: 12px;&quot;&gt;Universe changes???&lt;/span&gt;" link="data:page/id,UETkfCh4AJosU-Qw8zd5" id="W3f5UINCB4utkoovJ-PE-35">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;gradientColor=#b3b3b3;strokeColor=#666666;strokeWidth=2;fontSize=1;" parent="mExRIxhNE1BHIPu0LiUs-1" vertex="1">
            <mxGeometry x="3300" y="3440" width="220" height="50" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;span style=&quot;font-size: 12px;&quot;&gt;A change is the difference between no experience to experience? universe must change though...&lt;/span&gt;" link="data:page/id,UETkfCh4AJosU-Qw8zd5" id="CDvdlmPpTb5dEFEhMw8z-2">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;gradientColor=#b3b3b3;strokeColor=#666666;strokeWidth=2;fontSize=1;" parent="mExRIxhNE1BHIPu0LiUs-1" vertex="1">
            <mxGeometry x="3300" y="3500" width="220" height="50" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="CDvdlmPpTb5dEFEhMw8z-4" value="isn&#39;t my conditional induction assuming determisim? or is that inherent in the diagram?&lt;br&gt;like, why should redefining it to be &quot;when under the same context, the same things [will?] happen&quot; avoid the inductive leap?&lt;br&gt;isn&#39;t this presuming the principle of continuity?" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;" parent="mExRIxhNE1BHIPu0LiUs-1" vertex="1">
          <mxGeometry x="3080" y="4482" width="620" height="50" as="geometry" />
        </mxCell>
        <mxCell id="CDvdlmPpTb5dEFEhMw8z-5" value="because conditional induction is an accumulator: &lt;i&gt;&quot;when&lt;/i&gt;&amp;nbsp;it happens again, put it here&quot;, &lt;br&gt;not &quot;under the same conditions, this will happen again&quot;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;" parent="mExRIxhNE1BHIPu0LiUs-1" vertex="1">
          <mxGeometry x="3150" y="4527" width="440" height="40" as="geometry" />
        </mxCell>
        <mxCell id="cfRl_2op0VhH2dwHVONc-4" value="conditional induction addresses &quot;what happened?&quot; not &quot;what will certainly happen&quot;?" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;" parent="mExRIxhNE1BHIPu0LiUs-1" vertex="1">
          <mxGeometry x="3115" y="4570" width="430" height="30" as="geometry" />
        </mxCell>
        <mxCell id="cfRl_2op0VhH2dwHVONc-5" value="but don&#39;t both require the assumption that the same conditions have the same effects? where does this come from?" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;" parent="mExRIxhNE1BHIPu0LiUs-1" vertex="1">
          <mxGeometry x="3070" y="4600" width="580" height="30" as="geometry" />
        </mxCell>
        <mxCell id="cfRl_2op0VhH2dwHVONc-6" value="correlation: independent statements that have the same cause" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;" parent="mExRIxhNE1BHIPu0LiUs-1" vertex="1">
          <mxGeometry x="2000" y="4540" width="330" height="30" as="geometry" />
        </mxCell>
        <mxCell id="cfRl_2op0VhH2dwHVONc-7" value="before you know anything to be true, you need to ascertain the context first" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;" parent="mExRIxhNE1BHIPu0LiUs-1" vertex="1">
          <mxGeometry x="1910" y="4490" width="390" height="30" as="geometry" />
        </mxCell>
        <mxCell id="L-9aJI6RIaADPnCfDK0R-29" style="edgeStyle=elbowEdgeStyle;shape=connector;curved=0;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=default;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" parent="mExRIxhNE1BHIPu0LiUs-1" source="qXkxFjZwGKXk9LkzhMa4-0" target="L-9aJI6RIaADPnCfDK0R-27" edge="1">
          <mxGeometry relative="1" as="geometry" />
