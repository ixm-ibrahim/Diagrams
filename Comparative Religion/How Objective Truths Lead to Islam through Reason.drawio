        <mxCell id="hU9yVLdhYgLbUcQZa_KH-3" value="&lt;b style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 32px;&quot;&gt;How Objective Truths Lead to Islam Through Reason&lt;br&gt;&lt;/span&gt;&lt;font style=&quot;font-size: 4px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;i style=&quot;font-size: 12px;&quot;&gt;&lt;font style=&quot;font-size: 18px; color: rgb(102, 102, 102);&quot;&gt;Proving Existence (Node 1)&lt;/font&gt;&lt;/i&gt;&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6d0de;strokeColor=#996185;gradientColor=#d5739d;fontSize=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="40" width="1010" height="110" as="geometry" />
        </mxCell>
        <mxCell id="hU9yVLdhYgLbUcQZa_KH-4" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;We exist.&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;More formally: if sensations occur, and not&lt;br&gt;existing necessarily requires sensations&lt;br&gt;to never occur, then we must exist.&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;size=30;fillColor=#b0e3e6;strokeColor=#0e8088;fontSize=1;strokeWidth=2;" vertex="1" parent="1">
