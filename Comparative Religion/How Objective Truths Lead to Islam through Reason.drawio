        <mxCell id="7jwuDECKpDgqieylm1P--231" value="The mind/intellect processes the data received by the senses and creates understanding: a labelled model of reality" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
