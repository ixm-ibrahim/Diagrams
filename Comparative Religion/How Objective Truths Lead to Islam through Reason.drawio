      <root>
        <mxCell id="FNOzr5G4gKBUT3OswJa5-0" />
        <mxCell id="FNOzr5G4gKBUT3OswJa5-1" parent="FNOzr5G4gKBUT3OswJa5-0" />
        <UserObject label="&lt;b style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 32px;&quot;&gt;How Objective Truths Lead to Islam Through Reason&lt;br&gt;&lt;/span&gt;&lt;font style=&quot;font-size: 4px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/b&gt;&lt;b&gt;&lt;i style=&quot;font-size: 12px;&quot;&gt;&lt;font style=&quot;font-size: 18px; color: rgb(102, 102, 102);&quot;&gt;Understanding&amp;nbsp;&lt;/font&gt;&lt;/i&gt;&lt;/b&gt;&lt;b style=&quot;&quot;&gt;&lt;i style=&quot;font-size: 12px;&quot;&gt;&lt;font style=&quot;font-size: 18px; color: rgb(102, 102, 102);&quot;&gt;and Information (Node 4)&lt;/font&gt;&lt;/i&gt;&lt;/b&gt;" link="data:page/id,q1TZ7uQ2KXKU_8ORelwv" id="FNOzr5G4gKBUT3OswJa5-2">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6d0de;strokeColor=#996185;gradientColor=#d5739d;fontSize=1;" vertex="1" parent="FNOzr5G4gKBUT3OswJa5-1">
            <mxGeometry x="80" y="40" width="1010" height="110" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="FNOzr5G4gKBUT3OswJa5-3" style="edgeStyle=elbowEdgeStyle;shape=connector;curved=0;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=default;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" edge="1" parent="FNOzr5G4gKBUT3OswJa5-1" source="FNOzr5G4gKBUT3OswJa5-5" target="FNOzr5G4gKBUT3OswJa5-10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="FNOzr5G4gKBUT3OswJa5-4" style="edgeStyle=elbowEdgeStyle;shape=connector;curved=0;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=default;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" edge="1" parent="FNOzr5G4gKBUT3OswJa5-1" source="FNOzr5G4gKBUT3OswJa5-5" target="FNOzr5G4gKBUT3OswJa5-16">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <UserObject label="&lt;span style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;Understanding can be accurate or inaccurate.&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;font style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;br&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;We label the way different pieces of information are internally organized (forming a model of the external world) as our &lt;i&gt;understanding&lt;/i&gt;. The more closely this model aligns with reality, the more accurate our understanding becomes.&lt;/span&gt;" link="data:page/id,VuEyJK-5QdxOhdqgMgJb" id="FNOzr5G4gKBUT3OswJa5-5">
          <mxCell style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;size=30;fillColor=#b0e3e6;strokeColor=#0e8088;fontSize=1;strokeWidth=2;spacing=16;" vertex="1" parent="FNOzr5G4gKBUT3OswJa5-1">
            <mxGeometry x="340" y="470" width="490" height="100" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="FNOzr5G4gKBUT3OswJa5-6" style="edgeStyle=elbowEdgeStyle;shape=connector;curved=0;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=default;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" edge="1" parent="FNOzr5G4gKBUT3OswJa5-1" source="FNOzr5G4gKBUT3OswJa5-5" target="FNOzr5G4gKBUT3OswJa5-7">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="430" y="517" as="sourcePoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="FNOzr5G4gKBUT3OswJa5-7" value="&lt;b&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Objections&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/font&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;div&gt;&lt;div style=&quot;text-align: left; padding-left: 1px; padding-right: 1px;&quot;&gt;&lt;div style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); padding-left: 1px; padding-right: 1px; display: inline !important;&quot;&gt;&lt;font style=&quot;color: rgb(77, 77, 77);&quot;&gt;&lt;b style=&quot;background-color: transparent; font-size: 11px;&quot;&gt;1.&lt;/b&gt;&lt;span style=&quot;background-color: transparent; font-size: 11px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;span style=&quot;background-color: transparent; font-size: 11px; color: light-dark(rgb(77, 77, 77), rgb(171, 171, 171));&quot;&gt;It is irrational to jump from information to understanding: it can&#39;t be proven.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;div style=&quot;background-color: transparent; margin-bottom: 1px; margin-top: 1px; padding-left: 25px; padding-right: 1px;&quot;&gt;&lt;span style=&quot;color: light-dark(rgb(51, 0, 0), rgb(255, 255, 255)); font-size: 11px; background-color: transparent;&quot;&gt;This node depends on the &lt;b&gt;sensational axioms&lt;/b&gt; and &lt;b&gt;our existence in an external reality&lt;/b&gt;&amp;nbsp;premises, which can&#39;t be rationally deduced by definition and can only be experienced (see premises). Additionally, if information (the content of our experiences) is not the external object itself, then it must be internal in some form (considering we consciously experience them). This node merely assigns a label to however those pieces of information are structured and organized.&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;div style=&quot;padding-left: 1px; padding-right: 1px;&quot;&gt;&lt;font style=&quot;color: rgb(77, 77, 77);&quot;&gt;&lt;b style=&quot;background-color: transparent; font-size: 11px;&quot;&gt;2.&lt;/b&gt;&lt;span style=&quot;background-color: transparent; font-size: 11px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;color: rgb(77, 77, 77); font-size: 11px; background-color: transparent;&quot;&gt;That internal model could be totally wrong.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: center;&quot;&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;div style=&quot;background-color: transparent; margin-bottom: 1px; margin-top: 1px; padding-left: 25px; padding-right: 1px;&quot;&gt;&lt;span style=&quot;color: rgb(51, 0, 0); font-size: 11px;&quot;&gt;Indeed, &quot;understanding&quot; can be flawed or partial - this node doesn’t guarantee accuracy. Later nodes will address true vs. false models.&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;div style=&quot;padding-left: 1px; padding-right: 1px;&quot;&gt;&lt;font style=&quot;color: rgb(77, 77, 77);&quot;&gt;&lt;b style=&quot;background-color: transparent; font-size: 11px;&quot;&gt;3.&lt;/b&gt;&lt;span style=&quot;background-color: transparent; font-size: 11px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 11px; color: light-dark(rgb(77, 77, 77), rgb(171, 171, 171));&quot;&gt;Calling it a &quot;model&quot; is too strong of an analogy: we might just have random or&amp;nbsp;chaotic mental states.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: center;&quot;&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;div style=&quot;background-color: transparent; margin-bottom: 1px; margin-top: 1px; padding-left: 25px; padding-right: 1px;&quot;&gt;&lt;span style=&quot;color: light-dark(rgb(51, 0, 0), rgb(255, 255, 255)); font-size: 11px; background-color: transparent;&quot;&gt;If we did have random or chaotic mental states (preventing us from understanding&amp;nbsp;&lt;i&gt;anything&lt;/i&gt;), we would have been incapable of identifying the premises that lead to this node to begin with. Furthermore, even if we had no internal model for some phenomenon in reality, it doesn&#39;t refute the definition this node provides: it merely reflects zero understanding.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;background-color: transparent; margin-bottom: 1px; margin-top: 1px; padding-left: 25px; padding-right: 1px;&quot;&gt;&lt;span style=&quot;color: light-dark(rgb(51, 0, 0), rgb(255, 255, 255)); font-size: 11px; background-color: transparent;&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;padding-left: 1px; padding-right: 1px;&quot;&gt;&lt;font style=&quot;color: rgb(77, 77, 77);&quot;&gt;&lt;b style=&quot;background-color: transparent; font-size: 11px;&quot;&gt;4.&lt;/b&gt;&lt;span style=&quot;background-color: transparent; font-size: 11px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 11px;&quot;&gt;&lt;font color=&quot;#4d4d4d&quot;&gt;If we define &quot;understanding&quot; as simply having an internal model that shapes behavior based on encoded information,&lt;br&gt;&amp;nbsp; &amp;nbsp; wouldn’t that imply that animals and even inanimate systems with basic feedback loops (like machines or geological&lt;br&gt;&amp;nbsp; &amp;nbsp; processes) also &quot;understand,&quot; even though we don’t&amp;nbsp;regard them as (fully) conscious?&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: center;&quot;&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;div style=&quot;background-color: transparent; margin-bottom: 1px; margin-top: 1px; padding-left: 25px; padding-right: 1px;&quot;&gt;&lt;font color=&quot;#330000&quot;&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;There’s a difference between &quot;functional&quot; understanding and &quot;conscious&quot; understanding. Consider a simple mechanical clock: its gears and springs “encode” time in a functional sense (i.e., the structure of its internal model), and its hands move to represent the passage of time (ie. the information stored internally). But does it actually understand the concept of time?&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 11px; color: rgb(51, 0, 0);&quot;&gt;Or take the Earth itself, rotating every 24 hours about the sun - does the planet consciously understand what a day is?&lt;br&gt;&lt;/span&gt;&lt;font color=&quot;#330000&quot;&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;While the common usage of “understanding” is often expanded to include deterministic or functional systems, we will use “understanding” here to refer specifically to &lt;i&gt;conscious&lt;/i&gt; understanding.&lt;/span&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;background-color: transparent; margin-bottom: 1px; margin-top: 1px; padding-left: 25px; padding-right: 1px;&quot;&gt;&lt;span style=&quot;color: light-dark(rgb(51, 0, 0), rgb(255, 255, 255)); font-size: 11px; background-color: transparent;&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;padding-left: 1px; padding-right: 1px;&quot;&gt;&lt;font style=&quot;color: rgb(77, 77, 77);&quot;&gt;&lt;b style=&quot;background-color: transparent; font-size: 11px;&quot;&gt;5.&lt;/b&gt;&lt;span style=&quot;background-color: transparent; font-size: 11px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 11px;&quot;&gt;&lt;font color=&quot;#4d4d4d&quot;&gt;But the brain’s neurons function deterministically, just like the gears in a clock. So if consciousness arises from brain&lt;br&gt;&amp;nbsp; &amp;nbsp; activity, isn’t &lt;i&gt;conscious&lt;/i&gt; understanding fundamentally just a special case of &lt;i&gt;functional&lt;/i&gt; understanding?&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: center;&quot;&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;div style=&quot;background-color: transparent; margin-bottom: 1px; margin-top: 1px; padding-left: 25px; padding-right: 1px;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 11px;&quot;&gt;&lt;font color=&quot;#330000&quot;&gt;Our knowledge of consciousness comes entirely from first-person experience, not from external observation or empirical measurement (see the &quot;&lt;b&gt;we experience an external reality&lt;/b&gt;&quot; premise).&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 11px;&quot;&gt;&lt;font color=&quot;#330000&quot;&gt;The only reason we even know consciousness exists is because we experience it ourselves, and we can&#39;t observe it directly in others (we can only infer it).&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 11px;&quot;&gt;&lt;font color=&quot;#330000&quot;&gt;As such, since animals and inanimate systems cannot communicate subjective experience, we can’t verify whether they possess consciousness or are simply reactin&lt;/font&gt;&lt;font style=&quot;color: rgb(51, 0, 0);&quot;&gt;g fu&lt;/font&gt;&lt;font color=&quot;#330000&quot;&gt;nctionally - like highly complex natural machines. In this sense, they may operate similarly to digital computers: they process information and produce behavior, but whether they are aware of doing so remains uncertain.&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;background-color: transparent; margin-bottom: 1px; margin-top: 1px; padding-left: 25px; padding-right: 1px;&quot;&gt;&lt;font style=&quot;color: rgb(51, 0, 0);&quot;&gt;&lt;font&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;This is known as the “Hard Problem of Consciousness”: while consciousness clearly correlates with brain activity and is linked to it in some way, the exact nature of that relationship remains unknown.&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 11px;&quot;&gt;&lt;font&gt;Even if we discover that functional systems (like the brain) actually create conscious understanding, we still have no explanation for&amp;nbsp;&lt;i&gt;why&lt;/i&gt;&amp;nbsp;such systems give rise to awareness, self-reflection, or the subjective feeling of understanding. As such, this is still an open question - one which would notably be easily resolved with the existence of the soul: the spiritual organ that allows for consciousness and will, interfacing directly with the brain and body (which processes intelligence, emotion, and all the sensations).&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 11px;&quot;&gt;&lt;font color=&quot;#330000&quot;&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;fontFamily=Helvetica;fontSize=1;labelBackgroundColor=none;fillColor=#f5f5f5;gradientColor=#b3b3b3;strokeColor=#666666;verticalAlign=top;size=0.043478260869565216;" vertex="1" parent="FNOzr5G4gKBUT3OswJa5-1">
          <mxGeometry x="-470" y="245" width="670" height="550" as="geometry" />
        </mxCell>
        <mxCell id="FNOzr5G4gKBUT3OswJa5-8" style="edgeStyle=elbowEdgeStyle;shape=connector;curved=0;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=default;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="FNOzr5G4gKBUT3OswJa5-1" source="FNOzr5G4gKBUT3OswJa5-5" target="FNOzr5G4gKBUT3OswJa5-20">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="740" y="517" as="sourcePoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="FNOzr5G4gKBUT3OswJa5-9" style="edgeStyle=elbowEdgeStyle;shape=connector;curved=0;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=default;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" edge="1" parent="FNOzr5G4gKBUT3OswJa5-1" source="FNOzr5G4gKBUT3OswJa5-12" target="FNOzr5G4gKBUT3OswJa5-5">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="590" y="407" as="sourcePoint" />
          </mxGeometry>
        </mxCell>
        <UserObject label="&lt;span style=&quot;font-size: 12px;&quot;&gt;We have self-awareness.&lt;/span&gt;" link="data:page/id,lB-egJEOEYA0CEClPfo6" id="FNOzr5G4gKBUT3OswJa5-10">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;gradientColor=#97d077;strokeColor=#82b366;strokeWidth=2;fontSize=1;" vertex="1" parent="FNOzr5G4gKBUT3OswJa5-1">
