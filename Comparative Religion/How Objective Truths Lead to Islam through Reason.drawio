        <mxCell id="7jwuDECKpDgqieylm1P--180" value="If the protocols differ or there is no shared experience, communication is impossible" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" parent="1" vertex="1">
