        <mxCell id="7jwuDECKpDgqieylm1P--185" value="Consistent reinforcement leads to pattern recognition: the more consistent reinforcement, the stronger the pattern&amp;nbsp;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" parent="1" vertex="1">
          <mxGeometry x="3450" y="-1680" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--186" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=none;fontColor=default;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" parent="1" source="7jwuDECKpDgqieylm1P--187" target="7jwuDECKpDgqieylm1P--188" edge="1">
