        </mxCell>
        <mxCell id="uHxNGxETZ01MsBiVxSH5-3" value="1. Gain enough empirical observations&lt;br&gt;2. Label those observations&lt;br&gt;3. Identify patterns of those observations&lt;br&gt;4. Classify patterns" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;" vertex="1" parent="mExRIxhNE1BHIPu0LiUs-1">
