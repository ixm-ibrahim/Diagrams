          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;gradientColor=#97d077;strokeColor=#82b366;strokeWidth=2;fontSize=1;" vertex="1" parent="gV_TXRiq1vcrWP1O0eZQ-1">
