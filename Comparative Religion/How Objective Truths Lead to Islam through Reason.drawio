        <UserObject label="&lt;span style=&quot;font-size: 12px;&quot;&gt;Information is not the external object itself.&lt;/span&gt;" link="data:page/id,toKE8OkaYsqcUdhYVe8k" id="FNOzr5G4gKBUT3OswJa5-12">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFDEC9;gradientColor=#FFB663;strokeColor=#D69555;strokeWidth=2;fontSize=1;" vertex="1" parent="FNOzr5G4gKBUT3OswJa5-1">
