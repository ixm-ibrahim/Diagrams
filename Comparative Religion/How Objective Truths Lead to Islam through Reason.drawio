        <mxCell id="7jwuDECKpDgqieylm1P--214" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=none;fontColor=default;" parent="1" source="7jwuDECKpDgqieylm1P--215" target="7jwuDECKpDgqieylm1P--222" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--215" value="Sensory input is a proof of existence: no sensual agent can logically doubt their own existence while they experience pleasure, pain, or some other sensation" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" parent="1" vertex="1">
          <mxGeometry x="2660" y="-910" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--216" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.25;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=none;fontColor=default;" parent="1" source="7jwuDECKpDgqieylm1P--217" target="7jwuDECKpDgqieylm1P--256" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--217" value="&lt;b&gt;Consistency&lt;/b&gt;: a set of statements are consistent if there is no statement such that both the statement and its negation are provable from the whole system, otherwise it&#39;s inconsistent - aka free from contradiction" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="-5230" y="-1680" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--218" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=none;fontColor=default;" parent="1" source="7jwuDECKpDgqieylm1P--219" target="7jwuDECKpDgqieylm1P--210" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--219" value="An &lt;b&gt;axiom &lt;/b&gt;(or postulate) is a fundamental principle that serves as a starting point for a logical or mathematical system" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="-4870" y="-1680" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--220" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=none;fontColor=default;" parent="1" source="7jwuDECKpDgqieylm1P--221" target="7jwuDECKpDgqieylm1P--391" edge="1">
