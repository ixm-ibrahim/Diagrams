        <mxCell id="uaGaVBngoMjA7IRcVmLT-3" style="edgeStyle=elbowEdgeStyle;shape=connector;curved=0;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=default;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" parent="uaGaVBngoMjA7IRcVmLT-1" source="uaGaVBngoMjA7IRcVmLT-4" target="uaGaVBngoMjA7IRcVmLT-10" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <UserObject label="&lt;span style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;Language is an external model of understanding.&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;font style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;br&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;We represent our understanding with &lt;i&gt;language&lt;/i&gt;&amp;nbsp;through external mediums (ex. spoken words, written text, images, computational simulations, etc.). These representations,&lt;br&gt;in turn, become new pieces of information for us to understand.&lt;/span&gt;" link="data:page/id,fF29h9r9_Ag0Hfm531MF" id="uaGaVBngoMjA7IRcVmLT-4">
          <mxCell style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;size=30;fillColor=#b0e3e6;strokeColor=#0e8088;fontSize=1;strokeWidth=2;spacing=16;" parent="uaGaVBngoMjA7IRcVmLT-1" vertex="1">
            <mxGeometry x="330" y="450" width="510" height="100" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="uaGaVBngoMjA7IRcVmLT-5" style="edgeStyle=elbowEdgeStyle;shape=connector;curved=0;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=default;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" parent="uaGaVBngoMjA7IRcVmLT-1" source="uaGaVBngoMjA7IRcVmLT-4" target="uaGaVBngoMjA7IRcVmLT-6" edge="1">
