        <UserObject label="&lt;font style=&quot;font-size: 12px;&quot;&gt;Physical sensations occur.&lt;/font&gt;" link="data:page/id,YQBf6YmFWLRNtrCXEbi-" id="VyjisshgyECK9-Sqm5kk-5">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;gradientColor=#ea6b66;strokeColor=#b85450;strokeWidth=2;fontSize=1;" vertex="1" parent="VyjisshgyECK9-Sqm5kk-1">
