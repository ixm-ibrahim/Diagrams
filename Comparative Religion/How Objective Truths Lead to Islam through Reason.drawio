        <mxCell id="7jwuDECKpDgqieylm1P--230" style="rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.014;exitY=0.963;exitDx=0;exitDy=0;entryX=0.987;entryY=0.027;entryDx=0;entryDy=0;dashed=1;dashPattern=12 12;exitPerimeter=0;entryPerimeter=0;startArrow=oval;startFill=1;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--231" target="7jwuDECKpDgqieylm1P--552">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--231" value="The mind/intellect processes the data received by the senses and creates understanding: a labelled model of reality" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="2120" y="-1800" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--232" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=none;fontColor=default;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--234" target="7jwuDECKpDgqieylm1P--236">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3200" y="290" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--233" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=none;fontColor=default;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--234" target="7jwuDECKpDgqieylm1P--335">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--234" value="Our understanding is limited by the intellect&#39;s capacity to generate complex models, how much we already understand, and how much we&#39;re willing to accept what we wish to understand" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1840" y="-1460" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--235" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.75;entryY=0;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;labelBackgroundColor=none;fontColor=default;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--236" target="7jwuDECKpDgqieylm1P--776">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1810" y="-670" as="sourcePoint" />
            <mxPoint x="1800.000000000001" y="-590" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--236" value="If our understanding is immature (lacks education) or incorrect (not sound), the communication will be flawed" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="1910" y="-1230" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--237" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.25;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=none;fontColor=default;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--239" target="7jwuDECKpDgqieylm1P--240">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--238" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;labelBackgroundColor=none;fontColor=default;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--239" target="7jwuDECKpDgqieylm1P--368">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--239" value="&lt;b&gt;Belief &lt;/b&gt;is the choice to accept a certain understanding/model" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="540" y="-1680" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--240" value="A sound belief is one that is aligned with reality&lt;br&gt;(true positive/false negative)" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="610" y="-1560" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--241" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=none;fontColor=default;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--776" target="7jwuDECKpDgqieylm1P--378">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--242" style="rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--776" target="7jwuDECKpDgqieylm1P--515">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--243" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=none;fontColor=default;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--244" target="7jwuDECKpDgqieylm1P--301">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--244" value="If sensory input is a proof for existence and a prerequisite for language, then sensory input is a means of communicating another&#39;s own existence to themselves" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="2660" y="-800" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--245" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=none;fontColor=default;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--248" target="7jwuDECKpDgqieylm1P--298">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--246" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=none;fontColor=default;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--248" target="7jwuDECKpDgqieylm1P--310">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--247" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--248" target="7jwuDECKpDgqieylm1P--664">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--248" value="As such, not everything needs to be proven to know something is true: once the core foundation (the main 20%) of a system is shown to be true, the subsequent conclusions (the remaining 80%) can also be safely assumed/induced to be true" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="-5150" y="-500" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--249" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=none;fontColor=default;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--250" target="7jwuDECKpDgqieylm1P--293">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--250" value="In a system without axioms, deduction, or a grounding in reality, all claims can be made with any explanation" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="-5440" y="-760" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--251" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;labelBackgroundColor=none;fontColor=default;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--252" target="7jwuDECKpDgqieylm1P--210">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-4380" y="-1600" as="sourcePoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--252" value="&lt;b&gt;Deduction &lt;/b&gt;is a logical process in which a specific conclusion is drawn from general premises, ensuring that the&amp;nbsp;conclusion&amp;nbsp;must necessarily follow from the given premises" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="-4540" y="-1680" width="300" height="70" as="geometry" />
        </mxCell>
