        <mxCell id="7jwuDECKpDgqieylm1P--165" value="&lt;b&gt;Objective &lt;/b&gt;reality is beyond and independent of human belief" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" parent="1" vertex="1">
