        <mxCell id="7jwuDECKpDgqieylm1P--239" value="&lt;b&gt;Belief &lt;/b&gt;is the choice to accept a certain understanding/model" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" parent="1" vertex="1">
