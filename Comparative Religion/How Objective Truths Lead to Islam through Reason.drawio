        <mxCell id="7jwuDECKpDgqieylm1P--234" value="Our understanding is limited by the intellect&#39;s capacity to generate complex models, how much we already understand, and how much we&#39;re willing to accept what we wish to understand" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
