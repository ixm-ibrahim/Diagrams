        <UserObject label="&lt;font style=&quot;font-size: 12px;&quot;&gt;We exist.&lt;/font&gt;" link="data:page/id,mfmMcbX07sLiCTksEZJi" id="Zc64t6COcdzYgmrHzigb-2">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;gradientColor=#ea6b66;strokeColor=#b85450;strokeWidth=2;fontSize=1;" parent="j4HVYzPnCFSpxK68TefG-1" vertex="1">
