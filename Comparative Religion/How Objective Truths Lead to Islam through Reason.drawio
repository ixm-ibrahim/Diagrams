        <mxCell id="_srCscuwjGoY3AZOJB17-2" style="shape=connector;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.983;exitY=0.959;exitDx=0;exitDy=0;entryX=0.036;entryY=0.003;entryDx=0;entryDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;exitPerimeter=0;dashed=1;dashPattern=12 12;startArrow=oval;startFill=1;entryPerimeter=0;" parent="1" source="_srCscuwjGoY3AZOJB17-71" target="_srCscuwjGoY3AZOJB17-117" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-3" style="shape=connector;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.99;exitY=0.951;exitDx=0;exitDy=0;entryX=0.018;entryY=0.035;entryDx=0;entryDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;dashed=1;dashPattern=12 12;startArrow=oval;startFill=1;entryPerimeter=0;exitPerimeter=0;" parent="1" source="_srCscuwjGoY3AZOJB17-93" target="_srCscuwjGoY3AZOJB17-94" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-4" style="shape=connector;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.014;exitY=0.96;exitDx=0;exitDy=0;entryX=0.986;entryY=0.042;entryDx=0;entryDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;exitPerimeter=0;dashed=1;dashPattern=12 12;startArrow=oval;startFill=1;entryPerimeter=0;" parent="1" source="_srCscuwjGoY3AZOJB17-9" target="_srCscuwjGoY3AZOJB17-7" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-5" style="shape=connector;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.99;exitY=0.958;exitDx=0;exitDy=0;entryX=0.012;entryY=0.04;entryDx=0;entryDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;dashed=1;dashPattern=8 8;startArrow=oval;startFill=1;exitPerimeter=0;entryPerimeter=0;" parent="1" source="_srCscuwjGoY3AZOJB17-41" target="_srCscuwjGoY3AZOJB17-7" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-6" style="shape=connector;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.014;exitY=0.962;exitDx=0;exitDy=0;entryX=0.989;entryY=0.044;entryDx=0;entryDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;dashed=1;dashPattern=12 12;startArrow=oval;startFill=1;exitPerimeter=0;entryPerimeter=0;" parent="1" source="_srCscuwjGoY3AZOJB17-33" target="_srCscuwjGoY3AZOJB17-67" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-7" value="All information requires an observable source, either from sensory input or reason" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" parent="1" vertex="1">
          <mxGeometry x="-490" y="580" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-8" style="edgeStyle=orthogonalEdgeStyle;shape=connector;curved=0;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" parent="1" source="_srCscuwjGoY3AZOJB17-9" target="_srCscuwjGoY3AZOJB17-18" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-9" value="To experience reality is then for reality to transmit information that our senses recieve" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#f5f5f5;gradientColor=#b3b3b3;strokeColor=#666666;" parent="1" vertex="1">
          <mxGeometry x="210" y="300" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-10" style="edgeStyle=orthogonalEdgeStyle;shape=connector;curved=0;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;entryX=0.75;entryY=0;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" parent="1" source="_srCscuwjGoY3AZOJB17-11" target="_srCscuwjGoY3AZOJB17-9" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-10" y="220" as="sourcePoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-11" value="If something hits your body, you&#39;ll only know when it triggers the touch receptors in the skin and the nerves pass that information to the brain to let you know that you&#39;ve been hit" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1">
          <mxGeometry x="415" y="140" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-12" style="rounded=1;orthogonalLoop=1;jettySize=auto;html=1;edgeStyle=orthogonalEdgeStyle;curved=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="_srCscuwjGoY3AZOJB17-15" target="_srCscuwjGoY3AZOJB17-11" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="90" y="120" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-13" style="edgeStyle=orthogonalEdgeStyle;shape=connector;curved=0;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="_srCscuwjGoY3AZOJB17-15" target="_srCscuwjGoY3AZOJB17-20" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-14" style="edgeStyle=elbowEdgeStyle;shape=connector;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" parent="1" source="_srCscuwjGoY3AZOJB17-15" target="_srCscuwjGoY3AZOJB17-39" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-15" value="&lt;b&gt;Information &lt;/b&gt;can be understood through the analogy of some data being passed from a transmitting source to a receiving agent" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#f5f5f5;gradientColor=#b3b3b3;strokeColor=#666666;" parent="1" vertex="1">
          <mxGeometry x="150" y="20" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-16" style="edgeStyle=orthogonalEdgeStyle;shape=connector;curved=0;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" parent="1" source="_srCscuwjGoY3AZOJB17-18" target="_srCscuwjGoY3AZOJB17-28" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="370.0000000000002" y="750" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-17" style="edgeStyle=elbowEdgeStyle;shape=connector;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" parent="1" source="_srCscuwjGoY3AZOJB17-18" target="_srCscuwjGoY3AZOJB17-24" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-18" value="The purest, most basic information that our senses recieve is that we exist in reality in some form" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#f5f5f5;strokeColor=#666666;gradientColor=#b3b3b3;" parent="1" vertex="1">
          <mxGeometry x="210" y="580" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-19" style="edgeStyle=elbowEdgeStyle;shape=connector;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;entryX=0.5;entryY=0;entryDx=0;entryDy=0;elbow=vertical;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" parent="1" source="_srCscuwjGoY3AZOJB17-20" target="_srCscuwjGoY3AZOJB17-22" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="280" y="220" as="sourcePoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-20" value="The existence of information depends on the existence of reality" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#f5f5f5;gradientColor=#b3b3b3;strokeColor=#666666;" parent="1" vertex="1">
          <mxGeometry x="150" y="140" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-21" style="edgeStyle=elbowEdgeStyle;shape=connector;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" parent="1" source="_srCscuwjGoY3AZOJB17-22" target="_srCscuwjGoY3AZOJB17-9" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-22" value="Experiencing reality can only be possible through an individual agent&#39;s senses" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#f5f5f5;gradientColor=#b3b3b3;strokeColor=#666666;" parent="1" vertex="1">
          <mxGeometry x="150" y="210" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-23" style="edgeStyle=elbowEdgeStyle;shape=connector;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" parent="1" source="_srCscuwjGoY3AZOJB17-24" target="_srCscuwjGoY3AZOJB17-33" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-24" value="Despite its lack of cognitive ability to understand its sensations, a baby&#39;s first sensory experiences of touch and sound (along with the fundamental sensations of comfort and discomfort) serve as the purest form of information that confirms its existence within some broader reality" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1">
          <mxGeometry x="-50" y="680" width="240" height="110" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-25" style="edgeStyle=elbowEdgeStyle;shape=connector;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" parent="1" source="_srCscuwjGoY3AZOJB17-26" target="_srCscuwjGoY3AZOJB17-86" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-26" value="The mind/intellect processes the data received by the senses and creates understanding: a labeled model of reality" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" parent="1" vertex="1">
          <mxGeometry x="-120" y="940" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-27" style="edgeStyle=elbowEdgeStyle;shape=connector;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" parent="1" source="_srCscuwjGoY3AZOJB17-28" target="_srCscuwjGoY3AZOJB17-33" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-28" value="Sensory input is a proof of existence: no agent can rationally doubt their own existence while they experience pleasure, pain, or some other sensation (for if they didn&#39;t exist, then they wouldn&#39;t feel anything to begin with)" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#f5f5f5;gradientColor=#b3b3b3;strokeColor=#666666;" parent="1" vertex="1">
          <mxGeometry x="210" y="680" width="240" height="110" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-29" style="edgeStyle=elbowEdgeStyle;shape=connector;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" parent="1" source="_srCscuwjGoY3AZOJB17-36" target="_srCscuwjGoY3AZOJB17-35" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-30" style="edgeStyle=elbowEdgeStyle;shape=connector;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" parent="1" source="_srCscuwjGoY3AZOJB17-33" target="_srCscuwjGoY3AZOJB17-36" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-31" style="edgeStyle=elbowEdgeStyle;shape=connector;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" parent="1" source="_srCscuwjGoY3AZOJB17-33" target="_srCscuwjGoY3AZOJB17-53" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-32" style="edgeStyle=elbowEdgeStyle;shape=connector;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" parent="1" source="_srCscuwjGoY3AZOJB17-33" target="_srCscuwjGoY3AZOJB17-26" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-33" value="Sensory input is independent of intelligence, thus the intellect is not capable of proving existence - except only to be aware of the proof of sensory input" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#f5f5f5;strokeColor=#666666;gradientColor=#b3b3b3;" parent="1" vertex="1">
          <mxGeometry x="150" y="830" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-34" style="edgeStyle=elbowEdgeStyle;shape=connector;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" parent="1" source="_srCscuwjGoY3AZOJB17-35" target="_srCscuwjGoY3AZOJB17-94" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-35" value="If someone wants to doubt their own existence or their ability to arrive at basic truths, just let them punch themselves in their face: if they feel it and react, it demonstrates awareness of sensory input and thus they prove to themselves that they must exist - and if they refuse, the very act of refusing proves the existence of an agent capable of decision-making and still aware of sensory input, thereby affirming their existence yet again" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1">
          <mxGeometry x="150" y="1040" width="240" height="170" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-36" value="It&#39;s not, &quot;I think, therefore I am&quot; but rather, &quot;I feel, therefore I am, and I think, therefore I know I am&quot;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#f5f5f5;gradientColor=#b3b3b3;strokeColor=#666666;" parent="1" vertex="1">
          <mxGeometry x="150" y="940" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-37" style="edgeStyle=elbowEdgeStyle;shape=connector;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" parent="1" source="_srCscuwjGoY3AZOJB17-39" target="_srCscuwjGoY3AZOJB17-43" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-38" style="edgeStyle=elbowEdgeStyle;shape=connector;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" parent="1" source="_srCscuwjGoY3AZOJB17-39" target="_srCscuwjGoY3AZOJB17-45" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-39" value="&lt;b&gt;Logic&lt;/b&gt;&amp;nbsp;(or a&amp;nbsp;&lt;b&gt;logical system&lt;/b&gt;)&lt;b&gt;&amp;nbsp;&lt;/b&gt;maps the relationship between different pieces of information, organizing them as conclusions that follow from premises" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#f5f5f5;gradientColor=#b3b3b3;strokeColor=#666666;" parent="1" vertex="1">
          <mxGeometry x="-1160" y="140" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-40" style="edgeStyle=elbowEdgeStyle;shape=connector;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" parent="1" source="_srCscuwjGoY3AZOJB17-41" target="_srCscuwjGoY3AZOJB17-59" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-41" value="A &lt;b&gt;proof &lt;/b&gt;is a logical argument that demonstrates the truth of a statement based on a series of deductions from previously established&amp;nbsp;axioms and&amp;nbsp;theorems using the rules of inference" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" parent="1" vertex="1">
          <mxGeometry x="-1160" y="460" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-42" style="edgeStyle=elbowEdgeStyle;shape=connector;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" parent="1" source="_srCscuwjGoY3AZOJB17-43" target="_srCscuwjGoY3AZOJB17-51" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-43" value="&lt;b&gt;Deduction &lt;/b&gt;is a logical process in which a conclusion is necessarily drawn from a set of premises, such that the&amp;nbsp;conclusion&amp;nbsp;will always follow from the given premises" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" parent="1" vertex="1">
          <mxGeometry x="-960" y="250" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-44" style="edgeStyle=elbowEdgeStyle;shape=connector;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" parent="1" source="_srCscuwjGoY3AZOJB17-45" target="_srCscuwjGoY3AZOJB17-48" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-45" value="&lt;b&gt;Induction&amp;nbsp;&lt;/b&gt;is a logical process in which principles are derived from finite empirical observations, such that more consistent observations lead to stronger principles" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" parent="1" vertex="1">
          <mxGeometry x="-1360" y="250" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-46" style="edgeStyle=elbowEdgeStyle;shape=connector;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" parent="1" source="_srCscuwjGoY3AZOJB17-48" target="_srCscuwjGoY3AZOJB17-41" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-47" style="edgeStyle=elbowEdgeStyle;shape=connector;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" parent="1" source="_srCscuwjGoY3AZOJB17-48" target="_srCscuwjGoY3AZOJB17-63" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-48" value="An &lt;b&gt;axiom &lt;/b&gt;(or postulate) is an induced fundamental principle that serves as a starting point for a logical or mathematical system" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" parent="1" vertex="1">
          <mxGeometry x="-1360" y="350" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-49" style="edgeStyle=elbowEdgeStyle;shape=connector;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" parent="1" source="_srCscuwjGoY3AZOJB17-51" target="_srCscuwjGoY3AZOJB17-41" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-50" style="edgeStyle=elbowEdgeStyle;shape=connector;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" parent="1" source="_srCscuwjGoY3AZOJB17-51" target="_srCscuwjGoY3AZOJB17-61" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-51" value="A &lt;b&gt;theorem &lt;/b&gt;(or proposition) is a new conclution that is deduced from other axioms or deductions" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" parent="1" vertex="1">
          <mxGeometry x="-960" y="350" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-52" value="A&amp;nbsp;&lt;b&gt;contradiction&amp;nbsp;&lt;/b&gt;is a logical inconsistency within a system that requires an infinite number of explanations, as resolving it with reality demands endless adjustments to account for the growing inconsistencies" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" parent="1" vertex="1">
          <mxGeometry x="-1160" y="760" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-53" value="Our awareness of our existence can be labelled as&amp;nbsp;&lt;b&gt;consciousness&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#f5f5f5;strokeColor=#666666;gradientColor=#b3b3b3;" parent="1" vertex="1">
          <mxGeometry x="425" y="940" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-54" style="edgeStyle=elbowEdgeStyle;shape=connector;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" parent="1" source="_srCscuwjGoY3AZOJB17-55" target="_srCscuwjGoY3AZOJB17-52" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-55" value="&lt;b&gt;Consistency&lt;/b&gt;: a set of statements such that there is no statement such that both the statement and its negation are provable from the whole system" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" parent="1" vertex="1">
          <mxGeometry x="-1160" y="670" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-56" style="edgeStyle=elbowEdgeStyle;shape=connector;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" parent="1" source="_srCscuwjGoY3AZOJB17-59" target="_srCscuwjGoY3AZOJB17-55" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-57" style="edgeStyle=elbowEdgeStyle;shape=connector;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" parent="1" source="_srCscuwjGoY3AZOJB17-52" target="_srCscuwjGoY3AZOJB17-61" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-58" style="edgeStyle=elbowEdgeStyle;shape=connector;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" parent="1" source="_srCscuwjGoY3AZOJB17-52" target="_srCscuwjGoY3AZOJB17-63" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-59" value="A proof is &lt;b&gt;valid &lt;/b&gt;if the conclusions logically follow from the premises, and it is &lt;b&gt;sound &lt;/b&gt;when it is valid and is harmonious with the rest of the system" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" parent="1" vertex="1">
          <mxGeometry x="-1160" y="560" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-60" style="edgeStyle=elbowEdgeStyle;shape=connector;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" parent="1" source="_srCscuwjGoY3AZOJB17-61" target="_srCscuwjGoY3AZOJB17-69" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-61" value="The truthfulness of a theorem depends on consistent and sound premises and is demonstrated by&amp;nbsp;proving that its premises must yield the conclusion, while an untrue or false&amp;nbsp;(yet potentially valid)&amp;nbsp;theorem will contradict the other theorems in the system&amp;nbsp;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" parent="1" vertex="1">
          <mxGeometry x="-1020" y="880" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-62" style="edgeStyle=elbowEdgeStyle;shape=connector;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" parent="1" source="_srCscuwjGoY3AZOJB17-63" target="_srCscuwjGoY3AZOJB17-67" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-63" value="The truthfulness of an axiom depends on consistent and sound observations and is demonstrated through the consistency of the system that follows it, while&amp;nbsp;an untrue or false axiom leads to (potentially valid yet) inconsistent or inaccurate models reality" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" parent="1" vertex="1">
          <mxGeometry x="-1300" y="880" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-64" style="edgeStyle=elbowEdgeStyle;shape=connector;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" parent="1" source="_srCscuwjGoY3AZOJB17-67" target="_srCscuwjGoY3AZOJB17-71" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-65" style="edgeStyle=elbowEdgeStyle;shape=connector;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" parent="1" source="_srCscuwjGoY3AZOJB17-67" target="_srCscuwjGoY3AZOJB17-73" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-66" style="edgeStyle=elbowEdgeStyle;shape=connector;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" parent="1" source="_srCscuwjGoY3AZOJB17-67" target="_srCscuwjGoY3AZOJB17-75" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-67" value="As such, deduction is not applicable to demonstrating the soundness of an axiom (empirical observations are not logical statements to deduce from), but axioms can be used to start deductive reasoning as fundamental premises" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" parent="1" vertex="1">
          <mxGeometry x="-1300" y="1010" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-68" style="edgeStyle=elbowEdgeStyle;shape=connector;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" parent="1" source="_srCscuwjGoY3AZOJB17-69" target="_srCscuwjGoY3AZOJB17-71" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-69" value="As such, induction&amp;nbsp;is not applicable to demonstrating the soundness of a theorem (logical statements are not empirical observations to induce from), but theorems can be used to expand inductive reasoning as new conclusions" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" parent="1" vertex="1">
          <mxGeometry x="-1020" y="1010" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-70" style="edgeStyle=elbowEdgeStyle;shape=connector;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" parent="1" source="_srCscuwjGoY3AZOJB17-71" target="_srCscuwjGoY3AZOJB17-77" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-71" value="The soundness/truthfulness of a system is shown through how internally consistent its the theorems are, as well as how externally consistent its axioms are with reality (or the system&#39;s scope)" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" parent="1" vertex="1">
          <mxGeometry x="-1160" y="1150" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-72" style="edgeStyle=elbowEdgeStyle;shape=connector;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="_srCscuwjGoY3AZOJB17-73" target="_srCscuwjGoY3AZOJB17-80" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-73" value="&lt;span style=&quot;text-align: left;&quot;&gt;The notion of truth for axioms is relative to the consistency and utility of the logical system, trying to find the best model of reality there can be&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" parent="1" vertex="1">
          <mxGeometry x="-1440" y="1150" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-74" style="edgeStyle=elbowEdgeStyle;shape=connector;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" parent="1" source="_srCscuwjGoY3AZOJB17-75" target="_srCscuwjGoY3AZOJB17-82" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-75" value="Trying to deductively prove an axiom is as impractical as trying to cook a chef: just as a chef can cook but isn&#39;t subject to the cooking process, axioms establish the basis for deduction but are not themselves derived through it (while inductions can lead to deductions, the reverse is not true: inductions can&#39;t be deduced)" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1">
          <mxGeometry x="-1720" y="1150" width="240" height="140" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-76" style="edgeStyle=elbowEdgeStyle;shape=connector;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" parent="1" source="_srCscuwjGoY3AZOJB17-77" target="_srCscuwjGoY3AZOJB17-107" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-77" value="Because systems can vary in scope and soundness (potentially containing any ratio of truth to falsehood in any context), the&amp;nbsp;more axioms and theorems a system has, the more narrow the range of possible alternative explanations becomes" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" parent="1" vertex="1">
          <mxGeometry x="-1160" y="1260" width="240" height="120" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-78" style="edgeStyle=elbowEdgeStyle;shape=connector;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" parent="1" source="_srCscuwjGoY3AZOJB17-80" target="_srCscuwjGoY3AZOJB17-82" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-79" style="edgeStyle=elbowEdgeStyle;shape=connector;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" parent="1" source="_srCscuwjGoY3AZOJB17-80" target="_srCscuwjGoY3AZOJB17-109" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-80" value="Axioms must be grounded in reality to prevent any arbitrary statement from being accepted to be valid, thus the soundness of axioms is not demonstrated through proofs but rather through signs: their evident consistency with observed reality" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" parent="1" vertex="1">
          <mxGeometry x="-1440" y="1260" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-81" style="edgeStyle=elbowEdgeStyle;shape=connector;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" parent="1" source="_srCscuwjGoY3AZOJB17-82" target="_srCscuwjGoY3AZOJB17-109" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-82" value="As such, axioms have no proof nor disproof: an axiom becomes intuitive when it is consistent with reality and there are enough signs to show that there is no reason for it not to be sound" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1">
          <mxGeometry x="-1660" y="1400" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-83" style="edgeStyle=elbowEdgeStyle;shape=connector;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" parent="1" source="_srCscuwjGoY3AZOJB17-86" target="_srCscuwjGoY3AZOJB17-93" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-84" style="edgeStyle=elbowEdgeStyle;shape=connector;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" parent="1" source="_srCscuwjGoY3AZOJB17-86" target="_srCscuwjGoY3AZOJB17-89" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-85" style="edgeStyle=elbowEdgeStyle;shape=connector;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" parent="1" source="_srCscuwjGoY3AZOJB17-86" target="_srCscuwjGoY3AZOJB17-96" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-86" value="Sensory input is how reality is experienced, and so only a model of that experience can be shared with other humans (education)" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" parent="1" vertex="1">
          <mxGeometry x="-120" y="1040" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-87" style="edgeStyle=elbowEdgeStyle;shape=connector;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" parent="1" source="_srCscuwjGoY3AZOJB17-89" target="_srCscuwjGoY3AZOJB17-90" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-88" style="edgeStyle=elbowEdgeStyle;shape=connector;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" parent="1" source="_srCscuwjGoY3AZOJB17-89" target="_srCscuwjGoY3AZOJB17-97" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-89" value="Our understanding is limited by the intellect&#39;s capacity to generate models, how much we already understand, and how much we&#39;re willing to accept what we wish to understand" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" parent="1" vertex="1">
          <mxGeometry x="-680" y="1150" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-90" value="&lt;b&gt;Education &lt;/b&gt;is the process of building an internal model of reality through observation and deduction, incorporating truths from more advanced models" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" parent="1" vertex="1">
          <mxGeometry x="-390" y="1250" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-91" style="edgeStyle=elbowEdgeStyle;shape=connector;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" parent="1" source="_srCscuwjGoY3AZOJB17-96" target="_srCscuwjGoY3AZOJB17-90" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-92" style="edgeStyle=elbowEdgeStyle;shape=connector;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" parent="1" source="_srCscuwjGoY3AZOJB17-93" target="_srCscuwjGoY3AZOJB17-90" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-93" value="As such, all &lt;b&gt;knowledge&lt;/b&gt;&amp;nbsp;is simply a model of some concept, and to&amp;nbsp;&lt;b&gt;know &lt;/b&gt;something is then to have a model that represents some concept on a practical or utilitarian level&amp;nbsp;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" parent="1" vertex="1">
          <mxGeometry x="-390" y="1150" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-94" value="To know something true is to have a model that is aligned with reality on a practical or utilitarian level (and not necessarily by knowing 100% of all knowledge, which is both impossible and impractical)" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1">
          <mxGeometry x="90" y="1250" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-95" style="edgeStyle=elbowEdgeStyle;shape=connector;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" parent="1" source="_srCscuwjGoY3AZOJB17-96" target="_srCscuwjGoY3AZOJB17-94" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-96" value="No one can possibly experience all of reality, so models can be expanded by learning about other models and experiences" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" parent="1" vertex="1">
          <mxGeometry x="-120" y="1150" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-97" value="all problems stem from &quot;all information need to have a source&quot; and the source is your own self or feelings - what does it mean to be &quot;taught&quot;?" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#e51400;strokeColor=#B20000;fontColor=#ffffff;" parent="1" vertex="1">
          <mxGeometry x="-680" y="1250" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-98" style="edgeStyle=elbowEdgeStyle;shape=connector;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" parent="1" source="_srCscuwjGoY3AZOJB17-77" target="_srCscuwjGoY3AZOJB17-101" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-1040" y="1440" as="sourcePoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-99" style="edgeStyle=elbowEdgeStyle;shape=connector;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" parent="1" source="_srCscuwjGoY3AZOJB17-101" target="_srCscuwjGoY3AZOJB17-109" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-100" style="edgeStyle=elbowEdgeStyle;shape=connector;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="_srCscuwjGoY3AZOJB17-77" target="_srCscuwjGoY3AZOJB17-115" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-1070" y="1530" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-101" value="In a system without axioms, deduction, or a grounding in reality, all claims can be made with any potentially valid explanation (a potential only out of ignorance)" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" parent="1" vertex="1">
          <mxGeometry x="-1160" y="1420" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-102" style="edgeStyle=elbowEdgeStyle;shape=connector;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" parent="1" source="_srCscuwjGoY3AZOJB17-107" target="_srCscuwjGoY3AZOJB17-113" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-103" style="edgeStyle=elbowEdgeStyle;shape=connector;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" parent="1" source="_srCscuwjGoY3AZOJB17-113" target="_srCscuwjGoY3AZOJB17-118" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-104" style="edgeStyle=elbowEdgeStyle;shape=connector;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" parent="1" source="_srCscuwjGoY3AZOJB17-115" target="_srCscuwjGoY3AZOJB17-126" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-105" style="edgeStyle=elbowEdgeStyle;shape=connector;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" parent="1" source="_srCscuwjGoY3AZOJB17-107" target="_srCscuwjGoY3AZOJB17-133" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-106" style="edgeStyle=elbowEdgeStyle;shape=connector;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" parent="1" source="_srCscuwjGoY3AZOJB17-107" target="_srCscuwjGoY3AZOJB17-126" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-107" value="The more axioms and theorems there are in a system, the exponentially easier it becomes to identify its soundness due to the increased number of relationships available for cross-validation" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" parent="1" vertex="1">
          <mxGeometry x="-290" y="1420" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-108" style="edgeStyle=elbowEdgeStyle;shape=connector;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" parent="1" source="_srCscuwjGoY3AZOJB17-109" target="_srCscuwjGoY3AZOJB17-110" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-109" value="A sound system cannot be founded on hypersimplistic axioms (such as &quot;everything is true&quot; or &quot;nothing can be proven to be true&quot;) as they lead to internal and external inconsistencies due to lacking a firm grounding in reality (the former axiom contradictingly includes both P and not P while the latter claims not P while being P itself, yet another contradiction)" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1">
          <mxGeometry x="-1570" y="1540" width="500" height="80" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-110" value="This includes hypersimplicity with human sensory input, either claiming that sensory observation is wholly trustworthy (whatever you observe and your understanding of it is truly accurate) or wholly untrustworthy (human sensory input is so untrustworthy that nothing can truly be known to be true from it), as sensory input includes both the possibility of deception and the possibility of accurate understanding, which are counterexamples to both claims - and not to mention that sensory input can be used to arrive at either conclusion" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" parent="1" vertex="1">
          <mxGeometry x="-1570" y="1660" width="500" height="90" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-111" style="edgeStyle=elbowEdgeStyle;shape=connector;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" parent="1" source="_srCscuwjGoY3AZOJB17-113" target="_srCscuwjGoY3AZOJB17-121" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-112" style="edgeStyle=elbowEdgeStyle;shape=connector;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" parent="1" source="_srCscuwjGoY3AZOJB17-113" target="_srCscuwjGoY3AZOJB17-131" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-113" value="Even with infinite alternative explanations, the range can be narrowed enough to make the differences between them negligible" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" parent="1" vertex="1">
          <mxGeometry x="-10" y="1540" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-114" style="edgeStyle=elbowEdgeStyle;shape=connector;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" parent="1" source="_srCscuwjGoY3AZOJB17-115" target="_srCscuwjGoY3AZOJB17-117" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-115" value="A system with unsound axioms will lead to deductions that may be valid but are unsound within the greater scope of reality, allowing the deductive justification of falsehood" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" parent="1" vertex="1">
          <mxGeometry x="-890" y="1420" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-116" style="edgeStyle=elbowEdgeStyle;shape=connector;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" parent="1" source="_srCscuwjGoY3AZOJB17-117" target="_srCscuwjGoY3AZOJB17-124" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-117" value="This is evident in systems that develop axioms from pre-defined/biased conclusions rather than observations: if the conclusion is false, then more ungrounded axioms must be added to maintain valid deductions" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" parent="1" vertex="1">
          <mxGeometry x="-890" y="1540" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-118" value="This is the proper implementation of Occam&#39;s Razor: the simplest explanation that includes all the relevant information, not just the simplest explanation one can conceive of" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1">
          <mxGeometry x="260" y="1660" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-119" style="edgeStyle=elbowEdgeStyle;shape=connector;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" parent="1" source="_srCscuwjGoY3AZOJB17-121" target="_srCscuwjGoY3AZOJB17-122" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-120" style="edgeStyle=elbowEdgeStyle;shape=connector;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" parent="1" source="_srCscuwjGoY3AZOJB17-121" target="_srCscuwjGoY3AZOJB17-127" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-121" value="As such, not everything needs to be proven to know something is true: once the core foundation (the main 20%) of a system is shown to be true, the subsequent conclusions (the remaining 80%) can also be safely assumed/induced to be true" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1">
          <mxGeometry x="-10" y="1660" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-122" value="A system can be shown to be true (or at the very least, more true) if it possesses sound axioms and theorems with a scope that provides enough evidence to elimintate alternate explanations, including the possibility of the system to be unsound" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" parent="1" vertex="1">
          <mxGeometry x="260" y="1790" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-123" style="edgeStyle=elbowEdgeStyle;shape=connector;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" parent="1" source="_srCscuwjGoY3AZOJB17-124" target="_srCscuwjGoY3AZOJB17-129" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-124" value="If an argument relies on an axiom, the truth of that axiom must be established before drawing conclusions from the argument: deduction is only meaningful with respect to sound axioms" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" parent="1" vertex="1">
          <mxGeometry x="-890" y="1660" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-125" style="edgeStyle=elbowEdgeStyle;shape=connector;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" parent="1" source="_srCscuwjGoY3AZOJB17-126" target="_srCscuwjGoY3AZOJB17-131" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-126" value="If a system supports a false claim, then the more sound axioms and theorems the system has, the easier it will be to idenitfy contradictions as the falsehood propagates throughout the system" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" parent="1" vertex="1">
          <mxGeometry x="-600" y="1540" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-127" value="As such, the argument that &quot;it&#39;s impossible to know anything&quot; becomes unsound as it is premised on having perfect knowledge of all things in order to be 100% certain there is no misunderstanding, yet knowledge is not&amp;nbsp;originally premised on that: knowledge is only such that enough is known about something to have practical use" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1">
          <mxGeometry x="-10" y="1790" width="240" height="140" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-128" style="edgeStyle=elbowEdgeStyle;shape=connector;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="_srCscuwjGoY3AZOJB17-129" target="_srCscuwjGoY3AZOJB17-130" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-870" y="1900" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-129" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;The more reality is experienced, the better and more sound model of the system will be established&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;align=center;" parent="1" vertex="1">
          <mxGeometry x="-890" y="1790" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-130" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;Unsound whatifism will take the system away from reality and into a (potentially valid yet) hypothetical world that is not aligned with reality&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;align=center;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1">
          <mxGeometry x="-890" y="1890" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-131" value="Unlike a sound argument with infinite alternative explanations with negligible differences, the infinite number of explanations that come with contradictions lead to a growing number of inconsistencies, preventing a sound resolution" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" parent="1" vertex="1">
          <mxGeometry x="-290" y="1660" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-132" style="edgeStyle=elbowEdgeStyle;shape=connector;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=default;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" parent="1" source="_srCscuwjGoY3AZOJB17-133" target="_srCscuwjGoY3AZOJB17-131" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-133" value="An i&lt;b&gt;nfinite regress&lt;/b&gt; occurs when a claim requires further support indefinitely, lacking the possibility of reaching a definitive conclusion from a stable foundation (ex. the Library of Babel)" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" parent="1" vertex="1">
          <mxGeometry x="-290" y="1540" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-134" value="&lt;span style=&quot;text-align: left;&quot;&gt;The notion of truth for axioms is not absolute but relative to the consistency and utility of the logical system, trying to find the best model of reality there can be&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" parent="1" vertex="1">
          <mxGeometry x="-2150" y="230" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-135" value="An axiom becomes intuitive when it is consistent with reality and there are enough signs to show that there is no reason for it not to be sound" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" parent="1" vertex="1">
          <mxGeometry x="-1870" y="235" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-136" value="Proving an argument without first establishing the soundness of its necessary axioms is like proving algebra exists while doubting the existence of math itself, or like trying to explain how to run while doubting that legs exist: conclusions must be reached through established axioms" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1">
          <mxGeometry x="-1970" y="410" width="260" height="99" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-137" value="Being unable to sensually observe a phenomena does not necessitate an impossibility in knowing its utility or knowing enough about it to be&amp;nbsp;utilitarianly purposeful" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" parent="1" vertex="1">
          <mxGeometry x="-1970" y="700" width="240" height="110" as="geometry" />
        </mxCell>
        <mxCell id="_srCscuwjGoY3AZOJB17-138" value="If some phenomena can&#39;t be sensually observed, then the range of possible explanations can be narrowed down by using what can be sensually observed" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" parent="1" vertex="1">
          <mxGeometry x="-1950" y="560" width="240" height="110" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
