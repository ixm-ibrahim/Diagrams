          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <UserObject label="&lt;span style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;Truth and falsehood are mutually exclusive.&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;font style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;br&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;If understanding is &quot;true&quot; in the sense that it aligns with reality, then it can&#39;t be simultaneously &quot;false&quot; in the sense that it is also misaligned with reality.&amp;nbsp;&lt;/span&gt;" link="data:page/id,-Jo48hRcNlxwHJQ-ha_P" id="XE9wM9tcj7p-6C1WfFt_-4">
          <mxCell style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;size=30;fillColor=#b0e3e6;strokeColor=#0e8088;fontSize=1;strokeWidth=2;spacing=16;" parent="XE9wM9tcj7p-6C1WfFt_-1" vertex="1">
