        <mxCell id="7jwuDECKpDgqieylm1P--244" value="If sensory input is a proof for existence and a prerequisite for language, then sensory input is a means of communicating another&#39;s own existence to themselves" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" parent="1" vertex="1">
