        <mxCell id="uHxNGxETZ01MsBiVxSH5-1" value="deprive of all sensations, what do you experience? heightened will" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;" vertex="1" parent="mExRIxhNE1BHIPu0LiUs-1">
