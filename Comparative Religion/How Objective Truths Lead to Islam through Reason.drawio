      <root>
        <mxCell id="N5PPzdv7nw5bOdpd8VeD-0" />
        <mxCell id="N5PPzdv7nw5bOdpd8VeD-1" parent="N5PPzdv7nw5bOdpd8VeD-0" />
        <UserObject label="&lt;b style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 32px;&quot;&gt;How Objective Truths Lead to Islam Through Reason&lt;br&gt;&lt;/span&gt;&lt;font style=&quot;font-size: 4px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/b&gt;&lt;b&gt;&lt;i style=&quot;font-size: 12px;&quot;&gt;&lt;font style=&quot;font-size: 18px; color: rgb(102, 102, 102);&quot;&gt;Understanding&amp;nbsp;&lt;/font&gt;&lt;/i&gt;&lt;/b&gt;&lt;b style=&quot;&quot;&gt;&lt;i style=&quot;font-size: 12px;&quot;&gt;&lt;font style=&quot;font-size: 18px; color: rgb(102, 102, 102);&quot;&gt;and Information (Node 3)&lt;/font&gt;&lt;/i&gt;&lt;/b&gt;" link="data:page/id,q1TZ7uQ2KXKU_8ORelwv" id="N5PPzdv7nw5bOdpd8VeD-2">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6d0de;strokeColor=#996185;gradientColor=#d5739d;fontSize=1;" parent="N5PPzdv7nw5bOdpd8VeD-1" vertex="1">
