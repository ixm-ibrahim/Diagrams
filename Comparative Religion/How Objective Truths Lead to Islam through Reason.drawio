        <mxCell id="Q5tvUoDjn6x08kLSBcZP-3" value="&lt;font style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;Physical sensations occur.&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;font style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;This encompasses the 5 senses (sight, hearing, touch,&amp;nbsp;smell, and taste), as well as feelings&lt;br&gt;such as hunger, thirst, pleasure, and pain.&lt;/font&gt;&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;size=30;fillColor=#b0e3e6;strokeColor=#0e8088;fontSize=1;strokeWidth=2;" vertex="1" parent="Q5tvUoDjn6x08kLSBcZP-1">
