        <mxCell id="Yg7MVec-9dlvVUTOqUPx-79" value="&lt;div style=&quot;&quot;&gt;&lt;div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;&lt;b&gt;How do sensations occur without volition?&lt;/b&gt;&amp;nbsp;Sensations are not initated by volition.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;==================================&lt;/span&gt;&lt;/div&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;&lt;b&gt;Sensations are not initiated by will.&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;{}&lt;/span&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;-----------------------------------------------------------&lt;/font&gt;&lt;/div&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;&lt;/span&gt;&lt;div&gt;&lt;b style=&quot;font-size: 11px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Initiation&lt;/b&gt;&lt;/div&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;{&lt;/span&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;initiation, begin, origination&lt;/span&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;}&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;-----------------------------------------------------------&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;&lt;b&gt;Event&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;{event}&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;-----------------------------------------------------------&lt;/span&gt;&lt;/div&gt;&lt;span style=&quot;background-color: transparent; font-size: 11px;&quot;&gt;&lt;b&gt;Sensations occur without volition.&lt;/b&gt;&lt;/span&gt;&lt;b style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); background-color: transparent; font-size: 11px;&quot;&gt;&amp;nbsp;∪&amp;nbsp;&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;b s