          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <UserObject label="&lt;span style=&quot;font-size: 12px;&quot;&gt;A statement is subjective when its context is reality.&lt;/span&gt;" link="data:page/id,UETkfCh4AJosU-Qw8zd5" id="W3f5UINCB4utkoovJ-PE-27">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;gradientColor=#b3b3b3;strokeColor=#666666;strokeWidth=2;fontSize=1;labelBackgroundColor=default;" parent="mExRIxhNE1BHIPu0LiUs-1" vertex="1">
