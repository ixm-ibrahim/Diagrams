            <mxGeometry x="80" y="40" width="1010" height="110" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="IMg7hGBO13cETrvNUV1--2" style="edgeStyle=elbowEdgeStyle;shape=connector;curved=0;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=default;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" parent="D02OvW6ERCM4YyDwM5Ql-1" source="D02OvW6ERCM4YyDwM5Ql-4" target="IMg7hGBO13cETrvNUV1--0" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="IMg7hGBO13cETrvNUV1--3" style="edgeStyle=elbowEdgeStyle;shape=connector;curved=0;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=default;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" parent="D02OvW6ERCM4YyDwM5Ql-1" source="D02OvW6ERCM4YyDwM5Ql-4" target="IMg7hGBO13cETrvNUV1--1" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <UserObject label="&lt;span style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;Information exists.&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;font style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;br&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;We label the content of our experiences - arising from the external reality we perceive - as &lt;i&gt;information&lt;/i&gt;. Experiencing any external object means receiving information transmitted to our senses. Thus, &quot;information&quot; is an internal representation of something external to our consciousness.&lt;/span&gt;" link="data:page/id,VuEyJK-5QdxOhdqgMgJb" id="D02OvW6ERCM4YyDwM5Ql-4">
          <mxCell style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;size=30;fillColor=#b0e3e6;strokeColor=#0e8088;fontSize=1;strokeWidth=2;spacing=16;" parent="D02OvW6ERCM4YyDwM5Ql-1" vertex="1">
            <mxGeometry x="360" y="470" width="450" height="120" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="D02OvW6ERCM4YyDwM5Ql-5" style="edgeStyle=elbowEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;elbow=vertical;curved=0;strokeWidth=2;" parent="D02OvW6ERCM4YyDwM5Ql-1" source="D02OvW6ERCM4YyDwM5Ql-7" target="D02OvW6ERCM4YyDwM5Ql-20" edge="1">
