        </mxCell>
        <mxCell id="VyjisshgyECK9-Sqm5kk-11" value="&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Objections&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/font&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;div style=&quot;text-align: left; padding-left: 1px; padding-right: 1px;&quot;&gt;&lt;font style=&quot;color: rgb(77, 77, 77);&quot;&gt;&lt;font&gt;&lt;b style=&quot;background-color: transparent; font-size: 11px;&quot;&gt;1.&lt;/b&gt;&lt;span style=&quot;background-color: transparent; font-size: 11px;&quot;&gt;&amp;nbsp;All stimuli could be simulated in a brain-in-a-jar situation&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;.&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;ul style=&quot;padding-left: 25px; padding-right: 1px; margin-bottom: 2px;&quot;&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 11px; color: light-dark(rgb(51, 0, 0), rgb(255, 255, 255));&quot;&gt;This node does not address the true nature of the external world - and even in this counterexample, both the brain and the jar exist.&lt;/font&gt;&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;div style=&quot;background-color: transparent; padding-left: 1px; padding-right: 1px; display: inline !important;&quot;&gt;&lt;font style=&quot;color: rgb(77, 77, 77);&quot;&gt;&lt;b style=&quot;background-color: transparent; font-size: 11px;&quot;&gt;2.&lt;/b&gt;&lt;span style=&quot;background-color: transparent; font-size: 11px;&quot;&gt;&amp;nbsp;Reality could be an illusion&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;.&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;background-color: transparent;&quot;&gt;&lt;ul style=&quot;padding-left: 25px; padding-right: 1px; margin-bottom: 2px;&quot;&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 11px; color: light-dark(rgb(51, 0, 0), rgb(255, 255, 255));&quot;&gt;This node does not address the true nature of the external world - and even in this counterexample, there is a reality beyond the illusion.&lt;/font&gt;&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;div style=&quot;padding-left: 1px; padding-right: 1px;&quot;&gt;&lt;font style=&quot;color: rgb(77, 77, 77);&quot;&gt;&lt;b style=&quot;background-color: transparent; font-size: 11px;&quot;&gt;3.&lt;/b&gt;&lt;span style=&quot;background-color: transparent; font-size: 11px;&quot;&gt;&amp;nbsp;What if my mind is the only thing that exists (so no brain and no&lt;br&gt;&amp;nbsp; &amp;nbsp; jar), and it simulates all this on its own?&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;ul style=&quot;padding-left: 25px; padding-right: 1px;&quot;&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 11px; color: light-dark(rgb(51, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;a.&lt;/b&gt; If your mind alone simulates everything (like God), then that&lt;br&gt;&amp;nbsp; &amp;nbsp; simulated construct practically functions as an external reality, for it&lt;br&gt;&amp;nbsp; &amp;nbsp; would be external to your consciousness.&lt;br&gt;&lt;b&gt;b.&lt;/b&gt; If the simulation is somehow purely metaphysical, your mind would&lt;br&gt;&amp;nbsp; &amp;nbsp; then exist outside of time and space (as they are just simulated&lt;br&gt;&amp;nbsp; &amp;nbsp; constructs) and would be free from need and necessity (for there is&lt;br&gt;&amp;nbsp; &amp;nbsp; no external world to gain sustenance from and to be dependent on).&lt;/font&gt;&lt;/span&gt;&lt;/li&gt;&lt;ul style=&quot;padding-left: 20px; margin-bottom: 2px;&quot;&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 11px; color: light-dark(rgb(51, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;&amp;nbsp;i.&lt;/b&gt; If you have free will and are unable to transcend space and&lt;br&gt;&amp;nbsp; &amp;nbsp; time, then space and time are external to your conscious will (in&lt;br&gt;&amp;nbsp; &amp;nbsp; some form) and thus an external world exists.&lt;/font&gt;&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 11px; color: light-dark(rgb(51, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;ii.&lt;/b&gt;&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;color: rgb(51, 0, 0); font-size: 11px;&quot;&gt;If you do not have free will, then your mind is a result of some&lt;br&gt;&amp;nbsp; &amp;nbsp; deterministic process, necessitating the existence of an external&lt;br&gt;&amp;nbsp; &amp;nbsp; structure or cause (within time and space, or some other law).&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;/div&gt;&lt;/div&gt;" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;fontFamily=Helvetica;fontSize=1;labelBackgroundColor=none;fillColor=#f5f5f5;gradientColor=#b3b3b3;strokeColor=#666666;verticalAlign=top;size=0.043478260869565216;" vertex="1" parent="VyjisshgyECK9-Sqm5kk-1">
          <mxGeometry x="-210" y="360" width="410" height="320" as="geometry" />
        </mxCell>
        <mxCell id="VyjisshgyECK9-Sqm5kk-12" style="edgeStyle=elbowEdgeStyle;shape=connector;curved=0;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=default;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="VyjisshgyECK9-Sqm5kk-1" source="VyjisshgyECK9-Sqm5kk-3" target="VyjisshgyECK9-Sqm5kk-13">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="740" y="520" as="sourcePoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="VyjisshgyECK9-Sqm5kk-13" value="&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Proofs by Contradiction&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;div style=&quot;text-align: left; padding-left: 1px; padding-right: 1px;&quot;&gt;&lt;font style=&quot;color: rgb(77, 77, 77);&quot;&gt;&lt;font&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;Due to the occurence of sensations, &lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;font-size: 11px; background-color: transparent; color: rgb(77, 77, 77);&quot;&gt;rationally&lt;/span&gt;&lt;font style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;&amp;nbsp;attempting to prove that an external world doesn&#39;t exist requires one of two statements:&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/font&gt;&lt;font style=&quot;background-color: transparent; color: light-dark(rgb(77, 77, 77), rgb(171, 171, 171));&quot;&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;that only the self exists (&quot;I am reality&quot;), or the complete non-existence of all things (&quot;reality doesn&#39;t exist, including myself&quot;). Both are fundamentally self-defeating, for the very existence of any sensation presupposes the existence of a conscious agent and some external structure causing the sensation (external to concsciousness). And if nothing exists, then our&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; color: rgb(77, 77, 77); font-size: 11px;&quot;&gt;non-existence (or lack of consciousness) necessarily requires those sensations to not occur.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;ul style=&quot;padding-left: 25px; padding-right: 1px;&quot;&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 11px; color: light-dark(rgb(51, 0, 0), rgb(255, 255, 255));&quot;&gt;It is fallacious to rationally invalidate the existence of externality itself, as doing so results in contradicting with the sensual premises this node is derived from.&lt;/font&gt;&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;fontFamily=Helvetica;fontSize=1;labelBackgroundColor=none;fillColor=#f5f5f5;gradientColor=#b3b3b3;strokeColor=#666666;verticalAlign=top;size=0.043478260869565216;gradientDirection=north;" vertex="1" parent="VyjisshgyECK9-Sqm5kk-1">
          <mxGeometry x="860" y="425" width="390" height="190" as="geometry" />
        </mxCell>
        <mxCell id="VyjisshgyECK9-Sqm5kk-14" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;b&gt;Notes&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;ul style=&quot;padding-left: 20px; margin-top: 4px;&quot;&gt;&lt;li&gt;&lt;font&gt;Any objection to this node requires ad hoc explanations that violate Occam’s Razor, reducing to one of two extreme positions:&lt;/font&gt;&lt;/li&gt;&lt;ul style=&quot;padding-left: 20px; margin-bottom: 4px;&quot;&gt;&lt;li&gt;&lt;span style=&quot;color: rgb(77, 77, 77);&quot;&gt;Only the self exists, which begs the question of how the self came into existence in the first place&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;color: rgb(77, 77, 77);&quot;&gt;Nothing exists at all - including the self - which requires sensations to &lt;i&gt;not&lt;/i&gt;&amp;nbsp;occur, thus invalidating this node&#39;s premises (this is already addressed in the &quot;we exist&quot; node).&lt;br&gt;&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;If one claims that only the self exists, they must explain why the self alone exists without an external reality. But this mirrors the same argument theists use for God&#39;s existence:&lt;/li&gt;&lt;ul style=&quot;padding-left: 20px; margin-top: 0px; padding-bottom: 4px;&quot;&gt;&lt;li&gt;&lt;font style=&quot;color: rgb(77, 77, 77);&quot;&gt;Just like God, the &quot;self&quot; in this scenario would exist outside of time and space, would be capable of generating complex realities ex nihilo (from absolute nothingness), and would be would be self-sustaining and independent of any external cause.&lt;/font&gt;&lt;/li&gt;&lt;li style=&quot;&quot;&gt;&lt;font color=&quot;#4d4d4d&quot; style=&quot;color: rgb(77, 77, 77);&quot;&gt;As such, if skeptics reject God on the grounds that such an entity is &quot;unjustified&quot; or &quot;too extraordinary,&quot; then they must also reject the idea that their own isolated self is the sole existence - since it requires the exact same extraordinary assumptions.&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;This node is true so long as these sensations occur (one cannot verify the existence [or non-existence] of an external world if they can&#39;t sense, feel, or think anything)&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=none;align=left;fillColor=#e6d0de;gradientColor=#d5739d;strokeColor=#996185;gradientDirection=north;verticalAlign=top;" vertex="1" parent="VyjisshgyECK9-Sqm5kk-1">
          <mxGeometry x="350" y="770" width="470" height="260" as="geometry" />
        </mxCell>
        <mxCell id="tBRKAKRQe_UZLHtQJRz1-2" style="edgeStyle=elbowEdgeStyle;shape=connector;curved=0;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=default;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" edge="1" parent="VyjisshgyECK9-Sqm5kk-1" source="tBRKAKRQe_UZLHtQJRz1-0" target="VyjisshgyECK9-Sqm5kk-3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <UserObject label="&lt;font style=&quot;font-size: 12px;&quot;&gt;We exist.&lt;/font&gt;" link="data:page/id,mfmMcbX07sLiCTksEZJi" id="tBRKAKRQe_UZLHtQJRz1-0">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;gradientColor=#97d077;strokeColor=#82b366;strokeWidth=2;fontSize=1;" vertex="1" parent="VyjisshgyECK9-Sqm5kk-1">
            <mxGeometry x="340" y="360" width="230" height="50" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="tBRKAKRQe_UZLHtQJRz1-3" style="edgeStyle=elbowEdgeStyle;shape=connector;curved=0;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=default;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" edge="1" parent="VyjisshgyECK9-Sqm5kk-1" source="tBRKAKRQe_UZLHtQJRz1-1" target="VyjisshgyECK9-Sqm5kk-3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <UserObject label="&lt;font style=&quot;font-size: 12px;&quot;&gt;An external world exists&lt;/font&gt;" link="data:page/id,nwnlQaXgrGs-5OhVyxBg" id="tBRKAKRQe_UZLHtQJRz1-1">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;gradientColor=#7ea6e0;strokeColor=#6c8ebf;strokeWidth=2;fontSize=1;" vertex="1" parent="VyjisshgyECK9-Sqm5kk-1">
            <mxGeometry x="600" y="360" width="230" height="50" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="BJN4GQEKp7-nyg8GsP0h-0" value="&lt;ul style=&quot;padding-left: 25px;&quot;&gt;&lt;li&gt;believing in your own non-existence is irrational&lt;/li&gt;&lt;li style=&quot;&quot;&gt;there are concepts thare are objectively true&lt;/li&gt;&lt;ul style=&quot;padding-left: 25px;&quot;&gt;&lt;li style=&quot;&quot;&gt;this requires logic to exist&lt;br&gt;&lt;/li&gt;&lt;li style=&quot;&quot;&gt;logic to model the world is sound&lt;/li&gt;&lt;li style=&quot;&quot;&gt;information exists&lt;/li&gt;&lt;li style=&quot;&quot;&gt;axioms and premises&lt;br&gt;&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;knowledge of something is not the thing itself&lt;br&gt;&lt;/li&gt;&lt;ul style=&quot;padding-left: 30px;&quot;&gt;&lt;li&gt;the only way to know something 100% is to sense it&lt;/li&gt;&lt;li&gt;not exactly, can be wrong... has to be worded better&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;" vertex="1" parent="VyjisshgyECK9-Sqm5kk-1">
