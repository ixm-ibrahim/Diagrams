        <UserObject label="&lt;span style=&quot;font-size: 12px;&quot;&gt;All information requires a source.&lt;/span&gt;" link="data:page/id,_ksWU1FAoSn5eXPdy180" id="Zc64t6COcdzYgmrHzigb-3">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFDEC9;gradientColor=#FFB663;strokeColor=#D69555;strokeWidth=2;fontSize=1;" parent="j4HVYzPnCFSpxK68TefG-1" vertex="1">
