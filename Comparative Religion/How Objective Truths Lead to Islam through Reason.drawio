            <mxPoint x="-4380" y="-1300" as="sourcePoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--271" value="A proof is &lt;b&gt;valid &lt;/b&gt;if the conclusions logically follow from the premises, and it is &lt;b&gt;sound &lt;/b&gt;when it is valid and is harmonious with the rest of the system" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="-4510" y="-1430" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--272" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;labelBackgroundColor=none;fontColor=default;" parent="1" source="7jwuDECKpDgqieylm1P--275" target="7jwuDECKpDgqieylm1P--291" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-4310" y="-540" as="sourcePoint" />
          </mxGeometry>
