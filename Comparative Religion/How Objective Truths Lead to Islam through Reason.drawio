          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <UserObject label="&lt;span style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;Knowledge can be true or false.&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;font style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;br&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;We label&amp;nbsp;&lt;/span&gt;&lt;i style=&quot;font-size: 12px;&quot;&gt;knowledge&lt;/i&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&amp;nbsp;as how we&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;understand information in terms of truth or falsehood.&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;If our internal models align with reality, we label that as &lt;/span&gt;&lt;i style=&quot;font-size: 12px;&quot;&gt;true&lt;/i&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;. If they do&amp;nbsp;not, we label that as &lt;/span&gt;&lt;i style=&quot;font-size: 12px;&quot;&gt;false&lt;/i&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;. As such, all understanding has a truth-value.&lt;/span&gt;" link="data:page/id,VuEyJK-5QdxOhdqgMgJb" id="GMR3rLYLVEv-W5v50Xch-5">
          <mxCell style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;size=30;fillColor=#b0e3e6;strokeColor=#0e8088;fontSize=1;strokeWidth=2;spacing=16;" parent="GMR3rLYLVEv-W5v50Xch-1" vertex="1">
            <mxGeometry x="360" y="450" width="450" height="100" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="GMR3rLYLVEv-W5v50Xch-6" style="edgeStyle=elbowEdgeStyle;shape=connector;curved=0;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=default;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" parent="GMR3rLYLVEv-W5v50Xch-1" source="GMR3rLYLVEv-W5v50Xch-5" target="GMR3rLYLVEv-W5v50Xch-7" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="430" y="497" as="sourcePoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="GMR3rLYLVEv-W5v50Xch-7" value="&lt;b&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Objections&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/font&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;div&gt;&lt;div style=&quot;text-align: left; padding-left: 1px; padding-right: 1px;&quot;&gt;&lt;div style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); padding-left: 1px; padding-right: 1px; display: inline !important;&quot;&gt;&lt;font style=&quot;color: rgb(77, 77, 77);&quot;&gt;&lt;b style=&quot;background-color: transparent; font-size: 11px;&quot;&gt;1.&lt;/b&gt;&lt;span style=&quot;background-color: transparent; font-size: 11px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;span style=&quot;background-color: transparent; text-align: center; font-size: 11px;&quot;&gt;&lt;font color=&quot;#4d4d4d&quot;&gt;All knowledge is internal, so there is no meaningful concept of &quot;true&quot; or &quot;false&quot;.&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;div style=&quot;background-color: transparent;&quot;&gt;&lt;ul style=&quot;padding-left: 25px; padding-right: 1px; margin-bottom: 2px;&quot;&gt;&lt;li&gt;&lt;font color=&quot;#330000&quot;&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;The premise that “&lt;b&gt;we experience an external reality&lt;/b&gt;” entails that there is something for our internal model to match or fail to match. The concepts of &quot;true&quot; and &quot;false&quot; are precisely about whether one’s representations match that external object or set of states.&lt;/span&gt;&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;div style=&quot;padding-left: 1px; padding-right: 1px;&quot;&gt;&lt;font style=&quot;color: rgb(77, 77, 77);&quot;&gt;&lt;b style=&quot;background-color: transparent; font-size: 11px;&quot;&gt;2.&lt;/b&gt;&lt;span style=&quot;background-color: transparent; font-size: 11px;&quot;&gt;&amp;nbsp;Our internal models will never fully encompass the complexity of reality. And w&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 11px;&quot;&gt;&lt;font color=&quot;#4d4d4d&quot;&gt;e might&lt;br&gt;&amp;nbsp; &amp;nbsp; never be certain if our knowledge is true, so it’s incorrect (or at least impractical) to&lt;br&gt;&amp;nbsp; &amp;nbsp; label anything &quot;true&quot; or &quot;false.&quot;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;ul style=&quot;padding-left: 25px; padding-right: 1px;&quot;&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 11px; color: light-dark(rgb(51, 0, 0), rgb(255, 255, 255));&quot;&gt;Even if we are incapable of having perfect knowledge of reality, it does not negative the &lt;i&gt;concept&lt;/i&gt;&amp;nbsp;that there &lt;i&gt;is&lt;/i&gt;&amp;nbsp;a truth-value.&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;font color=&quot;#330000&quot;&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;Our inability to check absolute correctness does not imply that truth and falsehood doen&#39;t exist - rather, it would only makes it impossible for us to know which is which. Future nodes will explore if it&#39;s possible to know anything is true or false.&lt;/span&gt;&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;div style=&quot;background-color: transparent; padding-left: 1px; padding-right: 1px; display: inline !important;&quot;&gt;&lt;font style=&quot;color: rgb(77, 77, 77);&quot;&gt;&lt;b style=&quot;background-color: transparent; font-size: 11px;&quot;&gt;3.&lt;/b&gt;&lt;span style=&quot;background-color: transparent; font-size: 11px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;span style=&quot;background-color: transparent; font-size: 11px;&quot;&gt;&lt;font color=&quot;#4d4d4d&quot;&gt;If reality could be illusory or if we’re in a simulation, &quot;true&quot; and &quot;false&quot; are meaningless.&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;div style=&quot;background-color: transparent; margin-bottom: 1px; margin-top: 1px; padding-left: 25px; padding-right: 1px;&quot;&gt;&lt;font color=&quot;#330000&quot;&gt;&lt;span style=&quot;font-size: 11px; background-color: transparent;&quot;&gt;This node does claim to identify the true nature of reality; rather it merely defines the truth-value for any piece of knowledge.&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;Even in the case where every single one of our sensations (physical, emotional, and mental) are being simulated such that each one contradicts reality, it would only indicate that all possible knowledge is false (not that the concepts of truth and falsehood don&#39;t exist).&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;fontFamily=Helvetica;fontSize=1;labelBackgroundColor=none;fillColor=#f5f5f5;gradientColor=#b3b3b3;strokeColor=#666666;verticalAlign=top;size=0.043478260869565216;" parent="GMR3rLYLVEv-W5v50Xch-1" vertex="1">
          <mxGeometry x="-280" y="350" width="480" height="300" as="geometry" />
        </mxCell>
        <mxCell id="GMR3rLYLVEv-W5v50Xch-8" style="edgeStyle=elbowEdgeStyle;shape=connector;curved=0;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=default;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" parent="GMR3rLYLVEv-W5v50Xch-1" source="GMR3rLYLVEv-W5v50Xch-5" target="GMR3rLYLVEv-W5v50Xch-9" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="740" y="497" as="sourcePoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="GMR3rLYLVEv-W5v50Xch-9" value="&lt;b&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Proofs by Contradiction&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;div style=&quot;text-align: left; padding-left: 1px; padding-right: 1px;&quot;&gt;&lt;div style=&quot;padding-left: 1px; padding-right: 1px;&quot;&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;This node is not a deduction but a definition - a means of assigning value to our understanding. But suppose we dismissed that metric altogether, such that the concepts of truth and falsehood simply could not be meaningfully applied to any piece of understanding. In that scenario, every claim would be equally valid (or equally meaningless) making it pointless to distinguish accurate models of reality from inaccurate ones in the first place.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;padding-left: 1px; padding-right: 1px;&quot;&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;Applied to this node’s premises, it would then be just as &quot;valid&quot; (or &quot;meaningless&quot;) to say &quot;&lt;b&gt;we exist&lt;/b&gt;&quot; as it would be to say &quot;we don’t exist&quot;. However, clearly there is no reality in which &quot;we don’t exist&quot; and such a node doesn&#39;t exist, so there must be some legitimate way to assess how &quot;true&quot; a statement is. Hence, a metric of truth and falsehood must be necessary if our understanding of reality is to have any value.&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;ul style=&quot;padding-left: 25px; padding-right: 1px;&quot;&gt;&lt;li&gt;&lt;font color=&quot;#330000&quot;&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;This node is self‐referential: it defines &quot;truth&quot; and &quot;falsehood&quot; as how much our understanding aligns with reality, while also using that notion of &quot;truth&quot; to verify this definition. In that sense, it’s analogous to Gödel’s self‐referential statements: if this node were false, then none of its premises could even form a meaningful definition (as contradictory nodes would be derived as well). But, if it is true, then the definition holds up.&lt;/span&gt;&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;fontFamily=Helvetica;fontSize=1;labelBackgroundColor=none;fillColor=#f5f5f5;gradientColor=#b3b3b3;strokeColor=#666666;verticalAlign=top;size=0.043478260869565216;gradientDirection=north;" parent="GMR3rLYLVEv-W5v50Xch-1" vertex="1">
          <mxGeometry x="970" y="365" width="430" height="270" as="geometry" />
        </mxCell>
        <mxCell id="GMR3rLYLVEv-W5v50Xch-10" style="edgeStyle=elbowEdgeStyle;shape=connector;curved=0;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=default;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" parent="GMR3rLYLVEv-W5v50Xch-1" source="GMR3rLYLVEv-W5v50Xch-12" target="GMR3rLYLVEv-W5v50Xch-5" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="585" y="390" as="sourcePoint" />
          </mxGeometry>
        </mxCell>
        <UserObject label="&lt;span style=&quot;font-size: 12px;&quot;&gt;Truth is not falsehood.&lt;/span&gt;" link="data:page/id,s4b5a8lz5EKkWFNapb_4" id="GMR3rLYLVEv-W5v50Xch-11">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;gradientColor=#97d077;strokeColor=#82b366;strokeWidth=2;fontSize=1;" parent="GMR3rLYLVEv-W5v50Xch-1" vertex="1">
            <mxGeometry x="340" y="610" width="230" height="50" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;span style=&quot;font-size: 12px;&quot;&gt;Understanding is an internal model of reality.&lt;/span&gt;" link="data:page/id,ktynhSzzUmXId41NQhS_" id="GMR3rLYLVEv-W5v50Xch-12">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFDEC9;gradientColor=#FFB663;strokeColor=#D69555;strokeWidth=2;fontSize=1;" parent="GMR3rLYLVEv-W5v50Xch-1" vertex="1">
            <mxGeometry x="460" y="340" width="250" height="50" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="GMR3rLYLVEv-W5v50Xch-13" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;div style=&quot;font-size: 11px;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;b&gt;Notes&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 11px; text-align: left;&quot;&gt;&lt;ul style=&quot;padding-left: 20px; margin-top: 4px;&quot;&gt;&lt;li&gt;This node only defines truth and falsehood and does not explore certainty and uncertainty.&lt;/li&gt;&lt;ul style=&quot;padding-left: 20px; margin-bottom: 4px;&quot;&gt;&lt;li&gt;&lt;span style=&quot;color: rgb(77, 77, 77);&quot;&gt;It only shows that knowledge can be one of two types: true and false&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;color: rgb(77, 77, 77);&quot;&gt;It &lt;i&gt;could&lt;/i&gt;&amp;nbsp;be that everything someone knows is true, or that everything they know is false - future nodes will explore if either is possible&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;Unlike information, which is defined as the raw content of our experiences (which either occurs or does not) without being subject to interpretation or rationalization, knowledge is our interpretation of that information, and can therefore be evaluated, questioned, and judged as true or false.&lt;/li&gt;&lt;/ul&gt;&lt;div&gt;&lt;font color=&quot;#4d4d4d&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=1;labelBackgroundColor=none;align=left;fillColor=#e6d0de;gradientColor=#d5739d;strokeColor=#996185;gradientDirection=north;verticalAlign=top;" parent="GMR3rLYLVEv-W5v50Xch-1" vertex="1">
          <mxGeometry x="360" y="737" width="450" height="163" as="geometry" />
        </mxCell>
        <mxCell id="GMR3rLYLVEv-W5v50Xch-14" style="edgeStyle=elbowEdgeStyle;shape=connector;curved=0;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=default;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;dashed=1;" parent="GMR3rLYLVEv-W5v50Xch-1" source="GMR3rLYLVEv-W5v50Xch-15" target="GMR3rLYLVEv-W5v50Xch-12" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="585" y="340" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <UserObject label="&lt;font style=&quot;font-size: 12px;&quot;&gt;We experience an external reality.&lt;/font&gt;" link="data:page/id,BJJeBhxEE8Z-n9mm-ttt" id="GMR3rLYLVEv-W5v50Xch-15">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;gradientColor=#ea6b66;strokeColor=#b85450;strokeWidth=2;fontSize=1;" parent="GMR3rLYLVEv-W5v50Xch-1" vertex="1">
            <mxGeometry x="460" y="250" width="250" height="50" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" link="data:page/id,likM1HnRl3nmRLB4e34p" id="GMR3rLYLVEv-W5v50Xch-16">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;fillColor=none;strokeColor=none;" parent="GMR3rLYLVEv-W5v50Xch-1" vertex="1">
            <mxGeometry x="410" y="105" width="350" height="25" as="geometry" />
          </mxCell>
