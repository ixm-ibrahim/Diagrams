          </mxGeometry>
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--206" style="rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.011;exitY=0.944;exitDx=0;exitDy=0;entryX=0.994;entryY=0.056;entryDx=0;entryDy=0;dashed=1;dashPattern=12 12;exitPerimeter=0;entryPerimeter=0;startArrow=oval;startFill=1;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--207" target="7jwuDECKpDgqieylm1P--388">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--207" value="To experience reality is for reality to transmit information that our senses recieve" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="2120" y="-2000" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--208" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=none;fontColor=default;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--210" target="7jwuDECKpDgqieylm1P--268">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--209" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=none;fontColor=default;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--210" target="7jwuDECKpDgqieylm1P--271">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--210" value="A &lt;b&gt;proof &lt;/b&gt;is a logical argument that demonstrates the truth of a statement based on a series of deductions from axioms and previously established theorems using the rules of inference." style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="-4540" y="-1570" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--211" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;labelBackgroundColor=none;fontColor=default;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--204" target="7jwuDECKpDgqieylm1P--215">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--212" value="The most basic information that can be shared is a model of our own existence" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="2930" y="-910" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--213" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;labelBackgroundColor=none;fontColor=default;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--215" target="7jwuDECKpDgqieylm1P--244">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2800" y="220" as="sourcePoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--214" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=none;fontColor=default;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--215" target="7jwuDECKpDgqieylm1P--222">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--215" value="Sensory input is a proof of existence: no sensual agent can logically doubt their own existence while they experience pleasure, pain, or some other sensation" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="2660" y="-910" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--216" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.25;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=none;fontColor=default;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--217" target="7jwuDECKpDgqieylm1P--256">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--217" value="&lt;b&gt;Consistency&lt;/b&gt;: a set of statements are consistent if there is no statement such that both the statement and its negation are provable from the whole system, otherwise it&#39;s inconsistent - aka free from contradiction" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="-5230" y="-1680" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--218" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=none;fontColor=default;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--219" target="7jwuDECKpDgqieylm1P--210">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--219" value="An &lt;b&gt;axiom &lt;/b&gt;(or postulate) is a fundamental principle that serves as a starting point for a logical or mathematical system" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="-4870" y="-1680" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--220" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=none;fontColor=default;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--221" target="7jwuDECKpDgqieylm1P--391">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="-5020" y="-1310" />
              <mxPoint x="-5700" y="-1310" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--221" value="&lt;span style=&quot;text-align: left;&quot;&gt;The notion of truth for axioms is not absolute but relative to the consistency and utility of the logical system, trying to find the best model of reality there can be&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="-5140" y="-1430" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--222" value="&lt;span style=&quot;text-align: left;&quot;&gt;Our observation shows that reality is consistently &quot;true&quot;, and so axioms must be relative to reality in order to be&lt;/span&gt;&amp;nbsp;logically consistent with the framework of the system" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="2380" y="-800" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--223" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=none;fontColor=default;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--231" target="7jwuDECKpDgqieylm1P--173">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2260" y="-1090" as="sourcePoint" />
          </mxGeometry>
        </mxCell>
