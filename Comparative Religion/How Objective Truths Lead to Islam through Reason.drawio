        <UserObject label="&lt;font style=&quot;font-size: 12px;&quot;&gt;Knowledge can be true or false.&lt;/font&gt;" link="data:page/id,7PXsJPQ2AF7nXEVdAFUW" id="YfQTRhn89XA0bx_5e_hw-0">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;gradientColor=#7ea6e0;strokeColor=#6c8ebf;strokeWidth=2;fontSize=1;" parent="VRDFq0wFc6pFJHJ383-H-1" vertex="1">
