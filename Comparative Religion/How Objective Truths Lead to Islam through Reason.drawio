        </mxCell>
        <UserObject label="&lt;font style=&quot;font-size: 12px;&quot;&gt;Information can be right or wrong&lt;/font&gt;" link="data:page/id,YQBf6YmFWLRNtrCXEbi-" id="0CvlbLKx0ee9BSFNSc6A-21">
