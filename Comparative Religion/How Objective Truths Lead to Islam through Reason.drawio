        <mxCell id="7jwuDECKpDgqieylm1P--246" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=none;fontColor=default;" parent="1" source="7jwuDECKpDgqieylm1P--248" target="7jwuDECKpDgqieylm1P--310" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--247" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="7jwuDECKpDgqieylm1P--248" target="7jwuDECKpDgqieylm1P--664" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--248" value="As such, not everything needs to be proven to know something is true: once the core foundation (the main 20%) of a system is shown to be true, the subsequent conclusions (the remaining 80%) can also be safely assumed/induced to be true" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1">
          <mxGeometry x="-5150" y="-500" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--249" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=none;fontColor=default;" parent="1" source="7jwuDECKpDgqieylm1P--250" target="7jwuDECKpDgqieylm1P--293" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--250" value="In a system without axioms, deduction, or a grounding in reality, all claims can be made with any explanation" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="-5440" y="-760" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--251" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;labelBackgroundColor=none;fontColor=default;" parent="1" source="7jwuDECKpDgqieylm1P--252" target="7jwuDECKpDgqieylm1P--210" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-4380" y="-1600" as="sourcePoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--252" value="&lt;b&gt;Deduction &lt;/b&gt;is a logical process in which a specific conclusion is drawn from general premises, ensuring that the&amp;nbsp;conclusion&amp;nbsp;must necessarily follow from the given premises" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="-4540" y="-1680" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--253" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.25;entryY=0;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;labelBackgroundColor=none;fontColor=default;" parent="1" source="7jwuDECKpDgqieylm1P--256" target="7jwuDECKpDgqieylm1P--268" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-4980" y="-1450" as="sourcePoint" />
            <mxPoint x="-4730" y="-1430" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--254" style="rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=none;fontColor=default;edgeStyle=orthogonalEdgeStyle;" parent="1" source="7jwuDECKpDgqieylm1P--256" target="7jwuDECKpDgqieylm1P--293" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="-5090" y="-1460" />
              <mxPoint x="-5500" y="-1460" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--255" style="rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.978;exitY=0.966;exitDx=0;exitDy=0;entryX=0.019;entryY=0.025;entryDx=0;entryDy=0;entryPerimeter=0;exitPerimeter=0;labelBackgroundColor=none;fontColor=default;dashed=1;dashPattern=12 12;startArrow=oval;startFill=1;" parent="1" source="7jwuDECKpDgqieylm1P--256" target="7jwuDECKpDgqieylm1P--367" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--256" value="The soundness/truthfulness of an axiom is shown through the consistency of the system that follows it, while&amp;nbsp;an untrue or false axiom is one leads to inconsistent or contradictory deductions" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="-5140" y="-1570" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--257" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.75;entryY=0;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;labelBackgroundColor=none;fontColor=default;" parent="1" source="7jwuDECKpDgqieylm1P--219" target="7jwuDECKpDgqieylm1P--256" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-4690" y="-1600" as="sourcePoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--258" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.75;entryY=0;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;labelBackgroundColor=none;fontColor=default;" parent="1" source="7jwuDECKpDgqieylm1P--260" target="7jwuDECKpDgqieylm1P--210" edge="1">
          <mxGeometry relative="1" as="geometry">
