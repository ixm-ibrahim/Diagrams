          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--275" value="The more axioms and theorems a system has, the more narrow the range of possible alternative explanations becomes and the easier it is to identify soundness" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="-4580" y="-760" width="240" height="60" as="geometry" />
        </mxCell>
