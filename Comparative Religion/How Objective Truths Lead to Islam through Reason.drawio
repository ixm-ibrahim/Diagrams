        <mxCell id="7jwuDECKpDgqieylm1P--187" value="Feedback loop: new patterns lead to more complex reinforcements, which leads to more complex patterns" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" vertex="1" parent="1">
