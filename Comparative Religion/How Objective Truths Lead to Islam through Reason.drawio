        <UserObject label="&lt;font style=&quot;font-size: 12px;&quot;&gt;We experience an external reality.&lt;/font&gt;" link="data:page/id,BJJeBhxEE8Z-n9mm-ttt" id="iJ3tdISiJrQzXHI7dPVi-3">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;gradientColor=#ea6b66;strokeColor=#b85450;strokeWidth=2;fontSize=1;" parent="uaGaVBngoMjA7IRcVmLT-1" vertex="1">
            <mxGeometry x="460" y="250" width="250" height="50" as="geometry" />
