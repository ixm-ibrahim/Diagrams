          </mxCell>
        </UserObject>
        <mxCell id="W3f5UINCB4utkoovJ-PE-23" value="upon contradiction, refinement leads to truth faster than ignorance" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;" parent="mExRIxhNE1BHIPu0LiUs-1" vertex="1">
          <mxGeometry x="4210" y="4480" width="340" height="30" as="geometry" />
        </mxCell>
        <mxCell id="W3f5UINCB4utkoovJ-PE-24" value="contradictions are a path to truth (more than a path to ignorance)" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;" parent="mExRIxhNE1BHIPu0LiUs-1" vertex="1">
