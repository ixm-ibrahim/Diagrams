        <mxCell id="taM9z-ia8H7w3pWIfFxK-0" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Proofs by Contradiction&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;div style=&quot;padding-left: 0px; padding-right: 0px; margin-bottom: 4px;&quot;&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(51, 0, 0), rgb(51, 0, 0));&quot;&gt;This node is a definition, not a deduction - a label for something previously established to be true. As such, assuming this node to be false necessarily requires the premises are false.&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;padding-left: 1px; padding-right: 1px; margin-bottom: 2px;&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(77, 77, 77), rgb(77, 77, 77));&quot;&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;&lt;b style=&quot;&quot;&gt;1.&lt;/b&gt; Assume: logic (the relationship between difference pieces of information) does not&lt;br&gt;&amp;nbsp; &amp;nbsp; exist.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;padding-left: 1px; padding-right: 1px; margin-bottom: 2px;&quot;&gt;&lt;div style=&quot;padding-left: 1px; padding-right: 1px; margin-bottom: 2px;&quot;&gt;&lt;b style=&quot;background-color: transparent; color: rgb(77, 77, 77); font-size: 11px;&quot;&gt;2.&lt;/b&gt;&lt;span style=&quot;background-color: transparent; color: rgb(77, 77, 77); font-size: 11px;&quot;&gt;&amp;nbsp;Different pieces of information can&#39;t be structured or organized to relate to each other&lt;br&gt;&amp;nbsp; &amp;nbsp; in any systematic way (by definition).&lt;/span&gt;&lt;/div&gt;&lt;font style=&quot;&quot;&gt;&lt;div style=&quot;padding-right: 1px; padding-left: 1px; margin-bottom: 2px; padding-bottom: 0px;&quot;&gt;&lt;font style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;&lt;b style=&quot;color: rgb(77, 77, 77);&quot;&gt;3.&lt;/b&gt;&lt;span style=&quot;color: rgb(77, 77, 77);&quot;&gt;&amp;nbsp;The pieces of information that define logic (this node) and that it doesn&#39;t exist &lt;/span&gt;&lt;span style=&quot;color: rgb(77, 77, 77);&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(133, 106, 106), rgb(133, 106, 106));&quot;&gt;(Step 1)&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;color: rgb(77, 77, 77);&quot;&gt; can&#39;t relate to each other in any way &lt;/span&gt;&lt;span style=&quot;color: rgb(77, 77, 77);&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(133, 106, 106), rgb(133, 106, 106));&quot;&gt;(Step 2)&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;color: rgb(77, 77, 77);&quot;&gt;.&lt;/span&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;padding-right: 1px; padding-left: 1px; margin-bottom: 2px; padding-bottom: 0px;&quot;&gt;&lt;b style=&quot;background-color: transparent; font-size: 11px; color: rgb(77, 77, 77);&quot;&gt;4.&lt;/b&gt;&lt;span style=&quot;background-color: transparent; font-size: 11px; color: rgb(77, 77, 77);&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;font style=&quot;color: light-dark(rgb(77, 77, 77), rgb(77, 77, 77));&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 11px; color: rgb(77, 77, 77);&quot;&gt;&lt;font style=&quot;&quot;&gt;Steps 2 and 3&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 11px; color: rgb(77, 77, 77);&quot;&gt; &lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 11px; color: rgb(77, 77, 77);&quot;&gt;(both of which are pieces of information themselves) relate to each&lt;br&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: rgb(77, 77, 77); font-size: 11px; background-color: transparent;&quot;&gt;other such that one can be&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(77, 77, 77), rgb(171, 171, 171)); font-size: 11px;&quot;&gt;deduced from the other.&lt;/span&gt;&lt;/div&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;padding-left: 1px; padding-right: 1px; margin-bottom: 4px;&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;&lt;b style=&quot;color: rgb(77, 77, 77);&quot;&gt;5.&lt;/b&gt;&lt;span style=&quot;color: rgb(77, 77, 77);&quot;&gt;&amp;nbsp;Contradiction: to deny &quot;logic&quot; as a valid definition &lt;/span&gt;&lt;span style=&quot;color: rgb(77, 77, 77);&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(133, 106, 106), rgb(133, 106, 106));&quot;&gt;(Step 1)&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;color: rgb(77, 77, 77);&quot;&gt;, we must accept that logic&lt;br&gt;&amp;nbsp; &amp;nbsp; exists&lt;/span&gt;&lt;span style=&quot;color: rgb(77, 77, 77);&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: rgb(77, 77, 77);&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(133, 106, 106), rgb(133, 106, 106));&quot;&gt;(Step 4)&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;color: rgb(77, 77, 77);&quot;&gt;.&lt;/span&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font color=&quot;#330000&quot;&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;If you try to argue there’s no logic, you’re already using a connection of ideas to reach that conclusion - which is how logic is defined. So you end up presupposing and relying on exactly what you’re trying to deny.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;fontFamily=Helvetica;fontSize=1;labelBackgroundColor=none;fillColor=#f5f5f5;gradientColor=#b3b3b3;strokeColor=#666666;verticalAlign=top;size=0.043478260869565216;gradientDirection=north;align=left;" parent="VRDFq0wFc6pFJHJ383-H-1" vertex="1">
          <mxGeometry x="870" y="370" width="480" height="260" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="LS2" id="7PXsJPQ2AF7nXEVdAFUW">
    <mxGraphModel dx="2154" dy="652" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1654" background="#808080" math="0" shadow="1" adaptiveColors="none">
      <root>
        <mxCell id="squETe9dAdE64J5XPLQU-0" />
        <mxCell id="squETe9dAdE64J5XPLQU-1" parent="squETe9dAdE64J5XPLQU-0" />
        <UserObject label="&lt;b style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 32px;&quot;&gt;How Objective Truths Lead to Islam Through Reason&lt;br&gt;&lt;/span&gt;&lt;font style=&quot;font-size: 4px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;i style=&quot;font-size: 12px;&quot;&gt;&lt;font style=&quot;font-size: 18px; color: rgb(102, 102, 102);&quot;&gt;Logical Systems (Node 2)&lt;/font&gt;&lt;/i&gt;&lt;/b&gt;" link="data:page/id,q1TZ7uQ2KXKU_8ORelwv" id="squETe9dAdE64J5XPLQU-2">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6d0de;strokeColor=#996185;gradientColor=#d5739d;fontSize=1;" parent="squETe9dAdE64J5XPLQU-1" vertex="1">
            <mxGeometry x="80" y="40" width="1010" height="110" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="squETe9dAdE64J5XPLQU-3" style="edgeStyle=elbowEdgeStyle;shape=connector;curved=0;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=default;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" parent="squETe9dAdE64J5XPLQU-1" source="squETe9dAdE64J5XPLQU-4" target="squETe9dAdE64J5XPLQU-10" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="8GN2kHdML_jIbyp9E5i6-1" style="edgeStyle=elbowEdgeStyle;shape=connector;curved=0;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=default;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" parent="squETe9dAdE64J5XPLQU-1" source="squETe9dAdE64J5XPLQU-4" target="8GN2kHdML_jIbyp9E5i6-0" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <UserObject label="&lt;span style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;Knowledge can be true or false.&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;font style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;br&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;We label&amp;nbsp;&lt;/span&gt;&lt;i style=&quot;font-size: 12px;&quot;&gt;knowledge&lt;/i&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&amp;nbsp;as the relationship between reality and our understanding&lt;/span&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;.&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;If our internal model aligns with reality, we label that as &lt;/span&gt;&lt;i style=&quot;font-size: 12px;&quot;&gt;true&lt;/i&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;. If it does not, we label that as &lt;/span&gt;&lt;i style=&quot;font-size: 12px;&quot;&gt;false&lt;/i&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;. As such, all understanding has a truth-value.&lt;/span&gt;" link="data:page/id,VuEyJK-5QdxOhdqgMgJb" id="squETe9dAdE64J5XPLQU-4">
          <mxCell style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;size=30;fillColor=#b0e3e6;strokeColor=#0e8088;fontSize=1;strokeWidth=2;spacing=16;" parent="squETe9dAdE64J5XPLQU-1" vertex="1">
            <mxGeometry x="350" y="450" width="470" height="100" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="squETe9dAdE64J5XPLQU-5" style="edgeStyle=elbowEdgeStyle;shape=connector;curved=0;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=default;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" parent="squETe9dAdE64J5XPLQU-1" source="squETe9dAdE64J5XPLQU-4" target="squETe9dAdE64J5XPLQU-6" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="430" y="497" as="sourcePoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="squETe9dAdE64J5XPLQU-6" value="&lt;b&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Objections&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/font&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;div&gt;&lt;div style=&quot;text-align: left; padding-left: 1px; padding-right: 1px;&quot;&gt;&lt;div style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); padding-left: 1px; padding-right: 1px; display: inline !important;&quot;&gt;&lt;font style=&quot;color: rgb(77, 77, 77);&quot;&gt;&lt;b style=&quot;background-color: transparent; font-size: 11px;&quot;&gt;1.&lt;/b&gt;&lt;span style=&quot;background-color: transparent; font-size: 11px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;span style=&quot;background-color: transparent; text-align: center; font-size: 11px;&quot;&gt;&lt;font color=&quot;#4d4d4d&quot;&gt;All knowledge is internal, so there can&#39;t be meaningful concepts of &quot;true&quot; or &quot;false&quot;.&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;div style=&quot;background-color: transparent;&quot;&gt;&lt;ul style=&quot;padding-left: 25px; padding-right: 1px; margin-bottom: 2px;&quot;&gt;&lt;li&gt;&lt;font color=&quot;#330000&quot;&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;The premise that we experience an external reality means there is something for our internal model to correspond to - or fail to correspond to. The very concepts of &quot;true&quot; and &quot;false&quot; are then only meaningful in that context: they refer to the accuracy in which our internal representations match something external.&lt;/span&gt;&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;div style=&quot;padding-left: 1px; padding-right: 1px;&quot;&gt;&lt;font style=&quot;color: rgb(77, 77, 77);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 11px;&quot;&gt;&lt;b&gt;2.&lt;/b&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 11px;&quot;&gt;&amp;nbsp;Our internal models will never fully encompass the complexity of reality. And w&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 11px;&quot;&gt;&lt;font color=&quot;#4d4d4d&quot;&gt;e might&lt;br&gt;&amp;nbsp; &amp;nbsp; never be certain if our knowledge is true, so it’s incorrect (or at least impractical or&lt;br&gt;&amp;nbsp; &amp;nbsp; perhaps&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;color: rgb(77, 77, 77); font-size: 11px; background-color: transparent;&quot;&gt;meaningless) to&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(77, 77, 77), rgb(171, 171, 171)); background-color: transparent; font-size: 11px;&quot;&gt;label anything &quot;true&quot; or &quot;false.&quot;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;ul style=&quot;padding-left: 25px; padding-right: 1px;&quot;&gt;&lt;li&gt;&lt;font style=&quot;color: light-dark(rgb(51, 0, 0), rgb(51, 0, 0));&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;Even if perfect certainty is unattainable&lt;/span&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;, it does not invalidate the &lt;/span&gt;&lt;i style=&quot;font-size: 11px;&quot;&gt;principle&lt;/i&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;&amp;nbsp;that there &lt;/span&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;is&lt;/span&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;&amp;nbsp;a truth-value.&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;Our inability to know for sure whether a belief is true doesn’t mean truth and falsehood don’t exist - it only means we may not know &lt;i style=&quot;&quot;&gt;whic&lt;/i&gt;h is which. Later nodes will explore whether and how truth can be identified.&lt;/span&gt;&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;div style=&quot;background-color: transparent; padding-left: 1px; padding-right: 1px; display: inline !important;&quot;&gt;&lt;font style=&quot;color: rgb(77, 77, 77);&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 11px;&quot;&gt;&lt;b&gt;3.&lt;/b&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 11px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font&gt;&lt;span style=&quot;color: rgb(77, 77, 77); font-size: 11px;&quot;&gt;If reality is illusory or simulated&lt;/span&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(77, 77, 77), rgb(77, 77, 77));&quot;&gt;, then &quot;true&quot; and &quot;false&quot; become meaningless.&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;div style=&quot;background-color: transparent; margin-bottom: 1px; margin-top: 1px; padding-left: 25px; padding-right: 1px;&quot;&gt;&lt;font color=&quot;#330000&quot;&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;This node doesn’t depend on identifying the ultimate nature of reality. It simply defines truth-value relative to whatever reality is. Even in a fully simulated environment, there is still the reality of an underlying structure (the simulation itself). In that case, knowledge is true if it matches reality, and false if it doesn’t. Truth and falsehood still exist - they just would apply to a different level of reality.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;fontFamily=Helvetica;fontSize=1;labelBackgroundColor=none;fillColor=#f5f5f5;gradientColor=#b3b3b3;strokeColor=#666666;verticalAlign=top;size=0.043478260869565216;" parent="squETe9dAdE64J5XPLQU-1" vertex="1">
          <mxGeometry x="-220" y="360" width="490" height="280" as="geometry" />
        </mxCell>
        <mxCell id="squETe9dAdE64J5XPLQU-7" style="edgeStyle=elbowEdgeStyle;shape=connector;curved=0;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=default;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" parent="squETe9dAdE64J5XPLQU-1" source="squETe9dAdE64J5XPLQU-4" target="OgN7uMYAacG9BayYqLVh-0" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="740" y="497" as="sourcePoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="squETe9dAdE64J5XPLQU-9" style="edgeStyle=elbowEdgeStyle;shape=connector;curved=0;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=default;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" parent="squETe9dAdE64J5XPLQU-1" source="squETe9dAdE64J5XPLQU-13" target="squETe9dAdE64J5XPLQU-4" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="585" y="390" as="sourcePoint" />
          </mxGeometry>
        </mxCell>
        <UserObject label="&lt;span style=&quot;font-size: 12px;&quot;&gt;Truth is not falsehood.&lt;/span&gt;" link="data:page/id,s4b5a8lz5EKkWFNapb_4" id="squETe9dAdE64J5XPLQU-10">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;gradientColor=#97d077;strokeColor=#82b366;strokeWidth=2;fontSize=1;" parent="squETe9dAdE64J5XPLQU-1" vertex="1">
            <mxGeometry x="340" y="610" width="230" height="50" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;span style=&quot;font-size: 12px;&quot;&gt;Understanding can be accurate or inaccurate.&lt;/span&gt;" link="data:page/id,FHEVo7xXrC0qPuqc3gVQ" id="squETe9dAdE64J5XPLQU-13">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFDEC9;gradientColor=#FFB663;strokeColor=#D69555;strokeWidth=2;fontSize=1;" parent="squETe9dAdE64J5XPLQU-1" vertex="1">
            <mxGeometry x="460" y="340" width="250" height="50" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="squETe9dAdE64J5XPLQU-14" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;div style=&quot;font-size: 11px;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;b&gt;Notes&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 11px; text-align: left;&quot;&gt;&lt;ul style=&quot;padding-left: 20px; margin-top: 4px; margin-bottom: 4px;&quot;&gt;&lt;li&gt;This node only defines truth and falsehood in princple, and does not explore certainty and uncertainty.&lt;/li&gt;&lt;ul style=&quot;padding-left: 20px; margin-bottom: 4px;&quot;&gt;&lt;li&gt;&lt;span style=&quot;color: rgb(77, 77, 77);&quot;&gt;It only shows that knowledge can be one of two types: true and false&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;color: rgb(77, 77, 77);&quot;&gt;It &lt;i&gt;could&lt;/i&gt;&amp;nbsp;be that everything someone knows is true, or that everything they know is false - future nodes will explore if either is possible&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;This node applies to an indivisible piece of information, not to a collection of them&lt;/li&gt;&lt;ul style=&quot;padding-left: 20px; margin-bottom: 4px;&quot;&gt;&lt;li&gt;&lt;font style=&quot;color: light-dark(rgb(77, 77, 77), rgb(77, 77, 77));&quot;&gt;A multitude of information has &lt;i&gt;n!&lt;/i&gt;&amp;nbsp;permutations for each statement to be true or false, meaning that only&amp;nbsp;&lt;i&gt;1 / n!&lt;/i&gt;&amp;nbsp;cases will have all statements being true or false (with a spectrum in between)&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;Unlike information, which is defined as the raw content of our experiences (which either occurs or does not) without being subject to interpretation or rationalization, knowledge is our interpretation of that information, and can therefore be evaluated, questioned, and judged as true or false.&lt;/li&gt;&lt;/ul&gt;&lt;div&gt;&lt;ul style=&quot;font-size: 1px; padding-left: 20px; margin-top: 4px;&quot;&gt;&lt;li style=&quot;font-size: 11px;&quot;&gt;This node functions the same way as&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Gödel’s self‐referential statements&lt;/span&gt;&lt;/li&gt;&lt;ul style=&quot;padding-left: 20px; margin-bottom: 4px; font-size: 11px;&quot;&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;color: rgb(77, 77, 77);&quot;&gt;I&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;color: rgb(77, 77, 77);&quot;&gt;f this node were false, then none of its premises could even form a meaningful definition (contradicting the axioms that we feel senations, which are established to be true without the use of reason).&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;color: light-dark(rgb(77, 77, 77), rgb(77, 77, 77));&quot;&gt;If this node is true, then the definition will hold up and be consistent with the rest of the system.&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#4d4d4d&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=1;labelBackgroundColor=none;align=left;fillColor=#e6d0de;gradientColor=#d5739d;strokeColor=#996185;gradientDirection=north;verticalAlign=top;" parent="squETe9dAdE64J5XPLQU-1" vertex="1">
          <mxGeometry x="310" y="737" width="550" height="243" as="geometry" />
        </mxCell>
        <mxCell id="squETe9dAdE64J5XPLQU-15" style="edgeStyle=elbowEdgeStyle;shape=connector;curved=0;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=default;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;dashed=1;" parent="squETe9dAdE64J5XPLQU-1" source="squETe9dAdE64J5XPLQU-16" target="squETe9dAdE64J5XPLQU-13" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="585" y="340" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <UserObject label="&lt;font style=&quot;font-size: 12px;&quot;&gt;We experience an external reality.&lt;/font&gt;" link="data:page/id,BJJeBhxEE8Z-n9mm-ttt" id="squETe9dAdE64J5XPLQU-16">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;gradientColor=#ea6b66;strokeColor=#b85450;strokeWidth=2;fontSize=1;" parent="squETe9dAdE64J5XPLQU-1" vertex="1">
