        <mxCell id="pwmyedOiPAz3ql49Ekzr-1" style="edgeStyle=elbowEdgeStyle;shape=connector;curved=0;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=default;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" parent="DZrcdCRluUI7c4hvy4qe-1" source="DZrcdCRluUI7c4hvy4qe-6" target="pwmyedOiPAz3ql49Ekzr-0" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <UserObject label="&lt;span style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;Information is not the external object itself.&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;font style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;br&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;If we experience an external reality as distinct from ourselves, and we define &quot;information&quot; as the [internal] content of those experiences, then information about any external object must also be distinct from the object itself.&lt;/span&gt;" link="data:page/id,VuEyJK-5QdxOhdqgMgJb" id="DZrcdCRluUI7c4hvy4qe-6">
          <mxCell style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;size=30;fillColor=#b0e3e6;strokeColor=#0e8088;fontSize=1;strokeWidth=2;spacing=16;" parent="DZrcdCRluUI7c4hvy4qe-1" vertex="1">
            <mxGeometry x="360" y="450" width="450" height="100" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="DZrcdCRluUI7c4hvy4qe-11" style="edgeStyle=elbowEdgeStyle;shape=connector;curved=0;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=default;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" parent="DZrcdCRluUI7c4hvy4qe-1" source="DZrcdCRluUI7c4hvy4qe-6" target="DZrcdCRluUI7c4hvy4qe-12" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="430" y="497" as="sourcePoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="DZrcdCRluUI7c4hvy4qe-12" value="&lt;b&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Objections&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/font&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;div&gt;&lt;div&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left; padding-left: 1px; padding-right: 1px;&quot;&gt;&lt;div style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); padding-left: 1px; padding-right: 1px; display: inline !important;&quot;&gt;&lt;font style=&quot;color: rgb(77, 77, 77);&quot;&gt;&lt;b style=&quot;background-color: transparent; font-size: 11px;&quot;&gt;1.&lt;/b&gt;&lt;span style=&quot;background-color: transparent; font-size: 11px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;span style=&quot;background-color: transparent; text-align: center; font-size: 11px;&quot;&gt;&lt;font color=&quot;#4d4d4d&quot;&gt;Information about something &lt;i&gt;is&lt;/i&gt; that something’s essence.&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;ul style=&quot;padding-left: 25px; padding-right: 1px; margin-bottom: 2px;&quot;&gt;&lt;li style=&quot;&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(51, 0, 0), rgb(51, 0, 0));&quot;&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;This is a category mistake: saying &quot;the feeling of heat is the fire&quot; confuses the effect (our perception) with the cause (the actual flames). T&lt;/span&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;he warmth felt is not the fire itself - it’s merely the experience or content produced by the fire.&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;Information about an object is derived from the object’s properties; it isn’t identical to them.&lt;/span&gt;&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;div style=&quot;padding-left: 1px; padding-right: 1px;&quot;&gt;&lt;font style=&quot;color: rgb(77, 77, 77);&quot;&gt;&lt;b style=&quot;background-color: transparent; font-size: 11px;&quot;&gt;2.&lt;/b&gt;&lt;span style=&quot;background-color: transparent; font-size: 11px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 11px;&quot;&gt;&lt;font color=&quot;#4d4d4d&quot;&gt;What if the information is a perf&lt;/font&gt;&lt;font style=&quot;color: rgb(77, 77, 77);&quot;&gt;ect &lt;/font&gt;&lt;font color=&quot;#4d4d4d&quot;&gt;copy?&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;ul style=&quot;padding-left: 25px; padding-right: 1px;&quot;&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 11px; color: light-dark(rgb(51, 0, 0), rgb(255, 255, 255));&quot;&gt;What would this even mean? For you to experience or know every possible detail about an object? Regardless of &lt;i&gt;how&lt;/i&gt; we represent information through different mediums (writing, digital simulations, your own brain&#39;s neurons, etc. - different physical representations of information), a perfect representation still wouldn&#39;t be the original object itself. In fact, the ultimate proof of this would be the very information that the copy &lt;i&gt;is&lt;/i&gt;&amp;nbsp;a copy.&lt;/font&gt;&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;div style=&quot;background-color: transparent; color: rgb(0, 0, 0); padding-left: 1px; padding-right: 1px; display: inline !important;&quot;&gt;&lt;font style=&quot;color: rgb(77, 77, 77);&quot;&gt;&lt;b style=&quot;background-color: transparent; font-size: 11px;&quot;&gt;3.&lt;/b&gt;&lt;span style=&quot;background-color: transparent; font-size: 11px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;&lt;font style=&quot;color: rgb(77, 77, 77);&quot;&gt;In quantum mechanics, observing something changes it - aren’t they then the same?&lt;/font&gt;&lt;/span&gt;&lt;div style=&quot;background-color: transparent; color: rgb(0, 0, 0);&quot;&gt;&lt;ul style=&quot;padding-left: 25px; padding-right: 1px;&quot;&gt;&lt;li style=&quot;&quot;&gt;&lt;font color=&quot;#330000&quot;&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;This phenomenon doesn’t occur because conscious awareness directly alters a quantum system (as far as we know), but rather because the very act of measuring&amp;nbsp; disturbs the quantum state - similar to how touching water disrupts its stillness.&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;font color=&quot;#330000&quot;&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;Even if consciousness is discovered to directly influence reality, it would still remain a relationship - one entity affecting another - not proof that the two are the same.&lt;/span&gt;&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;fontFamily=Helvetica;fontSize=1;labelBackgroundColor=none;fillColor=#f5f5f5;gradientColor=#b3b3b3;strokeColor=#666666;verticalAlign=top;size=0.043478260869565216;" parent="DZrcdCRluUI7c4hvy4qe-1" vertex="1">
          <mxGeometry x="-200" y="355" width="480" height="290" as="geometry" />
        </mxCell>
        <mxCell id="DZrcdCRluUI7c4hvy4qe-13" style="edgeStyle=elbowEdgeStyle;shape=connector;curved=0;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=default;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" parent="DZrcdCRluUI7c4hvy4qe-1" source="DZrcdCRluUI7c4hvy4qe-6" target="FXB_iGxQvqBiaUQBnRjr-0" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="740" y="497" as="sourcePoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="DZrcdCRluUI7c4hvy4qe-15" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;div style=&quot;font-size: 11px;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;b&gt;Notes&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 11px; text-align: left;&quot;&gt;&lt;ul style=&quot;padding-left: 20px; margin-top: 4px;&quot;&gt;&lt;li&gt;Just like memories: the memory of an event (which is a mental sensation) is not the event itself&lt;/li&gt;&lt;ul style=&quot;padding-left: 20px; margin-bottom: 4px;&quot;&gt;&lt;li&gt;&lt;font color=&quot;#4d4d4d&quot;&gt;Reality is external, while the information we recieve from it is internal&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;This node is the foundation for how information can be processed&lt;/span&gt;&lt;/li&gt;&lt;ul style=&quot;padding-left: 20px; margin-bottom: 4px;&quot;&gt;&lt;li&gt;&lt;span style=&quot;color: light-dark(rgb(77, 77, 77), rgb(171, 171, 171)); background-color: transparent;&quot;&gt;Information can be ignored or can be understood truly or falsely&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;div&gt;&lt;font color=&quot;#4d4d4d&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=1;labelBackgroundColor=none;align=left;fillColor=#e6d0de;gradientColor=#d5739d;strokeColor=#996185;gradientDirection=north;verticalAlign=top;" parent="DZrcdCRluUI7c4hvy4qe-1" vertex="1">
          <mxGeometry x="370" y="737" width="430" height="113" as="geometry" />
        </mxCell>
        <mxCell id="DZrcdCRluUI7c4hvy4qe-16" style="edgeStyle=elbowEdgeStyle;shape=connector;curved=0;rounded=1;orthogonalLoop=1;jettySize=auto;elbow=vertical;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=default;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;" parent="DZrcdCRluUI7c4hvy4qe-1" source="EcoFD-7CPlCxJA1pQeIg-2" target="DZrcdCRluUI7c4hvy4qe-6" edge="1">
