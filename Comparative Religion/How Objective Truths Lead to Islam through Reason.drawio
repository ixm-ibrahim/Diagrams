        <UserObject label="&lt;font style=&quot;font-size: 12px;&quot;&gt;Emotional sensations occur.&lt;/font&gt;" link="data:page/id,dt7_A_dOgK_7RRUwUDZR" id="xCnwdoKPpG8b0vwkaMOA-9">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFDEC9;gradientColor=#FFB663;strokeColor=#D69555;strokeWidth=2;fontSize=1;" parent="xCnwdoKPpG8b0vwkaMOA-1" vertex="1">
