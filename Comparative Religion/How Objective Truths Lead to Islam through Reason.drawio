        <mxCell id="7jwuDECKpDgqieylm1P--201" value="If the same pattern between individuals is identified - regardless of validity - the model can be sensually shared" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" parent="1" vertex="1">
