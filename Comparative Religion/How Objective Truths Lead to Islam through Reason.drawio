          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFDEC9;gradientColor=#FFB663;strokeColor=#D69555;strokeWidth=2;fontSize=1;" parent="VRDFq0wFc6pFJHJ383-H-1" vertex="1">
