        <mxCell id="7jwuDECKpDgqieylm1P--168" value="&lt;b&gt;Subjective &lt;/b&gt;reality is completely dependent on human belief" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" parent="1" vertex="1">
