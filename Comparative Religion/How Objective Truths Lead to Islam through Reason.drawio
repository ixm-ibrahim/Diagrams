        <UserObject label="&lt;span style=&quot;font-size: 12px;&quot;&gt;Knowledge can be true or false.&lt;/span&gt;" link="data:page/id,7PXsJPQ2AF7nXEVdAFUW" id="XE9wM9tcj7p-6C1WfFt_-13">
