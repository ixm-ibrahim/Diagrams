        <mxCell id="7jwuDECKpDgqieylm1P--281" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--283" target="7jwuDECKpDgqieylm1P--525">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--282" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--283" target="7jwuDECKpDgqieylm1P--217">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--283" value="A &lt;b&gt;system &lt;/b&gt;is a set of axioms and theorems that seeks to deductively explain reality" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="-4540" y="-1810" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--284" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.75;entryY=0;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;labelBackgroundColor=none;fontColor=default;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--288" target="7jwuDECKpDgqieylm1P--250">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-4450" y="-660" as="sourcePoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--285" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=none;fontColor=default;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--364" target="7jwuDECKpDgqieylm1P--407">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--286" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=none;fontColor=default;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--288" target="7jwuDECKpDgqieylm1P--422">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--287" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--275" target="7jwuDECKpDgqieylm1P--762">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-4130" y="-770" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--288" value="The number and scope of the axioms and theorems in the system&amp;nbsp;is inversely proportional to the range of possible alternate explanations that could explain the same conclusions" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="-4600" y="-900" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--289" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;labelBackgroundColor=none;fontColor=default;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--288" target="7jwuDECKpDgqieylm1P--275">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-4450" y="-660" as="sourcePoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--290" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;labelBackgroundColor=none;fontColor=default;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--291" target="7jwuDECKpDgqieylm1P--248">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-3530" y="180" as="sourcePoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--291" value="Even with infinite alternative explanations, the range can be narrowed enough to make the differences between them negligible" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="-5150" y="-640" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--292" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=none;fontColor=default;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--293" target="7jwuDECKpDgqieylm1P--300">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--293" value="A sound system cannot be founded on hypersimplistic axioms (such as &quot;everything is true&quot; or &quot;nothing can be proven to be true&quot;) as they lead to internal and external inconsistensies due to lacking a firm grounding in reality (the former axiom contradictingly includes both P and not P while the latter claims not P while being P itself, yet another contradiction)" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="-5900" y="-640" width="520" height="80" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--294" style="rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.99;exitY=0.974;exitDx=0;exitDy=0;entryX=0.022;entryY=0.033;entryDx=0;entryDy=0;entryPerimeter=0;exitPerimeter=0;labelBackgroundColor=none;fontColor=default;dashed=1;dashPattern=12 12;startArrow=oval;startFill=1;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--295" target="7jwuDECKpDgqieylm1P--315">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--295" value="If someone has to resort to the axiom/claim of doubting their own senses or existence in an attempt to show that an otherwise sensually or logically consistent argument is not sound (especially considering that this argument is only brought up when all other intuitive argumentation fails), then that shows that the basis for such an axiom/claim is fundamentally baseless, considering that the argument is so aligned with reality that reality itself has to be doubted" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="-5780" y="-140" width="560" height="100" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--296" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.75;entryY=0;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;labelBackgroundColor=none;fontColor=default;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--298" target="7jwuDECKpDgqieylm1P--295">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-4440" y="550" as="sourcePoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--297" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--298" target="7jwuDECKpDgqieylm1P--641">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--298" value="A flat earther does not need to perform every calculation and observation himself to know the earth is round: 20% of the evidence is enough to narrow down and dismiss any other possible explanation (the rest of the 80% of the evidence will only grant more intuition and understanding), and that 20% provides a more sound explanation than 80% of any false counter" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="-5210" y="-340" width="360" height="100" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--299" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.25;entryY=0;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;labelBackgroundColor=none;fontColor=default;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--300" target="7jwuDECKpDgqieylm1P--295">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-5000" y="390" as="sourcePoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--300" value="This includes hypersimplicity with human sensory input, either claiming that sensory observation is wholly trustworthy (whatever you observe and your understanding of it is truly accurate) or wholly untrustworthy (human sensory input is so untrustworthy that nothing can truly be known to be true from it), as sensory input includes both the possibility of deception and the possibility of accurate understanding, which&amp;nbsp;are counterexamples to both claims - and not to mention that sensory input can be used to arrive at either conclusion" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="-5900" y="-500" width="520" height="100" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--301" value="If someone wants to doubt their own existence or their ability to arrive at basic truths, just let them punch themselves in their face: if they react in any way, then they show that they are aware that their body receives sensual input and thus they prove to themselves that they must exist, and if they refuse then they prove to themselves that there exists some agent to be able to refuse at all and thus they must exist" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="2570" y="40" width="280" height="140" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--302" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;labelBackgroundColor=none;fontColor=default;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--303" target="7jwuDECKpDgqieylm1P--306">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--303" value="A system with too many axioms will by hyperfitted such that deductions are replaced with/treated as axioms and axioms are made to validate conclusions" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="-4580" y="-640" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--304" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.75;entryY=0;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;labelBackgroundColor=none;fontColor=default;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--306" target="7jwuDECKpDgqieylm1P--310">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-3970" y="320" as="targetPoint" />
            <mxPoint x="-3970" y="330" as="sourcePoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--305" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;labelBackgroundColor=none;fontColor=default;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--306" target="7jwuDECKpDgqieylm1P--318">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-3970" y="330" as="sourcePoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--306" value="This is evident in systems that treat certain conclusions as axioms: if the conclusion is false, then more ungrounded axioms must be added to maintain valid deductions" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="-4580" y="-500" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--307" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.25;entryY=0;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;labelBackgroundColor=none;fontColor=default;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--310" target="7jwuDECKpDgqieylm1P--321">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-4030" y="500" as="sourcePoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--308" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;curved=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;labelBackgroundColor=none;fontColor=default;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--310" target="7jwuDECKpDgqieylm1P--322">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-4030" y="500" as="sourcePoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--309" style="rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.98;exitY=0.961;exitDx=0;exitDy=0;entryX=0.025;entryY=0.018;entryDx=0;entryDy=0;dashed=1;dashPattern=12 12;entryPerimeter=0;startArrow=oval;startFill=1;exitPerimeter=0;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--644" target="7jwuDECKpDgqieylm1P--786">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--310" value="A system can be shown to be true (or at the very least, more true) if it possesses sound axioms and theorems with a scope that provides enough evidence to elimintate alternate explanations" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="-4640" y="-340" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--311" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=none;fontColor=default;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--313" target="7jwuDECKpDgqieylm1P--158">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1235.000000000001" y="-520" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--312" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;labelBackgroundColor=none;fontColor=default;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--313" target="7jwuDECKpDgqieylm1P--348">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1070" y="-690" as="sourcePoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--313" value="It&#39;s possible that what we observe may not be what&#39;s objectively &quot;real&quot;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="970" y="-1560" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--314" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;labelBackgroundColor=none;fontColor=default;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--268" target="7jwuDECKpDgqieylm1P--265">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-4430" y="-1150" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--315" value="A sound counterargument will be grounded in reality, and so it will never need to make an argument such that reality itself is doubted, as some observation or deduction must exist to show it to be true or false" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="-4240" y="40" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--316" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=none;fontColor=default;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--318" target="7jwuDECKpDgqieylm1P--320">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--317" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=none;fontColor=default;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--318" target="7jwuDECKpDgqieylm1P--321">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--318" value="If an argument relies on an axiom, the truth of that axiom must be established before drawing conclusions from the argument: deduction is only meaningful with respect to their necessary axioms" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="-4300" y="-340" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--319" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.25;entryY=0;entryDx=0;entryDy=0;curved=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;labelBackgroundColor=none;fontColor=default;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--320" target="7jwuDECKpDgqieylm1P--315">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-3390" y="670" as="sourcePoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--320" value="Proving an argument without first establishing the soundness of its necessary axioms is like proving algebra exists while doubting the existence of math itself, or like trying to explain how to run while doubting that legs exist: conclusions must be reached through established axioms" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="-4310" y="-140" width="260" height="99" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--321" value="If an argument is claiming something that is far from a sound axiom or another theorem (&quot;great claims require great evidence&quot;), then it requires more deductive steps (or more sound axioms) to be proven, which also means it will be easier to validate" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="-4580" y="-140" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--322" value="In SSBU, when your opponent attempts to return to the ledge, you can position yourself to cover all their options - even though you may not know which option they&#39;ll choose, you can be certain that your positioning will lead to your winning the game in all cases" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="-4850" y="-140" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--323" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;labelBackgroundColor=none;fontColor=default;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--324" target="7jwuDECKpDgqieylm1P--330">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3860" y="-1080" as="sourcePoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--324" value="Words are externally sensual labels that represent our internal models, or a placeholder for a model we have yet to build" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="3720" y="-1200" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--325" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=none;fontColor=default;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--327" target="7jwuDECKpDgqieylm1P--201">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--326" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--327" target="7jwuDECKpDgqieylm1P--559">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="4130" y="-1470" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--327" value="Tools are used as a medium of extending the resolution of our senses or clarifying the scope of our observations" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="3990" y="-1580" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--328" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=none;fontColor=default;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--330" target="7jwuDECKpDgqieylm1P--332">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--329" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=none;fontColor=default;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--330" target="7jwuDECKpDgqieylm1P--370">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3800" y="-760" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--330" value="Because words represent internal models, it is possible that different individuals use the same words for different models (homonyms) and different words for the same model (synonyms)" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="3720" y="-1050" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--331" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;labelBackgroundColor=none;fontColor=default;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--332" target="7jwuDECKpDgqieylm1P--370">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--332" value="If the protocols, models, or words differ&amp;nbsp;for the same experience, then a translation based on shared experience is required to communicate a certain concept" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="3450" y="-910" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--333" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=none;fontColor=default;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--335" target="7jwuDECKpDgqieylm1P--236">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--334" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.75;entryY=0;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;labelBackgroundColor=none;fontColor=default;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--335" target="7jwuDECKpDgqieylm1P--378">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2140" y="-810" as="sourcePoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--335" value="Education is the process of building an internal model of concepts through observation and deduction, incorporating truths from more advanced models" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="2120" y="-1340" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--336" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--338" target="7jwuDECKpDgqieylm1P--490">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--337" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--338" target="7jwuDECKpDgqieylm1P--620">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1400" y="230" />
              <mxPoint x="670" y="230" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--338" value="Thus, this proof by contradiction shows that if existence is true, then logic must also be true - and if existence is demonstrable through sensory experience, then sound logic (axioms and theorems) can be demonstrably validated through sensory experience" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1260" y="40" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--339" style="rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.75;entryY=0;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;labelBackgroundColor=none;fontColor=default;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--430" target="7jwuDECKpDgqieylm1P--391">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--340" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;labelBackgroundColor=none;fontColor=default;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--348" target="7jwuDECKpDgqieylm1P--346">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="930" y="-550" as="sourcePoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--341" value="The possibility of the worst case does not diminish from the possibility of the best case" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="550" y="-1770" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--342" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=none;fontColor=default;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--476" target="7jwuDECKpDgqieylm1P--479">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--343" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--344" target="7jwuDECKpDgqieylm1P--476">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--344" value="Thus the question is not, &quot;how can we know the truth if we can&#39;t trust the means of arriving there?&quot; but rather &quot;how can we use the means available to us to separate the truth from falsehood?&quot;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1280" y="-1180" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--345" style="rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=none;fontColor=default;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--346" target="7jwuDECKpDgqieylm1P--344">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--346" value="Saying just one without the other dismissess or implies the other&#39;s lack of existence, which sets up a system with a false axiom" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="840" y="-1320" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--347" style="rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.014;exitY=0.961;exitDx=0;exitDy=0;entryX=0.986;entryY=0.029;entryDx=0;entryDy=0;dashed=1;dashPattern=12 12;startArrow=oval;startFill=1;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--348" target="7jwuDECKpDgqieylm1P--920">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--348" value="Although we experience and sense so little of reality and know far less than what we do know, the possibility of false or deceptive observation does not negate the potential for true or trustworthy observation" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="840" y="-1460" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--349" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=none;fontColor=default;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--350" target="7jwuDECKpDgqieylm1P--357">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--350" value="&lt;b&gt;Theory &lt;/b&gt;is a logical extrapolation that seeks to show the soundness of an unestablished claim by demonstrating its soundness within an established system" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="-1320" y="-1560" width="240" height="81" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--351" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--354" target="7jwuDECKpDgqieylm1P--743">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-2460" y="-790" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--352" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--354" target="7jwuDECKpDgqieylm1P--531">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--353" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--354" target="7jwuDECKpDgqieylm1P--637">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--354" value="From the perspective of a false system, the truth always seems to provide a &quot;convenient&quot; answer for everything, just as a false system appears from the perspective of the truth: true convenience occurs when the real nature of a claim is obscured by a more appealing but misleading one" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="-2940" y="-900" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--355" value="The difference between objectivity and subjectivity is the reference: objectivity has a constant reference while subjectivity has a variable or arbitrary reference" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="1590" y="-1560" width="250" height="60" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--356" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=none;fontColor=default;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--357" target="7jwuDECKpDgqieylm1P--363">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--357" value="If a concept transcends comprehension or observation, we can logically fill in the gaps by building a theoretical model through analogy based on known experiences" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="-1260" y="-1420" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--358" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=none;fontColor=default;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--360" target="7jwuDECKpDgqieylm1P--357">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--359" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=none;fontColor=default;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--360" target="7jwuDECKpDgqieylm1P--402">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-140" y="-675" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--360" value="&lt;b&gt;Analogy &lt;/b&gt;is a logical extrapolation that seeks to build intuition for a newly established model by associating a set of previously established experiences with it" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="-990" y="-1560" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--361" style="rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.023;exitY=0.947;exitDx=0;exitDy=0;entryX=0.985;entryY=0.039;entryDx=0;entryDy=0;labelBackgroundColor=none;fontColor=default;entryPerimeter=0;exitPerimeter=0;dashed=1;dashPattern=12 12;startArrow=oval;startFill=1;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--363" target="7jwuDECKpDgqieylm1P--367">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--362" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--363" target="7jwuDECKpDgqieylm1P--621">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="-870" y="-740" />
              <mxPoint x="-1235" y="-740" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--363" value="For abstract concepts transcending direct experience&amp;nbsp;(such as infinity, nothingness, or a simple lack of knowledge/education), we develop theories that best model observable reality and use analogies to build intuition" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="-990" y="-1290" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--364" value="A &lt;b&gt;paradox &lt;/b&gt;is an incomprehensible truth: a sound conclusion that presents an apparent contradiction within a system" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="-2130" y="-1680" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--365" value="The difference betwen a wise man and an insane man is shown by the pattern/rules/protocol that governs their arguments: if they are consistent, grounded in reality, and with utility, then it is wisdom; otherwise, if they are chaotic, random, arbitrary, or unsound, then it is insanity&amp;nbsp;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="-2680" y="-40" width="380" height="100" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--366" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--367" target="7jwuDECKpDgqieylm1P--662">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--367" value="While our comprehension may never fully grasp either, the difference between an unintuitive/unsound axiom and an abstract/theoretical concept or paradox (aka identifying truth and falsehood of what we can&#39;t see) is that the latter relies on sound axioms whereas the former requires an infinite regression of axioms without a basis in reality" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="-3890" y="530" width="320" height="110" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--368" value="It&#39;s possible that we believe something true to be false&amp;nbsp;(false positive) and vice versa (false negative)" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="340" y="-1560" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--369" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--370" target="7jwuDECKpDgqieylm1P--536">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--370" value="Before using the same word or label for a concept, it needs to be explicated to avoid ambiguation" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="3720" y="-740" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--371" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--374" target="7jwuDECKpDgqieylm1P--389">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--372" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--374" target="7jwuDECKpDgqieylm1P--464">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--373" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--374" target="7jwuDECKpDgqieylm1P--518">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-320" y="110" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--374" value="Random distributions do not necessitate arbitrary distributions, and thus using a likelihood to prove or disprove a past event is like trying to determine the exact roll of a die rolled yesterday based solely on the probability of rolling each number" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="-730" y="-40" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--375" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--378" target="7jwuDECKpDgqieylm1P--146">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--376" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--378" target="7jwuDECKpDgqieylm1P--469">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--377" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--378" target="7jwuDECKpDgqieylm1P--517">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--378" value="With system soundness not guaranteed, comparing two systems exposes their differences, which can then be evaluated against reality to determine the better model" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="2060" y="-610" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--379" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=none;fontColor=default;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--384" target="7jwuDECKpDgqieylm1P--288">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--380" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=none;fontColor=default;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--384" target="7jwuDECKpDgqieylm1P--407">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--381" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=none;fontColor=default;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--384" target="7jwuDECKpDgqieylm1P--425">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--382" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=none;fontColor=default;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--384" target="7jwuDECKpDgqieylm1P--440">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--383" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--384" target="7jwuDECKpDgqieylm1P--354">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--384" value="A system can vary in scope and soundness, potentially containing any ratio of truth to falsehood in any context" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="-4510" y="-1030" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--385" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=none;fontColor=default;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--475" target="7jwuDECKpDgqieylm1P--392">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--386" style="rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=none;fontColor=default;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--388" target="7jwuDECKpDgqieylm1P--407">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="-2440" y="-1590" />
              <mxPoint x="-2110" y="-1590" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--387" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--388" target="7jwuDECKpDgqieylm1P--475">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--388" value="All &lt;b&gt;information &lt;/b&gt;needs a source, either through observation, induction, or deduction" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="-2560" y="-1680" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--389" value="Any bit within a storage drive has a random chance of being 0 or 1, yet if they were randomly chosen the computer would not function properly, or at all (Chaos Theory)" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="-730" y="120" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--390" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=none;fontColor=default;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--391" target="7jwuDECKpDgqieylm1P--293">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--391" value="Axioms have no proof nor disproof: an axiom becomes intuitive when it is consistent with reality and there are enough signs to show that there is no reason for it not to be sound" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="-5760" y="-1160" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--392" value="If a child says there&#39;s a monster under their bed, the claim can be verified by checking it to see if the source of that information is from observation or emotion, whereas if a mathematician says there&#39;s imaginary numbers or a physicist says there&#39;s a higher spatial dimension, it would have to be logically demonstrated" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="-2560" y="-1450" width="240" height="130" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--393" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=none;fontColor=default;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--394" target="7jwuDECKpDgqieylm1P--363">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--394" value="A strong analogy accurately highlights relevant similarities and avoids misleading differences" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="-720" y="-1420" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--395" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=none;fontColor=default;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--396" target="7jwuDECKpDgqieylm1P--394">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--396" value="Any conclusion can be extrapolated, but the further the conclusion is from the system or the less of the system&#39;s logic is used, the weaker the extrapolation" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="-720" y="-1560" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--397" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontColor=default;labelBackgroundColor=none;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--399" target="7jwuDECKpDgqieylm1P--360">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--398" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=none;fontColor=default;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--399" target="7jwuDECKpDgqieylm1P--396">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--399" value="&lt;b&gt;Extrapolation &lt;/b&gt;is using a system&#39;s logical trends to predict a conclusion not currently within the system" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="-990" y="-1680" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--400" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=none;fontColor=default;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--402" target="7jwuDECKpDgqieylm1P--363">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--401" style="rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.014;exitY=0.957;exitDx=0;exitDy=0;entryX=0.985;entryY=0.034;entryDx=0;entryDy=0;dashed=1;dashPattern=12 12;exitPerimeter=0;entryPerimeter=0;startArrow=oval;startFill=1;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--402" target="7jwuDECKpDgqieylm1P--584">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--402" value="Analogies are not proofs, rather they build intuition by associating previous experiences with a new logical connection" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="-990" y="-1420" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--403" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;fontColor=default;labelBackgroundColor=none;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--407" target="7jwuDECKpDgqieylm1P--409">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="-2110" y="-380" />
              <mxPoint x="-2395" y="-380" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--404" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=none;fontColor=default;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--407" target="7jwuDECKpDgqieylm1P--417">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--405" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=none;fontColor=default;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--407" target="7jwuDECKpDgqieylm1P--413">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="-2110" y="-380" />
              <mxPoint x="-1760" y="-380" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--406" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=none;fontColor=default;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--407" target="7jwuDECKpDgqieylm1P--411">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="-2030" y="-380" />
              <mxPoint x="-1330" y="-380" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--407" value="Paradoxes are merely a reflection of missing information: they arise when something is observed or known to be true yet presents a contradiction within the system due to lack of knowledge of the rest of the system and, unlike contradictions, can have their soundness demonstrated by identifying the soundness of what we can&#39;t comprehend" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="-2310" y="-900" width="400" height="80" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--408" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=none;fontColor=default;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--409" target="7jwuDECKpDgqieylm1P--505">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--409" value="&lt;b&gt;Paradox vs. Contradiction&lt;/b&gt;&amp;nbsp;(lack of knowledge vs. lack of soundness): a contradiction requires an infinite number of explanations because resolving it demands endless adjustments to account for inconsistencies, while a paradox is an apparent contradiction that needs a finite number of explanations, as it stems from an incomplete understanding of reality and identifiable limitations in our knowledge" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="-2680" y="-340" width="380" height="100" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--410" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--411" target="7jwuDECKpDgqieylm1P--497">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--411" value="&lt;b&gt;Unintuitive vs. Unsound&lt;/b&gt;&amp;nbsp;(subjective vs. objective contradiction): a lack of intuition indicates a contradiction within one&#39;s internal model, which can occur because either the internal model is false, incomplete, or the new claim is false - making it merely unsound" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="-1570" y="-340" width="320" height="100" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--412" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=none;fontColor=default;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--413" target="7jwuDECKpDgqieylm1P--415">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--413" value="&lt;b&gt;Truth vs. Whole Truth&lt;/b&gt;: a truth is a subset of the whole truth and can appear false when placed in a false system" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="-1920" y="-340" width="320" height="100" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--414" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--415" target="7jwuDECKpDgqieylm1P--512">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--415" value="&lt;b&gt;Necessary Truth vs. Whole Truth&lt;/b&gt;: necessary truth comprises the essential knowledge needed to arrive at a conclusion and is a subset of the whole truth" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="-1920" y="-200" width="320" height="100" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--416" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=none;fontColor=default;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--417" target="7jwuDECKpDgqieylm1P--419">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--417" value="&lt;b&gt;No Proof vs. Disproof&lt;/b&gt;&amp;nbsp;(absence of evidence vs. evidence of absence): the lack of proof reflects either a lack of knowledge or lack of soundness, whereas disproof provides evidence that contradicts the claim trying to be proven" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="-2270" y="-340" width="320" height="100" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--418" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--419" target="7jwuDECKpDgqieylm1P--495">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--419" value="&lt;b&gt;No Proof vs. No Disproof&amp;nbsp;&lt;/b&gt;(lack of necessary knowledge): no argument can be made for or against a claim if there isn&#39;t enough information about it" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="-2270" y="-200" width="320" height="110" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--420" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=none;fontColor=default;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--432" target="7jwuDECKpDgqieylm1P--409">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="-3810" y="-380" />
              <mxPoint x="-2585" y="-380" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--421" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=none;fontColor=default;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--422" target="7jwuDECKpDgqieylm1P--432">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--422" value="If a system supports a false claim, then the more sound axioms and theorems the system has, the easier it will be to idenitfy contradictions as the falsehood propagates throughout the system" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="-3930" y="-760" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--423" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=none;fontColor=default;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--425" target="7jwuDECKpDgqieylm1P--422">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--424" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--425" target="7jwuDECKpDgqieylm1P--510">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="-3750" y="-790" />
              <mxPoint x="-3540" y="-790" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--425" value="The more axioms and theorems in a system, the exponentially easier it becomes to identify its soundness due to the increased number of relationship available for cross-validation" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="-3890" y="-900" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--426" value="" style="rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=none;fontColor=default;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--221" target="7jwuDECKpDgqieylm1P--430">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-5086" y="-1361" as="sourcePoint" />
            <mxPoint x="183" y="313" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--427" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--430" target="7jwuDECKpDgqieylm1P--288">
          <mxGeometry relative="1" as="geometry">
