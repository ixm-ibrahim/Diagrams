        <mxCell id="7jwuDECKpDgqieylm1P--259" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.75;entryY=0;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;labelBackgroundColor=none;fontColor=default;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--260" target="7jwuDECKpDgqieylm1P--262">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-4030" y="-1590" as="sourcePoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--260" value="A &lt;b&gt;theorem &lt;/b&gt;(or proposition) is a new conclution that is deduced from other axioms or deductions" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="-4210" y="-1680" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--261" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=none;fontColor=default;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--262" target="7jwuDECKpDgqieylm1P--265">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--262" value="The truthfulness of a theorem is shown through proving that its premises must yield the conclusion, while&amp;nbsp;an untrue or false theorem is one that lacks validity or soundness" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="-4240" y="-1430" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--263" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=none;fontColor=default;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--210" target="7jwuDECKpDgqieylm1P--262">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--264" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--265" target="7jwuDECKpDgqieylm1P--526">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--265" value="The soundness/truthfulness of a &lt;b&gt;system &lt;/b&gt;is shown through how internally consistent all the axioms and theorems are, as well as how external consistent it is with reality" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="-4510" y="-1280" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--266" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=none;fontColor=default;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--268" target="7jwuDECKpDgqieylm1P--430">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--267" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;labelBackgroundColor=none;fontColor=default;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--256" target="7jwuDECKpDgqieylm1P--221">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--268" value="The soundness of an axiom isn&#39;t demonstrated through an empirical proof if proofs depend on axioms (trying to empirically prove an axiom is like trying to cook a chef:&amp;nbsp;they themselves are not subject to the same process of empirical proof that they support): rather they are only shown" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="-4870" y="-1430" width="330" height="90" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--269" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=none;fontColor=default;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--271" target="7jwuDECKpDgqieylm1P--265">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--270" style="rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.986;entryY=0.043;entryDx=0;entryDy=0;exitX=0.02;exitY=0.958;exitDx=0;exitDy=0;labelBackgroundColor=none;fontColor=default;exitPerimeter=0;entryPerimeter=0;dashed=1;dashPattern=12 12;startArrow=oval;startFill=1;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--271" target="7jwuDECKpDgqieylm1P--430">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-4380" y="-1300" as="sourcePoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--271" value="A proof is &lt;b&gt;valid &lt;/b&gt;if the conclusions logically follow from the premises, and it is &lt;b&gt;sound &lt;/b&gt;when it is valid and is harmonious with the rest of the system" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="-4510" y="-1430" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="7jwuDECKpDgqieylm1P--272" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;labelBackgroundColor=none;fontColor=default;" edge="1" parent="1" source="7jwuDECKpDgqieylm1P--275" target="7jwuDECKpDgqieylm1P--291">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-4310" y="-540" as="sourcePoint" />
          </mxGeometry>
        </mxCell>
