        <mxCell id="gV_TXRiq1vcrWP1O0eZQ-3" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;Emotional sensations occur.&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;This encompasses feelings such as happiness,&lt;br&gt;sadness, anger, sexual attraction, hatred,&lt;br&gt;calmness, empathy, contentness, etc.&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;size=30;fillColor=#b0e3e6;strokeColor=#0e8088;fontSize=1;strokeWidth=2;" vertex="1" parent="gV_TXRiq1vcrWP1O0eZQ-1">
