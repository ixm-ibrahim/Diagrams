        <UserObject label="&lt;font style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;Sensations occur over time.&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 4px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;This encompasses feelings of thoughts, memories, contemplation, dreams, and ideas.&lt;/font&gt;" link="data:page/id,OxJ0hisxOXPdo3oqrMkj" id="X--VHpJq4IpHabeX2C67-3">
          <mxCell style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;size=30;fillColor=#b0e3e6;strokeColor=#0e8088;fontSize=1;strokeWidth=2;spacing=16;" vertex="1" parent="X--VHpJq4IpHabeX2C67-1">
