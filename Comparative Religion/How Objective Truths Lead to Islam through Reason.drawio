        <UserObject label="&lt;font style=&quot;font-size: 14px;&quot;&gt;We exist.&lt;/font&gt;" link="data:page/id,mfmMcbX07sLiCTksEZJi" id="C01_gXIBqlTGAEDjqyAt-3">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;gradientColor=#97d077;strokeColor=#82b366;strokeWidth=2;fontSize=1;" parent="ZeCqcVlVIzQ71kG4cJJh-1" vertex="1">
