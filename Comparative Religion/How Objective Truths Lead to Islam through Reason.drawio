        <mxCell id="7jwuDECKpDgqieylm1P--236" value="If our understanding is immature (lacks education) or incorrect (not sound), the communication will be flawed" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;" parent="1" vertex="1">
