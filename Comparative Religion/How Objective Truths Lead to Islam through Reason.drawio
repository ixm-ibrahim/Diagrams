        <mxCell id="7jwuDECKpDgqieylm1P--204" value="The purest, most basic information that our senses recieve is that we exist in reality in some form" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1">
          <mxGeometry x="2760" y="-1680" width="240" height="60" as="geometry" />
