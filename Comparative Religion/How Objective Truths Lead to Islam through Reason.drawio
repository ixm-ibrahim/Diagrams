        </mxCell>
        <mxCell id="uHxNGxETZ01MsBiVxSH5-2" value="if you can phenomenologically show that &quot;you&quot;exist, and derive the structure for ontology, then you can ontologically show that God exists" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;" vertex="1" parent="mExRIxhNE1BHIPu0LiUs-1">
