        <UserObject label="&lt;div style=&quot;width:336px;height:210px;color:#0B1324;&quot;&gt;&lt;div style=&quot;height:36px;line-height:36px;font-size:30px;font-weight:bold;white-space:nowrap;&quot;&gt;Hamzah after&lt;/div&gt;&lt;div dir=&quot;rtl&quot; style=&quot;direction:rtl;height:44px;line-height:44px;font-size:32px;white-space:nowrap;&quot;&gt;الهمز بعد حرف المدّ&lt;/div&gt;&lt;div style=&quot;height:24px;margin:6px 0px 8px 0px;display:flex;align-items:center;&quot;&gt;&lt;div style=&quot;flex:1;height:1px;background-color:#826730;&quot;&gt;&lt;/div&gt;&lt;div style=&quot;flex:none;box-sizing:border-box;width:132px;height:24px;line-height:24px;border-radius:12px;background-color:#0B1324;color:#F6B93B;font-size:14px;font-weight:bold;text-align:center;white-space:nowrap;&quot;&gt;4 or 5 counts&lt;/div&gt;&lt;div style=&quot;flex:1;height:1px;background-color:#826730;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;height:92px;display:flex;flex-direction:column;align-items:center;justify-content:center;&quot;&gt;&lt;div style=&quot;font-size:14px;line-height:20px;text-align:center;text-wrap:balance;&quot;&gt;The hamzah comes right after the long vowel.&lt;/div&gt;&lt;div style=&quot;height:30px;line-height:30px;margin-top:2px;text-align:center;white-space:nowrap;&quot;&gt;&lt;span style=&quot;font-size:13px;font-style:italic;margin-right:10px;&quot;&gt;like&lt;/span&gt;&lt;span dir=&quot;rtl&quot; style=&quot;direction:rtl;unicode-bidi:isolate;font-size:20px;&quot;&gt;جَآءَ&lt;/span&gt;&lt;span style=&quot;font-size:20px;margin:0px 10px;&quot;&gt;·&lt;/span&gt;&lt;span dir=&quot;rtl&quot; style=&quot;direction:rtl;unicode-bidi:isolate;font-size:20px;&quot;&gt;قُرُوٓءٍ&lt;/span&gt;&lt;span style=&quot;font-size:20px;margin:0px 10px;&quot;&gt;·&lt;/span&gt;&lt;span dir=&quot;rtl&quot; style=&quot;direction:rtl;unicode-bidi:isolate;font-size:20px;&quot;&gt;بِمَآ أُنْزِلَ&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" tooltip="&lt;div style=&quot;font-size:13px;line-height:19px;&quot;&gt;&lt;b&gt;Hamzah after&lt;/b&gt;&lt;div style=&quot;margin-top:4px;&quot;&gt;&lt;b&gt;All of these conditions apply, top box first:&lt;/b&gt;&lt;/div&gt;&lt;div&gt;Vowel Lengthening: A long vowel or a soft letter is held.&lt;/div&gt;&lt;div&gt;Secondary: The lengthening has a cause, one of two: a hamzah right before or right after the letter, or a sukūn on the next letter.&lt;/div&gt;&lt;div&gt;Caused by hamzah: The cause is a hamzah right before or right after the letter, and the letter is a long vowel.&lt;/div&gt;&lt;div&gt;&lt;b&gt;Hamzah after:&lt;/b&gt; The hamzah comes right after the long vowel.&lt;/div&gt;&lt;div&gt;&lt;b&gt;Length:&lt;/b&gt; 4 or 5 counts.&lt;/div&gt;&lt;div style=&quot;margin-top:4px;&quot;&gt;&lt;b&gt;Examples:&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;line-height:30px;white-space:nowrap;&quot;&gt;&lt;span dir=&quot;rtl&quot; style=&quot;font-size:19px;&quot;&gt;جَآءَ&lt;/span&gt;&lt;span style=&quot;margin-left:8px;&quot;&gt;Connected: same word · an-Naṣr 110:1&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;line-height:30px;white-space:nowrap;&quot;&gt;&lt;span dir=&quot;rtl&quot; style=&quot;font-size:19px;&quot;&gt;بِمَآ أُنْزِلَ&lt;/span&gt;&lt;span style=&quot;margin-left:8px;&quot;&gt;Separated: next word · al-Baqarah 2:4&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:2px;&quot;&gt;Whichever length you choose, 4 or 5, keep it for Connected and for Separated throughout a recitation.&lt;/div&gt;&lt;/div&gt;" id="hamza_after">
          <mxCell parent="1" style="rounded=1;absoluteArcSize=1;arcSize=28;whiteSpace=wrap;html=1;fillColor=#F6B93B;strokeColor=#FAD893;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontColor=#0B1324;align=center;verticalAlign=middle;spacing=10;shadow=0;" vertex="1">
            <mxGeometry height="230" width="360" x="240" y="1110" as="geometry" />
