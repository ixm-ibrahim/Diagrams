        <UserObject label="&lt;div style=&quot;width:336px;height:210px;color:#0B1324;&quot;&gt;&lt;div style=&quot;height:36px;line-height:36px;font-size:30px;font-weight:bold;white-space:nowrap;&quot;&gt;Caused by sukūn&lt;/div&gt;&lt;div dir=&quot;rtl&quot; style=&quot;direction:rtl;height:44px;line-height:44px;font-size:32px;white-space:nowrap;&quot;&gt;بسبب السكون&lt;/div&gt;&lt;div style=&quot;height:24px;margin:6px 0px 8px 0px;display:flex;align-items:center;&quot;&gt;&lt;div style=&quot;flex:1;height:1px;background-color:#3A5F85;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;height:92px;display:flex;flex-direction:column;align-items:center;justify-content:center;&quot;&gt;&lt;div style=&quot;font-size:14px;line-height:20px;text-align:center;text-wrap:balance;&quot;&gt;The cause is a sukūn on the next letter.&lt;/div&gt;&lt;div style=&quot;height:30px;line-height:30px;margin-top:2px;text-align:center;white-space:nowrap;&quot;&gt;&lt;span style=&quot;font-size:13px;font-style:italic;margin-right:10px;&quot;&gt;like&lt;/span&gt;&lt;span dir=&quot;rtl&quot; style=&quot;direction:rtl;unicode-bidi:isolate;font-size:20px;&quot;&gt;الْحَآقَّةُ&lt;/span&gt;&lt;span style=&quot;font-size:20px;margin:0px 10px;&quot;&gt;·&lt;/span&gt;&lt;span dir=&quot;rtl&quot; style=&quot;direction:rtl;unicode-bidi:isolate;font-size:20px;&quot;&gt;الْمُفْلِحُونَ&lt;/span&gt;&lt;span style=&quot;font-size:20px;margin:0px 10px;&quot;&gt;·&lt;/span&gt;&lt;span dir=&quot;rtl&quot; style=&quot;direction:rtl;unicode-bidi:isolate;font-size:20px;&quot;&gt;خَوْفٍ&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" tooltip="&lt;div style=&quot;font-size:13px;line-height:19px;&quot;&gt;&lt;b&gt;Caused by sukūn&lt;/b&gt;&lt;div style=&quot;margin-top:4px;&quot;&gt;&lt;b&gt;All of these conditions apply, top box first:&lt;/b&gt;&lt;/div&gt;&lt;div&gt;Vowel Lengthening: A long vowel or a soft letter is held.&lt;/div&gt;&lt;div&gt;Secondary: The lengthening has a cause, one of two: a hamzah right before or right after the letter, or a sukūn on the next letter.&lt;/div&gt;&lt;div&gt;&lt;b&gt;Caused by sukūn:&lt;/b&gt; The cause is a sukūn on the next letter.&lt;/div&gt;&lt;div style=&quot;margin-top:4px;&quot;&gt;&lt;b&gt;Examples:&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;line-height:30px;white-space:nowrap;&quot;&gt;&lt;span dir=&quot;rtl&quot; style=&quot;font-size:19px;&quot;&gt;الْحَآقَّةُ&lt;/span&gt;&lt;span style=&quot;margin-left:8px;&quot;&gt;Required: always there · al-Ḥāqqah 69:1&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;line-height:30px;white-space:nowrap;&quot;&gt;&lt;span dir=&quot;rtl&quot; style=&quot;font-size:19px;&quot;&gt;الْمُفْلِحُونَ&lt;/span&gt;&lt;span style=&quot;margin-left:8px;&quot;&gt;At a stop: only when you stop · al-Baqarah 2:5&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" id="sukun">
          <mxCell parent="1" style="rounded=1;absoluteArcSize=1;arcSize=28;whiteSpace=wrap;html=1;fillColor=#6FB5F3;strokeColor=#B0D6F8;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontColor=#0B1324;align=center;verticalAlign=middle;spacing=10;shadow=0;" vertex="1">
            <mxGeometry height="230" width="360" x="1740" y="820" as="geometry" />
