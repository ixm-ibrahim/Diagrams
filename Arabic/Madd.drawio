        <mxCell id="legend-hamza" connectable="0" parent="1" style="rounded=1;absoluteArcSize=1;arcSize=28;whiteSpace=wrap;html=1;fillColor=#F6B93B;strokeColor=#FAD893;strokeWidth=2;fontFamily=Helvetica;fontSize=20;fontColor=#0B1324;align=center;verticalAlign=middle;spacing=4;shadow=0;" value="&lt;div style=&quot;height: 20px; line-height: 20px; font-size: 20px; font-weight: bold; color: rgb(11, 19, 36); white-space: nowrap;&quot;&gt;caused by hamzah&lt;/div&gt;" vertex="1">
